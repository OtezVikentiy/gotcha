# Таблицы, созданные миграциями прыжка: были отсутствующими, стали пустыми.
# Заполняется по факту прогона, а не заранее: пустой файл означает
# «расхождений не ожидаем вовсе».
#
# Дорожка B, прыжок v0.4.3 (схема 59) -> v0.35.0 (схема 91), 2026-09-05.
# Паттерны — подстрока (grep -F), применяется к обоим снимкам одинаково.
# Где число в строке не варьируется между снимками, оставлена полная
# строка; где число закономерно растёт от прогона к прогону (счётчики
# служебных таблиц), паттерн обрублен до имени таблицы с хвостовым табом,
# чтобы не завязываться на конкретное значение.

# Новые ПУСТЫЕ таблицы — фичи моложе v0.4.3, миграции только создали
# структуру, наполнять их дорожке B нечем (см. отчёт, раздел «предел
# дорожки B»): хосты (A1, v0.5.0), их пороги и группы, host-инциденты
# (0087_host_incidents_not_null — по пустой таблице, ничего не доказывает
# о бэкфилле), SLO (D1, v0.12.0), эскалации (B4, v0.17.0), зависимости
# (B5, v0.18.0, alert_dependencies), маркеры деплоя (C5, v0.11.0),
# выгрузки ошибок (E1, v0.22.0), группы инцидентов, cardinality-сигналы приёма.
pg	table	hosts	0
pg	table	host_group_thresholds	0
pg	table	host_threshold_overrides	0
pg	table	host_threshold_settings	0
pg	table	host_incidents	0
pg	table	slos	0
pg	table	slo_incidents	0
pg	table	escalation_steps	0
pg	table	escalation_step_channels	0
pg	table	escalation_step_log_failures	0
pg	table	incident_escalations	0
pg	table	alert_dependencies	0
pg	table	deployments	0
pg	table	export_jobs	0
pg	table	incident_groups	0
pg	table	ingest_signals	0

# Новая таблица НЕ пустая: status_page_redirects получила одну строку —
# это и есть бэкфилл миграций 0062/0063 (status_page_public_id /
# status_page_drop_slug) по НАШЕЙ существующей статус-странице. Ожидаемо
# и желанно: доказывает, что миграция трогает существующие строки, а не
# только создаёт структуру.
pg	table	status_page_redirects	1

# CH: новая пустая таблица логов (C1, v0.7.0 — моложе v0.4.3, синтетика
# дорожки B логи не пишет).
ch	table	logs	0

# Служебные счётчики миграций — растут закономерно на любом прыжке,
# к пользовательским данным отношения не имеют. Обрублены до имени
# таблицы: конкретное значение варьируется (77->111 записей schema_compat
# за 32 PG-миграции жизни компата, 36->40 записей ch.schema_migrations
# за миграции ClickHouse) и не является тем, что здесь проверяется —
# проверяется version/dirty схемы отдельно (снимок cmd_snapshot).
pg	table	schema_compat
ch	table	schema_migrations

# retention_state растёт на один ряд за каждую новую политику ретеншена,
# добавленную миграциями между версиями (rollout новых категорий данных,
# не пользовательские строки).
pg	table	retention_state
