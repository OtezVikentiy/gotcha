package templates

import (
	"strconv"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/org"
)

templ orgProjectCard(p org.Project) {
	<div class="card project-card">
		<h2 class="card-header"><a href={ templ.URL(overviewPath(p.ID)) }>{ p.Name }</a></h2>
		<span class="chip">{ i18n.T(ctx, "platform."+p.Platform) }</span>
		<div class="card-actions">
			<a class="btn btn-ghost" href={ templ.URL(projectSetupPath(p.ID)) }>{ i18n.T(ctx, "project.list.setup_link") }</a>
		</div>
	</div>
}

// canCreate непуст (ровно с этой организацией) только у owner/admin — иначе кнопка и модалка скрыты.
// hidden origin=org_projects: на 422 хендлер перерисовывает эту же страницу, не общий список.
templ OrgProjects(o org.Org, items []org.Project, canCreate []OrgOption, form FormState, errMsg, userEmail string) {
	@layout(i18n.Tf(ctx, "org.projects.title", "org", o.Name), userEmail) {
		<div class="org-projects">
			<h1>{ i18n.Tf(ctx, "org.projects.title", "org", o.Name) }</h1>
			if errMsg != "" && !form.Has() {
				<p class="error">{ errMsg }</p>
			}
			if len(canCreate) > 0 {
				@createTrigger("new-project", "project.create.title")
			}
			if len(items) == 0 {
				if len(canCreate) > 0 {
					@emptyState("building", "org.projects.empty.title", "org.projects.empty", "org.projects.empty_cta", "#new-project", 2)
				} else {
					@emptyState("building", "org.projects.empty.title", "org.projects.empty", "", "", 2)
				}
			} else {
				<div class="settings-grid">
					for _, p := range items {
						@orgProjectCard(p)
					}
				</div>
			}
			if len(canCreate) > 0 {
				@createModalOpen("new-project", "project.create.title", false, form.Opens("new-project")) {
					<form method="post" action="/projects/new" class="project-create-form">
						<input type="hidden" name="origin" value="org_projects"/>
						// без role=alert: фокус в модалку переносит modal.js, ошибка привязана через aria-describedby.
						if errMsg != "" && form.Opens("new-project") {
							<p class="error" id="new-project-error">{ errMsg }</p>
						}
						<div class="field">
							<label>
								{ i18n.T(ctx, "project.create.org") }
								<select name="org_id" class="select">
									for _, oo := range canCreate {
										<option value={ strconv.FormatInt(oo.ID, 10) } selected>{ oo.Name }</option>
									}
								</select>
							</label>
						</div>
						<div class="field">
							<label>
								{ i18n.T(ctx, "project.create.slug") }
								<input
									type="text"
									name="slug"
									required
									class="input"
									placeholder="backend-api"
									value={ form.Get("slug", "") }
									if errMsg != "" && form.Opens("new-project") {
										aria-invalid="true"
										aria-describedby="new-project-error"
									}
								/>
							</label>
							<span class="hint">{ i18n.T(ctx, "project.create.slug_hint") }</span>
						</div>
						<div class="field">
							<label>
								{ i18n.T(ctx, "project.create.name") }
								<input type="text" name="name" required class="input" value={ form.Get("name", "") }/>
							</label>
						</div>
						<div class="field">
							<label>
								{ i18n.T(ctx, "project.create.platform") }
								<select name="platform" required class="select">
									for _, pl := range org.Platforms {
										@platformOption(pl, i18n.T(ctx, "platform."+pl), form.Get("platform", "go"))
									}
								</select>
							</label>
						</div>
						<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "project.create.submit") }</button>
					</form>
				}
			}
		</div>
	}
}
