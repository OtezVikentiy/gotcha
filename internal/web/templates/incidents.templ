package templates

import (
	"strconv"
	"strings"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/uptime"
)

func incidentsPath(projectID int64) string {
	return "/projects/" + strconv.FormatInt(projectID, 10) + "/incidents"
}

// Дублирует несэкспортированный incidentsPerPage из web/incidents.go — числа обязаны совпадать.
const incidentsPerPage = 50

func incidentsTotalPages(total int64) int64 {
	if total <= 0 {
		return 1
	}
	return (total + incidentsPerPage - 1) / incidentsPerPage
}

// Не путать с лентой инцидентов (incidentfeed.templ) — та сводит 6 источников, путь /incident-feed.
func incidentsPageURL(projectID int64, page int) string {
	if page > 1 {
		return incidentsPath(projectID) + "?page=" + strconv.Itoa(page)
	}
	return incidentsPath(projectID)
}

type IncidentRow struct {
	Incident    uptime.Incident
	MonitorName string
}

templ incidentListRow(row IncidentRow, projectID int64, canOperate bool, ackedBy map[int64]string) {
	<tr>
		<td>
			<span class={ incidentStatusBadgeClass(row.Incident) }>{ i18n.T(ctx, incidentStatusTextKey(row.Incident)) }</span>
			if row.Incident.SuppressedByDep {
				<span class="badge">{ i18n.T(ctx, "incident.badge.suppressed_by_dep") }</span>
			}
			if row.Incident.DeliveryExhausted() {
				<span class="badge badge-danger" title={ i18n.T(ctx, "incident.badge.delivery_failed.hint") }>{ i18n.T(ctx, "incident.badge.delivery_failed") }</span>
			}
		</td>
		<td><a href={ templ.URL(monitorDetailPath(row.Incident.MonitorID)) }>{ row.MonitorName }</a></td>
		<td>@incidentSeverityBadge(row.Incident.Severity)</td>
		<td>@relativeTime(row.Incident.StartedAt)</td>
		<td>{ incidentDurationText(ctx, row.Incident) }</td>
		<td>{ row.Incident.Cause }</td>
		<td>{ strings.Join(row.Incident.Regions, ", ") }</td>
		<td>{ yesNo(ctx, row.Incident.InMaintenance) }</td>
		<td>
			if row.Incident.ResolvedAt == nil {
				@ackControl(projectID, "uptime", row.Incident.ID, canOperate, row.Incident.AcknowledgedAt, ackedByEmailOf(row.Incident.AcknowledgedBy, ackedBy))
			}
		</td>
	</tr>
}

// Вариадик, не параметр: тесты пакета зовут IncidentsList напрямую, менять сигнатуру нельзя.
type IncidentsListOpts struct {
	CanOperate bool
	AckedBy    map[int64]string
}

func firstIncidentsListOpts(opts []IncidentsListOpts) IncidentsListOpts {
	if len(opts) > 0 {
		return opts[0]
	}
	return IncidentsListOpts{}
}

templ IncidentsList(projectID int64, rows []IncidentRow, page int, total int64, userEmail string, incOpts ...IncidentsListOpts) {
	{{ opts := firstIncidentsListOpts(incOpts) }}
	@layout(i18n.T(ctx, "nav.incidents"), userEmail) {
		<div class="incidents">
			@breadcrumbBackTo(templ.URL(monitorsPath(projectID)), i18n.T(ctx, "nav.monitors"))
			<h1>{ i18n.T(ctx, "nav.incidents") }</h1>
			<p class="hint">{ i18n.T(ctx, "uptime.incidents.see_feed_hint") }<a href={ templ.URL(overviewPath(projectID)) }>{ i18n.T(ctx, "nav.overview") }</a>{ i18n.T(ctx, "uptime.incidents.see_feed_hint_suffix") }</p>
			@helpPanel("incidents", "uptime")
			if len(rows) == 0 {
				@emptyState("activity", "uptime.incidents.empty.title", "uptime.incidents.empty.body", "", "", 2)
			} else {
				<div class="card">
				@scrollRegion("table-scroll", "nav.incidents") {
						<table class="data-table">
							<thead>
								<tr>
									<th scope="col">{ i18n.T(ctx, "uptime.incidents.table.status") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.incidents.table.monitor") }</th>
									<th scope="col">{ i18n.T(ctx, "incidents.table.severity") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.incidents.table.started") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.incidents.table.duration") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.incidents.table.cause") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.incidents.table.regions") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.incidents.table.maintenance") }</th>
									<th scope="col">{ i18n.T(ctx, "incidents.ack.button") }</th>
								</tr>
							</thead>
							<tbody>
								for _, row := range rows {
									@incidentListRow(row, projectID, opts.CanOperate, opts.AckedBy)
								}
							</tbody>
						</table>
				}
				</div>
			}
			// Пагинатор — вне ветки len(rows)==0: пустая таблица не должна прятать пейджер.
			if incidentsTotalPages(total) > 1 || page > 1 {
				<nav class="pagination" aria-label={ i18n.T(ctx, "pagination.label") }>
					if page > 1 {
						<a href={ templ.URL(incidentsPageURL(projectID, pagerPrev(page, total))) }><span aria-hidden="true">« </span>{ i18n.T(ctx, "pagination.prev") }</a>
					}
					if total > 0 {
						<span>{ strconv.Itoa(page) } / { strconv.FormatInt(incidentsTotalPages(total), 10) }</span>
					}
					if int64(page) < incidentsTotalPages(total) {
						<a href={ templ.URL(incidentsPageURL(projectID, page+1)) }>{ i18n.T(ctx, "pagination.next") }<span aria-hidden="true"> »</span></a>
					}
				</nav>
			}
		</div>
	}
}
