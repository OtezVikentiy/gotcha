package templates

import (
	"strconv"
	"strings"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/trace"
)

// PerfEvidence — распарсенный evidence проблемы для отображения (парсится в
// web/perfissues.go, ключи — из trace/detect.go). Флаги Has* отделяют
// «значение 0» от «поля нет»: total_us/max_us есть не у всех видов.
type PerfEvidence struct {
	Count          int64
	TotalUS        int64
	MaxUS          int64
	ParentOp       string
	SequentialPct  int
	MaxConcurrency int
	URLs           []string
	HasTotal       bool
	HasMax         bool
	HasSequential  bool
}

// PerfCodeLoc — привязка проблемы к месту в коде из data показательного спана
// (code.filepath/lineno/function). Заполняется, только если её прислал SDK.
type PerfCodeLoc struct {
	File     string
	Line     string
	Function string
}

// PerfIssueDetailData — всё для страницы проблемы: сама строка, распарсенный
// evidence, и обогащение из показательного спана примера-трейса: полный текст
// запроса и привязка к коду. Кнопки смены статуса рендерятся безусловно —
// видит их любой смотрящий, не только owner/admin (спека 2026-08-08); поле
// видимости здесь раньше было (CanOperate), но всегда приходило true, так что
// удалено вместе с мёртвой веткой в шаблоне (D2, полировка).
type PerfIssueDetailData struct {
	Issue    trace.PerfIssue
	Evidence PerfEvidence
	// Query — ПОЛНЫЙ текст показательного запроса (сырой description спана, в
	// отличие от нормализованного и обрезанного Title). Пусто для http-флуда
	// и когда пример-трейс истёк по TTL.
	Query          string
	QueryOp        string
	SpanDurationUS int64
	DBSystem       string
	Code           *PerfCodeLoc
}

func perfIssueStatusPath(id int64) string {
	return perfIssueDetailPath(id) + "/status"
}

// perfMS форматирует микросекунды в миллисекунды с одним знаком после запятой:
// evidence хранит время в µs (Redis-спаны субмиллисекундны), человек читает мс.
func perfMS(us int64) string {
	return strconv.FormatFloat(float64(us)/1000, 'f', 1, 64) + "ms"
}

// perfKindExplainKey/perfKindFixKey — i18n-ключи разбора «что происходит» и
// «как чинить» по виду проблемы. Ключ строится из известного вида (иначе
// общий), чтобы в T() не попадала произвольная строка.
func perfKindExplainKey(kind string) string {
	switch kind {
	case trace.KindNPlusOne, trace.KindSlowDBQuery, trace.KindHTTPFlood:
		return "perf.kind.explain." + kind
	}
	return "perf.kind.explain.default"
}

func perfKindFixKey(kind string) string {
	switch kind {
	case trace.KindNPlusOne, trace.KindSlowDBQuery, trace.KindHTTPFlood:
		return "perf.kind.fix." + kind
	}
	return "perf.kind.fix.default"
}

// perfQueryMeta — строка мета над запросом: операция · СУБД · длительность
// показательного спана (что из этого есть).
func perfQueryMeta(d PerfIssueDetailData) string {
	var parts []string
	if d.QueryOp != "" {
		parts = append(parts, d.QueryOp)
	}
	if d.DBSystem != "" {
		parts = append(parts, d.DBSystem)
	}
	if d.SpanDurationUS > 0 {
		parts = append(parts, perfMS(d.SpanDurationUS))
	}
	return strings.Join(parts, " · ")
}

// perfCodeLine — «файл:строка» (или просто файл, если строки нет).
func perfCodeLine(c *PerfCodeLoc) string {
	if c == nil {
		return ""
	}
	if c.Line != "" {
		return c.File + ":" + c.Line
	}
	return c.File
}

// PerfIssueDetail — GET /perf-issues/{id}: шапка проблемы, метаданные,
// человекочитаемый evidence по виду, ссылка на пример трейса и (для owner/admin)
// кнопки смены статуса. Визуально повторяет страницу issue этапа 1.
templ PerfIssueDetail(d PerfIssueDetailData, userEmail string) {
	@layout(perfIssueTitle(ctx, d.Issue), userEmail) {
		<div class="perf-issue-detail issue-detail">
			@breadcrumbBackTo(templ.URL(perfIssuesPath(d.Issue.ProjectID)), i18n.T(ctx, "nav.perf_issues"))
			<h1>{ perfIssueTitle(ctx, d.Issue) }</h1>
			if d.Issue.Culprit != "" {
				<div class="culprit">{ d.Issue.Culprit }</div>
			}
			<span class={ perfKindBadgeClass(d.Issue.Kind) }>{ perfKindLabel(ctx, d.Issue.Kind) }</span>
			<span class={ perfStatusBadgeClass(d.Issue.Status) }>{ issueStatusLabel(ctx, d.Issue.Status) }</span>
			<div class="issue-meta">
				<span>{ i18n.T(ctx, "issues.detail.times_seen") }: { strconv.FormatInt(d.Issue.Count, 10) }</span>
				// @relativeTime — отдельным узлом: после текста в той же строке
				// templ не разбирает @-вызов и печатает его буквально.
				<span>
					{ i18n.T(ctx, "issues.detail.first_seen") + ": " }
					@relativeTime(d.Issue.FirstSeen)
				</span>
				<span>
					{ i18n.T(ctx, "issues.detail.last_seen") + ": " }
					@relativeTime(d.Issue.LastSeen)
				</span>
			</div>

			<div class="issue-actions">
				<form method="post" action={ templ.URL(perfIssueStatusPath(d.Issue.ID)) }>
					if d.Issue.Status == "unresolved" {
						<button type="submit" name="status" value="resolved" class="btn btn-primary">{ i18n.T(ctx, "issues.action.resolve") }</button>
						<button type="submit" name="status" value="ignored" class="btn btn-ghost">{ i18n.T(ctx, "issues.action.ignore") }</button>
					} else {
						<button type="submit" name="status" value="unresolved" class="btn btn-ghost">{ i18n.T(ctx, "issues.action.unresolve") }</button>
					}
				</form>
			</div>

			// Что происходит: разбор проблемы простым языком + как чинить —
			// главное, чего не хватало (сами числа evidence ниже).
			<section class="perf-explain">
				<h2>{ i18n.T(ctx, "perf.issues.detail.whats_wrong") }</h2>
				<div class="card">
					<p>{ i18n.T(ctx, perfKindExplainKey(d.Issue.Kind)) }</p>
					<p class="perf-fix"><strong>{ i18n.T(ctx, "perf.issues.detail.fix") }:</strong> { i18n.T(ctx, perfKindFixKey(d.Issue.Kind)) }</p>
				</div>
			</section>

			// Полный текст запроса из показательного спана (не обрезанный).
			if d.Query != "" {
				<section class="perf-query-sec">
					<h2>
						{ i18n.T(ctx, "perf.issues.detail.query") }
						<span class="perf-query-meta">{ perfQueryMeta(d) }</span>
					</h2>
					<pre class="perf-query">{ d.Query }</pre>
				</section>
			}

			// Привязка к коду — если SDK её прислал (оппортунистично).
			if d.Code != nil {
				<section class="perf-code-sec">
					<h2>{ i18n.T(ctx, "perf.issues.detail.code") }</h2>
					<div class="card perf-code">
						<span class="perf-code-loc">{ perfCodeLine(d.Code) }</span>
						if d.Code.Function != "" {
							<span class="perf-code-fn">{ i18n.T(ctx, "perf.issues.detail.code_in") } { d.Code.Function }</span>
						}
					</div>
				</section>
			}

			<section class="perf-evidence">
				<h2>{ i18n.T(ctx, "perf.issues.detail.evidence") }</h2>
				<div class="card">
					@perfEvidenceView(d.Issue.Kind, d.Evidence)
				</div>
			</section>

			if d.Issue.SampleTraceID != "" {
				<p class="perf-sample-trace"><a class="btn btn-ghost" href={ templ.URL(tracePathFrom(d.Issue.SampleTraceID, "perf-issue", strconv.FormatInt(d.Issue.ID, 10))) }>{ i18n.T(ctx, "perf.issues.detail.sample_trace") }</a></p>
			}
		</div>
	}
}

// perfEvidenceView рендерит evidence человекочитаемо в зависимости от вида
// проблемы. Нормализованный запрос уже в заголовке (Title), здесь — числа.
templ perfEvidenceView(kind string, ev PerfEvidence) {
	<dl class="perf-evidence-list">
		switch kind {
			case trace.KindNPlusOne:
				<dt>{ i18n.T(ctx, "perf.issues.evidence.repeat_count") }</dt>
				<dd>{ strconv.FormatInt(ev.Count, 10) }</dd>
				if ev.HasTotal {
					<dt>{ i18n.T(ctx, "perf.issues.evidence.total_time") }</dt>
					<dd>{ perfMS(ev.TotalUS) }</dd>
				}
				if ev.ParentOp != "" {
					<dt>{ i18n.T(ctx, "perf.issues.evidence.parent_op") }</dt>
					<dd>{ ev.ParentOp }</dd>
				}
			case trace.KindSlowDBQuery:
				<dt>{ i18n.T(ctx, "perf.issues.evidence.count") }</dt>
				<dd>{ strconv.FormatInt(ev.Count, 10) }</dd>
				if ev.HasMax {
					<dt>{ i18n.T(ctx, "perf.issues.evidence.max_time") }</dt>
					<dd>{ perfMS(ev.MaxUS) }</dd>
				}
			case trace.KindHTTPFlood:
				<dt>{ i18n.T(ctx, "perf.issues.evidence.count") }</dt>
				<dd>{ strconv.FormatInt(ev.Count, 10) }</dd>
				if ev.HasSequential {
					<dt>{ i18n.T(ctx, "perf.issues.evidence.sequential") }</dt>
					<dd>{ strconv.Itoa(ev.SequentialPct) }%</dd>
				}
				if ev.MaxConcurrency > 0 {
					<dt>{ i18n.T(ctx, "perf.issues.evidence.max_concurrency") }</dt>
					<dd>{ strconv.Itoa(ev.MaxConcurrency) }</dd>
				}
				if len(ev.URLs) > 0 {
					<dt>{ i18n.T(ctx, "perf.issues.evidence.sample_urls") }</dt>
					<dd>
						<ul class="perf-urls">
							for _, u := range ev.URLs {
								<li>{ u }</li>
							}
						</ul>
					</dd>
				}
			default:
				<dt>{ i18n.T(ctx, "perf.issues.evidence.count") }</dt>
				<dd>{ strconv.FormatInt(ev.Count, 10) }</dd>
		}
	</dl>
}
