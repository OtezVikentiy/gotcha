package templates

import (
	"context"
	"net/url"
	"strconv"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/issue"
)


// Sparkline строится в web/issues.go и передаётся готовым — иначе цикл импорта web->templates->web.
type IssueRow struct {
	Issue     issue.Issue
	Sparkline templ.Component
}

type IssuesFilter struct {
	Status      string
	Level       string
	Query       string
	Sort        string
	Environment string
	Range TimeRangeVM
	// Active: пустой список отфильтрованных issues значит «ничего не подошло», не «событий не было».
	Active bool
}

func issuesPath(projectID int64) string {
	return "/projects/" + strconv.FormatInt(projectID, 10) + "/issues"
}

func issuesBulkPath(projectID int64) string {
	return "/projects/" + strconv.FormatInt(projectID, 10) + "/issues/bulk"
}

func issueDetailPath(issueID int64) string {
	return "/issues/" + strconv.FormatInt(issueID, 10)
}

func levelBadgeClass(level string) string {
	switch level {
	case issue.LevelError, issue.LevelFatal:
		return "badge badge-danger"
	case issue.LevelWarning:
		return "badge badge-warn"
	case issue.LevelInfo:
		return "badge badge-info"
	default:
		return "badge badge-neutral"
	}
}

// default (в т.ч. неизвестный статус) деградирует в warn: "требует внимания" безопаснее тихого
// "всё хорошо" для статуса, которого шаблон не узнал.
func statusBadgeClass(status string) string {
	switch status {
	case issue.StatusResolved:
		return "badge badge-good"
	case issue.StatusIgnored:
		return "badge badge-neutral"
	default:
		return "badge badge-warn"
	}
}

// Тот же набор ключей, что и в дропдауне фильтра — иначе подписи в таблице и фильтре разъедутся.
func issueLevelLabel(ctx context.Context, level string) string {
	switch level {
	case issue.LevelDebug, issue.LevelInfo, issue.LevelWarning, issue.LevelError, issue.LevelFatal:
		return i18n.T(ctx, "issues.level."+level)
	}
	return level
}

// Пустой title — у события нет ни exception, ни message, ни transaction, ни logger.
func issueTitle(ctx context.Context, title string) string {
	if title == "" {
		return i18n.T(ctx, "issues.untitled")
	}
	return title
}

func issueStatusLabel(ctx context.Context, status string) string {
	switch status {
	case issue.StatusUnresolved, issue.StatusResolved, issue.StatusIgnored:
		return i18n.T(ctx, "issues.status."+status)
	}
	return status
}

func assigneeDisplay(email string) string {
	if email == "" {
		return "—"
	}
	return email
}

func totalPages(total int64) int64 {
	if total <= 0 {
		return 1
	}
	return (total + issue.DefaultPerPage - 1) / issue.DefaultPerPage
}

// total=0 на out-of-range странице: считать «назад» не от чего, ведём сразу на первую страницу.
func pagerPrev(page int, total int64) int {
	if total <= 0 {
		return 1
	}
	return page - 1
}

func issuesPageURL(projectID int64, f IssuesFilter, page int) string {
	q := url.Values{}
	if f.Status != "" {
		q.Set("status", f.Status)
	}
	if f.Level != "" {
		q.Set("level", f.Level)
	}
	if f.Query != "" {
		q.Set("q", f.Query)
	}
	if f.Sort != "" {
		q.Set("sort", f.Sort)
	}
	if f.Environment != "" {
		q.Set("environment", f.Environment)
	}
	f.Range.apply(q)
	if page > 1 {
		q.Set("page", strconv.Itoa(page))
	}
	qs := q.Encode()
	if qs == "" {
		return issuesPath(projectID)
	}
	return issuesPath(projectID) + "?" + qs
}

templ statusOption(value, label string, selected string) {
	if value == selected {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

templ levelOption(value, label string, selected string) {
	if value == selected {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

templ sortOption(value, label string, selected string) {
	if value == selected {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

templ environmentOption(value, label string, selected string) {
	if value == selected {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

// canOperate/canManagePII гейтят кнопки и галку PII экспорта — рисовать форму, ведущую на 404,
// хуже, чем скрыть; sparklinesFailed — ClickHouse недоступен, колонка спарклайнов пустая.
templ IssuesList(projectID int64, rows []IssueRow, filter IssuesFilter, page int, total int64, userEmail string, environments []string, banner *QuotaBanner, gs GettingStartedVM, canOperate bool, canManagePII bool, sparklinesFailed bool) {
	@layout(i18n.T(ctx, "nav.issues"), userEmail) {
		<div class="issues">
			@quotaBannerView(banner)
			@gettingStartedChecklist(gs)
			<h1>{ i18n.T(ctx, "nav.issues") }</h1>
			@helpPanel("issues", "issues")
			if sparklinesFailed && len(rows) > 0 {
				<p class="hint">{ i18n.T(ctx, "issues.sparklines.error") }</p>
			}
			<form method="get" action={ templ.URL(issuesPath(projectID)) } class="issues-filters">
				<input type="text" name="q" class="input" placeholder={ i18n.T(ctx, "issues.filter.query_placeholder") } value={ filter.Query } aria-label={ i18n.T(ctx, "filter.search") }/>
				<select name="status" class="select" aria-label={ i18n.T(ctx, "filter.status") }>
					@statusOption("", i18n.T(ctx, "issues.filter.status_all"), filter.Status)
					@statusOption("unresolved", i18n.T(ctx, "issues.status.unresolved"), filter.Status)
					@statusOption("resolved", i18n.T(ctx, "issues.status.resolved"), filter.Status)
					@statusOption("ignored", i18n.T(ctx, "issues.status.ignored"), filter.Status)
				</select>
				<select name="level" class="select" aria-label={ i18n.T(ctx, "filter.level") }>
					@levelOption("", i18n.T(ctx, "issues.filter.level_all"), filter.Level)
					@levelOption(issue.LevelDebug, i18n.T(ctx, "issues.level.debug"), filter.Level)
					@levelOption(issue.LevelInfo, i18n.T(ctx, "issues.level.info"), filter.Level)
					@levelOption(issue.LevelWarning, i18n.T(ctx, "issues.level.warning"), filter.Level)
					@levelOption(issue.LevelError, i18n.T(ctx, "issues.level.error"), filter.Level)
					@levelOption(issue.LevelFatal, i18n.T(ctx, "issues.level.fatal"), filter.Level)
				</select>
				<select name="environment" class="select" aria-label={ i18n.T(ctx, "filter.environment") }>
					@environmentOption("", i18n.T(ctx, "issues.filter.env_all"), filter.Environment)
					for _, env := range environments {
						@environmentOption(env, env, filter.Environment)
					}
				</select>
				@timeRangeFields(filter.Range)
				<select name="sort" class="select" aria-label={ i18n.T(ctx, "filter.sort") }>
					@sortOption("last_seen", i18n.T(ctx, "issues.sort.last_seen"), filter.Sort)
					@sortOption("first_seen", i18n.T(ctx, "issues.sort.first_seen"), filter.Sort)
					@sortOption("times_seen", i18n.T(ctx, "issues.sort.times_seen"), filter.Sort)
				</select>
				<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "issues.filter.apply") }</button>
			</form>
			<div id="issues-table">
				if len(rows) == 0 && page > 1 {
					// total=0 на странице вне диапазона (issue.Service.List) не отличить от «проект
					// пуст» — решает номер страницы, а не total.
					@emptyState("arrow-left", "issues.empty.pageOverrun.title", "issues.empty.pageOverrun.body", "issues.empty.pageOverrun.cta", issuesPageURL(projectID, filter, 1), 2)
				} else if len(rows) == 0 && filter.Active {
					@emptyState("filter", "issues.empty.filtered.title", "issues.empty.filtered.body", "issues.empty.filtered.cta", issuesPath(projectID), 2)
				} else if len(rows) == 0 {
					@emptyState("bug", "issues.empty.title", "issues.empty.body", "issues.empty.cta", projectSetupPath(projectID), 2)
					// Чек-лист «Первые шаги» уже несёт эту врезку под шагом 2 — не повторяем на пустом проекте.
					// Рисуем только если чек-лист не виден (скрыт пользователем или все шаги закрыты).
					if len(gs.KeyRejects) > 0 && !gs.checklistVisible() {
						<div class="notice notice--warn">
							@keyRejectsBody(gs.KeyRejects, projectSettingsPath(projectID))
						</div>
					}
				} else {
					<div class="card">
						// Кнопки массовых действий — вне #issues-bulk, привязаны атрибутом form=: вложенный <form>
						// (формы экспорта) HTML не допускает, парсер закрыл бы внешнюю форму молча.
						<div class="card-toolbar">
							<div class="card-toolbar-group">
								<button type="submit" form="issues-bulk" name="action" value="resolve" class="btn btn-primary">{ i18n.T(ctx, "issues.action.resolve_bulk") }</button>
								<button type="submit" form="issues-bulk" name="action" value="ignore" class="btn btn-ghost">{ i18n.T(ctx, "issues.action.ignore") }</button>
								<button type="submit" form="issues-bulk" name="action" value="unresolve" class="btn btn-ghost">{ i18n.T(ctx, "issues.action.unresolve") }</button>
							</div>
							if canOperate {
								// Раскрывает <details> с форматом и (для CanManage) галкой PII, как у issuedetail.templ.
								// Период — query-параметром action: resolveTimeRange POST-тело не читает.
								<div class="card-toolbar-group">
									<details class="dropdown-control">
										<summary>{ i18n.T(ctx, "issues.export.groups") }</summary>
										<form method="post" action={ templ.URL(exportsPathWithRange(projectID, filter.Range)) } class="export-control-form">
											<input type="hidden" name="kind" value="issues"/>
											<input type="hidden" name="status" value={ filter.Status }/>
											<input type="hidden" name="level" value={ filter.Level }/>
											<input type="hidden" name="query" value={ filter.Query }/>
											<input type="hidden" name="environment" value={ filter.Environment }/>
											<input type="hidden" name="sort" value={ filter.Sort }/>
											@exportFormatField(nil)
											@exportPIIField(canManagePII, nil)
											<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "exports.create") }</button>
										</form>
									</details>
									<details class="dropdown-control">
										<summary>{ i18n.T(ctx, "issues.export.events") }</summary>
										<form method="post" action={ templ.URL(exportsPathWithRange(projectID, filter.Range)) } class="export-control-form">
											<input type="hidden" name="kind" value="events"/>
											<input type="hidden" name="status" value={ filter.Status }/>
											<input type="hidden" name="level" value={ filter.Level }/>
											<input type="hidden" name="query" value={ filter.Query }/>
											<input type="hidden" name="environment" value={ filter.Environment }/>
											<input type="hidden" name="sort" value={ filter.Sort }/>
											@exportFormatField(nil)
											@exportPIIField(canManagePII, nil)
											<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "exports.create") }</button>
										</form>
									</details>
								</div>
							}
						</div>
						<form method="post" action={ templ.URL(issuesBulkPath(projectID)) } id="issues-bulk">
							@scrollRegion("table-scroll", "nav.issues") {
									<table class="data-table">
										<thead>
											<tr>
												<th scope="col"><span class="visually-hidden">{ i18n.T(ctx, "issues.table.select") }</span></th>
												<th scope="col">{ i18n.T(ctx, "issues.table.level") }</th>
												<th scope="col">{ i18n.T(ctx, "issues.table.issue") }</th>
												<th scope="col">{ i18n.T(ctx, "issues.table.trend") }</th>
												<th scope="col" class="num">{ i18n.T(ctx, "issues.table.events") }</th>
												<th scope="col">{ i18n.T(ctx, "issues.table.last_seen") }</th>
												<th scope="col">{ i18n.T(ctx, "issues.table.status") }</th>
												<th scope="col">{ i18n.T(ctx, "issues.table.assignee") }</th>
											</tr>
										</thead>
										<tbody>
											for _, row := range rows {
												<tr>
													<td>
											// aria-label обязателен: без него скринридер скажет только «флажок, не отмечен».
														<input type="checkbox" name="ids" value={ strconv.FormatInt(row.Issue.ID, 10) } aria-label={ issueTitle(ctx, row.Issue.Title) }/>
													</td>
													<td><span class={ levelBadgeClass(row.Issue.Level) }>{ issueLevelLabel(ctx, row.Issue.Level) }</span></td>
													<td>
														<a href={ templ.URL(issueDetailPath(row.Issue.ID)) }>{ issueTitle(ctx, row.Issue.Title) }</a>
														if row.Issue.Culprit != "" {
															<div class="culprit">{ row.Issue.Culprit }</div>
														}
													</td>
													<td>@row.Sparkline</td>
													<td class="num">{ strconv.FormatInt(row.Issue.TimesSeen, 10) }</td>
													<td>@relativeTime(row.Issue.LastSeen)</td>
													<td><span class={ statusBadgeClass(row.Issue.Status) }>{ issueStatusLabel(ctx, row.Issue.Status) }</span></td>
													<td>
													if row.Issue.AssigneeEmail == "" {
														{ assigneeDisplay(row.Issue.AssigneeEmail) }
													} else {
														@userChip(row.Issue.AssigneeEmail)
													}
												</td>
												</tr>
											}
										</tbody>
									</table>
							}
						</form>
					</div>
				}
				if totalPages(total) > 1 || page > 1 {
					<nav class="pagination" aria-label={ i18n.T(ctx, "pagination.label") }>
						if page > 1 {
							<a href={ templ.URL(issuesPageURL(projectID, filter, pagerPrev(page, total))) }><span aria-hidden="true">« </span>{ i18n.T(ctx, "issues.pagination.prev") }</a>
						}
						if total > 0 {
							<span>{ strconv.Itoa(page) } / { strconv.FormatInt(totalPages(total), 10) }</span>
						}
						if int64(page) < totalPages(total) {
							<a href={ templ.URL(issuesPageURL(projectID, filter, page+1)) }>{ i18n.T(ctx, "issues.pagination.next") }<span aria-hidden="true"> »</span></a>
						}
					</nav>
				}
			</div>
		</div>
	}
}
