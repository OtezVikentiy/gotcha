package templates

import (
	"context"
	"net/url"
	"time"

	"gitflic.ru/otezvikentiy/gotcha/internal/humanize"
	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
)

// на пресетах Start/End пустые — иначе форма переключения пресета вела бы в произвольный диапазон.
type TimeRangeVM struct {
	Key    string
	Custom bool
	Start  string
	End    string
	// не для всех страниц осмыслен: у графика без границ нет оси.
	// для списка проблем нужен — без него старые группы (>суток) прятались бы за окно по умолчанию.
	AllowAll bool
}

func (r TimeRangeVM) apply(q url.Values) {
	if r.Key == "all" {
		q.Set("period", "all")
		return
	}
	if r.Custom {
		q.Set("period", "custom")
		q.Set("start", r.Start)
		q.Set("end", r.End)
		return
	}
	if r.Key == "" {
		// пустой Key — «состояние не задано», не окно: писать period= значит мусорить чистый адрес.
		return
	}
	q.Set("period", r.Key)
}

// пресет — короткая локализованная подпись; произвольный диапазон — «с – по» в ГГГГ-ММ-ДД ЧЧ:ММ.
// формат числовой: «02.01.2026» в английском можно прочесть и как 2 января, и как 1 февраля.
templ timeRangeLabel(r TimeRangeVM) {
	{ timeRangeLabelText(ctx, r) }
}

// UTC на каждой границе пишет humanize.Time — не добавлять свой суффикс: будет «UTC UTC».
func timeRangeLabelText(ctx context.Context, r TimeRangeVM) string {
	if r.Custom {
		return prettyBound(ctx, r.Start) + " – " + prettyBound(ctx, r.End)
	}
	return i18n.T(ctx, "range."+r.Key)
}

// значение с пикера трактуется как UTC — зона передаётся явно (time.UTC).
// нераспарсенная строка возвращается как есть — фолбэк для не-datetime-local значений.
func prettyBound(ctx context.Context, s string) string {
	if t, err := time.Parse("2006-01-02T15:04", s); err == nil {
		return humanize.Time(ctx, t, time.UTC)
	}
	return s
}

// произвольный диапазон включается вводом дат, не пунктом списка — видимые поля всегда пусты.
// активный диапазон переносится скрытыми cstart/cend, иначе смена сортировки/окружения его сбросит.
templ timeRangeFields(r TimeRangeVM) {
	// data-l-* — подписи для JS-пикера; без JS не читаются, фолбэк локализован через i18n.T выше.
	<span
		class="time-range"
		data-l-apply={ i18n.T(ctx, "range.picker.apply") }
		data-l-cancel={ i18n.T(ctx, "range.picker.cancel") }
		data-l-hint={ i18n.T(ctx, "range.picker.hint") }
		data-l-trigger={ i18n.T(ctx, "range.picker.trigger") }
		data-l-dialog={ i18n.T(ctx, "range.picker.dialog") }
		data-l-prev={ i18n.T(ctx, "range.picker.prev_month") }
		data-l-next={ i18n.T(ctx, "range.picker.next_month") }
		data-l-utc-hint={ i18n.T(ctx, "range.utc_hint") }
	>
		<select name="period" class="select" aria-label={ i18n.T(ctx, "filter.period") }>
			if r.AllowAll {
				@timeRangePresetOpt("all", r)
			}
			for _, p := range []string{"1h", "24h", "7d", "30d"} {
				@timeRangePresetOpt(p, r)
			}
			if r.Custom {
				<option value="custom" selected>{ i18n.T(ctx, "range.custom") }</option>
			}
		</select>
		// <details> прячет поля диапазона на пресетах (частый случай); раскрывается без JS.
		// с JS весь control заменяется попап-пикером.
		<details class="time-range-custom" open?={ r.Custom }>
			<summary class="time-range-summary">{ i18n.T(ctx, "range.set_dates") }</summary>
			<span class="time-range-fields">
				<input
					type="datetime-local"
					name="start"
					class="input time-range-input"
					aria-label={ i18n.T(ctx, "range.start") }
				/>
				<span class="time-range-sep" aria-hidden="true">–</span>
				<input
					type="datetime-local"
					name="end"
					class="input time-range-input"
					aria-label={ i18n.T(ctx, "range.end") }
				/>
				if r.Custom {
					<span class="time-range-active">@timeRangeLabel(r)</span>
					<input type="hidden" name="cstart" value={ r.Start }/>
					<input type="hidden" name="cend" value={ r.End }/>
				}
			</span>
			// "(UTC)" в aria-label полей (range.start/range.end) не видно на экране —
			// пикер иначе принимают за локальное время браузера.
			<p class="hint">{ i18n.T(ctx, "range.utc_hint") }</p>
		</details>
	</span>
}

templ timeRangePresetOpt(value string, r TimeRangeVM) {
	if r.Key == value && !r.Custom {
		<option value={ value } selected>{ i18n.T(ctx, "range."+value) }</option>
	} else {
		<option value={ value }>{ i18n.T(ctx, "range."+value) }</option>
	}
}
