package templates

import (
	"strconv"
	"time"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
)

// нативный <details>/<summary>, не JS: CSP (default-src 'self') не
// допускает инлайновых обработчиков.
templ helpPanel(area, guideSlug string) {
	@helpPanelWith(area, guideSlug) {
		<p>{ i18n.T(ctx, "help."+area+".body") }</p>
	}
}

// TestHelpPanelKeysResolve сканирует исходники на вызовы helpPanel с
// литеральной областью и не матчит helpPanelWith — здесь .body не обязателен.
templ helpPanelWith(area, guideSlug string) {
	<details class="help-panel">
		<summary>
			@icon("chevron-right")
			{ i18n.T(ctx, "help."+area+".title") }
		</summary>
		<div class="help-panel-body">
			{ children... }
			<a href={ templ.SafeURL("/docs/" + guideSlug) }>{ i18n.T(ctx, "help.more_link") }</a>
		</div>
	</details>
}

type GettingStartedVM struct {
	ProjectID, OrgID                                 int64
	Step2Done, Step3Done, Step4aDone, Step4bDone bool
	Done                                             int
	// шаги 2/3/4b доступны любому оператору проекта (CanAccessProject/
	// requireProjectOperator) — CanOperate гейтит весь чек-лист, не CanManage.
	CanOperate bool
	// только шаг 4a требует эту роль (настройки организации, requireOrgRole);
	// без неё шаг рендерится неактивным текстом, а не ссылкой на 403.
	CanManage bool
	// скрыт пользователем; гасит checklistVisible() независимо от Done —
	// карточка не возвращается сама при появлении нового незакрытого шага.
	Hidden bool
	// пусто — либо отказов не было, либо h.Signals не настроен (nil-safe).
	// Рендерится и под шагом 2, и на пустом issues, когда чек-лист не виден.
	KeyRejects []KeyRejectView
}

// Hits — счётчик за всё время наблюдения, не за окно фильтра часа, отобравшее
// строку; Kind — ingestsignal.Kind как строка, чтобы не тянуть зависимость от БД-слоя.
type KeyRejectView struct {
	Kind       string
	Hits       int64
	LastSeenAt time.Time
}

// kind вне закрытого списка (не должен встречаться — VM фильтрует в web-слое)
// не рендерит строку вовсе.
templ keyRejectItem(kr KeyRejectView) {
	switch kr.Kind {
		case "key_invalid":
			<li>
				{ i18n.Tf(ctx, "ingest_signals.rejects.key_invalid", "hits", strconv.FormatInt(kr.Hits, 10)) }
				@relativeTime(kr.LastSeenAt)
			</li>
		case "key_project_mismatch":
			<li>
				{ i18n.Tf(ctx, "ingest_signals.rejects.key_project_mismatch", "hits", strconv.FormatInt(kr.Hits, 10)) }
				@relativeTime(kr.LastSeenAt)
			</li>
		case "key_scope":
			<li>
				{ i18n.Tf(ctx, "ingest_signals.rejects.key_scope", "hits", strconv.FormatInt(kr.Hits, 10)) }
				@relativeTime(kr.LastSeenAt)
			</li>
	}
}

templ keyRejectsBody(rejects []KeyRejectView, settingsHref string) {
	if len(rejects) > 0 {
		<p>{ i18n.T(ctx, "ingest_signals.rejects.title") }</p>
		<ul>
			for _, kr := range rejects {
				@keyRejectItem(kr)
			}
		</ul>
		<a href={ templ.SafeURL(settingsHref) }>{ i18n.T(ctx, "ingest_signals.rejects.link") }</a>
	}
}

// общий метод — чтобы IssuesList (прячет свою врезку об отказах, пока эта
// карточка её уже показывает) не разошёлся условием с самой карточкой.
func (gs GettingStartedVM) checklistVisible() bool {
	return !gs.Hidden && gs.Done < 5 && gs.CanOperate
}

// гейт карточки — CanOperate, не CanManage: все её шаги, кроме 4a,
// доступны любому оператору проекта.
templ gettingStartedChecklist(gs GettingStartedVM) {
	if gs.checklistVisible() {
		<section class="card getting-started">
			<h2 class="card-header">
				{ i18n.T(ctx, "getting_started.title") } · { i18n.Tf(ctx, "getting_started.progress", "done", strconv.Itoa(gs.Done), "total", "5") }
				<form method="post" action="/profile/getting-started/hide" class="gs-hide-form card-header-action">
					<button type="submit" class="btn btn-ghost">{ i18n.T(ctx, "getting_started.hide") }</button>
				</form>
			</h2>
			<ul class="gs-steps">
				@gsStepDone("getting_started.step.1")
				@gsStep(gs.Step2Done, "getting_started.step.2", projectSetupPath(gs.ProjectID), "getting_started.step.2.cta")
				if len(gs.KeyRejects) > 0 {
					<li class="gs-todo">
						@keyRejectsBody(gs.KeyRejects, projectSettingsPath(gs.ProjectID))
					</li>
				}
				@gsStep(gs.Step3Done, "getting_started.step.3", alertsPath(gs.ProjectID), "getting_started.step.3.cta")
				if gs.CanManage {
					@gsStep(gs.Step4aDone, "getting_started.step.4a", orgSettingsPath(gs.OrgID), "getting_started.step.4a.cta")
				} else {
					@gsStepReadOnly(gs.Step4aDone, "getting_started.step.4a")
				}
				@gsStep(gs.Step4bDone, "getting_started.step.4b", monitorsPath(gs.ProjectID), "getting_started.step.4b.cta")
			</ul>
		</section>
	}
}

templ gsStep(done bool, labelKey, href, ctaKey string) {
	if done {
		@gsStepDone(labelKey)
	} else {
		<li class="gs-todo">
			@icon("circle")
			<span class="visually-hidden">{ i18n.T(ctx, "getting_started.state.todo") }</span>
			{ i18n.T(ctx, labelKey) } — <a href={ templ.SafeURL(href) }>{ i18n.T(ctx, ctaKey) }</a>
		</li>
	}
}

// без CTA-ссылки: цель шага 4a требует requireOrgRole, ссылка увела бы
// оператора без CanManage на честный 403.
templ gsStepReadOnly(done bool, labelKey string) {
	if done {
		@gsStepDone(labelKey)
	} else {
		<li class="gs-todo gs-todo-locked">
			@icon("circle")
			<span class="visually-hidden">{ i18n.T(ctx, "getting_started.state.todo") }</span>
			{ i18n.T(ctx, labelKey) }
		</li>
	}
}

// иконка aria-hidden, поэтому состояние дублируется скрытым текстом —
// иначе скринридер читал бы готовый и незакрытый шаг одинаково.
templ gsStepDone(labelKey string) {
	<li class="gs-done">
		@icon("check")
		<span class="visually-hidden">{ i18n.T(ctx, "getting_started.state.done") }</span>
		{ i18n.T(ctx, labelKey) }
	</li>
}
