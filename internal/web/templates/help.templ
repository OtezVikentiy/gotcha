package templates

import (
	"strconv"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
)

// helpPanel — свёрнутая по умолчанию контекстная справка под <h1> страниц-хабов
// (issues/performance/metrics/uptime/alerts). Нативный <details>/<summary> —
// без JS, т.к. CSP (default-src 'self', без unsafe-inline) не допускает
// инлайновых обработчиков. area — i18n-ключ (help.<area>.title/body),
// guideSlug — соответствующая страница документации /docs/{guideSlug}.
templ helpPanel(area, guideSlug string) {
	<details class="help-panel">
		<summary>
			@icon("chevron-right")
			{ i18n.T(ctx, "help."+area+".title") }
		</summary>
		<div class="help-panel-body">
			<p>{ i18n.T(ctx, "help."+area+".body") }</p>
			<a href={ templ.SafeURL("/docs/" + guideSlug) }>{ i18n.T(ctx, "help.more_link") }</a>
		</div>
	</details>
}

// GettingStartedVM — прогресс чек-листа «Первые шаги» на странице Issues
// (задача 5, docs-onboarding). Собирается в web/issues.go по реальным
// данным проекта/организации: Step1 (создать проект) всегда true — раз
// страница открылась, проект уже есть, поэтому отдельного поля под него
// нет. Total шагов всегда 5; Done = 1 (шаг 1) + число закрытых из
// Step2/3/4a/4bDone. Шаги 4a (позвать команду) и 4b (добавить монитор) —
// две отдельные строки с раздельными ссылками (№71): раньше они были
// склеены в один шаг с одной ссылкой на настройки организации, и путь к
// мониторам приходилось угадывать.
type GettingStartedVM struct {
	ProjectID, OrgID                                 int64
	Step2Done, Step3Done, Step4aDone, Step4bDone bool
	Done                                             int
	// CanManage — owner/admin ли смотрящий. Все шаги с действиями ведут на
	// страницы, которые требуют этой роли (подключение SDK, оповещения,
	// настройки организации): участнику чек-лист предлагал бы пойти туда, где
	// его встретит 404.
	CanManage bool
}

// gettingStartedChecklist — карточка над списком issues, пока не закрыты
// все 5 шагов онбординга (Done < 5). Пропадает сама, когда пользователь
// подключил SDK, настроил оповещение, позвал команду и добавил монитор —
// либо по кнопке «Скрыть» (№71): у действующей команды чек-лист может жить
// месяцами только из-за незакрытого шага, и это его законный конец.
templ gettingStartedChecklist(gs GettingStartedVM) {
	if gs.Done < 5 && gs.CanManage {
		<section class="card getting-started">
			<h2 class="card-header">
				{ i18n.T(ctx, "getting_started.title") } · { i18n.Tf(ctx, "getting_started.progress", "done", strconv.Itoa(gs.Done), "total", "5") }
				<form method="post" action="/profile/getting-started/hide" class="gs-hide-form card-header-action">
					<button type="submit" class="btn btn-ghost">{ i18n.T(ctx, "getting_started.hide") }</button>
				</form>
			</h2>
			<ul class="gs-steps">
				@gsStepDone("getting_started.step.1")
				@gsStep(gs.Step2Done, "getting_started.step.2", projectSetupPath(gs.ProjectID), "getting_started.step.2.cta")
				@gsStep(gs.Step3Done, "getting_started.step.3", alertsPath(gs.ProjectID), "getting_started.step.3.cta")
				@gsStep(gs.Step4aDone, "getting_started.step.4a", orgSettingsPath(gs.OrgID), "getting_started.step.4a.cta")
				@gsStep(gs.Step4bDone, "getting_started.step.4b", monitorsPath(gs.ProjectID), "getting_started.step.4b.cta")
			</ul>
		</section>
	}
}

templ gsStep(done bool, labelKey, href, ctaKey string) {
	if done {
		@gsStepDone(labelKey)
	} else {
		<li class="gs-todo">
			@icon("circle")
			<span class="visually-hidden">{ i18n.T(ctx, "getting_started.state.todo") }</span>
			{ i18n.T(ctx, labelKey) } — <a href={ templ.SafeURL(href) }>{ i18n.T(ctx, ctaKey) }</a>
		</li>
	}
}

// gsStepDone — выполненный шаг. Иконка помечена aria-hidden (см. @icon),
// поэтому состояние дублируется скрытым текстом: галочка — единственный
// сигнал «сделано», и без него скринридер прочитал бы обе строки одинаково.
templ gsStepDone(labelKey string) {
	<li class="gs-done">
		@icon("check")
		<span class="visually-hidden">{ i18n.T(ctx, "getting_started.state.done") }</span>
		{ i18n.T(ctx, labelKey) }
	</li>
}
