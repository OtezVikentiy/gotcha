package templates

import (
	"bytes"
	"encoding/json"
	"net/url"
	"sort"
	"strconv"
	"strings"

	"gitflic.ru/otezvikentiy/gotcha/internal/event"
	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/issue"
	"gitflic.ru/otezvikentiy/gotcha/internal/org"
)

// Frame — один фрейм стектрейса для отображения. Парсится из JSON исключения
// (event.Stored.Stacktrace) в web/issuedetail.go локальным парсером (не тянет
// internal/ingest — см. бриф задачи 7); сюда попадает уже в порядке "новые
// сверху".
type Frame struct {
	Function string
	Module   string
	Filename string
	Lineno   int
	InApp    bool
	// Исходный код кадра (шлёт sentry-php по опции context_lines): строки до
	// ошибки, сама строка и строки после. Пустые — фрейм без исходника.
	AbsPath     string
	ContextLine string
	PreContext  []string
	PostContext []string
	// Vars — локальные переменные кадра (JSON-объект), если SDK их прислал
	// (sentry-php: опция include_local_variables). Пусто — не показываем.
	Vars string
}

// frameHasVars — есть ли у кадра сохранённые локальные переменные.
func frameHasVars(f Frame) bool {
	return f.Vars != "" && f.Vars != "{}" && f.Vars != "null"
}

// frameVars разворачивает vars кадра в строки ключ/значение (тем же плоским
// парсером, что и контексты).
func frameVars(f Frame) []ctxRow {
	if !frameHasVars(f) {
		return nil
	}
	var rows []ctxRow
	flattenContext("", json.RawMessage(f.Vars), &rows)
	return rows
}

// sourceLine — одна строка исходника кадра с абсолютным номером и признаком
// «та самая строка ошибки» (для подсветки).
type sourceLine struct {
	No      int
	Code    string
	Current bool
}

// frameHasSource — есть ли у кадра исходный код для показа в развороте.
func frameHasSource(f Frame) bool {
	return f.ContextLine != "" || len(f.PreContext) > 0 || len(f.PostContext) > 0
}

// frameSourceLines собирает pre_context + context_line + post_context в единый
// список с корректной сквозной нумерацией: context_line стоит на f.Lineno,
// pre_context — строки прямо перед ним, post_context — сразу после.
func frameSourceLines(f Frame) []sourceLine {
	if !frameHasSource(f) {
		return nil
	}
	lines := make([]sourceLine, 0, len(f.PreContext)+1+len(f.PostContext))
	start := f.Lineno - len(f.PreContext)
	for i, code := range f.PreContext {
		lines = append(lines, sourceLine{No: start + i, Code: code})
	}
	lines = append(lines, sourceLine{No: f.Lineno, Code: f.ContextLine, Current: true})
	for i, code := range f.PostContext {
		lines = append(lines, sourceLine{No: f.Lineno + 1 + i, Code: code})
	}
	return lines
}

func sourceLineClass(l sourceLine) string {
	if l.Current {
		return "src-line src-line-current"
	}
	return "src-line"
}

// prettyJSON форматирует JSON с отступами для читаемости. Невалидный JSON
// возвращается как есть — лучше показать сырьё, чем ничего.
func prettyJSON(s string) string {
	var buf bytes.Buffer
	if err := json.Indent(&buf, []byte(s), "", "  "); err != nil {
		return s
	}
	return buf.String()
}

// ctxRow — пара ключ/значение в карточке контекста.
type ctxRow struct{ Key, Val string }

// ctxGroup — именованная группа контекста события (os, runtime, trace…),
// показывается таблицей ключ/значение вместо сырого JSON.
type ctxGroup struct {
	Title string
	Rows  []ctxRow
}

// contextTitle — заголовок группы контекста; неизвестные ключи как есть.
func contextTitle(key string) string {
	switch key {
	case "os":
		return "OS"
	case "runtime":
		return "Runtime"
	case "trace":
		return "Trace"
	case "browser":
		return "Browser"
	case "device":
		return "Device"
	case "app":
		return "App"
	case "gpu":
		return "GPU"
	case "response":
		return "Response"
	default:
		return key
	}
}

// jsonScalar приводит JSON-значение к строке: строки как есть, целые без .0,
// объект/массив — компактным JSON.
func jsonScalar(raw json.RawMessage) string {
	var v any
	if err := json.Unmarshal(raw, &v); err != nil {
		return string(raw)
	}
	switch t := v.(type) {
	case string:
		return t
	case float64:
		if t == float64(int64(t)) {
			return strconv.FormatInt(int64(t), 10)
		}
		return strconv.FormatFloat(t, 'f', -1, 64)
	case bool:
		return strconv.FormatBool(t)
	case nil:
		return ""
	default:
		b, _ := json.Marshal(v)
		return string(b)
	}
}

// flattenContext разворачивает вложенный объект в плоские строки с точечными
// ключами (data.http.url). Массивы/скаляры кладём как значение.
func flattenContext(prefix string, raw json.RawMessage, out *[]ctxRow) {
	var obj map[string]json.RawMessage
	if err := json.Unmarshal(raw, &obj); err == nil && len(obj) > 0 {
		keys := sortedKeys(obj)
		for _, k := range keys {
			key := k
			if prefix != "" {
				key = prefix + "." + k
			}
			flattenContext(key, obj[k], out)
		}
		return
	}
	*out = append(*out, ctxRow{Key: prefix, Val: jsonScalar(raw)})
}

func sortedKeys(m map[string]json.RawMessage) []string {
	keys := make([]string, 0, len(m))
	for k := range m {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	return keys
}

// contextGroups парсит contexts-JSON события в упорядоченные группы для показа
// таблицами. Пустой/битый JSON → nil (тогда шаблон падает на raw-JSON).
func contextGroups(contextsJSON string) []ctxGroup {
	if contextsJSON == "" || contextsJSON == "{}" {
		return nil
	}
	var top map[string]json.RawMessage
	if err := json.Unmarshal([]byte(contextsJSON), &top); err != nil || len(top) == 0 {
		return nil
	}
	groups := make([]ctxGroup, 0, len(top))
	for _, k := range sortedKeys(top) {
		var rows []ctxRow
		flattenContext("", top[k], &rows)
		if len(rows) == 0 {
			continue
		}
		groups = append(groups, ctxGroup{Title: contextTitle(k), Rows: rows})
	}
	return groups
}

// requestRows вытаскивает суть HTTP-запроса из contexts.trace.data (method, url,
// route, статус) — отдельная карточка «Запрос» сверху. Пусто → nil.
func requestRows(contextsJSON string) []ctxRow {
	if contextsJSON == "" {
		return nil
	}
	var top struct {
		Trace struct {
			Data map[string]json.RawMessage `json:"data"`
		} `json:"trace"`
	}
	if err := json.Unmarshal([]byte(contextsJSON), &top); err != nil || top.Trace.Data == nil {
		return nil
	}
	get := func(k string) string {
		if raw, ok := top.Trace.Data[k]; ok {
			return jsonScalar(raw)
		}
		return ""
	}
	var rows []ctxRow
	for _, p := range []struct{ label, key string }{
		{"Method", "http.request.method"},
		{"URL", "http.url"},
		{"Route", "route"},
		{"Status", "http.status_code"},
	} {
		if v := get(p.key); v != "" {
			rows = append(rows, ctxRow{Key: p.label, Val: v})
		}
	}
	return rows
}

// sentryRequest — распарсенный Sentry request-интерфейс к показу на детали issue.
type sentryRequest struct {
	Method  string
	URL     string
	Query   []ctxRow // разобранные query-параметры (из query_string)
	Headers []ctxRow
	Body    string // тело запроса: pretty-JSON для объекта, иначе как есть
}

// parseRequest разбирает JSON Sentry request-интерфейса (уже отскрабленного в
// пайплайне приёма). Терпим к вариациям SDK: query_string — строкой "a=1&b=2"
// либо объектом/массивом пар; data — телом-строкой либо объектом; headers —
// объектом {name:value} либо массивом пар [name, value]. Пусто/битый JSON → nil.
func parseRequest(requestJSON string) *sentryRequest {
	if requestJSON == "" || requestJSON == "{}" || requestJSON == "null" {
		return nil
	}
	var r struct {
		Method      string          `json:"method"`
		URL         string          `json:"url"`
		QueryString json.RawMessage `json:"query_string"`
		Data        json.RawMessage `json:"data"`
		Headers     json.RawMessage `json:"headers"`
	}
	if err := json.Unmarshal([]byte(requestJSON), &r); err != nil {
		return nil
	}
	out := &sentryRequest{
		Method:  r.Method,
		URL:     r.URL,
		Query:   parseQueryParams(r.QueryString),
		Headers: pairsOrObjectRows(r.Headers),
		Body:    requestBody(r.Data),
	}
	if out.Method == "" && out.URL == "" && len(out.Query) == 0 && len(out.Headers) == 0 && out.Body == "" {
		return nil
	}
	return out
}

// parseQueryParams разбирает query_string в пары ключ/значение: строка
// "a=1&b=2" — как URL-query; объект/массив — разворачивается flattenContext'ом.
func parseQueryParams(raw json.RawMessage) []ctxRow {
	if len(raw) == 0 {
		return nil
	}
	var s string
	if json.Unmarshal(raw, &s) == nil {
		if s == "" {
			return nil
		}
		vals, err := url.ParseQuery(strings.TrimPrefix(s, "?"))
		if err != nil {
			return []ctxRow{{Key: "", Val: s}}
		}
		keys := make([]string, 0, len(vals))
		for k := range vals {
			keys = append(keys, k)
		}
		sort.Strings(keys)
		rows := make([]ctxRow, 0, len(keys))
		for _, k := range keys {
			rows = append(rows, ctxRow{Key: k, Val: strings.Join(vals[k], ", ")})
		}
		return rows
	}
	var rows []ctxRow
	flattenContext("", raw, &rows)
	return rows
}

// pairsOrObjectRows разворачивает headers-подобное значение: массив пар
// [[name, value], …] либо объект {name: value} — в пары ключ/значение.
func pairsOrObjectRows(raw json.RawMessage) []ctxRow {
	if len(raw) == 0 {
		return nil
	}
	var pairs [][]json.RawMessage
	if json.Unmarshal(raw, &pairs) == nil && len(pairs) > 0 {
		rows := make([]ctxRow, 0, len(pairs))
		for _, p := range pairs {
			if len(p) == 2 {
				rows = append(rows, ctxRow{Key: jsonScalar(p[0]), Val: jsonScalar(p[1])})
			}
		}
		if len(rows) > 0 {
			return rows
		}
	}
	var rows []ctxRow
	flattenContext("", raw, &rows)
	return rows
}

// requestBody нормализует тело запроса: тело-строку возвращает как есть,
// объект/массив — отформатированным JSON (prettyJSON).
func requestBody(raw json.RawMessage) string {
	if len(raw) == 0 || string(raw) == "null" || string(raw) == `""` {
		return ""
	}
	var s string
	if json.Unmarshal(raw, &s) == nil {
		return s
	}
	return prettyJSON(string(raw))
}

// requestFullView — карточка «Запрос»: строка «METHOD URL», параметры, тело и
// (сворачиваемые) заголовки. Данные уже отскраблены на приёме.
templ requestFullView(r *sentryRequest) {
	<div class="request-view">
		if r.Method != "" || r.URL != "" {
			<p class="request-line"><span class="request-method">{ r.Method }</span> <span class="request-url">{ r.URL }</span></p>
		}
		if len(r.Query) > 0 {
			<h4 class="ctx-title">{ i18n.T(ctx, "issues.detail.request.query") }</h4>
			@contextTable(r.Query)
		}
		if r.Body != "" {
			<h4 class="ctx-title">{ i18n.T(ctx, "issues.detail.request.body") }</h4>
			<pre class="contexts-json">{ r.Body }</pre>
		}
		if len(r.Headers) > 0 {
			<details class="raw-json">
				<summary>{ i18n.T(ctx, "issues.detail.request.headers") }</summary>
				@contextTable(r.Headers)
			</details>
		}
	</div>
}

func issueStatusPath(issueID int64) string {
	return issueDetailPath(issueID) + "/status"
}

func issueAssignPath(issueID int64) string {
	return issueDetailPath(issueID) + "/assign"
}

func issueEventPath(issueID int64, eventID string, rng TimeRangeVM) string {
	q := url.Values{}
	q.Set("event", eventID)
	rng.apply(q)
	return issueDetailPath(issueID) + "?" + q.Encode()
}

// frameLocation — "filename:lineno", пусто для фреймов без адреса.
func frameLocation(f Frame) string {
	if f.Filename == "" {
		return ""
	}
	return f.Filename + ":" + strconv.Itoa(f.Lineno)
}

func eventSummary(ev event.Stored) string {
	if ev.ExceptionType != "" {
		return ev.ExceptionType + ": " + ev.ExceptionValue
	}
	return ev.Message
}

func eventRowClass(selected bool) string {
	if selected {
		return "event-row event-row-selected"
	}
	return "event-row"
}

// assignControl — смена ответственного. Состояние («на кого назначено»)
// показывает assigneeChip в шапке, а здесь только действие, поэтому форма
// свёрнута в <details>: раньше предвыбранный <select> был единственным
// носителем информации, и факт назначения приходилось вычитывать из элемента
// управления. <details> — нативный, работает без JS.
templ assignControl(it issue.Issue, members []org.Member) {
	<details class="dropdown-control">
		<summary>
			@icon("user")
			{ i18n.T(ctx, "issues.action.change_assignee") }
		</summary>
		<form method="post" action={ templ.URL(issueAssignPath(it.ID)) } class="assign-form">
			<select name="assignee" class="select" aria-label={ i18n.T(ctx, "issues.action.change_assignee") }>
				if it.AssigneeID == nil {
					<option value="" selected>{ i18n.T(ctx, "issues.detail.unassigned") }</option>
				} else {
					<option value="">{ i18n.T(ctx, "issues.detail.unassigned") }</option>
				}
				for _, m := range members {
					@assigneeOption(m, it.AssigneeID)
				}
			</select>
			<button type="submit" class="btn btn-ghost">{ i18n.T(ctx, "issues.action.assign") }</button>
		</form>
	</details>
}

templ assigneeOption(m org.Member, selected *int64) {
	if selected != nil && *selected == m.UserID {
		<option value={ strconv.FormatInt(m.UserID, 10) } selected>{ m.Email }</option>
	} else {
		<option value={ strconv.FormatInt(m.UserID, 10) }>{ m.Email }</option>
	}
}

// frameSource — исходный код кадра: строки с номерами, строка ошибки подсвечена.
templ frameSource(f Frame) {
	<div class="frame-source">
		for _, l := range frameSourceLines(f) {
			<div class={ sourceLineClass(l) }>
				<span class="src-lineno">{ strconv.Itoa(l.No) }</span>
				<span class="src-code">{ l.Code }</span>
			</div>
		}
	</div>
}

// breadcrumb — один «след» до ошибки (лог/HTTP/навигация), как шлёт SDK.
type breadcrumb struct {
	Category string
	Type     string
	Level    string
	Message  string
	Data     string
}

// breadcrumbLabel — что показать слева: категория, иначе тип, иначе прочерк.
func breadcrumbLabel(b breadcrumb) string {
	switch {
	case b.Category != "":
		return b.Category
	case b.Type != "":
		return b.Type
	default:
		return "—"
	}
}

// parseBreadcrumbs разбирает breadcrumbs события: Sentry шлёт {"values":[…]}
// либо прямой массив. Порядок сохраняем как есть (SDK шлёт хронологически).
func parseBreadcrumbs(js string) []breadcrumb {
	if js == "" || js == "{}" || js == "null" {
		return nil
	}
	var items []json.RawMessage
	var wrap struct {
		Values []json.RawMessage `json:"values"`
	}
	if json.Unmarshal([]byte(js), &wrap) == nil && len(wrap.Values) > 0 {
		items = wrap.Values
	} else {
		_ = json.Unmarshal([]byte(js), &items)
	}
	out := make([]breadcrumb, 0, len(items))
	for _, raw := range items {
		var b struct {
			Category string          `json:"category"`
			Type     string          `json:"type"`
			Level    string          `json:"level"`
			Message  string          `json:"message"`
			Data     json.RawMessage `json:"data"`
		}
		if json.Unmarshal(raw, &b) != nil {
			continue
		}
		data := ""
		if len(b.Data) > 0 && string(b.Data) != "null" && string(b.Data) != "{}" {
			data = string(b.Data)
		}
		out = append(out, breadcrumb{Category: b.Category, Type: b.Type, Level: b.Level, Message: b.Message, Data: data})
	}
	return out
}

// breadcrumbsView — таймлайн следов до ошибки.
templ breadcrumbsView(js string) {
	<ul class="breadcrumbs">
		for _, b := range parseBreadcrumbs(js) {
			<li class="bc-item">
				<span class="bc-cat">{ breadcrumbLabel(b) }</span>
				if b.Level != "" {
					// b.Level приходит из breadcrumb JSON события (SDK-controlled).
					// Держим class СРЕЗОМ из двух аргументов: templ санитизирует
					// каждый элемент через templ.CSSClasses/RenderCSSItems
					// (issuedetail_templ.go, сгенерированный код) — regexp-фильтром
					// допустимых CSS-имён. Схлопывание в один string-аргумент
					// (`class={ "bc-level bc-level-" + b.Level }`) выключит эту
					// санитизацию и откроет CSS-инъекцию через уровень breadcrumb —
					// НЕ упрощать этот атрибут при рефакторинге блока.
					<span class={ "bc-level", "bc-level-" + b.Level }>{ issueLevelLabel(ctx, b.Level) }</span>
				}
				<span class="bc-msg">{ b.Message }</span>
				if b.Data != "" {
					<pre class="bc-data">{ b.Data }</pre>
				}
			</li>
		}
	</ul>
}

// frameVarsView — локальные переменные кадра таблицей ключ/значение.
templ frameVarsView(f Frame) {
	<div class="frame-vars">
		<div class="frame-vars-title">{ i18n.T(ctx, "issues.detail.variables") }</div>
		@contextTable(frameVars(f))
	</div>
}

templ frameView(f Frame, expandSystem bool) {
	if f.InApp {
		<div class="frame in-app">
			<div class="frame-location">{ frameLocation(f) }</div>
			<div class="frame-function">{ f.Function }</div>
			if f.Module != "" {
				<div class="frame-module">{ f.Module }</div>
			}
			if frameHasSource(f) {
				@frameSource(f)
			}
			if frameHasVars(f) {
				@frameVarsView(f)
			}
		</div>
	} else {
		<details class="frame frame-system" open?={ expandSystem }>
			<summary>{ f.Function } ({ frameLocation(f) })</summary>
			if f.Module != "" {
				<div class="frame-module">{ f.Module }</div>
			}
			if frameHasSource(f) {
				@frameSource(f)
			}
			if frameHasVars(f) {
				@frameVarsView(f)
			}
		</details>
	}
}

// contextTable — таблица ключ/значение для группы контекста или Request-карточки.
templ contextTable(rows []ctxRow) {
	<table class="ctx-table data-table data-table--auto">
		<tbody>
			for _, r := range rows {
				<tr>
					<td class="ctx-key">{ r.Key }</td>
					<td class="ctx-val">{ r.Val }</td>
				</tr>
			}
		</tbody>
	</table>
}

templ eventRow(issueID int64, ev event.Stored, selected bool, rng TimeRangeVM) {
	<tr class={ eventRowClass(selected) }>
		<td><a href={ templ.URL(issueEventPath(issueID, ev.ID, rng)) }>@relativeTime(ev.Timestamp)</a></td>
		<td>{ eventSummary(ev) }</td>
		<td>{ ev.Environment }</td>
		<td>{ ev.Release }</td>
	</tr>
}

// IssueDetail — GET /issues/{id}: шапка, статус/assign-формы, график частоты
// за 7 дней, последние 20 событий, детали выбранного события (?event=).
// selectedID — id события из query (для подсветки строки в таблице), может
// не совпадать ни с одним из events, если событие устарело/удалено — тогда
// selected/frames приходят пустыми и блок деталей просто не рендерится.
templ IssueDetail(it issue.Issue, members []org.Member, chart templ.Component, rng TimeRangeVM, events []event.Stored, selectedID string, selected *event.Stored, frames []Frame, userEmail string, hasTrace bool, showAllFrames bool, copyMD string, copyTXT string, exportsEnabled bool, canManagePII bool) {
	@layout(issueTitle(ctx, it.Title), userEmail) {
		<div class="issue-detail">
			@breadcrumbBackTo(templ.URL(issuesPath(it.ProjectID)), i18n.T(ctx, "nav.errors"))
			<h1>{ issueTitle(ctx, it.Title) }</h1>
			if it.Culprit != "" {
				<div class="culprit">{ it.Culprit }</div>
			}
			<span class={ levelBadgeClass(it.Level) }>{ issueLevelLabel(ctx, it.Level) }</span>
			<span class={ statusBadgeClass(it.Status) }>{ issueStatusLabel(ctx, it.Status) }</span>
			<div class="issue-assignee">
				@assigneeChip(it.AssigneeEmail)
			</div>
			<div class="issue-meta">
				// @relativeTime — отдельным узлом: после текста в той же строке
				// templ не разбирает @-вызов и печатает его буквально
				// («…: @relativeTime(it.FirstSeen)» прямо на странице).
				<span>
					{ i18n.T(ctx, "issues.detail.first_seen") + ": " }
					@relativeTime(it.FirstSeen)
				</span>
				<span>
					{ i18n.T(ctx, "issues.detail.last_seen") + ": " }
					@relativeTime(it.LastSeen)
				</span>
				<span>{ i18n.T(ctx, "issues.detail.times_seen") }: { strconv.FormatInt(it.TimesSeen, 10) }</span>
			</div>

			<div class="issue-actions">
				<form method="post" action={ templ.URL(issueStatusPath(it.ID)) }>
					if it.Status == issue.StatusUnresolved {
						<button type="submit" name="status" value="resolved" class="btn btn-primary">{ i18n.T(ctx, "issues.action.resolve") }</button>
						<button type="submit" name="status" value="ignored" class="btn btn-ghost">{ i18n.T(ctx, "issues.action.ignore") }</button>
					} else {
						<button type="submit" name="status" value="unresolved" class="btn btn-ghost">{ i18n.T(ctx, "issues.action.unresolve") }</button>
					}
				</form>
				@assignControl(it, members)
				// Экспорт событий этой issue (E1, задача 11): без явного
				// canOperate-параметра — loadAccessibleIssue уже потребовал
				// CanAccessProject, а он сегодня буквально canOperateProject
				// (см. её докблок в operate.go), так что дошедший досюда
				// пользователь уже прошёл бы requireProjectOperator постановки.
				// exportsEnabled — сверх этого: на инстансе без каталога
				// выгрузок (h.Exports == nil) форма поведёт на 404, поэтому
				// не рендерится вовсе (ревью веб-части E1, п.3).
				//
				// Раскрывающаяся <details> — тот же приём, что и у
				// @assignControl чуть выше и у кнопок экспорта issues.templ:
				// раньше формат был зашит в hidden-поле («Экспорт событий
				// issue» всегда давал csv, тот же по названию со списка ошибок
				// давал ndjson) и выбрать его или поставить галку PII было
				// негде — находка аудита P2-UX-3. canManagePII гейтит галку
				// «выгрузить как есть» тем же правилом, что и генерическая
				// форма страницы «Выгрузки» (exports.go:exportsCreate,
				// authz.CanManage) — только здесь она впервые доступна ВМЕСТЕ
				// со scope_issue_id: раньше PII работала только для выгрузки
				// всего проекта.
				//
				// Период — тем же окном, что сейчас выбрано графиком частоты
				// (rng, дефолт 7д — issuedetail.go), переносится в action
				// query-параметром (exportsPathWithRange), тем же приёмом, что
				// и формы issues.templ: hidden-поле сюда не годится, POST-тело
				// не долетает до resolveTimeRange (ревью веб-части E1, п.1).
				if exportsEnabled {
					<details class="dropdown-control">
						<summary>{ i18n.T(ctx, "issuedetail.export") }</summary>
						<form method="post" action={ templ.URL(exportsPathWithRange(it.ProjectID, rng)) } class="export-control-form">
							<input type="hidden" name="kind" value="events"/>
							<input type="hidden" name="scope_issue_id" value={ strconv.FormatInt(it.ID, 10) }/>
							@exportFormatField(nil)
							@exportPIIField(canManagePII, nil)
							<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "exports.create") }</button>
						</form>
					</details>
				}
			</div>

			<form method="get" action={ templ.URL(issueDetailPath(it.ID)) } class="performance-filters">
				if selectedID != "" {
					<input type="hidden" name="event" value={ selectedID }/>
				}
				if showAllFrames {
					<input type="hidden" name="frames" value="all"/>
				}
				@timeRangeFields(rng)
				<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "perf.filter.apply") }</button>
			</form>
			@scrollRegion("issue-chart card", "region.issue.chart") {
				@chart
			}

			if selected != nil {
				<div class="event-detail">
					// Тот же случай inline-@, что у .issue-meta выше.
					<h2>
						{ i18n.T(ctx, "issues.detail.event") + " · " }
						@relativeTime(selected.Timestamp)
					</h2>
					<div class="culprit event-id">{ selected.ID }</div>
					@copyToolbar(copyMD, copyTXT)

					if hasTrace {
						<p class="event-trace-link"><a href={ templ.URL(tracePathFrom(selected.TraceID, "issue", strconv.FormatInt(it.ID, 10))) }>{ i18n.T(ctx, "issues.detail.view_trace") }</a></p>
					}

					<p class="logs-link"><a href={ templ.URL(logsAroundEventPath(it.ProjectID, selected.TraceID, selected.Timestamp, selected.Environment)) }>{ i18n.T(ctx, "issues.detail.view_logs") }</a></p>

					if len(frames) > 0 {
						<h3>{ i18n.T(ctx, "issues.detail.stacktrace") }</h3>
						if showAllFrames {
							<p class="frames-toggle"><a href={ templ.URL(issueEventPath(it.ID, selectedID, rng)) }>{ i18n.T(ctx, "issues.detail.hide_system_frames") }</a></p>
						} else {
							<p class="frames-toggle"><a href={ templ.URL(issueEventPath(it.ID, selectedID, rng) + "&frames=all") }>{ i18n.T(ctx, "issues.detail.show_system_frames") }</a></p>
						}
						<div class="frames card">
							for _, f := range frames {
								@frameView(f, showAllFrames)
							}
						</div>
					} else {
						<p class="hint">{ i18n.T(ctx, "issues.detail.no_stacktrace") }</p>
					}

					if len(selected.Tags) > 0 {
						<h3>{ i18n.T(ctx, "issues.detail.tags") }</h3>
						<table class="tags data-table data-table--auto">
							<tbody>
								for k, v := range selected.Tags {
									<tr>
										<td>{ k }</td>
										<td>{ v }</td>
									</tr>
								}
							</tbody>
						</table>
					}

					if selected.Breadcrumbs != "" && selected.Breadcrumbs != "{}" {
						<h3>{ i18n.T(ctx, "issues.detail.breadcrumbs") }</h3>
						@breadcrumbsView(selected.Breadcrumbs)
					}

					<div class="event-meta">
						<div>
							<h3>{ i18n.T(ctx, "issues.detail.user") }</h3>
							<pre>{ selected.UserID } { selected.UserEmail } { selected.UserIP }</pre>
						</div>
						<div>
							<h3>{ i18n.T(ctx, "issues.detail.sdk") }</h3>
							<pre>{ selected.SDK }</pre>
						</div>
					</div>

					// "{}" — пустой JSON-объект: секция с ним не несёт информации
					// и читается как недогруженные данные.
					if req := parseRequest(selected.Request); req != nil {
						<h3>{ i18n.T(ctx, "issues.detail.request") }</h3>
						<div class="ctx-card card">
							@requestFullView(req)
						</div>
					} else if reqRows := requestRows(selected.Contexts); len(reqRows) > 0 {
						<h3>{ i18n.T(ctx, "issues.detail.request") }</h3>
						<div class="ctx-card card">
							@contextTable(reqRows)
						</div>
					}
					if selected.Contexts != "" && selected.Contexts != "{}" {
						<h3>{ i18n.T(ctx, "issues.detail.contexts") }</h3>
						if groups := contextGroups(selected.Contexts); len(groups) > 0 {
							<div class="ctx-groups">
								for _, g := range groups {
									<div class="ctx-card card">
										<h4 class="ctx-title">{ g.Title }</h4>
										@contextTable(g.Rows)
									</div>
								}
							</div>
							<details class="raw-json">
								<summary>{ i18n.T(ctx, "issues.detail.raw_json") }</summary>
								<pre class="contexts-json">{ prettyJSON(selected.Contexts) }</pre>
							</details>
						} else {
							<pre class="contexts-json">{ prettyJSON(selected.Contexts) }</pre>
						}
					}
				</div>
			}

			<h2 class="issue-events-heading">{ i18n.T(ctx, "issues.detail.recent_events") }</h2>
			// Таблица событий — в собственном скролл-регионе, как остальные
			// таблицы (№31): на 375px она распирала страницу целиком.
			@scrollRegion("table-scroll", "issues.detail.recent_events") {
				<table class="issue-events data-table">
					<thead>
						<tr>
							<th scope="col">{ i18n.T(ctx, "issues.detail.events_table.when") }</th>
							<th scope="col">{ i18n.T(ctx, "issues.detail.events_table.message") }</th>
							<th scope="col">{ i18n.T(ctx, "issues.detail.events_table.environment") }</th>
							<th scope="col">{ i18n.T(ctx, "issues.detail.events_table.release") }</th>
						</tr>
					</thead>
					<tbody>
						for _, ev := range events {
							@eventRow(it.ID, ev, ev.ID == selectedID, rng)
						}
					</tbody>
				</table>
			}
		</div>
	}
}

// copyToolbar — кнопки «Скопировать для ИИ» (Markdown/текст) и скрытые
// off-screen textarea-источники для JS-обработчика (static/copy.js, Task 4).
// Рендерится только при непустом md (т.е. selected != nil в вызывающем
// коде) — без выбранного события копировать нечего. Текст в <textarea>
// экранируется templ автоматически — это корректно, обходить не нужно.
templ copyToolbar(md string, txt string) {
	if md != "" {
		<div class="copy-llm">
			<button type="button" class="btn-copy" data-copy-format="md"
				data-copy-target="copy-md" aria-label={ i18n.T(ctx, "issue.copy.aria") }>
				{ i18n.T(ctx, "issue.copy.md") }
			</button>
			<button type="button" class="btn-copy" data-copy-format="txt"
				data-copy-target="copy-txt" aria-label={ i18n.T(ctx, "issue.copy.aria") }>
				{ i18n.T(ctx, "issue.copy.txt") }
			</button>
			<span class="copy-done" data-copy-done hidden>{ i18n.T(ctx, "issue.copy.done") }</span>
			<textarea class="visually-hidden" id="copy-md" data-copy-blob readonly aria-hidden="true" tabindex="-1">{ md }</textarea>
			<textarea class="visually-hidden" id="copy-txt" data-copy-blob readonly aria-hidden="true" tabindex="-1">{ txt }</textarea>
		</div>
	}
}
