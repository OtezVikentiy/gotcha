package templates

import (
	"gitflic.ru/otezvikentiy/gotcha/internal/docs"
	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
)

type DocsGroup struct {
	Key   string
	Pages []docs.Page
}

func docPagePath(slug string) string {
	return "/docs/" + slug
}

templ DocsIndex(groups []DocsGroup, userEmail string) {
	@layout(i18n.T(ctx, "docs.index.title"), userEmail) {
		<div class="docs-index">
			<h1>{ i18n.T(ctx, "docs.index.title") }</h1>
			<div class="docs-index-groups">
				for _, g := range groups {
					<section class="card">
						<h2 class="card-header">{ i18n.T(ctx, g.Key) }</h2>
						<ul class="docs-index-list">
							for _, p := range g.Pages {
								<li><a href={ templ.URL(docPagePath(p.Slug)) }>{ p.Title }</a></li>
							}
						</ul>
					</section>
				}
			</div>
		</div>
	}
}

// htmlBody — templ.Raw, безопасно только пока docs.Render в safe-mode.
// Своего <h1> нет: markdown уже начинается с "# Заголовок".
templ DocsPage(slug, title, htmlBody string, pages []docs.Page, userEmail string) {
	@layout(title, userEmail) {
		<div class="docs-page">
			@breadcrumbBackTo(templ.SafeURL("/docs"), i18n.T(ctx, "docs.index.title"))
			<article class="doc-content">
				@templ.Raw(htmlBody)
			</article>
		</div>
	}
}
