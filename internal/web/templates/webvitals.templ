package templates

import (
	"net/url"
	"strconv"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/trace"
)

func webVitalsPath(projectID int64) string {
	return "/projects/" + strconv.FormatInt(projectID, 10) + "/web-vitals"
}

// shared-страница «Транзакций»/«Web Vitals»: from=web-vitals возвращает крошку и подсветку раздела.
// якорь #web-vitals ведёт сразу к панели, не к шапке.
func endpointVitalsPath(projectID int64, transaction string) string {
	return endpointPath(projectID, transaction) + "?from=web-vitals#web-vitals"
}

func wvListSortURL(projectID int64, f PerfFilter, sort string) string {
	q := url.Values{}
	f.Range.apply(q)
	if f.Environment != "" {
		q.Set("environment", f.Environment)
	}
	q.Set("sort", sort)
	return webVitalsPath(projectID) + "?" + q.Encode()
}

func vitalLabel(name string) string {
	switch name {
	case "lcp":
		return "LCP"
	case "inp":
		return "INP"
	case "cls":
		return "CLS"
	case "fcp":
		return "FCP"
	case "ttfb":
		return "TTFB"
	}
	return name
}

func vitalHelpKey(name string) string {
	switch name {
	case "lcp":
		return "perf.vital.help.lcp"
	case "inp":
		return "perf.vital.help.inp"
	case "cls":
		return "perf.vital.help.cls"
	case "fcp":
		return "perf.vital.help.fcp"
	case "ttfb":
		return "perf.vital.help.ttfb"
	}
	return ""
}

// abbr нативный, без JS и CSP-исключений — подсказка при наведении объясняет аббревиатуру.
templ vitalAbbr(name string) {
	if key := vitalHelpKey(name); key != "" {
		<abbr class="vital-abbr" title={ i18n.T(ctx, key) }>{ vitalLabel(name) }</abbr>
	} else {
		{ vitalLabel(name) }
	}
}

// CLS — безразмерный (два знака, не миллисекунды); нет данных (Rating=="") → «—».
func formatVitalValue(v trace.Vital) string {
	if v.Rating == "" {
		return "—"
	}
	if v.Name == "cls" {
		return strconv.FormatFloat(v.P75, 'f', 2, 64)
	}
	return formatVitalMS(v.P75)
}

func formatVitalMS(ms float64) string {
	if ms < 1000 {
		return strconv.FormatFloat(ms, 'f', 0, 64) + "ms"
	}
	return strconv.FormatFloat(ms/1000, 'f', 2, 64) + "s"
}

func vitalBadgeClass(rating string) string {
	switch rating {
	case "good":
		return "badge badge-good"
	case "needs-improvement":
		return "badge badge-warn"
	case "poor":
		return "badge badge-danger"
	}
	return ""
}

func vitalRatingKey(rating string) string {
	switch rating {
	case "good":
		return "perf.rating.good"
	case "needs-improvement":
		return "perf.rating.needs_improvement"
	case "poor":
		return "perf.rating.poor"
	}
	return ""
}

templ vitalRatingBadge(rating string) {
	if rating != "" {
		<span class={ vitalBadgeClass(rating) }>{ i18n.T(ctx, vitalRatingKey(rating)) }</span>
	}
}

templ vitalCell(v trace.Vital) {
	<td class="num">
		<span class="vital-value">{ formatVitalValue(v) }</span>
		@vitalRatingBadge(v.Rating)
	</td>
}

// loadFailed — ClickHouse не ответил: фильтры на месте, вместо таблицы «данные временно недоступны».
templ WebVitalsList(projectID int64, pages []trace.PageVitals, filter PerfFilter, environments []string, userEmail string, loadFailed bool) {
	@layout(i18n.T(ctx, "perf.webvitals"), userEmail) {
		<div class="web-vitals">
			<h1>{ i18n.T(ctx, "perf.webvitals") }</h1>
			@helpPanel("webvitals", "performance")
			<form method="get" action={ templ.URL(webVitalsPath(projectID)) } class="performance-filters">
				<select name="environment" class="select" aria-label={ i18n.T(ctx, "filter.environment") }>
					@perfEnvOption("", i18n.T(ctx, "perf.filter.env_all"), filter.Environment)
					for _, env := range environments {
						@perfEnvOption(env, env, filter.Environment)
					}
				</select>
				@timeRangeFields(filter.Range)
				if filter.Sort != "" {
					<input type="hidden" name="sort" value={ filter.Sort }/>
				}
				<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "perf.filter.apply") }</button>
			</form>
			if loadFailed {
				@emptyState("activity", "perf.webvitals.error.title", "perf.webvitals.error.body", "", "", 2)
			} else if len(pages) == 0 {
				@emptyState("activity", "perf.webvitals.empty.title", "perf.webvitals.empty.body", "perf.webvitals.empty.cta", "/docs/sdk", 2)
			} else {
				<div class="card">
				@scrollRegion("table-scroll", "perf.webvitals") {
					<table class="data-table">
						<thead>
							<tr>
								<th scope="col" aria-sort={ sortAria(filter.Sort, "name") }><a href={ templ.URL(wvListSortURL(projectID, filter, "name")) }>{ i18n.T(ctx, "perf.webvitals.table.page") }</a></th>
								<th scope="col">{ i18n.T(ctx, "perf.environment") }</th>
								<th scope="col" class="num" aria-sort={ sortAria(filter.Sort, "lcp") }><a href={ templ.URL(wvListSortURL(projectID, filter, "lcp")) }><abbr class="vital-abbr" title={ i18n.T(ctx, "perf.vital.help.lcp") }>{ i18n.T(ctx, "perf.webvitals.table.lcp") }</abbr></a></th>
								<th scope="col" class="num" aria-sort={ sortAria(filter.Sort, "inp") }><a href={ templ.URL(wvListSortURL(projectID, filter, "inp")) }><abbr class="vital-abbr" title={ i18n.T(ctx, "perf.vital.help.inp") }>{ i18n.T(ctx, "perf.webvitals.table.inp") }</abbr></a></th>
								<th scope="col" class="num" aria-sort={ sortAria(filter.Sort, "cls") }><a href={ templ.URL(wvListSortURL(projectID, filter, "cls")) }><abbr class="vital-abbr" title={ i18n.T(ctx, "perf.vital.help.cls") }>{ i18n.T(ctx, "perf.webvitals.table.cls") }</abbr></a></th>
								<th scope="col" class="num" aria-sort={ sortAria(filter.Sort, "count") }>{ i18n.T(ctx, "perf.webvitals.table.samples") }</th>
							</tr>
						</thead>
						<tbody>
							for _, p := range pages {
								<tr>
									<td><a href={ templ.URL(endpointVitalsPath(projectID, p.Transaction)) }>{ p.Transaction }</a></td>
									<td>{ envList(p.Environments) }</td>
									@vitalCell(p.LCP)
									@vitalCell(p.INP)
									@vitalCell(p.CLS)
									<td class="num">{ strconv.FormatUint(p.Count, 10) }</td>
								</tr>
							}
						</tbody>
					</table>
				}
				</div>
			}
		</div>
	}
}
