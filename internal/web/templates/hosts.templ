package templates

import (
	"context"
	"fmt"
	"net/url"
	"strconv"
	"time"

	"gitflic.ru/otezvikentiy/gotcha/internal/host"
	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
)

func hostsBasePath(projectID int64) string {
	return "/projects/" + strconv.FormatInt(projectID, 10) + "/hosts"
}

func hostLink(projectID int64, name string) string {
	return hostsBasePath(projectID) + "/" + url.PathEscape(name)
}

// CPU/RAM/диск/load — указатели: молчащий хост не имеет значения вовсе,
// нужно отличить «0%» от «нет данных».
type HostRowVM struct {
	Name string
	// "problem" (см. OpenKinds), "silent" (last_seen старше порога тишины) или "ok".
	StatusKind string
	// заполнено только при StatusKind == "problem".
	OpenKinds   []string
	CPU         *float64 // доля [0,1], busy = 1 − idle
	Mem         *float64 // доля [0,1], used
	Disk        *float64 // доля [0,1], худший mountpoint
	LoadPerCore *float64
	LastSeen    time.Time
	// "" — метка ещё не пришла ни в одном приёме.
	Environment string
	Role        string
	IsNew       bool
}

type HostSection struct {
	Label string
	Rows  []HostRowVM
}

func hostLabelText(v string) string {
	if v == "" {
		return "—"
	}
	return v
}

// fmt.Sprintf, не internal/humanize — в нём процентов нет.
func hostPercentText(v *float64) string {
	if v == nil {
		return "—"
	}
	return fmt.Sprintf("%.0f%%", *v*100)
}

func hostLoadText(v *float64) string {
	if v == nil {
		return "—"
	}
	return fmt.Sprintf("%.2f", *v)
}

func hostStatusBadgeClass(kind string) string {
	switch kind {
	case "problem":
		return "badge badge-danger"
	case "silent":
		return "badge badge-warn"
	default:
		return "badge badge-good"
	}
}

type HostsFilterVM struct {
	Environment string
	Role        string
	NewOnly     bool
	Active      bool
	// "" равнозначно "none". Отдельно от Active: группировка не сужает
	// список и не должна прятать онбординг пустого проекта.
	Group string
}

type HostsFacetValue struct {
	Label  string
	Href   string
	Active bool
}

type HostsFacets struct {
	Environment []HostsFacetValue
	Role        []HostsFacetValue
}

// «без метки» показывается ВСЕГДА, даже если таких хостов нет: PG DISTINCT
// не считает count'ы, а лишний поход в БД ради этого не стоит своей цены.
func NewHostsFacets(ctx context.Context, projectID int64, filter HostsFilterVM, envValues, roleValues []string) HostsFacets {
	return HostsFacets{
		Environment: newHostsFacetValues(ctx, projectID, filter, envValues,
			func(f HostsFilterVM) string { return f.Environment },
			func(f HostsFilterVM, v string) HostsFilterVM { f.Environment = v; return f }),
		Role: newHostsFacetValues(ctx, projectID, filter, roleValues,
			func(f HostsFilterVM) string { return f.Role },
			func(f HostsFilterVM, v string) HostsFilterVM { f.Role = v; return f }),
	}
}

func newHostsFacetValues(ctx context.Context, projectID int64, filter HostsFilterVM, values []string, get func(HostsFilterVM) string, set func(HostsFilterVM, string) HostsFilterVM) []HostsFacetValue {
	items := make([]HostsFacetValue, 0, len(values)+1)
	for _, v := range values {
		items = append(items, hostsFacetValueItem(projectID, filter, v, v, get, set))
	}
	items = append(items, hostsFacetValueItem(projectID, filter, host.HostLabelNone, i18n.T(ctx, "hosts.label.none"), get, set))
	return items
}

func hostsFacetValueItem(projectID int64, filter HostsFilterVM, value, label string, get func(HostsFilterVM) string, set func(HostsFilterVM, string) HostsFilterVM) HostsFacetValue {
	active := get(filter) == value
	next := filter
	if active {
		next = set(next, "")
	} else {
		next = set(next, value)
	}
	return HostsFacetValue{Label: label, Href: hostsFilterURL(projectID, next), Active: active}
}

func hostsNewFilterURL(projectID int64, filter HostsFilterVM) string {
	next := filter
	next.NewOnly = !filter.NewOnly
	return hostsFilterURL(projectID, next)
}

// group=none в query никогда не пишется, тем же принципом, что new=0:
// отсутствие параметра и есть состояние по умолчанию.
func hostsFilterURL(projectID int64, f HostsFilterVM) string {
	q := url.Values{}
	if f.Environment != "" {
		q.Set("environment", f.Environment)
	}
	if f.Role != "" {
		q.Set("role", f.Role)
	}
	if f.NewOnly {
		q.Set("new", "1")
	}
	if f.Group != "" && f.Group != "none" {
		q.Set("group", f.Group)
	}
	path := hostsBasePath(projectID)
	if len(q) == 0 {
		return path
	}
	return path + "?" + q.Encode()
}

func hostsGroupFilterURL(projectID int64, filter HostsFilterVM, group string) string {
	next := filter
	next.Group = group
	return hostsFilterURL(projectID, next)
}

func hostsGroupActive(filterGroup, group string) bool {
	if group == "none" {
		return filterGroup == "" || filterGroup == "none"
	}
	return filterGroup == group
}

func hostsFacetValueClass(active bool) string {
	if active {
		return "chip is-active"
	}
	return "chip"
}

templ hostsTable(projectID int64, rows []HostRowVM) {
	<table class="data-table">
		<thead>
			<tr>
				<th scope="col">{ i18n.T(ctx, "hosts.table.name") }</th>
				<th scope="col">{ i18n.T(ctx, "hosts.table.status") }</th>
				<th scope="col">{ i18n.T(ctx, "hosts.col.environment") }</th>
				<th scope="col">{ i18n.T(ctx, "hosts.col.role") }</th>
				<th scope="col" class="num">{ i18n.T(ctx, "hosts.table.cpu") }</th>
				<th scope="col" class="num">{ i18n.T(ctx, "hosts.table.mem") }</th>
				<th scope="col" class="num">{ i18n.T(ctx, "hosts.table.disk") }</th>
				<th scope="col" class="num">{ i18n.T(ctx, "hosts.table.load") }</th>
				<th scope="col">{ i18n.T(ctx, "hosts.table.last_seen") }</th>
			</tr>
		</thead>
		<tbody>
			for _, row := range rows {
				<tr>
					<td>
						<a href={ templ.URL(hostLink(projectID, row.Name)) }>{ row.Name }</a>
						if row.IsNew {
							<span class="badge badge-info">{ i18n.T(ctx, "hosts.badge.new") }</span>
						}
					</td>
					<td>
						switch row.StatusKind {
							case "problem":
								<span class={ hostStatusBadgeClass(row.StatusKind) }>
									for i, k := range row.OpenKinds {
										if i > 0 {
											{ ", " }
										}
										{ i18n.T(ctx, "hosts.kind."+k) }
									}
								</span>
							case "silent":
								<span class={ hostStatusBadgeClass(row.StatusKind) }>{ i18n.T(ctx, "hosts.status.silent") }</span>
							default:
								<span class={ hostStatusBadgeClass(row.StatusKind) }>{ i18n.T(ctx, "hosts.status.ok") }</span>
						}
					</td>
					<td>
						if row.Environment != "" {
							<span class="badge badge-neutral">{ row.Environment }</span>
						} else {
							{ hostLabelText(row.Environment) }
						}
					</td>
					<td>
						if row.Role != "" {
							<span class="badge badge-neutral">{ row.Role }</span>
						} else {
							{ hostLabelText(row.Role) }
						}
					</td>
					<td class="num">{ hostPercentText(row.CPU) }</td>
					<td class="num">{ hostPercentText(row.Mem) }</td>
					<td class="num">{ hostPercentText(row.Disk) }</td>
					<td class="num">{ hostLoadText(row.LoadPerCore) }</td>
					<td>@relativeTime(row.LastSeen)</td>
				</tr>
			}
		</tbody>
	</table>
}

// limit не вписан в перевод подсказки усечения: смена hostsListLimit не
// должна молча разъехаться с текстом.
templ HostsList(projectID int64, rows []HostRowVM, truncated bool, limit int, filter HostsFilterVM, facets HostsFacets, sections []HostSection, installCmd, config, agentReason, userEmail string, metricsFailed bool) {
	@layout(i18n.T(ctx, "nav.hosts"), userEmail) {
		<div class="hosts">
			<h1>{ i18n.T(ctx, "nav.hosts") }</h1>
			@helpPanel("hosts", "hosts")
			if len(rows) == 0 && !filter.Active {
				@emptyState("server", "hosts.empty.title", "hosts.empty.body", "", "", 2)
				@hostsOnboarding(projectID, installCmd, config, agentReason)
			} else {
				@hostsFilterBar(projectID, filter, facets)
				if metricsFailed {
					<p class="hint">{ i18n.T(ctx, "hosts.metrics.error") }</p>
				}
				if truncated {
					<p class="hint">{ i18n.Tf(ctx, "hosts.limit_notice", "limit", strconv.Itoa(limit)) }</p>
				}
				if len(rows) == 0 {
					@emptyState("server", "hosts.empty.filter.title", "hosts.empty.filter.body", "hosts.empty.filter.cta", hostsBasePath(projectID), 2)
				} else if filter.Group == "" {
					<div class="card">
					@scrollRegion("table-scroll", "nav.hosts") {
						@hostsTable(projectID, rows)
					}
					</div>
					@hostsCollectorConfigDetails("hosts-collector-config", projectID, installCmd, config, agentReason)
				} else {
					for _, sec := range sections {
						<div class="card hosts-section">
							<h2 class="card-header">{ sec.Label }</h2>
							@scrollRegion("table-scroll", "nav.hosts") {
								@hostsTable(projectID, sec.Rows)
							}
						</div>
					}
					@hostsCollectorConfigDetails("hosts-collector-config", projectID, installCmd, config, agentReason)
				}
			}
		</div>
	}
}

templ hostsFilterBar(projectID int64, filter HostsFilterVM, facets HostsFacets) {
	<div class="hosts-filters">
		<div class="hosts-filter-group">
			<span class="hosts-filter-label">{ i18n.T(ctx, "hosts.filter.environment") }</span>
			for _, v := range facets.Environment {
				<a class={ hostsFacetValueClass(v.Active) } href={ templ.URL(v.Href) } if v.Active { aria-current="page" }>{ v.Label }</a>
			}
		</div>
		<div class="hosts-filter-group">
			<span class="hosts-filter-label">{ i18n.T(ctx, "hosts.filter.role") }</span>
			for _, v := range facets.Role {
				<a class={ hostsFacetValueClass(v.Active) } href={ templ.URL(v.Href) } if v.Active { aria-current="page" }>{ v.Label }</a>
			}
		</div>
		<div class="hosts-filter-group">
			<span class="hosts-filter-label">{ i18n.T(ctx, "hosts.filter.age") }</span>
			<a class={ hostsFacetValueClass(filter.NewOnly) } href={ templ.URL(hostsNewFilterURL(projectID, filter)) } if filter.NewOnly { aria-current="page" }>{ i18n.T(ctx, "hosts.filter.new") }</a>
		</div>
		<div class="hosts-filter-group">
			<span class="hosts-filter-label">{ i18n.T(ctx, "hosts.group.label") }</span>
			for _, g := range []string{"none", "env", "role"} {
				<a class={ hostsFacetValueClass(hostsGroupActive(filter.Group, g)) } href={ templ.URL(hostsGroupFilterURL(projectID, filter, g)) } if hostsGroupActive(filter.Group, g) { aria-current="page" }>{ i18n.T(ctx, "hosts.group."+g) }</a>
			}
		</div>
		if filter.Active {
			<a class="hosts-filter-reset" href={ templ.URL(hostsBasePath(projectID)) }>{ i18n.T(ctx, "hosts.filter.reset") }</a>
		}
	</div>
}

// id — id скрытой textarea copyBlock конфига, обязан быть уникален в
// документе; блок команды агента получает id+"-agent-cmd".
templ hostsCollectorConfigDetails(id string, projectID int64, installCmd, config, agentReason string) {
	if installCmd != "" {
		<details>
			<summary>{ i18n.T(ctx, "hosts.settings.agent_install_howto") }</summary>
			@copyBlock(id+"-agent-cmd", "hosts.copy.command", installCmd)
		</details>
	} else if agentReason == "dist" {
		<p class="hint">{ i18n.T(ctx, "hosts.onboarding.agent_unavailable") }</p>
	} else if agentReason == "insecure" {
		<p class="hint">{ i18n.T(ctx, "hosts.onboarding.agent_insecure") }</p>
	}
	<details>
		<summary>{ i18n.T(ctx, "hosts.settings.show_config") }</summary>
		if config != "" {
			@copyBlock(id, "hosts.copy.button", config)
		} else {
			<p class="hint">
				{ i18n.T(ctx, "hosts.onboarding.no_key") }
				<a href={ templ.URL(projectSettingsPath(projectID)) }>{ i18n.T(ctx, "hosts.onboarding.no_key_link") }</a>
			</p>
		}
	</details>
}

// installCmd и collectorCfg пустые одновременно — ключа agent в проекте нет
// вовсе; если только installCmd пуст, agentReason объясняет, почему путь агента недоступен.
templ hostsOnboarding(projectID int64, installCmd, collectorCfg, agentReason string) {
	<section class="card">
		<h2 class="card-header">{ i18n.T(ctx, "hosts.onboarding.title") }</h2>
		<ol>
			<li>
				<p>{ i18n.T(ctx, "hosts.onboarding.agent_title") }</p>
				if installCmd != "" {
					@copyBlock("hosts-onboarding-agent-cmd", "hosts.copy.command", installCmd)
					<p class="hint">{ i18n.T(ctx, "hosts.onboarding.agent_update_note") }</p>
				} else if agentReason == "dist" {
					<p class="hint">{ i18n.T(ctx, "hosts.onboarding.agent_unavailable") }</p>
				} else if agentReason == "insecure" {
					<p class="hint">{ i18n.T(ctx, "hosts.onboarding.agent_insecure") }</p>
				} else {
					<p class="hint">
						{ i18n.T(ctx, "hosts.onboarding.no_key") }
						<a href={ templ.URL(projectSettingsPath(projectID)) }>{ i18n.T(ctx, "hosts.onboarding.no_key_link") }</a>
					</p>
				}
			</li>
			<li>
				<p>{ i18n.T(ctx, "hosts.onboarding.agent_step") }</p>
				<p class="hint">
					{ i18n.T(ctx, "hosts.onboarding.agent_platforms") }
					<a href="/docs/hosts">{ i18n.T(ctx, "hosts.onboarding.docs_link") }</a>
				</p>
			</li>
		</ol>
		<details>
			<summary>{ i18n.T(ctx, "hosts.onboarding.collector_alt") }</summary>
			<ol>
				<li>
					<p>{ i18n.T(ctx, "hosts.onboarding.step1") } <a href="/docs/hosts">{ i18n.T(ctx, "hosts.onboarding.docs_link") }</a></p>
				</li>
				<li>
					<p>{ i18n.T(ctx, "hosts.onboarding.step2") }</p>
					if collectorCfg != "" {
						@copyBlock("hosts-onboarding-collector-config", "hosts.copy.button", collectorCfg)
					} else {
						<p class="hint">
							{ i18n.T(ctx, "hosts.onboarding.no_key") }
							<a href={ templ.URL(projectSettingsPath(projectID)) }>{ i18n.T(ctx, "hosts.onboarding.no_key_link") }</a>
						</p>
					}
				</li>
				<li>
					<p>{ i18n.T(ctx, "hosts.onboarding.step3") }</p>
					<pre>sudo systemctl enable --now otelcol-contrib</pre>
				</li>
			</ol>
		</details>
	</section>
}
