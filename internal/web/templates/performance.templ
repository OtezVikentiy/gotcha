package templates

import (
	"context"
	"net/url"
	"strconv"
	"strings"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/trace"
)

func performancePath(projectID int64) string {
	return "/projects/" + strconv.FormatInt(projectID, 10) + "/performance"
}

// имя транзакции недоверенное, может содержать «/» — PathEscape держит его одним сегментом пути.
// обработчик декодирует обратно через url.PathUnescape.
func endpointPath(projectID int64, transaction string) string {
	return performancePath(projectID) + "/" + url.PathEscape(transaction)
}

type PerfFilter struct {
	Range       TimeRangeVM
	Environment string
	Sort        string
}

// совпадает с sortEndpointStats/sortVitalPages: имя/apdex по возрастанию, метрики — по убыванию.
// CSS рисует стрелку через ::after по этому же атрибуту — не менять его отдельно от направления.
func sortAria(active, col string) string {
	if active != col {
		return "none"
	}
	if col == "name" || col == "apdex" {
		return "ascending"
	}
	return "descending"
}

func perfListSortURL(projectID int64, f PerfFilter, sort string) string {
	q := url.Values{}
	f.Range.apply(q)
	if f.Environment != "" {
		q.Set("environment", f.Environment)
	}
	q.Set("sort", sort)
	return performancePath(projectID) + "?" + q.Encode()
}

func formatDurationUS(us uint32) string {
	switch {
	case us < 1000:
		return strconv.FormatUint(uint64(us), 10) + "µs"
	case us < 1_000_000:
		return strconv.FormatFloat(float64(us)/1000, 'f', 1, 64) + "ms"
	default:
		return strconv.FormatFloat(float64(us)/1_000_000, 'f', 2, 64) + "s"
	}
}

// фиксированные «в минуту» давали «0.0/min» при малом трафике — единица подбирается по величине.
func formatThroughput(ctx context.Context, perMin float64) string {
	switch {
	case perMin >= 1:
		return strconv.FormatFloat(perMin, 'f', 1, 64) + i18n.T(ctx, "perf.per_min")
	case perMin*60 >= 1:
		return strconv.FormatFloat(perMin*60, 'f', 1, 64) + i18n.T(ctx, "perf.per_hour")
	default:
		return strconv.FormatFloat(perMin*60*24, 'f', 1, 64) + i18n.T(ctx, "perf.per_day")
	}
}

// пусто быть не должно — подстраховка прочерком.
func envList(envs []string) string {
	if len(envs) == 0 {
		return "—"
	}
	return strings.Join(envs, ", ")
}

func formatFailureRate(rate float64) string {
	return strconv.FormatFloat(rate*100, 'f', 1, 64) + "%"
}

func formatApdex(score float64) string {
	return strconv.FormatFloat(score, 'f', 2, 64)
}

// спарклайн p95 уже собран в web/performance.go — тот же приём, что у MonitorRow.
type EndpointRow struct {
	Stat      trace.EndpointStat
	Sparkline templ.Component
}

// native title, без JS — пунктир и курсор-help подсказывают, что на метрику можно навести.
templ metricHead(labelKey, helpKey string) {
	<abbr class="metric-abbr" title={ i18n.T(ctx, helpKey) }>{ i18n.T(ctx, labelKey) }</abbr>
}

templ perfEnvOption(value, label, selected string) {
	if value == selected {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

// total — полное число до усечения списка (len(rows) — показанные).
// loadFailed — ClickHouse не ответил: фильтры на месте, вместо таблицы «данные временно недоступны».
// capped — само окно несёт больше endpointsRowCap транзакций: total тоже неполон, не только rows.
templ PerformanceList(projectID int64, rows []EndpointRow, total int, filter PerfFilter, environments []string, apdexT int, cardinality []CardinalityNotice, userEmail string, loadFailed bool, capped bool) {
	// раздел называется «Транзакции» везде (рейл/сайдбар/h1/title/крошки).
	// «Эндпойнты» (perf.endpoints) — термин данных, не имя раздела.
	@layout(i18n.T(ctx, "nav.transactions"), userEmail) {
		<div class="performance">
			<h1>{ i18n.T(ctx, "nav.transactions") }</h1>
			@helpPanel("performance", "performance")
			// предупреждение о кардинальности — здесь, не в логах: тут видно, что часть имён пропала.
			if len(cardinality) > 0 {
				@helpPanel("cardinality", "cardinality")
			}
			@cardinalityNoticeView(cardinality)
			<form method="get" action={ templ.URL(performancePath(projectID)) } class="performance-filters">
				<select name="environment" class="select" aria-label={ i18n.T(ctx, "filter.environment") }>
					@perfEnvOption("", i18n.T(ctx, "perf.filter.env_all"), filter.Environment)
					for _, env := range environments {
						@perfEnvOption(env, env, filter.Environment)
					}
				</select>
				@timeRangeFields(filter.Range)
				if filter.Sort != "" {
					<input type="hidden" name="sort" value={ filter.Sort }/>
				}
				<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "perf.filter.apply") }</button>
			</form>
			if loadFailed {
				@emptyState("zap", "perf.error.title", "perf.error.body", "", "", 2)
			} else if len(rows) == 0 {
				@emptyState("zap", "perf.empty.title", "perf.empty.body", "perf.empty.cta", "/docs/performance", 2)
			} else {
				<p class="apdex-note">{ i18n.Tf(ctx, "perf.apdex_note", "t", strconv.Itoa(apdexT)) }</p>
				if capped {
					<p class="perf-cap-note">{ i18n.T(ctx, "perf.endpoints.capped") }</p>
				} else if total > len(rows) {
					<p class="perf-cap-note">{ i18n.Tf(ctx, "perf.truncated", "shown", strconv.Itoa(len(rows)), "total", strconv.Itoa(total)) }</p>
				}
				<div class="card">
				@scrollRegion("table-scroll", "perf.endpoints") {
					<table class="data-table">
						<thead>
							<tr>
								<th scope="col" aria-sort={ sortAria(filter.Sort, "name") }><a href={ templ.URL(perfListSortURL(projectID, filter, "name")) }>{ i18n.T(ctx, "perf.endpoint") }</a></th>
								<th scope="col">{ i18n.T(ctx, "perf.environment") }</th>
								<th scope="col" class="num">@metricHead("perf.events", "perf.help.events")</th>
								<th scope="col" class="num" aria-sort={ sortAria(filter.Sort, "throughput") }><a href={ templ.URL(perfListSortURL(projectID, filter, "throughput")) }>@metricHead("perf.throughput", "perf.help.throughput")</a></th>
								<th scope="col" class="num" aria-sort={ sortAria(filter.Sort, "p50") }><a href={ templ.URL(perfListSortURL(projectID, filter, "p50")) }>@metricHead("perf.p50", "perf.help.p50")</a></th>
								<th scope="col" class="num" aria-sort={ sortAria(filter.Sort, "p75") }><a href={ templ.URL(perfListSortURL(projectID, filter, "p75")) }>@metricHead("perf.p75", "perf.help.p75")</a></th>
								<th scope="col" class="num" aria-sort={ sortAria(filter.Sort, "p95") }><a href={ templ.URL(perfListSortURL(projectID, filter, "p95")) }>@metricHead("perf.p95", "perf.help.p95")</a></th>
								<th scope="col" class="num" aria-sort={ sortAria(filter.Sort, "p99") }><a href={ templ.URL(perfListSortURL(projectID, filter, "p99")) }>@metricHead("perf.p99", "perf.help.p99")</a></th>
								<th scope="col" class="num" aria-sort={ sortAria(filter.Sort, "failure") }><a href={ templ.URL(perfListSortURL(projectID, filter, "failure")) }>@metricHead("perf.failure", "perf.help.failure")</a></th>
								<th scope="col" class="num" aria-sort={ sortAria(filter.Sort, "apdex") }><a href={ templ.URL(perfListSortURL(projectID, filter, "apdex")) }>@metricHead("perf.apdex", "perf.help.apdex")</a></th>
								<th scope="col">@metricHead("perf.p95_period", "perf.help.p95_period")</th>
							</tr>
						</thead>
						<tbody>
							for _, row := range rows {
								<tr>
									<td><a href={ templ.URL(endpointPath(projectID, row.Stat.Transaction)) }>{ row.Stat.Transaction }</a></td>
									<td>{ envList(row.Stat.Environments) }</td>
									<td class="num">{ strconv.FormatUint(row.Stat.Count, 10) }</td>
									<td class="num">{ formatThroughput(ctx, row.Stat.Throughput) }</td>
									<td class="num">{ formatDurationUS(row.Stat.P50) }</td>
									<td class="num">{ formatDurationUS(row.Stat.P75) }</td>
									<td class="num">{ formatDurationUS(row.Stat.P95) }</td>
									<td class="num">{ formatDurationUS(row.Stat.P99) }</td>
									<td class="num">{ formatFailureRate(row.Stat.FailureRate) }</td>
									<td class="num">{ formatApdex(row.Stat.ApdexScore) }</td>
									<td>@row.Sparkline</td>
								</tr>
							}
						</tbody>
					</table>
				}
				</div>
			}
		</div>
	}
}
