package templates

import (
	"net/url"
	"strconv"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/log"
	"gitflic.ru/otezvikentiy/gotcha/internal/logfilter"
)

// Экспортированные обёртки над unexported logsPath/logsURLFromValues — путь строится в одном месте.
func LogsPath(projectID int64) string {
	return logsPath(projectID)
}

func LogsURLFromValues(projectID int64, q url.Values) string {
	return logsURLFromValues(projectID, q)
}

type LogSavedFilterRow struct {
	Filter    logfilter.Filter
	CanEdit   bool
	IsDefault bool
}

type LogSavedFiltersPanel struct {
	Personal []LogSavedFilterRow
	Shared   []LogSavedFilterRow
	CanShare bool
}

func logSavedFiltersCreateURL(projectID int64) string {
	return LogsPath(projectID) + "/filters"
}

func logSavedFilterUpdateURL(projectID, filterID int64) string {
	return logSavedFilterActionURL(projectID, filterID, "update")
}

func logSavedFilterDeleteURL(projectID, filterID int64) string {
	return logSavedFilterActionURL(projectID, filterID, "delete")
}

func logSavedFilterDefaultURL(projectID, filterID int64) string {
	return logSavedFilterActionURL(projectID, filterID, "default")
}

func logSavedFilterActionURL(projectID, filterID int64, action string) string {
	return logSavedFiltersCreateURL(projectID) + "/" + strconv.FormatInt(filterID, 10) + "/" + action
}

// Поля правки живут в модалке, не инлайн в строке — иначе строка тянула .input и портила список.
func logSavedFilterEditModalID(filterID int64) string {
	return "log-filter-edit-" + strconv.FormatInt(filterID, 10)
}

// Раскладку предикатов делает общий log.ApplyPredicates, та же функция, что применяет
// сохранённый фильтр и фильтр по умолчанию в web/logs.go; отдельная копия switch'а уже расходилась.
func logSavedFilterApplyURL(projectID int64, f logfilter.Filter) string {
	var lf log.ListFilter
	log.ApplyPredicates(&lf, f.Predicates)
	vm := LogsFilter{
		Severity:    lf.Severity,
		Service:     lf.Service,
		Environment: lf.Environment,
		Query:       lf.Query,
		Attrs:       lf.Attrs,
		TraceID:     lf.TraceID,
		Not:         lf.Not,
	}
	return logsURLFromValues(projectID, logsPageURLValues(vm))
}

// Переиспользуется формой «Сохранить» и формой «Обновить» — то же имя параметров, что читает
// web.logFilterFormParams. severity/service/environment/q не сюда: это живые поля GET-формы.
templ logFilterConditionFields(filter LogsFilter) {
	for _, sv := range filter.Severity {
		<input type="hidden" name="severity" value={ sv }/>
	}
	if filter.Service != "" {
		<input type="hidden" name="service" value={ filter.Service }/>
	}
	if filter.Environment != "" {
		<input type="hidden" name="environment" value={ filter.Environment }/>
	}
	if filter.Query != "" {
		<input type="hidden" name="q" value={ filter.Query }/>
	}
	@logFilterHiddenChipFields(filter)
}

// Чекбокс «сделать общим» — только для тех, у кого есть право; веб-слой проверяет его реально.
templ logSavedFilterSaveForm(projectID int64, filter LogsFilter, canShare bool) {
	<form method="post" action={ templ.URL(logSavedFiltersCreateURL(projectID)) } class="logs-saved-filter-save">
		<input type="text" name="name" class="input" placeholder={ i18n.T(ctx, "logs.savedfilters.name_placeholder") } aria-label={ i18n.T(ctx, "logs.savedfilters.name_placeholder") } maxlength="60" required/>
		@logFilterConditionFields(filter)
		if canShare {
			<label class="checkbox-inline">
				<input type="checkbox" name="shared" value="1"/>
				{ i18n.T(ctx, "logs.savedfilters.shared_checkbox") }
			</label>
		}
		<button type="submit" class="btn btn-ghost">{ i18n.T(ctx, "logs.savedfilters.save") }</button>
	</form>
}

// Поля правки — в модалке, иначе строка тянула .input и подпись чекбокса, переставая быть строкой.
// «Сделать умолчанием» видит любой с доступом к фильтру; «Изменить»/«Удалить» — только CanEdit.
templ logSavedFilterRow(projectID int64, filter LogsFilter, row LogSavedFilterRow, canShare bool) {
	<li class="logs-saved-filter-item">
		<span class="logs-saved-filter-name">
			if row.Filter.Applicable {
				<a href={ templ.URL(logSavedFilterApplyURL(projectID, row.Filter)) }>{ row.Filter.Name }</a>
			} else {
				<span class="logs-saved-filter-inapplicable">{ row.Filter.Name }</span>
				<span class="hint">{ i18n.T(ctx, "logs.savedfilters.not_applicable") }</span>
			}
			if row.IsDefault {
				<span class="badge badge-neutral">{ i18n.T(ctx, "logs.savedfilters.default_badge") }</span>
			}
		</span>
		<span class="logs-saved-filter-actions">
			if !row.IsDefault {
				<form method="post" action={ templ.URL(logSavedFilterDefaultURL(projectID, row.Filter.ID)) } class="logs-saved-filter-inline-form">
					<button type="submit" class="btn btn-ghost">{ i18n.T(ctx, "logs.savedfilters.make_default") }</button>
				</form>
			}
			if row.CanEdit {
				<a class="btn btn-ghost" href={ templ.SafeURL("#" + logSavedFilterEditModalID(row.Filter.ID)) }>{ i18n.T(ctx, "logs.savedfilters.edit") }</a>
				<form method="post" action={ templ.URL(logSavedFilterDeleteURL(projectID, row.Filter.ID)) } class="logs-saved-filter-inline-form">
					// Без условий текущего вида web.logFilterFormParams видит пустую форму, и редирект после
					// удаления уходит на голый /logs, теряя набранные вручную исключения.
					@logFilterConditionFields(filter)
					<button type="submit" class="btn btn-danger-ghost">{ i18n.T(ctx, "logs.savedfilters.delete") }</button>
				</form>
			}
		</span>
		if row.CanEdit {
			@logSavedFilterEditModal(projectID, filter, row, canShare)
		}
	</li>
}

// Модалка не переоткрывается сервером при ошибке — отказ рисуется над списком, панель раскрыта.
// Переключатель видимости — только при canShare; requireLogFilterOperator перепроверяет на сервере.
templ logSavedFilterEditModal(projectID int64, filter LogsFilter, row LogSavedFilterRow, canShare bool) {
	@createModalOpen(logSavedFilterEditModalID(row.Filter.ID), "logs.savedfilters.edit.title", false, false) {
		<form method="post" action={ templ.URL(logSavedFilterUpdateURL(projectID, row.Filter.ID)) } class="logs-saved-filter-edit-form">
			<div class="field">
				<label>
					{ i18n.T(ctx, "logs.savedfilters.name_placeholder") }
					<input type="text" name="name" class="input" value={ row.Filter.Name } maxlength="60" required/>
				</label>
			</div>
			@logFilterConditionFields(filter)
			if canShare {
				<div class="field">
					<label class="checkbox-inline">
						<input type="checkbox" name="shared" value="1" checked?={ row.Filter.Shared() }/>
						{ i18n.T(ctx, "logs.savedfilters.shared_checkbox") }
					</label>
				</div>
			} else if row.Filter.Shared() {
				<input type="hidden" name="shared" value="1"/>
			}
			<p class="hint">{ i18n.T(ctx, "logs.savedfilters.update_title") }</p>
			<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "logs.savedfilters.update") }</button>
		</form>
	}
}

// Счётчик в свёрнутом заголовке — иначе панель выглядит одинаково и пустой, и полной.
templ logSavedFiltersSection(projectID int64, filter LogsFilter, panel LogSavedFiltersPanel, errMsg string) {
	{{ total := len(panel.Personal) + len(panel.Shared) }}
	<details class="card logs-saved-filters" open?={ errMsg != "" }>
		<summary>
			{ i18n.T(ctx, "logs.savedfilters.title") }
			if total > 0 {
				<span class="logs-saved-filters-count">{ strconv.Itoa(total) }</span>
			}
		</summary>
		<div class="logs-saved-filters-body">
			if errMsg != "" {
				<p class="error">{ errMsg }</p>
			}
			<div class="logs-saved-filters-groups">
				<div class="logs-saved-filters-group">
					<h3>{ i18n.T(ctx, "logs.savedfilters.personal") }</h3>
					if len(panel.Personal) == 0 {
						<p class="hint">{ i18n.T(ctx, "logs.savedfilters.empty") }</p>
					} else {
						<ul class="logs-saved-filters-list">
							for _, row := range panel.Personal {
								@logSavedFilterRow(projectID, filter, row, panel.CanShare)
							}
						</ul>
					}
				</div>
				<div class="logs-saved-filters-group">
					<h3>{ i18n.T(ctx, "logs.savedfilters.shared") }</h3>
					if len(panel.Shared) == 0 {
						<p class="hint">{ i18n.T(ctx, "logs.savedfilters.empty") }</p>
					} else {
						<ul class="logs-saved-filters-list">
							for _, row := range panel.Shared {
								@logSavedFilterRow(projectID, filter, row, panel.CanShare)
							}
						</ul>
					}
				</div>
			</div>
			@logSavedFilterSaveForm(projectID, filter, panel.CanShare)
		</div>
	</details>
}
