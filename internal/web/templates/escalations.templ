package templates

import (
	"context"
	"fmt"
	"net/url"
	"strconv"
	"strings"
	"unicode"
	"unicode/utf8"

	"gitflic.ru/otezvikentiy/gotcha/internal/alert"
	"gitflic.ru/otezvikentiy/gotcha/internal/escalation"
	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
)

func EscalationsPath(projectID int64) string {
	return "/projects/" + strconv.FormatInt(projectID, 10) + "/escalations"
}

type EscalationStepForm struct {
	StepNo       int
	DelayMinutes string
	Selected     map[int64]bool
}

type EscalationLadderForm struct {
	Severity string
	Steps    []EscalationStepForm
}

func stepDelayField(stepNo int) string    { return fmt.Sprintf("step%d_delay", stepNo) }
func stepChannelsField(stepNo int) string { return fmt.Sprintf("step%d_channels", stepNo) }

func escalationSeverityTitle(ctx context.Context, severity string) string {
	if severity == escalation.SeverityWarning {
		return i18n.T(ctx, "escalations.severity.warning")
	}
	return i18n.T(ctx, "escalations.severity.critical")
}

func hasDeliverableChannel(channels []alert.Channel) bool {
	for _, c := range channels {
		if c.Deliverable() {
			return true
		}
	}
	return false
}

// target вебхука маскируется (maskedWebhookTarget) — иначе секрет виден на
// каждом скриншоте; у email/telegram секретов в адресе нет.
func escalationChannelDisplay(ctx context.Context, c alert.Channel) string {
	target := c.Target
	if c.Kind == alert.ChannelWebhook {
		target = maskedWebhookTarget(c.Target)
	}
	return channelKindLabel(ctx, c.Kind) + ": " + target
}

// пороги (20 рун; 10 рун со смесью букв и цифр; 6 рун в последнем сегменте)
// подобраны под реальные вебхуки — менять не глядя в TestSecretLikeSegment рискованно.
func secretLikeSegment(seg string, last bool) bool {
	if strings.Contains(seg, "…") {
		return false
	}
	r := []rune(seg)
	if len(r) >= 20 {
		return true
	}
	hasLetter, hasDigit := false, false
	for _, c := range r {
		switch {
		case unicode.IsLetter(c):
			hasLetter = true
		case unicode.IsDigit(c):
			hasDigit = true
		}
	}
	if last {
		return len(r) >= 6 && hasDigit
	}
	return len(r) >= 10 && hasLetter && hasDigit
}

// при схлопывании длинного результата первый и последний сегмент остаются:
// начало говорит о сервисе, конец различает вебхуки.
func maskedWebhookTarget(target string) string {
	const (
		tailRunes            = 6
		secretTailRunes      = 4
		maskedTargetMaxRunes = 60
	)
	u, err := url.Parse(target)
	if err != nil || u.Host == "" {
		// Не URL: validateChannel такой Target не пропускает, ветка чисто
		// защитная — хоста нет, показываем только хвост.
		r := []rune(target)
		if len(r) <= tailRunes {
			return target
		}
		return "…" + string(r[len(r)-tailRunes:])
	}
	suffix := ""
	if u.RawQuery != "" || u.Fragment != "" {
		suffix = "?…"
	}
	if u.Path == "" {
		return u.Host + suffix
	}
	segs := strings.Split(strings.TrimPrefix(u.Path, "/"), "/")
	// с поправкой на завершающий слэш (Zapier пишет ключ с «/» на конце) —
	// пустые хвостовые сегменты не считаются последним.
	lastIdx := len(segs) - 1
	for lastIdx > 0 && segs[lastIdx] == "" {
		lastIdx--
	}
	parts := make([]string, 0, len(segs))
	for i, seg := range segs {
		if secretLikeSegment(seg, i == lastIdx) {
			r := []rune(seg)
			// Хвост — не больше половины секрета: у короткого ключа
			// (6–7 рун) обычные 4 руны хвоста открывали бы две трети.
			tail := secretTailRunes
			if len(r)/2 < tail {
				tail = len(r) / 2
			}
			parts = append(parts, "…"+string(r[len(r)-tail:]))
		} else {
			parts = append(parts, seg)
		}
	}
	display := u.Host + "/" + strings.Join(parts, "/") + suffix
	if utf8.RuneCountInString(display) > maskedTargetMaxRunes && len(parts) > 2 {
		display = u.Host + "/" + parts[0] + "/…/" + parts[len(parts)-1] + suffix
	}
	return display
}

// канал, удалённый после того, как лесенка на него сослалась, молча пропускается.
func escalationChannelLabels(ctx context.Context, ids []int64, channels []alert.Channel) string {
	byID := make(map[int64]alert.Channel, len(channels))
	for _, c := range channels {
		byID[c.ID] = c
	}
	var parts []string
	for _, id := range ids {
		if c, ok := byID[id]; ok {
			parts = append(parts, escalationChannelDisplay(ctx, c))
		}
	}
	if len(parts) == 0 {
		return i18n.T(ctx, "escalations.dryrun.no_channels")
	}
	return strings.Join(parts, ", ")
}

func escalationDryRunStepText(ctx context.Context, step escalation.Step, channels []alert.Channel) string {
	chans := escalationChannelLabels(ctx, step.ChannelIDs, channels)
	no := strconv.Itoa(step.StepNo + 1)
	if step.DelayMinutes == 0 {
		return i18n.Tf(ctx, "escalations.dryrun.step_immediate", "step", no, "channels", chans)
	}
	return i18n.Tf(ctx, "escalations.dryrun.step_delayed", "step", no, "minutes", strconv.Itoa(step.DelayMinutes), "channels", chans)
}

templ escalationDryRun(ladder escalation.Ladder, channels []alert.Channel) {
	<div class="escalation-dryrun card">
		<h3 class="card-header">{ i18n.T(ctx, "escalations.dryrun.title") }</h3>
		<ul class="escalation-dryrun-list">
			for _, step := range ladder {
				<li>{ escalationDryRunStepText(ctx, step, channels) }</li>
			}
		</ul>
		<p class="hint">{ i18n.T(ctx, "escalations.dryrun.recovery") }</p>
	</div>
}

func escalationUndeliverableReasonKey(c alert.Channel) string {
	if !c.Enabled {
		return "escalations.field.channel_disabled"
	}
	return "escalations.field.channel_broken"
}

// чекбокс недоставляемого, но уже выбранного канала — НЕ disabled: disabled-
// инпут не попадает в POST, и обычное «Сохранить» тихо стёрло бы канал.
templ escalationStepFields(step EscalationStepForm, channels []alert.Channel) {
	<fieldset class="escalation-step card">
		<legend class="card-header">{ i18n.Tf(ctx, "escalations.step.legend", "no", strconv.Itoa(step.StepNo+1)) }</legend>
		<div class="field">
			<label>
				{ i18n.T(ctx, "escalations.field.delay") }
				<input type="number" class="input" name={ stepDelayField(step.StepNo) } value={ step.DelayMinutes } min="0"/>
			</label>
		</div>
		<div class="field checkbox-field" role="group" aria-label={ i18n.T(ctx, "escalations.field.channels") }>
			<span class="field-label" aria-hidden="true">{ i18n.T(ctx, "escalations.field.channels") }</span>
			for _, c := range channels {
				if c.Deliverable() || step.Selected[c.ID] {
					<label class="checkbox-inline">
						<input type="checkbox" name={ stepChannelsField(step.StepNo) } value={ strconv.FormatInt(c.ID, 10) } checked?={ step.Selected[c.ID] }/>
						{ escalationChannelDisplay(ctx, c) }
						if !c.Deliverable() {
							<span class="badge badge-warn">{ i18n.T(ctx, escalationUndeliverableReasonKey(c)) }</span>
						}
					</label>
				}
			}
		</div>
	</fieldset>
}

templ escalationSeveritySection(projectID int64, form EscalationLadderForm, channels []alert.Channel, ladder escalation.Ladder, showErr bool, errMsg string) {
	<section class="escalations-section card">
		<h2>{ escalationSeverityTitle(ctx, form.Severity) }</h2>
		if showErr && errMsg != "" {
			<p class="error">{ errMsg }</p>
		}
		if !hasDeliverableChannel(channels) {
			<p class="hint">{ i18n.T(ctx, "escalations.field.channels_none") }</p>
		}
		// объединены на лесенку, чтобы не повторять полную фразу на каждой ступени.
		<p class="notice">{ i18n.T(ctx, "escalations.field.steps_hint") } { i18n.T(ctx, "escalations.field.delay_hint") }</p>
		<p class="hint">{ i18n.T(ctx, "escalations.default_notice") }</p>
		<form method="post" action={ templ.URL(EscalationsPath(projectID)) } class="escalation-ladder-form">
			<input type="hidden" name="severity" value={ form.Severity }/>
			<div class="escalation-steps">
				for _, step := range form.Steps {
					@escalationStepFields(step, channels)
				}
			</div>
			<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "escalations.form.submit") }</button>
		</form>
		@escalationDryRun(ladder, channels)
	</section>
}

// critical/warning — вью-модель формы: из ladders на GET, из отправленного
// непринятого запроса — для упавшей на 422 severity.
templ Escalations(projectID int64, channels []alert.Channel, critical, warning EscalationLadderForm, ladders map[string]escalation.Ladder, failedSeverity, errMsg, userEmail string) {
	@layout(i18n.T(ctx, "escalations.title"), userEmail) {
		<div class="escalations">
			<h1>{ i18n.T(ctx, "escalations.title") }</h1>
			@helpPanelWith("escalations", "escalations") {
				<p>{ i18n.T(ctx, "escalations.intro") }</p>
				<p>{ i18n.T(ctx, "escalations.uptime_note") }</p>
				<p>{ i18n.T(ctx, "escalations.issue_note") }</p>
			}
			@escalationSeveritySection(projectID, critical, channels, ladders[escalation.SeverityCritical], failedSeverity == escalation.SeverityCritical, errMsg)
			@escalationSeveritySection(projectID, warning, channels, ladders[escalation.SeverityWarning], failedSeverity == escalation.SeverityWarning, errMsg)
		</div>
	}
}
