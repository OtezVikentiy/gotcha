package templates

import (
	"net/url"
	"strconv"
	"time"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
)

type TraceWaterfallData struct {
	ProjectID   int64
	TraceID     string
	Transaction string
	TotalUS     uint32
	Timestamp   time.Time

	Waterfall templ.Component
	ShownRows int
	TotalRows int
	// true — есть профиль для этого трейса, рисуем ссылку на flamegraph.
	HasProfile bool
	// пусто — прямой заход, возвращаем в список транзакций.
	From           string
	FromID         int64
	FromTransaction string
}

func traceFlamePath(traceID string) string {
	return "/traces/" + traceID + "/flame"
}

// трейс открывают из трёх мест — без пометки крошка всегда вела бы в «Транзакции», не туда, откуда пришли.
// origin/originID проверяются на сервере (traceOrigin, web/trace.go).
func tracePathFrom(traceID, origin, originID string) string {
	u := "/traces/" + url.PathEscape(traceID) + "?from=" + url.QueryEscape(origin)
	if originID != "" {
		u += "&from_id=" + url.QueryEscape(originID)
	}
	return u
}

templ TraceWaterfall(d TraceWaterfallData, userEmail string) {
	@layout(d.Transaction, userEmail) {
		<div class="trace-detail">
			switch d.From {
				case "perf-issue":
					@breadcrumbBack(templ.URL(perfIssuePath(d.FromID)), i18n.T(ctx, "nav.perf_issues"))
				case "issue":
					@breadcrumbBack(templ.URL(issueDetailPath(d.FromID)), i18n.T(ctx, "nav.issues"))
				case "endpoint":
					@breadcrumbBack(templ.URL(endpointPath(d.ProjectID, d.FromTransaction)), i18n.T(ctx, "nav.transactions"))
				default:
					// подпись «Транзакции», не «Производительность» — она должна называть то место, куда ведёт.
					@breadcrumbBack(templ.URL(performancePath(d.ProjectID)), i18n.T(ctx, "nav.transactions"))
			}
			<h1>{ d.Transaction }</h1>
			<div class="monitor-meta">
				<div class="stat-tile">
					<div class="stat-label">{ i18n.T(ctx, "trace.field.trace_id") }</div>
					<div class="stat-value">{ d.TraceID }</div>
				</div>
				<div class="stat-tile">
					<div class="stat-label">{ i18n.T(ctx, "trace.field.duration") }</div>
					<div class="stat-value">{ formatDurationUS(d.TotalUS) }</div>
				</div>
				<div class="stat-tile">
					<div class="stat-label">{ i18n.T(ctx, "trace.field.when") }</div>
					<div class="stat-value">@relativeTime(d.Timestamp)</div>
				</div>
			</div>
			if d.HasProfile {
				<p class="trace-actions"><a class="btn btn-ghost" href={ templ.URL(traceFlamePath(d.TraceID)) }>{ i18n.T(ctx, "trace.view_flamegraph") }</a></p>
			}
			<p class="trace-actions"><a class="btn btn-ghost" href={ templ.URL(logsForTracePath(d.ProjectID, d.TraceID, d.Timestamp, d.TotalUS)) }>{ i18n.T(ctx, "trace.view_logs") }</a></p>
			if d.TotalRows > d.ShownRows {
				<p class="trace-cap-note">{ i18n.Tf(ctx, "trace.truncated", "shown", strconv.Itoa(d.ShownRows), "total", strconv.Itoa(d.TotalRows)) }</p>
			}
			@scrollRegion("card trace-waterfall", "region.trace.waterfall") {
				@d.Waterfall
			}
		</div>
	}
}

// трейс существует, но spans пусты — waterfall рисовать нечем.
// не «страницы нет» (обычный notFound) — отдельное осмысленное состояние с кодом 404.
type TraceExpiredData struct {
	ProjectID int64
	TraceID   string

	// h.SpanRetentionDays (настраивается в проде), не trace.SpanRetentionDays — дефолт может отличаться.
	// <=0 — TTL не задан (хранится вечно): текст про число дней был бы враньём.
	RetentionDays int

	// true — спаны не доехали (буфер писателя под нагрузкой), а не истёк TTL:
	// транзакция моложе окна хранения спанов, объяснять её сроком хранения нечестно.
	Dropped bool

	// та же семантика, что в TraceWaterfallData — состояние одно и то же независимо от источника ссылки.
	From            string
	FromID          int64
	FromTransaction string
}

// handler отдаёт эту страницу с HTTP-статусом 404, не 200.
templ TraceExpired(d TraceExpiredData, userEmail string) {
	@layout(d.TraceID, userEmail) {
		<div class="trace-detail">
			switch d.From {
				case "perf-issue":
					@breadcrumbBack(templ.URL(perfIssuePath(d.FromID)), i18n.T(ctx, "nav.perf_issues"))
				case "issue":
					@breadcrumbBack(templ.URL(issueDetailPath(d.FromID)), i18n.T(ctx, "nav.issues"))
				case "endpoint":
					@breadcrumbBack(templ.URL(endpointPath(d.ProjectID, d.FromTransaction)), i18n.T(ctx, "nav.transactions"))
				default:
					@breadcrumbBack(templ.URL(performancePath(d.ProjectID)), i18n.T(ctx, "nav.transactions"))
			}
			<h1>{ d.TraceID }</h1>
			<div class="empty-state">
				if d.Dropped {
					@icon("activity")
					<h2 class="empty-title">{ i18n.T(ctx, "trace.dropped.title") }</h2>
					<p>{ i18n.T(ctx, "trace.dropped.body") }</p>
				} else {
					@icon("clock")
					<h2 class="empty-title">{ i18n.T(ctx, "trace.expired.title") }</h2>
					if d.RetentionDays > 0 {
						<p>{ i18n.Tf(ctx, "trace.expired.body", "period", i18n.Tn(ctx, "unit.days", d.RetentionDays)) }</p>
					} else {
						<p>{ i18n.T(ctx, "trace.expired.body_purged") }</p>
					}
				}
			</div>
		</div>
	}
}

// ответ 200, не 404 — отказ источника данных, не отсутствие страницы (в отличие от TraceExpired).
// ProjectID==0 — крошка не рисуется: ссылка на несуществующий проект хуже её отсутствия.
templ TraceUnavailable(d TraceExpiredData, userEmail string) {
	@layout(d.TraceID, userEmail) {
		<div class="trace-detail">
			switch d.From {
				case "perf-issue":
					@breadcrumbBack(templ.URL(perfIssuePath(d.FromID)), i18n.T(ctx, "nav.perf_issues"))
				case "issue":
					@breadcrumbBack(templ.URL(issueDetailPath(d.FromID)), i18n.T(ctx, "nav.issues"))
				case "endpoint":
					if d.ProjectID != 0 {
						@breadcrumbBack(templ.URL(endpointPath(d.ProjectID, d.FromTransaction)), i18n.T(ctx, "nav.transactions"))
					}
				default:
					if d.ProjectID != 0 {
						@breadcrumbBack(templ.URL(performancePath(d.ProjectID)), i18n.T(ctx, "nav.transactions"))
					}
			}
			<h1>{ d.TraceID }</h1>
			@emptyState("activity", "trace.error.title", "trace.error.body", "", "", 2)
		</div>
	}
}

type TraceFlameData struct {
	TraceID string
	Chart   templ.Component
	// см. ProfileFlameVM.HasData.
	HasData bool
	// ClickHouse не ответил — вместо флеймграфа «данные временно недоступны», ссылка на waterfall остаётся.
	LoadFailed bool
}

templ TraceFlame(d TraceFlameData, userEmail string) {
	@layout(i18n.T(ctx, "trace.flame.title"), userEmail) {
		@scrollRegion("trace-flame", "region.trace.flame") {
			@breadcrumbBack(templ.URL("/traces/" + d.TraceID), i18n.T(ctx, "trace.waterfall_link"))
			<h1>{ i18n.T(ctx, "trace.flame.title") }</h1>
			<div class="monitor-meta">
				<div class="stat-tile">
					<div class="stat-label">{ i18n.T(ctx, "trace.field.trace_id") }</div>
					<div class="stat-value">{ d.TraceID }</div>
				</div>
			</div>
			if d.LoadFailed {
				@emptyState("activity", "trace.error.title", "trace.error.body", "", "", 2)
			} else {
				@scrollRegion("card flamegraph-wrap", "trace.flame.title") {
					@d.Chart
				}
				if d.HasData {
					<p class="hint">{ i18n.T(ctx, "profile.flame.hint") }</p>
				}
			}
		}
	}
}
