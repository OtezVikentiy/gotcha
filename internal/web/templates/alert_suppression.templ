package templates

import (
	"strconv"
	"strings"
	"time"

	"gitflic.ru/otezvikentiy/gotcha/internal/humanize"
	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
)

func AlertSuppressionPath(projectID int64) string {
	return "/projects/" + strconv.FormatInt(projectID, 10) + "/alert-suppression"
}

func alertSuppressionDeletePath(projectID, depID int64) string {
	return AlertSuppressionPath(projectID) + "/" + strconv.FormatInt(depID, 10) + "/delete"
}

func alertSuppressionUpdatePath(projectID, depID int64) string {
	return AlertSuppressionPath(projectID) + "/" + strconv.FormatInt(depID, 10)
}

const SuppressionCreateModalID = "new-suppression-edge"

func EditSuppressionEdgeModalID(depID int64) string {
	return "edit-suppression-edge-" + strconv.FormatInt(depID, 10)
}

type SuppressionEdgeView struct {
	ID          int64
	ParentLabel string
	ChildLabel  string
	Defaults    FormState
}

type SuppressionNodeOption struct {
	ID   int64
	Name string
}

type SuppressionPreviewView struct {
	ParentLabel string
	Children    []string
}

templ suppressionNodeOptions(opts []SuppressionNodeOption, selected string) {
	for _, o := range opts {
		<option value={ strconv.FormatInt(o.ID, 10) } selected?={ strconv.FormatInt(o.ID, 10) == selected }>{ o.Name }</option>
	}
}

func suppressionFormValues(form FormState, open bool, fallback FormState) FormState {
	if open {
		return form
	}
	return fallback
}

// id у полей нет: фрагмент рендерится в N+1 модалках одной страницы,
// одинаковый id дал бы дубли в документе.
templ suppressionEdgeFields(form FormState, hosts, monitors []SuppressionNodeOption) {
	<fieldset class="field">
		<legend class="field-label">{ i18n.T(ctx, "alert_suppression.field.parent_kind") }</legend>
		<div class="segmented">
			<label>
				<input type="radio" name="parent_kind" value="host" checked?={ form.Get("parent_kind", "host") == "host" }/>
				{ i18n.T(ctx, "alert_suppression.kind.host") }
			</label>
			<label>
				<input type="radio" name="parent_kind" value="monitor" checked?={ form.Get("parent_kind", "host") == "monitor" }/>
				{ i18n.T(ctx, "alert_suppression.kind.monitor") }
			</label>
		</div>
	</fieldset>
	<div class="form-grid">
		<div class="field as-parent-host">
			<label>
				{ i18n.T(ctx, "alert_suppression.field.parent_host") }
				<select name="parent_host_id" class="select" aria-label={ i18n.T(ctx, "alert_suppression.field.parent_host") }>
					@suppressionNodeOptions(hosts, form.Get("parent_host_id", ""))
				</select>
			</label>
		</div>
		<div class="field as-parent-monitor">
			<label>
				{ i18n.T(ctx, "alert_suppression.field.parent_monitor") }
				<select name="parent_monitor_id" class="select" aria-label={ i18n.T(ctx, "alert_suppression.field.parent_monitor") }>
					@suppressionNodeOptions(monitors, form.Get("parent_monitor_id", ""))
				</select>
			</label>
		</div>
	</div>
	<fieldset class="field">
		<legend class="field-label">{ i18n.T(ctx, "alert_suppression.field.child_kind") }</legend>
		<div class="segmented">
			<label>
				<input type="radio" name="child_kind" value="host" checked?={ form.Get("child_kind", "host") == "host" }/>
				{ i18n.T(ctx, "alert_suppression.kind.host") }
			</label>
			<label>
				<input type="radio" name="child_kind" value="monitor" checked?={ form.Get("child_kind", "host") == "monitor" }/>
				{ i18n.T(ctx, "alert_suppression.kind.monitor") }
			</label>
			<label>
				<input type="radio" name="child_kind" value="label" checked?={ form.Get("child_kind", "host") == "label" }/>
				{ i18n.T(ctx, "alert_suppression.kind.label") }
			</label>
		</div>
	</fieldset>
	<div class="form-grid">
		<div class="field as-child-host">
			<label>
				{ i18n.T(ctx, "alert_suppression.field.child_host") }
				<select name="child_host_id" class="select" aria-label={ i18n.T(ctx, "alert_suppression.field.child_host") }>
					@suppressionNodeOptions(hosts, form.Get("child_host_id", ""))
				</select>
			</label>
		</div>
		<div class="field as-child-monitor">
			<label>
				{ i18n.T(ctx, "alert_suppression.field.child_monitor") }
				<select name="child_monitor_id" class="select" aria-label={ i18n.T(ctx, "alert_suppression.field.child_monitor") }>
					@suppressionNodeOptions(monitors, form.Get("child_monitor_id", ""))
				</select>
			</label>
		</div>
		<div class="field as-child-label">
			<label>
				{ i18n.T(ctx, "alert_suppression.field.child_label_scope") }
				<select name="child_label_scope" class="select" aria-label={ i18n.T(ctx, "alert_suppression.field.child_label_scope") }>
					<option value="env" selected?={ form.Selected("child_label_scope", "env", "env") }>{ i18n.T(ctx, "alert_suppression.scope.env") }</option>
					<option value="role" selected?={ form.Selected("child_label_scope", "role", "env") }>{ i18n.T(ctx, "alert_suppression.scope.role") }</option>
				</select>
			</label>
		</div>
		<div class="field as-child-label">
			<label>
				{ i18n.T(ctx, "alert_suppression.field.child_label_value") }
				<input
					type="text"
					name="child_label_value"
					class="input"
					value={ form.Get("child_label_value", "") }
					placeholder={ i18n.T(ctx, "alert_suppression.field.child_label_value_placeholder") }
					aria-label={ i18n.T(ctx, "alert_suppression.field.child_label_value") }
				/>
			</label>
		</div>
	</div>
	<p class="hint">{ i18n.T(ctx, "alert_suppression.form.hint") }</p>
}

templ suppressionCreateModal(projectID int64, hosts, monitors []SuppressionNodeOption, form FormState, errMsg string) {
	{{ open := form.Opens(SuppressionCreateModalID) }}
	@createModalOpen(SuppressionCreateModalID, "alert_suppression.form.title", true, open) {
		<form method="post" action={ templ.URL(AlertSuppressionPath(projectID)) } class="alert-suppression-form">
			if open && errMsg != "" {
				<p class="error" id={ SuppressionCreateModalID + "-error" }>{ errMsg }</p>
			}
			@suppressionEdgeFields(suppressionFormValues(form, open, nil), hosts, monitors)
			<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "alert_suppression.form.submit") }</button>
		</form>
	}
}

// правка действует только на новые решения о подавлении: флаг suppressed_by_dep
// на уже открытых инцидентах одноразовый, обратного писателя нет.
templ suppressionEditModal(projectID int64, e SuppressionEdgeView, hosts, monitors []SuppressionNodeOption, form FormState, errMsg string) {
	{{ modalID := EditSuppressionEdgeModalID(e.ID) }}
	{{ open := form.Opens(modalID) }}
	@createModalOpen(modalID, "alert_suppression.edit.title", true, open) {
		<form method="post" action={ templ.URL(alertSuppressionUpdatePath(projectID, e.ID)) } class="alert-suppression-form">
			if open && errMsg != "" {
				<p class="error" id={ modalID + "-error" }>{ errMsg }</p>
			}
			<p class="hint">{ i18n.T(ctx, "alert_suppression.edit.hint") }</p>
			@suppressionEdgeFields(suppressionFormValues(form, open, e.Defaults), hosts, monitors)
			<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "alert_suppression.edit.submit") }</button>
		</form>
	}
}

templ suppressionEdgeRow(projectID int64, e SuppressionEdgeView, hosts, monitors []SuppressionNodeOption, form FormState, errMsg string) {
	<tr>
		<td>{ e.ParentLabel }</td>
		<td>{ e.ChildLabel }</td>
		<td>
			<div class="row-actions">
				<a
					class="btn btn-ghost"
					href={ templ.SafeURL("#" + EditSuppressionEdgeModalID(e.ID)) }
					aria-label={ i18n.Tf(ctx, "alert_suppression.action.edit_aria", "parent", e.ParentLabel, "child", e.ChildLabel) }
				>
					{ i18n.T(ctx, "alert_suppression.action.edit") }
				</a>
				<form method="post" action={ templ.URL(alertSuppressionDeletePath(projectID, e.ID)) }>
					<button
						type="submit"
						class="btn btn-danger"
						aria-label={ i18n.Tf(ctx, "alert_suppression.action.delete_aria", "parent", e.ParentLabel, "child", e.ChildLabel) }
					>
						{ i18n.T(ctx, "alert_suppression.action.delete") }
					</button>
				</form>
			</div>
			@suppressionEditModal(projectID, e, hosts, monitors, form, errMsg)
		</td>
	</tr>
}

// aria-label дублирует видимый текст: список не интерактивен, но повтор ничего не стоит.
templ suppressionPreviewRow(p SuppressionPreviewView) {
	<li aria-label={ i18n.Tf(ctx, "alert_suppression.preview.row", "parent", p.ParentLabel, "children", strings.Join(p.Children, ", ")) }>
		{ i18n.Tf(ctx, "alert_suppression.preview.row", "parent", p.ParentLabel, "children", strings.Join(p.Children, ", ")) }
	</li>
}

// секция видна, если у проекта есть хоть одно ребро; пустой результат — текст,
// а не исчезновение карточки (дети могут быть label-селекторами без совпадений).
templ suppressionPreview(preview []SuppressionPreviewView) {
	<section class="card suppression-section">
		<h2 class="card-header">{ i18n.T(ctx, "alert_suppression.preview.title") }</h2>
		<p class="hint">{ i18n.T(ctx, "alert_suppression.preview.intro") }</p>
		if len(preview) == 0 {
			<p class="hint">{ i18n.T(ctx, "alert_suppression.preview.empty") }</p>
		} else {
			<ul class="preview-list">
				for _, p := range preview {
					@suppressionPreviewRow(p)
				}
			</ul>
		}
	</section>
}

// grace показывается только при значении > 0: ноль означает выключенный грейс
// либо стенд без main.go, где конкретную цифру показывать нечего.
templ AlertSuppression(projectID int64, edges []SuppressionEdgeView, hosts, monitors []SuppressionNodeOption, preview []SuppressionPreviewView, grace time.Duration, form FormState, errMsg, userEmail string) {
	@layout(i18n.T(ctx, "alert_suppression.title"), userEmail) {
		<h1>{ i18n.T(ctx, "alert_suppression.title") }</h1>
		@helpPanelWith("alert_suppression", "alert-suppression") {
			<p>{ i18n.T(ctx, "alert_suppression.intro.model") }</p>
			<p>{ i18n.T(ctx, "alert_suppression.intro") }</p>
			if grace > 0 {
				<p>{ i18n.Tf(ctx, "alert_suppression.intro.grace", "grace", humanize.Duration(ctx, grace)) }</p>
				<p>{ i18n.T(ctx, "alert_suppression.intro.grace_warning") }</p>
			}
			<p>{ i18n.T(ctx, "alert_suppression.intro.scope") }</p>
		}
		// ошибка модальной формы показывается внутри переоткрытой модалки; здесь
		// остаются только 422 без состояния формы (прямой POST без полей).
		if errMsg != "" && !form.Has() {
			<p class="error">{ errMsg }</p>
		}
		@createTrigger(SuppressionCreateModalID, "alert_suppression.form.title")
		<section class="card suppression-section">
			<h2 class="card-header">{ i18n.T(ctx, "alert_suppression.list.title") }</h2>
			if len(edges) == 0 {
				@emptyState("bell", "alert_suppression.empty.title", "alert_suppression.empty.body", "", "", 3)
			} else {
				@scrollRegion("table-scroll", "alert_suppression.list.title") {
					<table class="data-table">
						<thead>
							<tr>
								<th scope="col">{ i18n.T(ctx, "alert_suppression.table.parent") }</th>
								<th scope="col">{ i18n.T(ctx, "alert_suppression.table.child") }</th>
								<th scope="col"></th>
							</tr>
						</thead>
						<tbody>
							for _, e := range edges {
								@suppressionEdgeRow(projectID, e, hosts, monitors, form, errMsg)
							}
						</tbody>
					</table>
				}
			}
		</section>
		if len(edges) > 0 {
			@suppressionPreview(preview)
		}
		@suppressionCreateModal(projectID, hosts, monitors, form, errMsg)
	}
}
