package templates

import "gitflic.ru/otezvikentiy/gotcha/internal/i18n"

// textarea visually-hidden, не display:none — execCommand-фолбэк copy.js делает focus()/select().
// <pre> ниже — не дубль скрытой textarea, а сам видимый контент блока.
templ copyBlock(id, labelKey, content string) {
	<div class="copy-llm">
		<button type="button" class="btn-copy" data-copy-format="txt"
			data-copy-target={ id } aria-label={ i18n.T(ctx, labelKey) }>
			{ i18n.T(ctx, labelKey) }
		</button>
		<span class="copy-done" data-copy-done hidden role="status" aria-live="polite">{ i18n.T(ctx, "copy.done") }</span>
		<span class="copy-failed" data-copy-failed hidden role="alert">{ i18n.T(ctx, "copy.failed") }</span>
		<textarea class="visually-hidden" id={ id } data-copy-blob readonly aria-hidden="true" tabindex="-1">{ content }</textarea>
		<pre class="copy-preview">{ content }</pre>
	</div>
}
