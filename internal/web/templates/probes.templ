package templates

import (
	"context"
	"strconv"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/org"
	"gitflic.ru/otezvikentiy/gotcha/internal/uptime"
)

func orgProbesPath(orgID int64) string {
	return "/orgs/" + strconv.FormatInt(orgID, 10) + "/probes"
}

func orgProbesRevokePath(orgID int64) string {
	return orgProbesPath(orgID) + "/revoke"
}

// ProbeRow — проба вместе с уже посчитанным веб-слоем статусом (online, если
// last_seen_at свежее probeOfflineAfter; иначе offline; отозванная — revoked;
// см. web/probes.go) — тот же приём, что и MonitorRow: пороги и работа со
// временем остаются в web, этот пакет только форматирует.
type ProbeRow struct {
	Probe  uptime.Probe
	Status string
}

// probeStatusBadgeClass — цвета статусов проб через дизайн-систему: online —
// тот же зелёный, что и у монитора в состоянии up, offline — красный (проба
// молчит, её регион не проверяется), revoked — нейтральный (отозванная проба
// не тревога, а осознанное действие админа).
func probeStatusBadgeClass(status string) string {
	switch status {
	case uptime.ProbeStatusOnline:
		return "badge badge-good"
	case uptime.ProbeStatusOffline:
		return "badge badge-danger"
	default:
		return "badge badge-neutral"
	}
}

// probeStatusLabel — локализованное имя статуса пробы (online/offline/revoked).
// Неизвестный статус возвращается как есть.
func probeStatusLabel(ctx context.Context, status string) string {
	switch status {
	case uptime.ProbeStatusOnline, uptime.ProbeStatusOffline, uptime.ProbeStatusRevoked:
		return i18n.T(ctx, "probe.status."+status)
	}
	return status
}

// probeLastSeenCell — «никогда» для только что созданной пробы, которая ещё
// ни разу не постучалась в центр, либо точный момент последнего визита рядом
// с относительной подписью (тот же приём, что и lastCheckedCell в
// monitors.templ). Возвращает templ.Component вместо string — только так
// строка «никогда» и <time> с относительным временем внутри могут делить
// одну ячейку без ветвления разметки в вызывающем шаблоне.
func probeLastSeenCell(row ProbeRow) templ.Component {
	if row.Probe.LastSeenAt == nil {
		return neverSeenLabel()
	}
	return relativeTime(*row.Probe.LastSeenAt)
}

// neverSeenLabel — «никогда» текстом, обёрнутая в templ.Component ради
// единой сигнатуры с relativeTime в probeLastSeenCell выше.
templ neverSeenLabel() {
	{ i18n.T(ctx, "uptime.probes.never") }
}

templ probeTableRow(orgID int64, row ProbeRow) {
	<tr>
		<td>{ row.Probe.Name }</td>
		<td>{ row.Probe.Region }</td>
		<td><span class={ probeStatusBadgeClass(row.Status) }>{ probeStatusLabel(ctx, row.Status) }</span></td>
		<td>@probeLastSeenCell(row)</td>
		<td>@relativeTime(row.Probe.CreatedAt)</td>
		<td>
			if !row.Probe.Revoked {
				<form method="post" action={ templ.URL(orgProbesRevokePath(orgID)) } class="probe-revoke-form">
					<input type="hidden" name="probe_id" value={ strconv.FormatInt(row.Probe.ID, 10) }/>
					<button type="submit" class="btn btn-danger-ghost">{ i18n.T(ctx, "uptime.probes.action_revoke") }</button>
				</form>
			}
		</td>
	</tr>
}

// Probes — GET/POST /orgs/{id}/probes: таблица проб организации и форма
// создания новой. rawToken и runCmd заполняются ровно один раз — в теле ответа
// POST, создавшего пробу: сырой токен хранится в БД только хешем и второй раз
// его показать неоткуда (тот же приём, что и одноразовая ссылка-приглашение в
// OrgSettings и DSN-ключи проекта). errMsg — сообщение 422 (пустое/слишком
// длинное имя или регион), страница при этом перерисовывается на месте.
templ Probes(o org.Org, rows []ProbeRow, rawToken, runCmd, errMsg, userEmail string) {
	@layout(i18n.T(ctx, "uptime.probes.title")+" "+o.Name, userEmail) {
		<div class="org-probes">
			// №118: крошка ведёт в настройки организации — и называться обязана
			// ими же, а не «Участниками» (участники — лишь одна из карточек там).
			@breadcrumbBackTo(templ.URL(orgSettingsPath(o.ID)), i18n.T(ctx, "org.settings.title"))
			<h1>{ i18n.T(ctx, "uptime.probes.title") } { o.Name }</h1>
			@helpPanel("probes", "probes")
			if errMsg != "" {
				<p class="error">{ errMsg }</p>
			}
			if rawToken != "" {
				<div class="probe-token-block card">
					<p>{ i18n.T(ctx, "uptime.probes.token_hint") }</p>
					<p><code class="probe-token">{ rawToken }</code></p>
					<p>{ i18n.T(ctx, "uptime.probes.run_hint") }</p>
					<p><code class="probe-run">{ runCmd }</code></p>
					// №70: команда содержит плейсхолдер <gotcha-image> — без
					// пояснения он читается как опечатка, а не как «подставьте
					// свой образ».
					<p class="hint">{ i18n.T(ctx, "uptime.probes.cmd_hint") } <a href="/docs/probes">{ i18n.T(ctx, "uptime.probes.cmd_docs_link") }</a></p>
				</div>
			}
			<section class="card">
				<h2 class="card-header">{ i18n.T(ctx, "uptime.probes.list_title") }</h2>
				if len(rows) == 0 {
					@emptyState("globe", "uptime.probes.empty.title", "uptime.probes.empty.body", "", "", 3)
				} else {
					@scrollRegion("table-scroll", "uptime.probes.list_title") {
						<table class="data-table">
							<thead>
								<tr>
									<th scope="col">{ i18n.T(ctx, "uptime.probes.table.name") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.probes.table.region") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.probes.table.status") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.probes.table.last_seen") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.probes.table.created") }</th>
									<th scope="col"></th>
								</tr>
							</thead>
							<tbody>
								for _, row := range rows {
									@probeTableRow(o.ID, row)
								}
							</tbody>
						</table>
					}
				}
			</section>
			<h2>{ i18n.T(ctx, "uptime.probes.new_title") }</h2>
			<form method="post" action={ templ.URL(orgProbesPath(o.ID)) } class="probe-create-form">
				<div class="field">
					<label>
						{ i18n.T(ctx, "uptime.probes.field.name") }
						<input type="text" name="name" required maxlength="40" placeholder={ i18n.T(ctx, "uptime.probes.name_placeholder") } class="input"/>
					</label>
				</div>
				<div class="field">
					<label>
						{ i18n.T(ctx, "uptime.probes.field.region") }
						<input type="text" name="region" required maxlength="40" placeholder="ru-msk" class="input"/>
					</label>
				</div>
				<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "uptime.probes.submit") }</button>
			</form>
		</div>
	}
}
