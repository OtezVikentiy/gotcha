package templates

import (
	"context"
	"strconv"
	"time"

	"gitflic.ru/otezvikentiy/gotcha/internal/humanize"
	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/uptime"
)

func maintenancePath(projectID int64) string {
	return "/projects/" + strconv.FormatInt(projectID, 10) + "/maintenance"
}

func maintenanceDeletePath(projectID int64) string {
	return maintenancePath(projectID) + "/delete"
}

// EditWindowModalID — якорь модалки правки окна обслуживания. Одна модалка на
// строку таблицы: они построены на CSS :target, а якорь обязан быть уникальным.
// Экспортирована, чтобы обработчик мог сказать, какую именно открыть заново
// после ошибки валидации.
func EditWindowModalID(windowID int64) string {
	return "edit-window-" + strconv.FormatInt(windowID, 10)
}

func maintenanceUpdatePath(projectID int64) string {
	return maintenancePath(projectID) + "/update"
}

// windowFieldDefaults — значения полей формы для уже сохранённого окна.
//
// Форма одна на создание и на правку, а значения полей у них берутся из разных
// мест: у создания — пустые, у правки — из окна. Возвращаем плоскую карту тех
// же имён, что и у FormState, чтобы фрагмент полей не знал, какой он из двух.
func windowFieldDefaults(w uptime.Window) FormState {
	f := FormState{"name": w.Name, "kind": "oneoff", "timezone": w.Timezone}
	if w.Weekly {
		f["kind"] = "weekly"
		f["weekday"] = strconv.Itoa(w.Weekday)
		f["start_time"] = w.StartTime
		f["end_time"] = w.EndTime
	} else {
		// datetime-local понимает только этот формат и только местное время —
		// то же, в котором окно и было задано, поэтому переводим в его пояс.
		loc, err := time.LoadLocation(w.Timezone)
		if err != nil {
			loc = time.UTC
		}
		if w.StartsAt != nil {
			f["starts_at"] = w.StartsAt.In(loc).Format("2006-01-02T15:04")
		}
		if w.EndsAt != nil {
			f["ends_at"] = w.EndsAt.In(loc).Format("2006-01-02T15:04")
		} else {
			// Бессрочное окно (EndsAt == nil) — чекбокс «без даты окончания»
			// предотмечен при открытии формы правки, иначе сохранение без
			// изменений тут же упёрлось бы в oneOffEndRequired.
			f["indefinite"] = "1"
		}
	}
	if !knownTimezone(w.Timezone) {
		// Пояса нет в фиксированном списке — select переключается на «Другой»
		// (пустое значение), а сам пояс уезжает в соседнее свободное поле.
		f["timezone"] = ""
		f["timezone_custom"] = w.Timezone
	}
	return f
}

func knownTimezone(tz string) bool {
	for _, known := range maintenanceTimezones {
		if known == tz {
			return true
		}
	}
	return false
}

// windowFormValues — какие значения показывать в полях: введённые человеком,
// если ошиблась именно эта форма, иначе значения самого окна (или пустые у
// формы создания). Модалок правки на странице столько же, сколько окон, а
// состояние формы одно — без этой развилки введённое попало бы во все сразу.
func windowFormValues(form FormState, open bool, defaults FormState) FormState {
	if open {
		return form
	}
	return defaults
}

// maintenanceTimezones — фиксированный список TZ из спеки задачи; "Другой"
// (пустое значение select'а) переключает форму на соседнее свободное
// IANA-поле, см. web/maintenance.go:maintenanceTimezone.
var maintenanceTimezones = []string{"UTC", "Europe/Moscow", "Europe/Berlin", "Asia/Yekaterinburg"}

// weekdayLabelKeys — i18n-ключи дней недели, индекс совпадает со значением
// select'а weekday (0 = воскресенье, как в БД/уже сохранённых окнах).
var weekdayLabelKeys = [7]string{
	"uptime.weekday.0", "uptime.weekday.1", "uptime.weekday.2", "uptime.weekday.3",
	"uptime.weekday.4", "uptime.weekday.5", "uptime.weekday.6",
}

func weekdayLabelKey(d int) string {
	if d < 0 || d > 6 {
		return "uptime.weekday.unknown"
	}
	return weekdayLabelKeys[d]
}

func windowKindTextKey(w uptime.Window) string {
	if w.Weekly {
		return "uptime.maintenance.kind.weekly"
	}
	if w.EndsAt == nil {
		return "uptime.maintenance.indefinite"
	}
	return "uptime.maintenance.kind.oneoff"
}

func windowScheduleText(ctx context.Context, w uptime.Window) string {
	if w.Weekly {
		return i18n.T(ctx, weekdayLabelKey(w.Weekday)) + " " + w.StartTime + "–" + w.EndTime + " (" + w.Timezone + ")"
	}
	// Время показывается В ПОЯСЕ ОКНА. Раньше здесь стоял RFC3339 от значения
	// в UTC, а рядом подписывался пояс окна: «2026-07-31T00:00:00Z
	// (Europe/Moscow)» — число одного пояса под именем другого. Соседняя
	// функция этого же файла переводила время честно.
	loc := humanize.LocationOrUTC(w.Timezone)
	// EndsAt == nil — не «неизвестно», а «бессрочно» (validateWindow требует
	// StartsAt всегда, так что "?" у начала — чисто defensive и на практике
	// у сохранённых окон не встречается).
	starts, ends := "?", i18n.T(ctx, "uptime.maintenance.indefinite")
	if w.StartsAt != nil {
		starts = humanize.Time(ctx, *w.StartsAt, loc)
	}
	if w.EndsAt != nil {
		ends = humanize.Time(ctx, *w.EndsAt, loc)
	}
	return starts + " → " + ends
}

templ maintenanceTimezoneOption(tz string, selected bool) {
	if selected {
		<option value={ tz } selected>{ tz }</option>
	} else {
		<option value={ tz }>{ tz }</option>
	}
}

templ maintenanceWeekdayOption(value int, selected bool) {
	if selected {
		<option value={ strconv.Itoa(value) } selected>{ i18n.T(ctx, weekdayLabelKey(value)) }</option>
	} else {
		<option value={ strconv.Itoa(value) }>{ i18n.T(ctx, weekdayLabelKey(value)) }</option>
	}
}

templ windowRow(projectID int64, w uptime.Window, form FormState, errMsg string) {
	<tr>
		<td>{ w.Name }</td>
		<td>{ i18n.T(ctx, windowKindTextKey(w)) }</td>
		<td>{ windowScheduleText(ctx, w) }</td>
		<td>
			<div class="row-actions">
				<a class="btn btn-ghost" href={ templ.SafeURL("#" + EditWindowModalID(w.ID)) }>{ i18n.T(ctx, "uptime.maintenance.edit") }</a>
				<form method="post" action={ templ.URL(maintenanceDeletePath(projectID)) } class="window-delete-form">
					<input type="hidden" name="window_id" value={ strconv.FormatInt(w.ID, 10) }/>
					<button type="submit" class="btn btn-danger-ghost">{ i18n.T(ctx, "uptime.detail.action_delete") }</button>
				</form>
			</div>
			@windowEditModal(projectID, w, form, errMsg)
		</td>
	</tr>
}

// windowEditModal — правка окна обслуживания теми же полями, что и создание.
templ windowEditModal(projectID int64, w uptime.Window, form FormState, errMsg string) {
	{{ open := form.Opens(EditWindowModalID(w.ID)) }}
	{{ errID := "" }}
	if errMsg != "" && open {
		{{ errID = EditWindowModalID(w.ID) + "-error" }}
	}
	@createModalOpen(EditWindowModalID(w.ID), "uptime.maintenance.edit.title", false, open) {
		<form method="post" action={ templ.URL(maintenanceUpdatePath(projectID)) } class="maintenance-form">
			// Без role="alert": фокус в модалку переносит modal.js (№80),
			// ошибка привязана к полю имени (maintenanceFields) через errID.
			if errID != "" {
				<p class="error" id={ errID }>{ errMsg }</p>
			}
			<input type="hidden" name="window_id" value={ strconv.FormatInt(w.ID, 10) }/>
			@maintenanceFields(windowFormValues(form, open, windowFieldDefaults(w)), "uptime.maintenance.edit.submit", errID, EditWindowModalID(w.ID))
		</form>
	}
}

// maintenanceFields — поля окна обслуживания. Общие для создания и правки:
// формы отличаются только адресом, идентификатором окна и подписью кнопки, а
// восемь полей с их взаимными зависимостями (тип окна прячет половину, «Другой»
// пояс открывает свободное поле) незачем держать в двух экземплярах — они
// разъедутся при первой же правке.
//
// values — что показывать в полях: введённое человеком после ошибки либо
// значения самого окна; см. windowFormValues.
//
// errID — id блока ошибки валидации в вызывающей модалке (пустой, если
// ошибки нет): первое текстовое поле получает aria-invalid/aria-describedby,
// чтобы скринридер связал сообщение с полем (№80).
//
// idPrefix — модалка создания и модалка правки каждого окна рендерят этот
// фрагмент на одной странице ("new-maintenance-window" / EditWindowModalID),
// поэтому статичные id полей (сейчас — подсказки под ends_at) собираются из
// него, а не зашиты в разметке: иначе на странице с несколькими окнами id
// задвоились бы.
templ maintenanceFields(values FormState, submitKey string, errID string, idPrefix string) {
	<div class="field">
		<label>
			{ i18n.T(ctx, "uptime.maintenance.field.name") }
			<input
				type="text"
				name="name"
				required
				class="input"
				value={ values.Get("name", "") }
				if errID != "" {
					aria-invalid="true"
					aria-describedby={ errID }
				}
			/>
		</label>
	</div>
	<fieldset class="field">
		// fieldset/legend, а не span: без группы скринридер читает «Разовое» и
		// «Еженедельное» как одиночные radio без общего вопроса (№79,
		// WCAG 1.3.1). Визуально ничего не меняется — рамка снята в app.css.
		<legend class="field-label">{ i18n.T(ctx, "uptime.maintenance.field.kind") }</legend>
		<div class="segmented">
			<label>
				if values.Selected("kind", "oneoff", "oneoff") {
					<input type="radio" name="kind" value="oneoff" checked/>
				} else {
					<input type="radio" name="kind" value="oneoff"/>
				}
				{ i18n.T(ctx, "uptime.maintenance.kind.oneoff_label") }
			</label>
			<label>
				if values.Selected("kind", "weekly", "oneoff") {
					<input type="radio" name="kind" value="weekly" checked/>
				} else {
					<input type="radio" name="kind" value="weekly"/>
				}
				{ i18n.T(ctx, "uptime.maintenance.kind.weekly_label") }
			</label>
		</div>
	</fieldset>
	// Показывается только выбранный блок: тип окна — «либо-либо», хендлер
	// берёт поля только выбранной ветки (см. maintenance.go), поэтому второй
	// блок при активном первом только сбивал бы с толку. Скрытие — чистый CSS
	// через :has() по radio, без JS (см. .maintenance-form в app.css).
	<div class="mw-oneoff">
		// Чекбокс явного выбора «бессрочно» стоит ПЕРЕД полем конца: пустой
		// ends_at раньше молча значил то же самое (T2 смягчил validateWindow),
		// а забытая дата тихо глушила весь проект навсегда вместо ошибки —
		// см. oneOffEndRequired в web/maintenance.go. Предупреждение о
		// последствии бессрочного окна для SLO живёт прямо под чекбоксом
		// (aria-describedby на нём же), а не постоянным жёлтым баннером под
		// ends_at для ЛЮБОГО разового окна.
		<div class="checkbox-field">
			<label class="checkbox-inline">
				if values.Checked("indefinite", false) {
					<input type="checkbox" name="indefinite" checked aria-describedby={ idPrefix + "-indefinite-warning" }/>
				} else {
					<input type="checkbox" name="indefinite" aria-describedby={ idPrefix + "-indefinite-warning" }/>
				}
				{ i18n.T(ctx, "uptime.maintenance.oneoff.indefinite") }
			</label>
			<p class="hint hint--warn" id={ idPrefix + "-indefinite-warning" }>{ i18n.T(ctx, "uptime.maintenance.indefinite_slo_warning") }</p>
		</div>
		<div class="form-grid">
			<div class="field">
				<label>
					{ i18n.T(ctx, "uptime.maintenance.oneoff.start") }
					<input type="datetime-local" name="starts_at" class="input" value={ values.Get("starts_at", "") }/>
				</label>
			</div>
			<div class="field">
				<label>
					{ i18n.T(ctx, "uptime.maintenance.oneoff.end") }
					<input type="datetime-local" name="ends_at" class="input" value={ values.Get("ends_at", "") }/>
				</label>
			</div>
		</div>
	</div>
	<div class="mw-weekly">
		<div class="form-grid">
			<div class="field">
				<label>
					{ i18n.T(ctx, "uptime.maintenance.weekly.weekday") }
					<select name="weekday" class="select">
						for wd := 0; wd < 7; wd++ {
							@maintenanceWeekdayOption(wd, values.Selected("weekday", strconv.Itoa(wd), "0"))
						}
					</select>
				</label>
			</div>
			<div class="field">
				<label>
					{ i18n.T(ctx, "uptime.maintenance.weekly.start") }
					<input type="time" name="start_time" class="input" value={ values.Get("start_time", "") }/>
				</label>
			</div>
			<div class="field">
				<label>
					{ i18n.T(ctx, "uptime.maintenance.weekly.end") }
					<input type="time" name="end_time" class="input" value={ values.Get("end_time", "") }/>
				</label>
			</div>
		</div>
	</div>
	<div class="form-grid">
		<div class="field">
			<label>
				{ i18n.T(ctx, "uptime.maintenance.field.timezone") }
				<select name="timezone" class="select">
					for _, tz := range maintenanceTimezones {
						@maintenanceTimezoneOption(tz, values.Selected("timezone", tz, "UTC"))
					}
					if values.Selected("timezone", "", "UTC") {
						<option value="" selected>{ i18n.T(ctx, "uptime.maintenance.field.timezone_other") }</option>
					} else {
						<option value="">{ i18n.T(ctx, "uptime.maintenance.field.timezone_other") }</option>
					}
				</select>
			</label>
		</div>
		// Поле своего IANA-пояса нужно только при выборе «Другой» (пустое value
		// в select). Показывается через CSS :has() по выбранной option, без JS
		// (см. .maintenance-form в app.css).
		<div class="field mw-custom-tz">
			<label>
				{ i18n.T(ctx, "uptime.maintenance.field.timezone_custom") }
				<input type="text" name="timezone_custom" placeholder={ i18n.T(ctx, "uptime.maintenance.timezone_placeholder") } class="input" value={ values.Get("timezone_custom", "") }/>
			</label>
		</div>
	</div>
	<button type="submit" class="btn btn-primary">{ i18n.T(ctx, submitKey) }</button>
}

// Maintenance — GET/POST /projects/{id}/maintenance: список окон
// обслуживания проекта + форма создания (разового или еженедельного).
// Доступ только owner/admin организации проекта (requireProjectRole).
templ Maintenance(projectID int64, windows []uptime.Window, form FormState, errMsg, userEmail string) {
	@layout(i18n.T(ctx, "nav.maintenance"), userEmail) {
		<div class="maintenance">
			@breadcrumbBackTo(templ.URL(monitorsPath(projectID)), i18n.T(ctx, "nav.monitors"))
			<h1>{ i18n.T(ctx, "nav.maintenance") }</h1>
			@helpPanel("maintenance", "maintenance")
			if errMsg != "" && !form.Has() {
				<p class="error">{ errMsg }</p>
			}
			@createTrigger("new-maintenance-window", "uptime.maintenance.new_title")
			<section class="card">
				<h2 class="card-header">{ i18n.T(ctx, "uptime.maintenance.list_title") }</h2>
				if len(windows) == 0 {
					@emptyState("clock", "uptime.maintenance.empty.title", "uptime.maintenance.empty.body", "", "", 3)
				} else {
					@scrollRegion("table-scroll", "uptime.maintenance.list_title") {
							<table class="data-table">
								<thead>
									<tr>
										<th scope="col">{ i18n.T(ctx, "uptime.maintenance.table.name") }</th>
										<th scope="col">{ i18n.T(ctx, "uptime.maintenance.table.type") }</th>
										<th scope="col">{ i18n.T(ctx, "uptime.maintenance.table.schedule") }</th>
										<th scope="col"></th>
									</tr>
								</thead>
								<tbody>
									for _, w := range windows {
										@windowRow(projectID, w, form, errMsg)
									}
								</tbody>
							</table>
					}
				}
			</section>

			{{ createErrID := "" }}
			if errMsg != "" && form.Opens("new-maintenance-window") {
				{{ createErrID = "new-maintenance-window-error" }}
			}
			@createModalOpen("new-maintenance-window", "uptime.maintenance.new_title", false, form.Opens("new-maintenance-window")) {
			<form method="post" action={ templ.URL(maintenancePath(projectID)) } class="maintenance-form">
				// Без role="alert": фокус в модалку переносит modal.js (№80),
				// ошибка привязана к полю имени (maintenanceFields) через errID.
				if createErrID != "" {
					<p class="error" id={ createErrID }>{ errMsg }</p>
				}
				@maintenanceFields(form, "uptime.maintenance.submit", createErrID, "new-maintenance-window")
			</form>
			}
		</div>
	}
}
