package templates

import (
	"strconv"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/trace"
)

func tracePath(traceID string) string {
	return "/traces/" + traceID
}

// perfIssuePath — ссылка на страницу perf-проблемы (маршрут появится в
// следующих задачах; ссылку кладём заранее, как это принято в проекте).
func perfIssuePath(id int64) string {
	return "/perf-issues/" + strconv.FormatInt(id, 10)
}

// EndpointDetailData — всё, что нужно странице эндпойнта: имя, фильтры,
// уже собранные в web/performance.go SVG-графики и таблицы медленных трейсов и
// связанных perf-проблем (тот же приём, что и MonitorRow/EndpointRow).
type EndpointDetailData struct {
	ProjectID   int64
	Transaction string
	Range       TimeRangeVM
	Environment string
	ApdexT      int

	LatencyChart templ.Component
	Throughput   templ.Component
	Histogram    templ.Component
	// StepLabel — шаг агрегации графиков («5m», «1h»): без него высота
	// столбика трафика ни о чём не говорит — непонятно, за какой интервал
	// это число.
	StepLabel string
	// From — подраздел, из которого пришёл пользователь («web-vitals» либо
	// пусто). Страница общая для «Транзакций» и «Web Vitals», и без этого
	// крошка всегда вела бы в «Транзакции», куда пользователь не заходил.
	From string

	Slowest    []SlowestTraceRow
	PerfIssues []trace.PerfIssue
	// LoadFailed — ClickHouse не ответил: вместо графиков, виталов и
	// медленных трейсов — «данные временно недоступны»; шапка и связанные
	// проблемы (PostgreSQL) остаются.
	LoadFailed bool

	// Vitals — панель Web Vitals (этап 4, план 2, задача 2): непустой слайс →
	// у транзакции есть web vitals и панель рендерится; nil → панели нет.
	Vitals []VitalPanelRow
}

// VitalPanelRow — строка панели Web Vitals: один vital с p75/рейтингом
// (trace.Vital) и уже собранный в web/webvitals.go SVG-мини-график p75 во
// времени (тот же приём, что и EndpointRow.Sparkline).
type VitalPanelRow struct {
	Vital trace.Vital
	Chart templ.Component
}

// SlowestTraceRow — строка таблицы «самые медленные трейсы»: сам трейс
// (trace.TraceRow) и Expired — истёк ли TTL его спанов по настроенному
// h.SpanRetentionDays (сравнение с "сейчас" и с порогом сделано в
// web/performance.go, а не здесь — шаблон не должен решать, что такое
// "сейчас", и не знает о конфиге хендлера). Expired=true → trace_id рисуется
// простым текстом без ссылки: у /traces/{id} для такого трейса нет спанов,
// ссылка вела бы на состояние "детали недоступны". Данные при этом не
// прячутся — трейс действительно был медленным, это не мусор.
type SlowestTraceRow struct {
	Row     trace.TraceRow
	Expired bool
}

// EndpointDetail — GET /projects/{id}/performance/{transaction}: перцентили и
// throughput во времени, гистограмма длительностей, самые медленные трейсы и
// связанные perf-проблемы. Все графики — server-side SVG.
templ EndpointDetail(d EndpointDetailData, userEmail string) {
	@layout(d.Transaction, userEmail) {
		<div class="endpoint-detail">
			if d.From == "web-vitals" {
				@breadcrumbBack(templ.URL(webVitalsPath(d.ProjectID)), i18n.T(ctx, "nav.webvitals"))
			} else {
				@breadcrumbBack(templ.URL(performancePath(d.ProjectID)), i18n.T(ctx, "nav.transactions"))
			}
			<h1>{ d.Transaction }</h1>
			<form method="get" action={ templ.URL(endpointPath(d.ProjectID, d.Transaction)) } class="performance-filters">
				if d.Environment != "" {
					<input type="hidden" name="environment" value={ d.Environment }/>
				}
				if d.From != "" {
					<input type="hidden" name="from" value={ d.From }/>
				}
				@timeRangeFields(d.Range)
				<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "perf.filter.apply") }</button>
			</form>
			<div class="monitor-meta">
				<div class="stat-tile">
					<div class="stat-label">{ i18n.T(ctx, "perf.period") }</div>
					<div class="stat-value">@timeRangeLabel(d.Range)</div>
				</div>
				if d.Environment != "" {
					<div class="stat-tile">
						<div class="stat-label">{ i18n.T(ctx, "perf.environment") }</div>
						<div class="stat-value">{ d.Environment }</div>
					</div>
				}
				<div class="stat-tile">
					<div class="stat-label">@metricHead("perf.apdex_threshold", "perf.help.apdex_threshold")</div>
					<div class="stat-value">{ strconv.Itoa(d.ApdexT) }ms</div>
				</div>
			</div>

			if d.LoadFailed {
				@emptyState("zap", "perf.error.title", "perf.error.body", "", "", 2)
			} else {
			if len(d.Vitals) > 0 {
				<h2>{ i18n.T(ctx, "perf.webvitals") }</h2>
				// Таблица виталов — в собственном скролл-регионе, как остальные
				// таблицы (№31): на 375px она распирала страницу целиком.
				@scrollRegion("card table-scroll", "perf.webvitals") {
					<table id="web-vitals" class="data-table web-vitals-panel">
						<thead>
							<tr>
								<th scope="col">{ i18n.T(ctx, "perf.webvitals.table.metric") }</th>
								<th scope="col" class="num">@metricHead("perf.p75", "perf.help.p75")</th>
								<th scope="col">{ i18n.T(ctx, "perf.webvitals.table.rating") }</th>
								<th scope="col">{ i18n.T(ctx, "perf.webvitals.table.trend") }</th>
							</tr>
						</thead>
						<tbody>
							for _, row := range d.Vitals {
								<tr>
									<td>@vitalAbbr(row.Vital.Name)</td>
									<td class="num">{ formatVitalValue(row.Vital) }</td>
									<td>@vitalRatingBadge(row.Vital.Rating)</td>
									<td class="vital-chart-cell">@row.Chart</td>
								</tr>
							}
						</tbody>
					</table>
				}
			}

			<h2>{ i18n.T(ctx, "perf.chart.latency") }</h2>
			<p class="chart-caption">
				{ i18n.Tf(ctx, "perf.chart.latency.caption", "step", d.StepLabel) }
			</p>
			<p class="chart-legend">
				<span class="legend-item legend-p50">@metricHead("perf.p50", "perf.help.p50")</span>
				<span class="legend-item legend-p95">@metricHead("perf.p95", "perf.help.p95")</span>
			</p>
			@scrollRegion("endpoint-chart card", "perf.chart.latency") {
				@d.LatencyChart
			}

			<h2>{ i18n.T(ctx, "perf.throughput") }</h2>
			<p class="chart-caption">
				{ i18n.Tf(ctx, "perf.chart.throughput.caption", "step", d.StepLabel) }
			</p>
			@scrollRegion("endpoint-chart card", "perf.throughput") {
				@d.Throughput
			}

			<h2>{ i18n.T(ctx, "perf.chart.histogram") }</h2>
			<p class="chart-caption">
				{ i18n.T(ctx, "perf.chart.histogram.caption") }
			</p>
			@scrollRegion("endpoint-chart card", "perf.chart.histogram") {
				@d.Histogram
			}

			<h2>{ i18n.T(ctx, "perf.slowest") }</h2>
			if len(d.Slowest) == 0 {
				@emptyState("activity", "perf.slowest.empty.title", "perf.slowest.empty.body", "", "", 3)
			} else {
				<div class="card">
					@scrollRegion("table-scroll", "perf.slowest") {
							<table class="data-table">
								<thead>
									<tr>
										<th scope="col">{ i18n.T(ctx, "perf.slowest.table.when") }</th>
										<th scope="col" class="num">{ i18n.T(ctx, "perf.slowest.table.duration") }</th>
										<th scope="col">{ i18n.T(ctx, "perf.slowest.table.status") }</th>
										<th scope="col">{ i18n.T(ctx, "perf.slowest.table.trace") }</th>
									</tr>
								</thead>
								<tbody>
									for _, row := range d.Slowest {
										<tr>
											<td>@relativeTime(row.Row.Timestamp)</td>
											<td class="num">{ formatDurationUS(row.Row.DurationUS) }</td>
											<td>{ row.Row.Status }</td>
											<td>
												if row.Expired {
													<span class="trace-id-expired" title={ i18n.T(ctx, "perf.slowest.table.trace_expired") }>{ row.Row.TraceID }</span>
												} else {
													<a href={ templ.URL(tracePathFrom(row.Row.TraceID, "endpoint", d.Transaction)) }>{ row.Row.TraceID }</a>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
					}
				</div>
			}

			}
			<h2>{ i18n.T(ctx, "perf.related_issues") }</h2>
			if len(d.PerfIssues) == 0 {
				@emptyState("zap", "perf.related_issues.empty.title", "perf.related_issues.empty.body", "", "", 3)
			} else {
				<div class="card">
					@scrollRegion("table-scroll", "perf.related_issues") {
							<table class="data-table">
								<thead>
									<tr>
										<th scope="col">{ i18n.T(ctx, "perf.related_issues.table.kind") }</th>
										<th scope="col">{ i18n.T(ctx, "perf.related_issues.table.title") }</th>
										<th scope="col">{ i18n.T(ctx, "perf.related_issues.table.status") }</th>
										<th scope="col" class="num">{ i18n.T(ctx, "perf.related_issues.table.seen") }</th>
									</tr>
								</thead>
								<tbody>
									for _, iss := range d.PerfIssues {
										<tr>
											<td>{ perfKindLabel(ctx, iss.Kind) }</td>
											<td><a href={ templ.URL(perfIssuePath(iss.ID)) }>{ perfIssueTitle(ctx, iss) }</a></td>
											<td>{ issueStatusLabel(ctx, iss.Status) }</td>
											<td class="num">{ strconv.FormatInt(iss.Count, 10) }</td>
										</tr>
									}
								</tbody>
							</table>
					}
				</div>
			}
		</div>
	}
}
