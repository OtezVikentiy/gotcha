package templates

import (
	"strconv"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/org"
)

func orgTeamsPath(orgID int64) string {
	return "/orgs/" + strconv.FormatInt(orgID, 10) + "/teams"
}

func teamRenamePath(teamID int64) string {
	return "/teams/" + strconv.FormatInt(teamID, 10) + "/rename"
}

func teamDeletePath(teamID int64) string {
	return "/teams/" + strconv.FormatInt(teamID, 10) + "/delete"
}

func teamMembersPath(teamID int64) string {
	return "/teams/" + strconv.FormatInt(teamID, 10) + "/members"
}

func teamMembersRemovePath(teamID int64) string {
	return teamMembersPath(teamID) + "/remove"
}

func teamProjectsPath(teamID int64) string {
	return "/teams/" + strconv.FormatInt(teamID, 10) + "/projects"
}

func teamProjectsDetachPath(teamID int64) string {
	return teamProjectsPath(teamID) + "/detach"
}

// участники/проекты загружены один раз хендлером — страница рендерит сразу несколько команд.
type TeamView struct {
	Team     org.Team
	Members  []org.Member
	Projects []org.Project
}

// не предлагаем в select тех, кто уже участник — идемпотентно, но лишний пункт путает.
func memberInTeam(members []org.Member, userID int64) bool {
	for _, m := range members {
		if m.UserID == userID {
			return true
		}
	}
	return false
}

func projectAttached(projects []org.Project, projectID int64) bool {
	for _, p := range projects {
		if p.ID == projectID {
			return true
		}
	}
	return false
}

func hasAvailableMembers(members []org.Member, teamMembers []org.Member) bool {
	for _, m := range members {
		if !memberInTeam(teamMembers, m.UserID) {
			return true
		}
	}
	return false
}

func hasAvailableProjects(projects []org.Project, teamProjects []org.Project) bool {
	for _, p := range projects {
		if !projectAttached(teamProjects, p.ID) {
			return true
		}
	}
	return false
}

templ teamMemberRow(teamID int64, m org.Member) {
	<tr>
		<td>{ m.Email }</td>
		<td>
			<form method="post" action={ templ.URL(teamMembersRemovePath(teamID)) } class="team-member-remove-form">
				<input type="hidden" name="user_id" value={ strconv.FormatInt(m.UserID, 10) }/>
				<button type="submit" class="btn btn-ghost">{ i18n.T(ctx, "teams.members.remove") }</button>
			</form>
		</td>
	</tr>
}

templ teamProjectRow(teamID int64, p org.Project) {
	<tr>
		<td>{ p.Name }</td>
		<td>
			<form method="post" action={ templ.URL(teamProjectsDetachPath(teamID)) } class="team-project-detach-form">
				<input type="hidden" name="project_id" value={ strconv.FormatInt(p.ID, 10) }/>
				<button type="submit" class="btn btn-ghost">{ i18n.T(ctx, "teams.projects.detach") }</button>
			</form>
		</td>
	</tr>
}

// когда добавлять/привязывать нечего, select не рендерится — вместо пустого <select> заметка.

// одна модалка на команду — построены на CSS :target, якорь обязан быть уникальным.
// экспортирована — обработчик должен знать, какую именно открыть заново после ошибки.
func EditTeamModalID(teamID int64) string {
	return "edit-team-" + strconv.FormatInt(teamID, 10)
}

// slug не редактируется — участвует в адресах и выдаче прав, смена сломала бы сохранённые ссылки.
templ teamRenameModal(tm TeamView, form FormState, errMsg string) {
	{{ open := form.Opens(EditTeamModalID(tm.Team.ID)) }}
	@createModalOpen(EditTeamModalID(tm.Team.ID), "teams.rename.title", false, open) {
		<form method="post" action={ templ.URL(teamRenamePath(tm.Team.ID)) } class="team-rename-form">
			// без role=alert: фокус в модалку переносит modal.js, ошибка привязана через aria-describedby.
			if errMsg != "" && open {
				<p class="error" id={ EditTeamModalID(tm.Team.ID) + "-error" }>{ errMsg }</p>
			}
			<div class="field">
				<label>
					{ i18n.T(ctx, "teams.create.name_label") }
					<input
						type="text"
						name="name"
						required
						class="input"
						value={ formValueFor(form, open, "name", tm.Team.Name) }
						if errMsg != "" && open {
							aria-invalid="true"
							aria-describedby={ EditTeamModalID(tm.Team.ID) + "-error" }
						}
					/>
				</label>
				<span class="hint">{ i18n.Tf(ctx, "teams.rename.slug_note", "slug", tm.Team.Slug) }</span>
			</div>
			<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "teams.rename.submit") }</button>
		</form>
	}
}

templ teamSection(tm TeamView, orgMembers []org.Member, orgProjects []org.Project, form FormState, errMsg string) {
	<section class="team card">
		<h2 class="card-header">
			{ tm.Team.Name } <span class="chip">{ tm.Team.Slug }</span>
			// удаление двухшаговое (страница подтверждения на POST без confirmed=yes), поэтому обычная форма.
			<span class="card-header-action row-actions">
				<a class="btn btn-ghost" href={ templ.SafeURL("#" + EditTeamModalID(tm.Team.ID)) }>{ i18n.T(ctx, "teams.rename.action") }</a>
				<form method="post" action={ templ.URL(teamDeletePath(tm.Team.ID)) } class="team-delete-form">
					<button type="submit" class="btn btn-danger-ghost">{ i18n.T(ctx, "teams.delete") }</button>
				</form>
			</span>
		</h2>
		@teamRenameModal(tm, form, errMsg)
		<h3>{ i18n.T(ctx, "teams.members.title") }</h3>
		<div class="team-scroll">
			if len(tm.Members) == 0 {
				@emptyState("user", "teams.members.empty.title", "teams.members.empty.body", "", "", 3)
			} else {
				@scrollRegion("table-scroll", "teams.members.title") {
					<table class="data-table">
						<thead>
							<tr>
								<th scope="col">{ i18n.T(ctx, "teams.members.table.email") }</th>
								<th scope="col"></th>
							</tr>
						</thead>
						<tbody>
							for _, m := range tm.Members {
								@teamMemberRow(tm.Team.ID, m)
							}
						</tbody>
					</table>
				}
			}
		</div>
		if hasAvailableMembers(orgMembers, tm.Members) {
			<form method="post" action={ templ.URL(teamMembersPath(tm.Team.ID)) } class="team-member-add-form">
				<div class="field">
					<label>
						{ i18n.T(ctx, "teams.members.add.select_label") }
						<select name="user_id" class="select">
							for _, m := range orgMembers {
								if !memberInTeam(tm.Members, m.UserID) {
									<option value={ strconv.FormatInt(m.UserID, 10) }>{ m.Email }</option>
								}
							}
						</select>
					</label>
				</div>
				<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "teams.members.add.submit") }</button>
			</form>
		} else {
			<p class="hint">{ i18n.T(ctx, "teams.members.add.empty") }</p>
		}
		<h3>{ i18n.T(ctx, "teams.projects.title") }</h3>
		<div class="team-scroll">
			if len(tm.Projects) == 0 {
				@emptyState("building", "teams.projects.empty.title", "teams.projects.empty.body", "", "", 3)
			} else {
				@scrollRegion("table-scroll", "teams.projects.title") {
					<table class="data-table">
						<thead>
							<tr>
								<th scope="col">{ i18n.T(ctx, "teams.projects.table.name") }</th>
								<th scope="col"></th>
							</tr>
						</thead>
						<tbody>
							for _, p := range tm.Projects {
								@teamProjectRow(tm.Team.ID, p)
							}
						</tbody>
					</table>
				}
			}
		</div>
		if hasAvailableProjects(orgProjects, tm.Projects) {
			<form method="post" action={ templ.URL(teamProjectsPath(tm.Team.ID)) } class="team-project-attach-form">
				<div class="field">
					<label>
						{ i18n.T(ctx, "teams.projects.attach.select_label") }
						<select name="project_id" class="select">
							for _, p := range orgProjects {
								if !projectAttached(tm.Projects, p.ID) {
									<option value={ strconv.FormatInt(p.ID, 10) }>{ p.Name }</option>
								}
							}
						</select>
					</label>
				</div>
				<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "teams.projects.attach.submit") }</button>
			</form>
		} else {
			<p class="hint">{ i18n.T(ctx, "teams.projects.attach.empty") }</p>
		}
	</section>
}

// errMsg рендерится с тем же статусом (422), что и ответ — тот же приём, что у OrgSettings.
templ Teams(o org.Org, teams []TeamView, orgMembers []org.Member, orgProjects []org.Project, form FormState, errMsg, userEmail string) {
	@layout(i18n.T(ctx, "teams.title")+" "+o.Name, userEmail) {
		<div class="teams">
			@breadcrumbBackTo(templ.URL(orgSettingsPath(o.ID)), i18n.T(ctx, "nav.members"))
			<h1>{ i18n.T(ctx, "teams.title") } { o.Name }</h1>
			@helpPanel("teams", "teams")
			// ошибка показывается здесь, только если не от формы создания команды — та уезжает в модалку.
			if errMsg != "" && !form.Has() {
				<p class="error">{ errMsg }</p>
			}
			@createTrigger("new-team", "teams.create.title")
			<div class="settings-grid">
			if len(teams) == 0 {
				@emptyState("building", "teams.empty.title", "teams.empty.body", "", "", 2)
			} else {
				for _, tm := range teams {
					@teamSection(tm, orgMembers, orgProjects, form, errMsg)
				}
			}
			</div>
			@createModalOpen("new-team", "teams.create.title", false, form.Opens("new-team")) {
				<form method="post" action={ templ.URL(orgTeamsPath(o.ID)) } class="team-create-form">
					// без role=alert: фокус в модалку переносит modal.js, ошибка привязана через aria-describedby.
					if errMsg != "" && form.Opens("new-team") {
						<p class="error" id="new-team-error">{ errMsg }</p>
					}
					<div class="field">
						<label>
							{ i18n.T(ctx, "teams.create.slug_label") }
							<input
								type="text"
								name="slug"
								placeholder="backend"
								autocomplete="off"
								required
								class="input"
								value={ form.Get("slug", "") }
								if errMsg != "" && form.Opens("new-team") {
									aria-invalid="true"
									aria-describedby="new-team-error"
								}
							/>
						</label>
					</div>
					<div class="field">
						<label>
							{ i18n.T(ctx, "teams.create.name_label") }
							<input type="text" name="name" placeholder={ i18n.T(ctx, "teams.create.name_placeholder") } required class="input" value={ form.Get("name", "") }/>
						</label>
					</div>
					<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "teams.create.submit") }</button>
				</form>
			}
		</div>
	}
}
