package templates

import (
	"context"
	"strconv"
	"time"

	"gitflic.ru/otezvikentiy/gotcha/internal/host"
	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/metric"
)

// Empty=true — данных совсем нет; «пусто в выбранном окне» рисует сам
// multiSeriesMarkup текстом внутри SVG, это разные состояния.
type HostChartVM struct {
	Key       string // "cpu"/"mem"/"disk_usage"/"disk_io"/"net"/"load"/"proc"
	Empty     bool
	Chart     templ.Component
	Legend    []LegendItem
	Truncated bool // top-8 групп (SeriesGrouped/SeriesGroupedRate) — есть отброшенные
}

type HostDetailVM struct {
	ProjectID  int64
	Host       host.Host
	Range      TimeRangeVM
	StatusKind string // "problem"/"silent"/"ok" — см. hostRowStatus (web/hosts.go)
	// виды открытых инцидентов, КРОМЕ silent — тот сворачивается в отдельный
	// тир и текстом бейджа "problem" не участвует.
	ProblemKinds    []string
	OpenIncidents   []host.Incident
	RecentIncidents []host.Incident
	Charts          []HostChartVM
	ChartsFailed    bool
	CanOperate      bool
	// ключ — id пользователя (host.Incident.AcknowledgedBy).
	AckedBy map[int64]string
	// пустая строка — хост ещё не отчитался этой метрикой: блок не
	// рендерится, а не показывает «0».
	Uptime string
	// задублирована, а не читается из vm.Host.AgentVersion: контракт карточки
	// переиспользуют другие VM, не всегда несущие host.Host целиком.
	AgentVersion string
	// честный сигнал независимо от того, можно ли безопасно предложить команду.
	AgentUpdateAvailable bool
	// пусто, если путь агента недоступен — раздача не настроена или
	// BaseURL не https/локальный.
	AgentUpdateCmd string
	ServerVersion  string
	IsNew          bool

	// nil-поля Override = «наследовать» на этом виде.
	Override host.ThresholdOverride
	// каскад host-override → role-group → env-group → project → default,
	// отдельно по каждому из 4 видов.
	Effective host.EffectiveSettings
	// nil на первом открытии — поля берут значения из Override/Effective.
	ThresholdsForm FormState
	ThresholdsErr  string
}

func hostDeleteLink(projectID int64, name string) string {
	return hostLink(projectID, name) + "/delete"
}

func hostThresholdsPath(projectID int64, name string) string {
	return hostLink(projectID, name) + "/thresholds"
}

// якорь захардкожен (templates не может импортировать internal/docs) и
// разный на два языка — сверять руками с заголовком в docs/{ru,en}/hosts.md.
func hostThresholdCascadeDocsLink(ctx context.Context) string {
	if i18n.FromContext(ctx).Code == "en" {
		return "/docs/hosts#thresholds-cascade-and-overrides"
	}
	return "/docs/hosts#porogi-kaskad-i-pereopredelenie"
}

func thresholdMode(enabled *bool) string {
	if enabled == nil {
		return "inherit"
	}
	if *enabled {
		return "override"
	}
	return "off"
}

func thresholdModeFor(form FormState, field string, current *bool) string {
	return form.Get(field, thresholdMode(current))
}

// без override — текущее эффективное значение каскада, не ноль: переключение
// radio на "Переопределить" начинается с уже действующего числа.
func thresholdPercentValue(ov *float64, effective float64) string {
	if ov != nil {
		return settingsPercentDefault(*ov)
	}
	return settingsPercentDefault(effective)
}

func thresholdFloatValue(ov *float64, effective float64) string {
	if ov != nil {
		return settingsFloatDefault(*ov)
	}
	return settingsFloatDefault(effective)
}

func thresholdMinutesValue(ov *time.Duration, effective time.Duration) string {
	if ov != nil {
		return settingsMinutesDefault(*ov)
	}
	return settingsMinutesDefault(effective)
}

// value — сырое значение вида: доля для disk/memory, число для load, СЕКУНДЫ
// для silent (вызывающий передаёт SilentAfter.Seconds()).
func thresholdEffectiveLabel(ctx context.Context, kind string, enabled bool, value float64, src host.ThresholdSource) string {
	valueText := i18n.T(ctx, "host.threshold.off_value")
	if enabled {
		valueText = host.ValueLabel(ctx, kind, value)
	}
	return i18n.Tf(ctx, "host.threshold.effective_from."+string(src.Level), "value", valueText, "label", src.Label)
}

templ hostThresholdsSection(vm HostDetailVM) {
	<section class="host-thresholds">
		<h2>{ i18n.T(ctx, "host.threshold.title") }</h2>
		<p class="hint"><a href={ templ.URL(hostThresholdCascadeDocsLink(ctx)) }>{ i18n.T(ctx, "host.threshold.cascade_help") }</a></p>
		if vm.ThresholdsErr != "" {
			<p class="error" id="host-thresholds-error">{ vm.ThresholdsErr }</p>
		}
		if vm.CanOperate {
			<form method="post" action={ templ.URL(hostThresholdsPath(vm.ProjectID, vm.Host.Name)) } class="host-thresholds-form">
				<div class="threshold-grid">
					<fieldset class="card th-kind">
						<legend class="card-header">{ i18n.T(ctx, "host.threshold.disk") }</legend>
						<p class="hint">{ thresholdEffectiveLabel(ctx, "disk", vm.Effective.Settings.DiskEnabled, vm.Effective.Settings.DiskThreshold, vm.Effective.DiskSource) }</p>
						<div class="segmented">
							<label>
								<input type="radio" name="disk_mode" value="inherit" checked?={ thresholdModeFor(vm.ThresholdsForm, "disk_mode", vm.Override.DiskEnabled) == "inherit" }/>
								{ i18n.T(ctx, "host.threshold.inherit") }
							</label>
							<label>
								<input type="radio" name="disk_mode" value="override" checked?={ thresholdModeFor(vm.ThresholdsForm, "disk_mode", vm.Override.DiskEnabled) == "override" }/>
								{ i18n.T(ctx, "host.threshold.override") }
							</label>
							<label>
								<input type="radio" name="disk_mode" value="off" checked?={ thresholdModeFor(vm.ThresholdsForm, "disk_mode", vm.Override.DiskEnabled) == "off" }/>
								{ i18n.T(ctx, "host.threshold.off") }
							</label>
						</div>
						<div class="field th-disk-value">
							<label>
								{ i18n.T(ctx, "hosts.settings.field.disk_threshold") }
								<input type="number" class="input" name="disk_value" min="1" max="99" step="1"
									value={ vm.ThresholdsForm.Get("disk_value", thresholdPercentValue(vm.Override.DiskThreshold, vm.Effective.Settings.DiskThreshold)) }/>
							</label>
						</div>
					</fieldset>
					<fieldset class="card th-kind">
						<legend class="card-header">{ i18n.T(ctx, "host.threshold.memory") }</legend>
						<p class="hint">{ thresholdEffectiveLabel(ctx, "memory", vm.Effective.Settings.MemoryEnabled, vm.Effective.Settings.MemoryThreshold, vm.Effective.MemorySource) }</p>
						<div class="segmented">
							<label>
								<input type="radio" name="memory_mode" value="inherit" checked?={ thresholdModeFor(vm.ThresholdsForm, "memory_mode", vm.Override.MemoryEnabled) == "inherit" }/>
								{ i18n.T(ctx, "host.threshold.inherit") }
							</label>
							<label>
								<input type="radio" name="memory_mode" value="override" checked?={ thresholdModeFor(vm.ThresholdsForm, "memory_mode", vm.Override.MemoryEnabled) == "override" }/>
								{ i18n.T(ctx, "host.threshold.override") }
							</label>
							<label>
								<input type="radio" name="memory_mode" value="off" checked?={ thresholdModeFor(vm.ThresholdsForm, "memory_mode", vm.Override.MemoryEnabled) == "off" }/>
								{ i18n.T(ctx, "host.threshold.off") }
							</label>
						</div>
						<div class="field th-memory-value">
							<label>
								{ i18n.T(ctx, "hosts.settings.field.memory_threshold") }
								<input type="number" class="input" name="memory_value" min="1" max="99" step="1"
									value={ vm.ThresholdsForm.Get("memory_value", thresholdPercentValue(vm.Override.MemoryThreshold, vm.Effective.Settings.MemoryThreshold)) }/>
							</label>
						</div>
					</fieldset>
					<fieldset class="card th-kind">
						<legend class="card-header">{ i18n.T(ctx, "host.threshold.load") }</legend>
						<p class="hint">{ thresholdEffectiveLabel(ctx, "load", vm.Effective.Settings.LoadEnabled, vm.Effective.Settings.LoadThreshold, vm.Effective.LoadSource) }</p>
						<div class="segmented">
							<label>
								<input type="radio" name="load_mode" value="inherit" checked?={ thresholdModeFor(vm.ThresholdsForm, "load_mode", vm.Override.LoadEnabled) == "inherit" }/>
								{ i18n.T(ctx, "host.threshold.inherit") }
							</label>
							<label>
								<input type="radio" name="load_mode" value="override" checked?={ thresholdModeFor(vm.ThresholdsForm, "load_mode", vm.Override.LoadEnabled) == "override" }/>
								{ i18n.T(ctx, "host.threshold.override") }
							</label>
							<label>
								<input type="radio" name="load_mode" value="off" checked?={ thresholdModeFor(vm.ThresholdsForm, "load_mode", vm.Override.LoadEnabled) == "off" }/>
								{ i18n.T(ctx, "host.threshold.off") }
							</label>
						</div>
						<div class="field th-load-value">
							<label>
								{ i18n.T(ctx, "hosts.settings.field.load_threshold") }
								<input type="number" class="input" name="load_value" min="0.1" step="0.1"
									value={ vm.ThresholdsForm.Get("load_value", thresholdFloatValue(vm.Override.LoadThreshold, vm.Effective.Settings.LoadThreshold)) }/>
							</label>
						</div>
					</fieldset>
					<fieldset class="card th-kind">
						<legend class="card-header">{ i18n.T(ctx, "host.threshold.silent") }</legend>
						<p class="hint">{ thresholdEffectiveLabel(ctx, "silent", vm.Effective.Settings.SilentEnabled, vm.Effective.Settings.SilentAfter.Seconds(), vm.Effective.SilentSource) }</p>
						<div class="segmented">
							<label>
								<input type="radio" name="silent_mode" value="inherit" checked?={ thresholdModeFor(vm.ThresholdsForm, "silent_mode", vm.Override.SilentEnabled) == "inherit" }/>
								{ i18n.T(ctx, "host.threshold.inherit") }
							</label>
							<label>
								<input type="radio" name="silent_mode" value="override" checked?={ thresholdModeFor(vm.ThresholdsForm, "silent_mode", vm.Override.SilentEnabled) == "override" }/>
								{ i18n.T(ctx, "host.threshold.override") }
							</label>
							<label>
								<input type="radio" name="silent_mode" value="off" checked?={ thresholdModeFor(vm.ThresholdsForm, "silent_mode", vm.Override.SilentEnabled) == "off" }/>
								{ i18n.T(ctx, "host.threshold.off") }
							</label>
						</div>
						<div class="field th-silent-value">
							<label>
								{ i18n.T(ctx, "hosts.settings.field.silent_after") }
								<input type="number" class="input" name="silent_value" min="3" max="720" step="1"
									value={ vm.ThresholdsForm.Get("silent_value", thresholdMinutesValue(vm.Override.SilentAfter, vm.Effective.Settings.SilentAfter)) }/>
							</label>
						</div>
					</fieldset>
				</div>
				<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "hosts.settings.submit") }</button>
			</form>
		} else {
			<ul class="host-thresholds-readonly">
				<li>{ i18n.T(ctx, "host.threshold.disk") }: { thresholdEffectiveLabel(ctx, "disk", vm.Effective.Settings.DiskEnabled, vm.Effective.Settings.DiskThreshold, vm.Effective.DiskSource) }</li>
				<li>{ i18n.T(ctx, "host.threshold.memory") }: { thresholdEffectiveLabel(ctx, "memory", vm.Effective.Settings.MemoryEnabled, vm.Effective.Settings.MemoryThreshold, vm.Effective.MemorySource) }</li>
				<li>{ i18n.T(ctx, "host.threshold.load") }: { thresholdEffectiveLabel(ctx, "load", vm.Effective.Settings.LoadEnabled, vm.Effective.Settings.LoadThreshold, vm.Effective.LoadSource) }</li>
				<li>{ i18n.T(ctx, "host.threshold.silent") }: { thresholdEffectiveLabel(ctx, "silent", vm.Effective.Settings.SilentEnabled, vm.Effective.Settings.SilentAfter.Seconds(), vm.Effective.SilentSource) }</li>
			</ul>
		}
	</section>
}

templ hostChartCard(c HostChartVM) {
	<div class="card host-chart-card" data-chart={ c.Key }>
		<h2>{ i18n.T(ctx, "hosts.chart."+c.Key) }</h2>
		if c.Empty {
			<div class="empty-state">
				@icon("chart")
				<p>{ i18n.Tf(ctx, "hosts.chart.empty", "scraper", i18n.T(ctx, "hosts.scraper_hint."+c.Key)) }</p>
			</div>
		} else {
			@scrollRegion("metric-chart-wrap", "hosts.chart."+c.Key) {
				@c.Chart
			}
			if len(c.Legend) > 0 {
				@chartLegend(c.Legend)
			}
			if c.Truncated {
				<p class="hint">{ i18n.Tf(ctx, "hosts.chart.top_groups", "n", strconv.Itoa(metric.MaxSeriesGroups)) }</p>
			}
		}
	</div>
}

templ hostStatusText(kind string, problemKinds []string) {
	switch kind {
		case "problem":
			for i, k := range problemKinds {
				if i > 0 {
					{ ", " }
				}
				{ i18n.T(ctx, "hosts.kind."+k) }
			}
		case "silent":
			{ i18n.T(ctx, "hosts.status.silent") }
		default:
			{ i18n.T(ctx, "hosts.status.ok") }
	}
}

// host.ValueLabel, не fmtFloat: формат зависит от вида порога — доля для
// disk/memory процентом, load множителем ядра, тишина длительностью.
templ hostOpenIncidentRow(inc host.Incident, projectID int64, canOperate bool, ackedBy map[int64]string) {
	<li class="host-incident-open">
		<span class={ hostStatusBadgeClass("problem") }>{ i18n.T(ctx, "hosts.kind."+inc.Kind) }</span>
		@incidentSeverityBadge(inc.Severity)
		if inc.SuppressedByDep {
			<span class="badge">{ i18n.T(ctx, "incident.badge.suppressed_by_dep") }</span>
		}
		{ host.ValueLabel(ctx, inc.Kind, inc.CurrentValue) }
		if inc.Detail != "" {
			<span class="hint">({ inc.Detail })</span>
		}
		@relativeTime(inc.StartedAt)
		@ackControl(projectID, "host", inc.ID, canOperate, inc.AcknowledgedAt, ackedByEmailOf(inc.AcknowledgedBy, ackedBy))
	</li>
}

templ hostIncidentRow(inc host.Incident) {
	<tr>
		<td>
			@incidentStatusBadge(inc.Status)
			if inc.SuppressedByDep {
				<span class="badge">{ i18n.T(ctx, "incident.badge.suppressed_by_dep") }</span>
			}
		</td>
		<td>{ i18n.T(ctx, "hosts.kind."+inc.Kind) }</td>
		<td>@incidentSeverityBadge(inc.Severity)</td>
		<td class="num">{ host.ValueLabel(ctx, inc.Kind, inc.PeakValue) }</td>
		<td class="num">{ host.ValueLabel(ctx, inc.Kind, inc.CurrentValue) }</td>
		<td>@relativeTime(inc.StartedAt)</td>
	</tr>
}

templ HostDetail(vm HostDetailVM, userEmail string) {
	@layout(vm.Host.Name, userEmail) {
		<div class="host-detail">
			@breadcrumbBackTo(templ.URL(hostsBasePath(vm.ProjectID)), i18n.T(ctx, "nav.hosts"))
			<h1>{ vm.Host.Name }</h1>
			<span class={ hostStatusBadgeClass(vm.StatusKind) }>@hostStatusText(vm.StatusKind, vm.ProblemKinds)</span>
			if vm.IsNew {
				<span class="badge badge-info">{ i18n.T(ctx, "hosts.badge.new") }</span>
			}
			if vm.Host.Environment != "" {
				<span class="badge badge-neutral" title={ i18n.T(ctx, "hosts.col.environment") }>{ vm.Host.Environment }</span>
			}
			if vm.Host.Role != "" {
				<span class="badge badge-neutral" title={ i18n.T(ctx, "hosts.col.role") }>{ vm.Host.Role }</span>
			}
			<p class="logs-link"><a href={ templ.URL(logsForHostPath(vm.ProjectID, vm.Host.Name)) }>{ i18n.T(ctx, "hosts.detail.view_logs") }</a></p>

			<div class="monitor-meta">
				<div class="stat-tile">
					<div class="stat-label">{ i18n.T(ctx, "hosts.detail.last_seen") }</div>
					<div class="stat-value">@relativeTime(vm.Host.LastSeen)</div>
				</div>
				<div class="stat-tile">
					<div class="stat-label">{ i18n.T(ctx, "hosts.detail.first_seen") }</div>
					<div class="stat-value">@relativeTime(vm.Host.FirstSeen)</div>
				</div>
				if vm.Uptime != "" {
					<div class="stat-tile">
						<div class="stat-label">{ i18n.T(ctx, "hosts.detail.uptime") }</div>
						<div class="stat-value">{ vm.Uptime }</div>
					</div>
				}
				if vm.AgentVersion != "" {
					<div class="stat-tile">
						<div class="stat-label">{ i18n.T(ctx, "hosts.detail.agent_version") }</div>
						<div class="stat-value">
							{ vm.AgentVersion }
							if vm.AgentUpdateAvailable {
								<span class="badge badge-info">{ i18n.T(ctx, "hosts.detail.agent_update") }</span>
							}
						</div>
					</div>
				}
			</div>
			if vm.AgentUpdateAvailable && vm.AgentUpdateCmd != "" {
				<details class="host-agent-update">
					<summary>{ i18n.Tf(ctx, "hosts.detail.agent_update_howto", "version", vm.ServerVersion) }</summary>
					@copyBlock("host-agent-update", "hosts.copy.command", vm.AgentUpdateCmd)
				</details>
			}

			<form method="get" class="metric-filters">
				<label>
					{ i18n.T(ctx, "metrics.filter.period") }
					@timeRangeFields(vm.Range)
				</label>
				<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "metrics.filter.apply") }</button>
			</form>

			<section class="host-incidents-open">
				<h2>{ i18n.T(ctx, "hosts.detail.incidents_open") }</h2>
				if len(vm.OpenIncidents) == 0 {
					<p class="hint">{ i18n.T(ctx, "hosts.detail.incidents_open_empty") }</p>
				} else {
					<ul class="host-incident-list">
						for _, inc := range vm.OpenIncidents {
							@hostOpenIncidentRow(inc, vm.ProjectID, vm.CanOperate, vm.AckedBy)
						}
					</ul>
				}
			</section>

			if vm.ChartsFailed {
				@emptyState("chart", "hosts.charts.error.title", "hosts.charts.error.body", "", "", 2)
			} else {
				<div class="host-charts">
					for _, c := range vm.Charts {
						@hostChartCard(c)
					}
				</div>
			}

			<section class="host-incidents-recent">
				<h2>{ i18n.T(ctx, "hosts.detail.incidents_recent") }</h2>
				if len(vm.RecentIncidents) == 0 {
					// не emptyState: он печатает свой <h3> тем же ключом, что <h2>
					// секции — заголовок шёл бы дважды подряд.
					<p class="hint">{ i18n.T(ctx, "hosts.detail.incidents_empty") }</p>
				} else {
					<div class="card">
						@scrollRegion("table-scroll", "hosts.detail.incidents_recent") {
							<table class="data-table">
								<thead>
									<tr>
										<th scope="col">{ i18n.T(ctx, "metrics.alerts.table.status") }</th>
										<th scope="col">{ i18n.T(ctx, "hosts.table.kind") }</th>
										<th scope="col">{ i18n.T(ctx, "incidents.table.severity") }</th>
										<th scope="col" class="num">{ i18n.T(ctx, "metrics.alerts.table.peak") }</th>
										<th scope="col" class="num">{ i18n.T(ctx, "metrics.alerts.table.current") }</th>
										<th scope="col">{ i18n.T(ctx, "metrics.alerts.table.started") }</th>
									</tr>
								</thead>
								<tbody>
									for _, inc := range vm.RecentIncidents {
										@hostIncidentRow(inc)
									}
								</tbody>
							</table>
						}
					</div>
				}
			</section>

			@hostThresholdsSection(vm)

			if vm.CanOperate {
				<form method="post" action={ templ.URL(hostDeleteLink(vm.ProjectID, vm.Host.Name)) } class="host-actions">
					<button type="submit" class="btn btn-danger">{ i18n.T(ctx, "hosts.detail.delete") }</button>
				</form>
			}
		</div>
	}
}
