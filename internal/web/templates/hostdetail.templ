package templates

import (
	"strconv"

	"gitflic.ru/otezvikentiy/gotcha/internal/host"
	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/metric"
)

// HostChartVM — один график карточки хоста: либо готовый SVG + легенда
// (Empty=false), либо пустое состояние с подсказкой требуемого скрейпера
// (Empty=true) — «данных совсем нет», а не «пусто в выбранном окне» (это
// нарисует сам multiSeriesMarkup текстом внутри SVG).
type HostChartVM struct {
	Key       string // "cpu"/"mem"/"disk_usage"/"disk_io"/"net"/"load"/"proc"
	Empty     bool
	Chart     templ.Component
	Legend    []LegendItem
	Truncated bool // top-8 групп (SeriesGrouped/SeriesGroupedRate) — есть отброшенные
}

// HostDetailVM — GET /projects/{id}/hosts/{name}: карточка хоста.
type HostDetailVM struct {
	ProjectID  int64
	Host       host.Host
	Range      TimeRangeVM
	StatusKind string // "problem"/"silent"/"ok" — см. hostRowStatus (web/hosts.go)
	// ProblemKinds — виды открытых инцидентов, КРОМЕ silent (см. комментарий
	// hostRowStatus): подпись бейджа "problem" перечисляет именно их, silent
	// сворачивается в отдельный тир и текстом бейджа не участвует.
	ProblemKinds    []string
	OpenIncidents   []host.Incident
	RecentIncidents []host.Incident
	Charts          []HostChartVM
	CanOperate      bool
	// Uptime — гуманизированное «сколько хост живёт» (humanize.Duration),
	// последнее значение system.uptime за hostsListWindow. Пустая строка —
	// хост ещё не отчитался этой метрикой (агент/коллектор не настроены или
	// запрос не удался) — блок не рендерится, а не показывает «0».
	Uptime string
	// AgentVersion — версия собственного Go-агента (A2), уже пришедшая с
	// хоста (host.Host.AgentVersion). Задублирована здесь, а не читается из
	// vm.Host.AgentVersion в шаблоне: тот же контракт карточки хоста
	// переиспользуют другие VM (T14+), не всегда несущие host.Host целиком.
	AgentVersion string
	// AgentUpdateAvailable — версия агента строго старше версии сервера (см.
	// agentUpdateAvailable, hosts.go): включает бейдж "есть обновление" —
	// честный сигнал независимо от того, можно ли безопасно предложить команду.
	AgentUpdateAvailable bool
	// AgentUpdateCmd — готовая команда переустановки install.sh (см.
	// agentUpdateCommand, hosts.go). Пусто, если путь агента недоступен
	// (раздача не сконфигурирована — sec-M1 — или BaseURL не https/локальный —
	// sec-M4): свёрнутый блок с инструкцией рендерится только когда команда
	// непуста, отдельно от бейджа (AgentUpdateAvailable).
	AgentUpdateCmd string
	// ServerVersion — версия самого сервера (version.Version(), hosts.go), та
	// же, с которой сверяется AgentUpdateAvailable. Подставляется в заголовок
	// блока "Как обновить агента до {version}" (rem-E ux-L16): бейдж
	// "Есть обновление" сам по себе не называл целевую версию.
	ServerVersion string
}

func hostDeleteLink(projectID int64, name string) string {
	return hostLink(projectID, name) + "/delete"
}

// hostChartCard — карточка одного графика: заголовок, SVG+легенда либо
// пустое состояние со скрейпером, подпись усечения топ-8. data-chart —
// маркер для тестов (см. TestWebHostDetail*) и потенциальных якорей ссылок.
templ hostChartCard(c HostChartVM) {
	<div class="card host-chart-card" data-chart={ c.Key }>
		<h2>{ i18n.T(ctx, "hosts.chart."+c.Key) }</h2>
		if c.Empty {
			<div class="empty-state">
				@icon("chart")
				<p>{ i18n.Tf(ctx, "hosts.chart.empty", "scraper", i18n.T(ctx, "hosts.scraper_hint."+c.Key)) }</p>
			</div>
		} else {
			@scrollRegion("metric-chart-wrap", "hosts.chart."+c.Key) {
				@c.Chart
			}
			if len(c.Legend) > 0 {
				@chartLegend(c.Legend)
			}
			if c.Truncated {
				<p class="hint">{ i18n.Tf(ctx, "hosts.chart.top_groups", "n", strconv.Itoa(metric.MaxSeriesGroups)) }</p>
			}
		}
	</div>
}

// hostStatusText — текст статус-бейджа карточки (без класса — тот берёт
// hostStatusBadgeClass из hosts.templ, тот же набор классов). "problem"
// перечисляет ProblemKinds (silent туда не входит, см. HostDetailVM) — та же
// логика, что в HostsList.
templ hostStatusText(kind string, problemKinds []string) {
	switch kind {
		case "problem":
			for i, k := range problemKinds {
				if i > 0 {
					{ ", " }
				}
				{ i18n.T(ctx, "hosts.kind."+k) }
			}
		case "silent":
			{ i18n.T(ctx, "hosts.status.silent") }
		default:
			{ i18n.T(ctx, "hosts.status.ok") }
	}
}

// Значения инцидентов печатает host.ValueLabel, а не fmtFloat (UX-аудит A1,
// P1-3): формат зависит от ВИДА порога — диск/память в процентах, нагрузка
// множителем ядра, тишина длительностью. Через fmtFloat диск на карточке
// выглядел как «0.93» при «93%» в списке строкой выше, а тишина — как «3.6K»
// (секунды без единицы). Таблица «вид → формат» одна на карточку и на текст
// уведомления, см. докблок host.ValueLabel.
templ hostOpenIncidentRow(inc host.Incident) {
	<li class="host-incident-open">
		<span class={ hostStatusBadgeClass("problem") }>{ i18n.T(ctx, "hosts.kind."+inc.Kind) }</span>
		{ host.ValueLabel(ctx, inc.Kind, inc.CurrentValue) }
		if inc.Detail != "" {
			<span class="hint">({ inc.Detail })</span>
		}
		@relativeTime(inc.StartedAt)
	</li>
}

templ hostIncidentRow(inc host.Incident) {
	<tr>
		<td>@incidentStatusBadge(inc.Status)</td>
		<td>{ i18n.T(ctx, "hosts.kind."+inc.Kind) }</td>
		<td class="num">{ host.ValueLabel(ctx, inc.Kind, inc.PeakValue) }</td>
		<td class="num">{ host.ValueLabel(ctx, inc.Kind, inc.CurrentValue) }</td>
		<td>@relativeTime(inc.StartedAt)</td>
	</tr>
}

// HostDetail — GET /projects/{id}/hosts/{name}: карточка хоста (§5.3).
templ HostDetail(vm HostDetailVM, userEmail string) {
	@layout(vm.Host.Name, userEmail) {
		<div class="host-detail">
			@breadcrumbBackTo(templ.URL(hostsBasePath(vm.ProjectID)), i18n.T(ctx, "nav.hosts"))
			<h1>{ vm.Host.Name }</h1>
			<span class={ hostStatusBadgeClass(vm.StatusKind) }>@hostStatusText(vm.StatusKind, vm.ProblemKinds)</span>
			<p class="event-logs-link"><a href={ templ.URL(logsForHostPath(vm.ProjectID, vm.Host.Name)) }>{ i18n.T(ctx, "hosts.detail.view_logs") }</a></p>

			<div class="monitor-meta">
				<div class="stat-tile">
					<div class="stat-label">{ i18n.T(ctx, "hosts.detail.last_seen") }</div>
					<div class="stat-value">@relativeTime(vm.Host.LastSeen)</div>
				</div>
				<div class="stat-tile">
					<div class="stat-label">{ i18n.T(ctx, "hosts.detail.first_seen") }</div>
					<div class="stat-value">@relativeTime(vm.Host.FirstSeen)</div>
				</div>
				if vm.Uptime != "" {
					<div class="stat-tile">
						<div class="stat-label">{ i18n.T(ctx, "hosts.detail.uptime") }</div>
						<div class="stat-value">{ vm.Uptime }</div>
					</div>
				}
				if vm.AgentVersion != "" {
					<div class="stat-tile">
						<div class="stat-label">{ i18n.T(ctx, "hosts.detail.agent_version") }</div>
						<div class="stat-value">
							{ vm.AgentVersion }
							if vm.AgentUpdateAvailable {
								<span class="badge badge-info">{ i18n.T(ctx, "hosts.detail.agent_update") }</span>
							}
						</div>
					</div>
				}
			</div>
			if vm.AgentUpdateAvailable && vm.AgentUpdateCmd != "" {
				<details class="host-agent-update">
					<summary>{ i18n.Tf(ctx, "hosts.detail.agent_update_howto", "version", vm.ServerVersion) }</summary>
					@copyBlock("host-agent-update", "hosts.copy.command", vm.AgentUpdateCmd)
				</details>
			}

			<form method="get" class="metric-filters">
				<label>
					{ i18n.T(ctx, "metrics.filter.period") }
					@timeRangeFields(vm.Range)
				</label>
				<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "metrics.filter.apply") }</button>
			</form>

			<section class="host-incidents-open">
				<h2>{ i18n.T(ctx, "hosts.detail.incidents_open") }</h2>
				if len(vm.OpenIncidents) == 0 {
					<p class="hint">{ i18n.T(ctx, "hosts.detail.incidents_open_empty") }</p>
				} else {
					<ul class="host-incident-list">
						for _, inc := range vm.OpenIncidents {
							@hostOpenIncidentRow(inc)
						}
					</ul>
				}
			</section>

			<div class="host-charts">
				for _, c := range vm.Charts {
					@hostChartCard(c)
				}
			</div>

			<section class="host-incidents-recent">
				<h2>{ i18n.T(ctx, "hosts.detail.incidents_recent") }</h2>
				if len(vm.RecentIncidents) == 0 {
					// Подсказка строкой, а не emptyState (UX-аудит A1, P2-1):
					// emptyState печатает свой <h3> тем же ключом, что <h2>
					// секции, — заголовок «Последние инциденты» шёл дважды
					// подряд. Соседний блок открытых инцидентов пустое
					// состояние показывает ровно так же, одной строкой.
					<p class="hint">{ i18n.T(ctx, "hosts.detail.incidents_empty") }</p>
				} else {
					<div class="card">
						@scrollRegion("table-scroll", "hosts.detail.incidents_recent") {
							<table class="data-table">
								<thead>
									<tr>
										<th scope="col">{ i18n.T(ctx, "metrics.alerts.table.status") }</th>
										<th scope="col">{ i18n.T(ctx, "hosts.table.kind") }</th>
										<th scope="col" class="num">{ i18n.T(ctx, "metrics.alerts.table.peak") }</th>
										<th scope="col" class="num">{ i18n.T(ctx, "metrics.alerts.table.current") }</th>
										<th scope="col">{ i18n.T(ctx, "metrics.alerts.table.started") }</th>
									</tr>
								</thead>
								<tbody>
									for _, inc := range vm.RecentIncidents {
										@hostIncidentRow(inc)
									}
								</tbody>
							</table>
						}
					</div>
				}
			</section>

			if vm.CanOperate {
				<form method="post" action={ templ.URL(hostDeleteLink(vm.ProjectID, vm.Host.Name)) } class="host-actions">
					<button type="submit" class="btn btn-danger">{ i18n.T(ctx, "hosts.detail.delete") }</button>
				</form>
			}
		</div>
	}
}
