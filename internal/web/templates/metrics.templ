package templates

import (
	"net/url"
	"strconv"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/metric"
)

func metricsBasePath(projectID int64) string {
	return "/projects/" + strconv.FormatInt(projectID, 10) + "/metrics"
}

func metricLink(projectID int64, name string) string {
	return metricsBasePath(projectID) + "/" + url.PathEscape(name)
}

func metricsSystemToggleURL(projectID int64, environment string, showSystem bool) string {
	q := url.Values{}
	if environment != "" {
		q.Set("environment", environment)
	}
	if showSystem {
		q.Set("system", "1")
	}
	u := metricsBasePath(projectID)
	if enc := q.Encode(); enc != "" {
		u += "?" + enc
	}
	return u
}

// hiddenCount — метрик system.* скрыто; 0 без хостов означает, что переключатель не рисуется.
templ MetricsList(projectID int64, metrics []metric.MetricInfo, environment, userEmail string, showSystem bool, hiddenCount int, loadFailed bool) {
	@layout(i18n.T(ctx, "metrics.title"), userEmail) {
		<div class="metrics">
			<h1>{ i18n.T(ctx, "metrics.title") }</h1>
			@helpPanel("metrics", "metrics")
			if loadFailed {
				@emptyState("chart", "metrics.error.title", "metrics.error.body", "", "", 2)
			} else if len(metrics) == 0 && hiddenCount == 0 {
				@emptyState("chart", "metrics.empty.title", "metrics.empty.body", "metrics.empty.cta", "/docs/metrics", 2)
			} else if len(metrics) == 0 {
				<div class="card">
					<div class="empty-state">
						@icon("chart")
						<h3 class="empty-title">{ i18n.T(ctx, "metrics.empty.system_only.title") }</h3>
						<p>{ i18n.T(ctx, "metrics.empty.system_only.body") }</p>
						<a class="btn btn-primary empty-cta" href={ templ.URL(metricsSystemToggleURL(projectID, environment, true)) }>{ i18n.Tn(ctx, "metrics.system.show_toggle", hiddenCount) }</a>
					</div>
				</div>
			} else {
				<div class="card">
				if hiddenCount > 0 {
					if showSystem {
						<p class="frames-toggle"><a href={ templ.URL(metricsSystemToggleURL(projectID, environment, false)) }>{ i18n.T(ctx, "metrics.system.hide_toggle") }</a></p>
					} else {
						<p class="frames-toggle"><a href={ templ.URL(metricsSystemToggleURL(projectID, environment, true)) }>{ i18n.Tn(ctx, "metrics.system.show_toggle", hiddenCount) }</a></p>
						<p class="hint">{ i18n.T(ctx, "hosts.see_hosts_hint") }<a href={ templ.URL(hostsBasePath(projectID)) }>{ i18n.T(ctx, "nav.hosts") }</a>{ i18n.T(ctx, "hosts.see_hosts_hint_suffix") }</p>
					}
				}
				@scrollRegion("table-scroll", "metrics.title") {
						<table class="data-table">
							<thead>
								<tr>
									<th scope="col">{ i18n.T(ctx, "metrics.table.metric") }</th>
									<th scope="col">{ i18n.T(ctx, "metrics.table.type") }</th>
									<th scope="col" class="num">{ i18n.T(ctx, "metrics.table.unit") }</th>
								</tr>
							</thead>
							<tbody>
								for _, m := range metrics {
									<tr>
										<td><a href={ templ.URL(metricLink(projectID, m.Name)) }>{ m.Name }</a></td>
										<td>{ i18n.T(ctx, "metrics.type."+m.Type) }</td>
										<td class="num">{ metricUnitText(m.Unit) }</td>
									</tr>
								}
							</tbody>
						</table>
				}
				</div>
			}
		</div>
	}
}

type MetricDetailVM struct {
	ProjectID    int64
	Info         metric.MetricInfo
	Range        TimeRangeVM
	Agg          string
	Environment  string
	Environments []string
	Labels       map[string][]string
	LabelKey     string
	LabelValue   string
	Chart        templ.Component
	Percentiles  bool // histogram → доступны p50/p95/p99
	// LoadFailed — ClickHouse не ответил: вместо сводки/фильтров/графика — «данные недоступны».
	LoadFailed bool
}

// "1" по OTLP — безразмерная метрика: показывать её как юнит бессмысленно («ЮНИТ 1»).
func metricUnitText(unit string) string {
	if unit == "" || unit == "1" {
		return "—"
	}
	return unit
}

// Опции — подмножество закрытого metric.Aggregations (через metricAggFor) — переводить
// "metrics.aggregation."+a можно напрямую: группа сторожа i18n покрывает весь набор целиком.
func metricAggOptions(percentiles bool) []string {
	if percentiles {
		return []string{"p50", "p95", "p99", "avg"}
	}
	return []string{"avg", "max", "min", "sum"}
}

templ MetricDetail(vm MetricDetailVM, userEmail string) {
	@layout(i18n.Tf(ctx, "metrics.detail.title", "name", vm.Info.Name), userEmail) {
		<div class="metric-detail">
			@breadcrumbBackTo(templ.URL(metricsBasePath(vm.ProjectID)), i18n.T(ctx, "metrics.title"))
			<h1>{ vm.Info.Name }</h1>
			if vm.LoadFailed {
				@emptyState("chart", "metrics.error.title", "metrics.error.body", "", "", 2)
			} else {
			<div class="monitor-meta">
				<div class="stat-tile">
					<div class="stat-label">{ i18n.T(ctx, "metrics.table.type") }</div>
					<div class="stat-value">{ i18n.T(ctx, "metrics.type."+vm.Info.Type) }</div>
				</div>
				<div class="stat-tile">
					<div class="stat-label">{ i18n.T(ctx, "metrics.table.unit") }</div>
					<div class="stat-value">{ metricUnitText(vm.Info.Unit) }</div>
				</div>
			</div>
			<form method="get" class="metric-filters">
				<label>
					{ i18n.T(ctx, "metrics.filter.period") }
					@timeRangeFields(vm.Range)
				</label>
				<label>
					{ i18n.T(ctx, "metrics.filter.aggregation") }
					<select name="agg" class="select">
						for _, a := range metricAggOptions(vm.Percentiles) {
							if a == vm.Agg {
								<option value={ a } selected>{ i18n.T(ctx, "metrics.aggregation."+a) }</option>
							} else {
								<option value={ a }>{ i18n.T(ctx, "metrics.aggregation."+a) }</option>
							}
						}
					</select>
				</label>
				<label>
					{ i18n.T(ctx, "metrics.filter.environment") }
					<select name="environment" class="select">
						<option value="">{ i18n.T(ctx, "metrics.filter.env_all") }</option>
						for _, e := range vm.Environments {
							if e == vm.Environment {
								<option value={ e } selected>{ e }</option>
							} else {
								<option value={ e }>{ e }</option>
							}
						}
					</select>
				</label>
				if vm.LabelKey != "" {
					<input type="hidden" name="label_key" value={ vm.LabelKey }/>
					<input type="hidden" name="label_value" value={ vm.LabelValue }/>
				}
				<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "metrics.filter.apply") }</button>
			</form>
			@scrollRegion("metric-chart-wrap card", "region.metric.chart") {
				@vm.Chart
			}
			if len(vm.Labels) > 0 {
				<h2>{ i18n.T(ctx, "metrics.detail.labels") }</h2>
				<div class="metric-labels">
					for key, vals := range vm.Labels {
						<div class="metric-label-row">
							<span class="metric-label-key">{ key }</span>
							for _, v := range vals {
								<a class="chip" href={ templ.URL(metricLabelFilterURL(vm, key, v)) }>{ v }</a>
							}
						</div>
					}
				</div>
			}
			}
		</div>
	}
}

func metricLabelFilterURL(vm MetricDetailVM, key, value string) string {
	q := url.Values{}
	vm.Range.apply(q)
	q.Set("agg", vm.Agg)
	if vm.Environment != "" {
		q.Set("environment", vm.Environment)
	}
	q.Set("label_key", key)
	q.Set("label_value", value)
	return metricLink(vm.ProjectID, vm.Info.Name) + "?" + q.Encode()
}
