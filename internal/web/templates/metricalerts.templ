package templates

import (
	"context"
	"strconv"
	"time"

	"gitflic.ru/otezvikentiy/gotcha/internal/humanize"
	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/metric"
)

func metricAlertsBasePath(projectID int64) string {
	return "/projects/" + strconv.FormatInt(projectID, 10) + "/metrics/alerts"
}

func metricAlertUpdatePath(projectID, ruleID int64) string {
	return metricAlertsBasePath(projectID) + "/" + strconv.FormatInt(ruleID, 10)
}

const MetricRuleCreateModalID = "new-metric-rule"

// Построена на CSS :target — якорь обязан быть уникальным, id правила стабилен между рендерами.
// Экспортирована, чтобы обработчик мог переоткрыть нужную модалку после ошибки валидации.
func EditMetricRuleModalID(ruleID int64) string {
	return "edit-metric-rule-" + strconv.FormatInt(ruleID, 10)
}

// Модалок N+1, а состояние формы одно — без развилки введённое при ошибке попало бы во все сразу.
func metricRuleFormValues(form FormState, open bool, fallback FormState) FormState {
	if open {
		return form
	}
	return fallback
}

func metricRuleErrID(modalID string, open bool, errMsg string) string {
	if open && errMsg != "" {
		return modalID + "-error"
	}
	return ""
}

func metricRuleCreateDefaults() FormState { return FormState{"enabled": "on"} }

// Ключ enabled есть только у включённого правила — снятый чекбокс не шлётся в POST.
func ruleFormDefaults(r metric.Rule) FormState {
	f := FormState{
		"metric_name":    r.MetricName,
		"aggregation":    r.Aggregation,
		"comparator":     r.Comparator,
		"threshold":      strconv.FormatFloat(r.Threshold, 'g', -1, 64),
		"window_seconds": strconv.Itoa(r.WindowSeconds),
		"environment":    r.Environment,
		"label_key":      r.LabelKey,
		"label_value":    r.LabelValue,
		"severity":       r.Severity,
	}
	if r.Enabled {
		f["enabled"] = "on"
	}
	return f
}

// Компактная запись вместо strconv 'g' (иначе «avg > 8e+08» нечитаемо) — как на осях графиков.
func fmtFloat(v float64) string {
	return humanize.CompactNumber(v)
}

func comparatorSymbol(c string) string {
	if c == "lt" {
		return "<"
	}
	return ">"
}

func incidentBadgeClass(status string) string {
	if status == "open" {
		return "badge badge-danger"
	}
	return "badge badge-good"
}

func incidentStatusKey(status string) string {
	if status == "open" {
		return "metrics.alerts.status.open"
	}
	return "metrics.alerts.status.resolved"
}

templ incidentStatusBadge(status string) {
	<span class={ incidentBadgeClass(status) }>{ i18n.T(ctx, incidentStatusKey(status)) }</span>
}

templ ruleEnabledBadge(enabled bool) {
	if enabled {
		<span class="badge badge-good">{ i18n.T(ctx, "metrics.alerts.status.enabled") }</span>
	} else {
		<span class="badge badge-neutral">{ i18n.T(ctx, "metrics.alerts.status.disabled") }</span>
	}
}

func ruleScope(ctx context.Context, r metric.Rule) string {
	scope := r.Environment
	if scope == "" {
		scope = i18n.T(ctx, "metrics.alerts.scope_all")
	}
	if r.LabelKey != "" {
		scope += ", " + r.LabelKey + "=" + r.LabelValue
	}
	return scope
}

templ MetricAlerts(projectID int64, rules []metric.Rule, incidents []metric.Incident, knownMetrics []string, form FormState, errMsg, userEmail string, ackedByOpt ...map[int64]string) {
	{{ ackedBy := firstAckedByMap(ackedByOpt) }}
	@layout(i18n.T(ctx, "nav.metric_alerts"), userEmail) {
		<div class="metric-alerts">
			<h1>{ i18n.T(ctx, "nav.metric_alerts") }</h1>
			@helpPanel("metricalerts", "metric-alerts")
			// Ошибка формы — внутри модалки, у полей: снаружи она осталась бы в стороне от заполняемого.
			@createTrigger(MetricRuleCreateModalID, "metrics.alerts.new_rule")
			// datalist, не select: можно завести правило на ещё не приходившую метрику, но опечатка
			// в известном имени не проходит молча. Один экземпляр на страницу — иначе дубли id.
			<datalist id="known-metrics">
				for _, name := range knownMetrics {
					<option value={ name }></option>
				}
			</datalist>
			<h2>{ i18n.T(ctx, "metrics.alerts.rules") }</h2>
			if len(rules) == 0 {
				@emptyState("bell", "metrics.alerts.rules.empty.title", "metrics.alerts.rules.empty.body", "", "", 3)
			} else {
				<div class="card">
					@scrollRegion("table-scroll", "metrics.alerts.rules") {
							<table class="data-table">
								<thead>
									<tr>
										<th scope="col">{ i18n.T(ctx, "metrics.alerts.table.metric") }</th>
										<th scope="col">{ i18n.T(ctx, "metrics.alerts.table.condition") }</th>
										<th scope="col" class="num">{ i18n.T(ctx, "metrics.alerts.table.window") }</th>
										<th scope="col">{ i18n.T(ctx, "metrics.alerts.table.scope") }</th>
										<th scope="col">{ i18n.T(ctx, "incidents.table.severity") }</th>
										<th scope="col">{ i18n.T(ctx, "metrics.alerts.table.status") }</th>
										<th scope="col"></th>
									</tr>
								</thead>
								<tbody>
									for _, rule := range rules {
										<tr>
											<td>{ rule.MetricName }</td>
											<td>{ i18n.T(ctx, "metrics.aggregation."+rule.Aggregation) } { comparatorSymbol(rule.Comparator) } { fmtFloat(rule.Threshold) }</td>
											<td class="num">{ humanize.Duration(ctx, time.Duration(rule.WindowSeconds)*time.Second) }</td>
											<td>{ ruleScope(ctx, rule) }</td>
											<td>
												if rule.Severity != "" {
													@incidentSeverityBadge(rule.Severity)
												} else {
													<span class="hint">{ i18n.T(ctx, "metrics.alerts.form.severity_inherit") }</span>
												}
											</td>
											<td>@ruleEnabledBadge(rule.Enabled)</td>
											<td>
												<div class="row-actions">
													<a
														class="btn btn-ghost"
														href={ templ.SafeURL("#" + EditMetricRuleModalID(rule.ID)) }
														aria-label={ i18n.Tf(ctx, "metrics.alerts.action.edit_aria", "metric", rule.MetricName) }
													>
														{ i18n.T(ctx, "metrics.alerts.edit") }
													</a>
													<form method="post" action={ templ.URL(metricAlertsBasePath(projectID) + "/delete") }>
														<input type="hidden" name="rule_id" value={ strconv.FormatInt(rule.ID, 10) }/>
														<button
															type="submit"
															class="btn btn-danger"
															aria-label={ i18n.Tf(ctx, "metrics.alerts.action.delete_aria", "metric", rule.MetricName) }
														>
															{ i18n.T(ctx, "metrics.alerts.delete") }
														</button>
													</form>
												</div>
												@metricRuleEditModal(projectID, rule, form, errMsg)
											</td>
										</tr>
									}
								</tbody>
							</table>
					}
				</div>
			}
			<h2>{ i18n.T(ctx, "metrics.alerts.incidents") }</h2>
			if len(incidents) == 0 {
				@emptyState("activity", "metrics.alerts.incidents.empty.title", "metrics.alerts.incidents.empty.body", "", "", 3)
			} else {
				<div class="card">
					@scrollRegion("table-scroll", "metrics.alerts.incidents") {
							<table class="data-table">
								<thead>
									<tr>
										<th scope="col">{ i18n.T(ctx, "metrics.alerts.table.status") }</th>
										<th scope="col">{ i18n.T(ctx, "incidents.table.severity") }</th>
										<th scope="col" class="num">{ i18n.T(ctx, "metrics.alerts.table.peak") }</th>
										<th scope="col" class="num">{ i18n.T(ctx, "metrics.alerts.table.current") }</th>
										<th scope="col">{ i18n.T(ctx, "metrics.alerts.table.started") }</th>
										<th scope="col"></th>
									</tr>
								</thead>
								<tbody>
									for _, in := range incidents {
										<tr>
											<td>@incidentStatusBadge(in.Status)</td>
											<td>@incidentSeverityBadge(in.Severity)</td>
											<td class="num">{ fmtFloat(in.PeakValue) }</td>
											<td class="num">{ fmtFloat(in.CurrentValue) }</td>
											<td>@relativeTime(in.StartedAt)</td>
											<td>
												if in.Status == "open" {
													@ackControl(projectID, "metric", in.ID, true, in.AcknowledgedAt, ackedByEmailOf(in.AcknowledgedBy, ackedBy))
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
					}
				</div>
			}
			@metricRuleCreateModal(projectID, form, errMsg)
		</div>
	}
}

// open — 422 именно из этой модалки (FormState.Opens), не form.Has(): иначе форма создания
// открывалась бы вместе с правкой любой строки.
templ metricRuleCreateModal(projectID int64, form FormState, errMsg string) {
	{{ open := form.Opens(MetricRuleCreateModalID) }}
	@createModalOpen(MetricRuleCreateModalID, "metrics.alerts.new_rule", false, open) {
		<form method="post" action={ templ.URL(metricAlertsBasePath(projectID)) } class="metric-alert-form">
			// Без role="alert": фокус переносит modal.js, ошибка привязана к полю через aria-describedby.
			if open && errMsg != "" {
				<p class="error" id={ MetricRuleCreateModalID + "-error" }>{ errMsg }</p>
			}
			@metricRuleFormFields(metricRuleErrID(MetricRuleCreateModalID, open, errMsg), metricRuleFormValues(form, open, metricRuleCreateDefaults()))
			<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "metrics.alerts.form.submit") }</button>
		</form>
	}
}

// Правка вступает в силу со следующего цикла оценки (evaluator.evalRule перечитывает правило
// каждый тик) — открытый инцидент сам закроется или продолжится по новому условию.
templ metricRuleEditModal(projectID int64, rule metric.Rule, form FormState, errMsg string) {
	{{ modalID := EditMetricRuleModalID(rule.ID) }}
	{{ open := form.Opens(modalID) }}
	@createModalOpen(modalID, "metrics.alerts.edit.title", false, open) {
		<form method="post" action={ templ.URL(metricAlertUpdatePath(projectID, rule.ID)) } class="metric-alert-form">
			if open && errMsg != "" {
				<p class="error" id={ modalID + "-error" }>{ errMsg }</p>
			}
			<p class="hint">{ i18n.T(ctx, "metrics.alerts.edit.hint") }</p>
			@metricRuleFormFields(metricRuleErrID(modalID, open, errMsg), metricRuleFormValues(form, open, ruleFormDefaults(rule)))
			<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "metrics.alerts.edit.submit") }</button>
		</form>
	}
}

// id у полей нет намеренно — фрагмент рендерится в N+1 модалках, любой id дал бы дубли в документе.
templ metricRuleFormFields(errID string, values FormState) {
	<div class="form-grid">
	<div class="field">
		<label>
			{ i18n.T(ctx, "metrics.alerts.form.metric") }
			<input
				type="text"
				name="metric_name"
				required
				placeholder="http.server.duration"
				class="input"
				list="known-metrics"
				value={ values.Get("metric_name", "") }
				if errID != "" {
					aria-invalid="true"
					aria-describedby={ errID }
				}
			/>
		</label>
	</div>
	<div class="field">
		<label>
			{ i18n.T(ctx, "metrics.alerts.form.aggregation") }
			<select name="aggregation" class="select">
				for _, a := range metric.Aggregations {
					if values.Selected("aggregation", a, "avg") {
						<option value={ a } selected>{ i18n.T(ctx, "metrics.aggregation."+a) }</option>
					} else {
						<option value={ a }>{ i18n.T(ctx, "metrics.aggregation."+a) }</option>
					}
				}
			</select>
		</label>
	</div>
	<div class="field">
		<label>
			{ i18n.T(ctx, "metrics.alerts.form.condition") }
			<select name="comparator" class="select">
				if values.Selected("comparator", "lt", "gt") {
					<option value="gt">&gt;</option>
					<option value="lt" selected>&lt;</option>
				} else {
					<option value="gt" selected>&gt;</option>
					<option value="lt">&lt;</option>
				}
			</select>
		</label>
	</div>
	<div class="field">
		<label>
			{ i18n.T(ctx, "metrics.alerts.form.threshold") }
			<input type="text" name="threshold" required placeholder="100" class="input" value={ values.Get("threshold", "") }/>
		</label>
	</div>
	<div class="field">
		<label>
			{ i18n.T(ctx, "metrics.alerts.form.window") }
			<input type="number" name="window_seconds" value={ values.Get("window_seconds", "300") } min="1" required class="input"/>
		</label>
	</div>
	<div class="field">
		<label>
			{ i18n.T(ctx, "metrics.alerts.form.environment") }
			<input type="text" name="environment" placeholder={ i18n.T(ctx, "metrics.alerts.form.environment_any") } class="input" value={ values.Get("environment", "") }/>
		</label>
	</div>
	<div class="field">
		<label>
			{ i18n.T(ctx, "metrics.alerts.form.label_key") }
			<input type="text" name="label_key" placeholder={ i18n.T(ctx, "metrics.alerts.form.label_key_none") } class="input" value={ values.Get("label_key", "") }/>
		</label>
	</div>
	<div class="field">
		<label>
			{ i18n.T(ctx, "metrics.alerts.form.label_value") }
			<input type="text" name="label_value" class="input" value={ values.Get("label_value", "") }/>
		</label>
	</div>
	<div class="field">
		<label>
			{ i18n.T(ctx, "metrics.alerts.form.severity") }
			<select name="severity" class="select">
				if values.Selected("severity", "critical", "") {
					<option value="">{ i18n.T(ctx, "metrics.alerts.form.severity_inherit") }</option>
					<option value="critical" selected>{ i18n.T(ctx, "severity.critical") }</option>
					<option value="warning">{ i18n.T(ctx, "severity.warning") }</option>
				} else if values.Selected("severity", "warning", "") {
					<option value="">{ i18n.T(ctx, "metrics.alerts.form.severity_inherit") }</option>
					<option value="critical">{ i18n.T(ctx, "severity.critical") }</option>
					<option value="warning" selected>{ i18n.T(ctx, "severity.warning") }</option>
				} else {
					<option value="" selected>{ i18n.T(ctx, "metrics.alerts.form.severity_inherit") }</option>
					<option value="critical">{ i18n.T(ctx, "severity.critical") }</option>
					<option value="warning">{ i18n.T(ctx, "severity.warning") }</option>
				}
			</select>
		</label>
	</div>
	</div>
	<label class="checkbox-inline">
		// Hidden перед чекбоксом: без него снятый чекбокс не шлётся в POST, а прямой запрос мимо формы
		// обязан по умолчанию создавать включённое правило — hidden гарантирует enabled в любом случае.
		<input type="hidden" name="enabled" value="off"/>
		// Признак «взведён» — ключ "on" в values; у правки есть только для включённого правила.
		if values.Get("enabled", "") != "" {
			<input type="checkbox" name="enabled" value="on" checked/>
		} else {
			<input type="checkbox" name="enabled" value="on"/>
		}
		{ i18n.T(ctx, "metrics.alerts.form.enabled") }
	</label>
}
