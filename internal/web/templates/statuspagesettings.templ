package templates

import (
	"strconv"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
)

func statusPagesPath(projectID int64) string {
	return "/projects/" + strconv.FormatInt(projectID, 10) + "/statuspages"
}

func statusPageIDPath(statusPageID int64) string {
	return "/statuspages/" + strconv.FormatInt(statusPageID, 10)
}

func statusPageDeletePath(statusPageID int64) string {
	return statusPageIDPath(statusPageID) + "/delete"
}

func statusPageRotatePath(statusPageID int64) string {
	return statusPageIDPath(statusPageID) + "/rotate"
}

// публичный адрес — непрозрачный public_id, не slug (slug резолвится только через 301).
func statusPagePublicURL(baseURL, publicID string) string {
	return baseURL + "/status/" + publicID
}

// на 422 заполняется из тела запроса, чтобы ввод не пропадал; PublicID тогда пуст — это нормально.
// ссылка на публичный адрес рендерится только при f.ID != 0.
type StatusPageForm struct {
	ID          int64
	PublicID    string
	Title       string
	Description string
	Enabled     bool
	Monitors    []StatusPageFormMonitor
	// модалка на CSS :target — без флага она закрывалась бы при перерисовке, хотя значения сохранялись.
	Submitted bool
}

// MonitorName — настоящее имя монитора, только для админа; на публичную страницу не попадает.
type StatusPageFormMonitor struct {
	ID          int64
	MonitorName string
	Selected    bool
	DisplayName string
}

// кнопка «Сохранить» лежит в соседней карточке — связывается с формой через form=, без JS.
func statusPageFormID(f StatusPageForm) string {
	if f.ID == 0 {
		return "status-page-new"
	}
	return "status-page-" + strconv.FormatInt(f.ID, 10)
}

func statusPageFormAction(projectID int64, f StatusPageForm) string {
	if f.ID == 0 {
		return statusPagesPath(projectID)
	}
	return statusPageIDPath(f.ID)
}

templ statusPageMonitorRow(formID string, f StatusPageFormMonitor) {
	<tr>
		<td>
			// form= — поля вне <form>; без него браузер их не отправит, выбор молча терялся бы.
			// aria-label с именем — оно в соседней ячейке, без него скринридер объявит голый «флажок».
			if f.Selected {
				<input type="checkbox" form={ formID } name="monitors" value={ strconv.FormatInt(f.ID, 10) } aria-label={ f.MonitorName } checked/>
			} else {
				<input type="checkbox" form={ formID } name="monitors" value={ strconv.FormatInt(f.ID, 10) } aria-label={ f.MonitorName }/>
			}
		</td>
		<td>{ f.MonitorName }</td>
		<td>
			<input
				type="text"
				form={ formID }
				name={ "display_name_" + strconv.FormatInt(f.ID, 10) }
				value={ f.DisplayName }
				class="input"
				aria-label={ i18n.T(ctx, "uptime.statuspages.field.display_name") }
			/>
		</td>
	</tr>
}

// canManage — owner/admin; скрытое, но нерабочее поле для оператора хуже, чем его отсутствие.
templ statusPageFormBlock(projectID int64, baseURL string, f StatusPageForm, canManage bool) {
	<div class="status-page-editor">
		<div class="status-page-block">
			<h3>{ i18n.T(ctx, "uptime.statuspages.card.general") }</h3>
			<form
				id={ statusPageFormID(f) }
				method="post"
				action={ templ.URL(statusPageFormAction(projectID, f)) }
				class="status-page-form"
			>
				<div class="field">
					<label>
						{ i18n.T(ctx, "uptime.statuspages.field.title") }
						<input type="text" name="title" value={ f.Title } required class="input"/>
					</label>
				</div>
				<div class="field">
					<label>
						{ i18n.T(ctx, "uptime.statuspages.field.description") }
						<input type="text" name="description" value={ f.Description } class="input"/>
					</label>
				</div>
				if canManage {
					<label class="checkbox-inline">
						if f.Enabled {
							<input type="checkbox" name="enabled" checked/>
						} else {
							<input type="checkbox" name="enabled"/>
						}
						{ i18n.T(ctx, "uptime.statuspages.field.enabled") }
					</label>
				}
			</form>
		</div>

		<div class="status-page-block">
			<h3>{ i18n.T(ctx, "uptime.statuspages.card.services") }</h3>
			if len(f.Monitors) == 0 {
				<p class="hint">{ i18n.T(ctx, "uptime.statuspages.monitors_empty") }</p>
			} else {
				@scrollRegion("table-scroll", "uptime.statuspages.card.services") {
					<table class="data-table">
						<thead>
							<tr>
								<th scope="col"></th>
								<th scope="col">{ i18n.T(ctx, "uptime.statuspages.table.monitor") }</th>
								<th scope="col">{ i18n.T(ctx, "uptime.statuspages.field.display_name") }</th>
							</tr>
						</thead>
						<tbody>
							for _, m := range f.Monitors {
								@statusPageMonitorRow(statusPageFormID(f), m)
							}
						</tbody>
					</table>
				}
			}
		</div>

		<div class="status-page-block">
			<h3>{ i18n.T(ctx, "uptime.statuspages.card.publish") }</h3>
			if f.ID != 0 {
				<p class="status-page-public">
					{ i18n.T(ctx, "uptime.statuspages.public_url") }
					<br/>
					<a href={ templ.URL(statusPagePublicURL(baseURL, f.PublicID)) }>{ statusPagePublicURL(baseURL, f.PublicID) }</a>
				</p>
			}
			<div class="card-actions">
				if f.ID == 0 {
					<button type="submit" form={ statusPageFormID(f) } class="btn btn-primary">
						{ i18n.T(ctx, "uptime.statuspages.submit_create") }
					</button>
				} else {
					<button type="submit" form={ statusPageFormID(f) } class="btn btn-primary">
						{ i18n.T(ctx, "uptime.statuspages.submit_save") }
					</button>
					// перевыпуск адреса — публикационное решение, как включение страницы: только canManage.
					if canManage {
						<form method="post" action={ templ.URL(statusPageRotatePath(f.ID)) }>
							<button type="submit" class="btn btn-ghost">{ i18n.T(ctx, "uptime.statuspages.action_rotate") }</button>
						</form>
					}
					// удаление опубликованной страницы — только canManage (сервер иначе вернёт 403 оператору).
					// черновик (не enabled) оператор удаляет свободно.
					if canManage || !f.Enabled {
						<form method="post" action={ templ.URL(statusPageDeletePath(f.ID)) } class="status-page-delete-form">
							<button type="submit" class="btn btn-danger-ghost">{ i18n.T(ctx, "uptime.detail.action_delete") }</button>
						</form>
					}
				}
			</div>
		</div>
	</div>
}

// контент — оператору проекта, публикация (slug/enabled) — только owner/admin (canManage).
templ StatusPagesSettings(projectID int64, baseURL string, forms []StatusPageForm, newForm StatusPageForm, canManage bool, errMsg, userEmail string) {
	@layout(i18n.T(ctx, "nav.status_pages"), userEmail) {
		<div class="status-pages">
			@breadcrumbBackTo(templ.URL(monitorsPath(projectID)), i18n.T(ctx, "nav.monitors"))
			<h1>{ i18n.T(ctx, "nav.status_pages") }</h1>
			@helpPanel("statuspages", "status-pages")
			if errMsg != "" {
				<p class="error">{ errMsg }</p>
			}
			@createTrigger("new-statuspage", "uptime.statuspages.new_title")
			if len(forms) == 0 {
				@emptyState("globe", "uptime.statuspages.empty.title", "uptime.statuspages.empty.body", "", "", 2)
			} else {
				<div class="settings-grid">
					for _, f := range forms {
						<section class="status-page-item card">
							<h2 class="card-header">{ f.Title }</h2>
							@statusPageFormBlock(projectID, baseURL, f, canManage)
						</section>
					}
				</div>
			}

			@createModalOpen("new-statuspage", "uptime.statuspages.new_title", false, newForm.Submitted) {
				@statusPageFormBlock(projectID, baseURL, newForm, canManage)
			}
		</div>
	}
}
