package templates

import (
	"net/url"
	"strconv"
	"time"

	"gitflic.ru/otezvikentiy/gotcha/internal/humanize"
	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
)

func ExportsPath(projectID int64) string {
	return "/projects/" + strconv.FormatInt(projectID, 10) + "/exports"
}

// без этого POST ставит заявку по cookie/дефолту хендлера, а не по тому
// окну, что видит пользователь; resolveTimeRange читает именно "start"/"end".
func exportsPathWithRange(projectID int64, rng TimeRangeVM) string {
	q := url.Values{}
	rng.apply(q)
	if len(q) == 0 {
		return ExportsPath(projectID)
	}
	return ExportsPath(projectID) + "?" + q.Encode()
}

func exportsDownloadPath(projectID, jobID int64) string {
	return ExportsPath(projectID) + "/" + strconv.FormatInt(jobID, 10) + "/download"
}

func exportsDeletePath(projectID, jobID int64) string {
	return ExportsPath(projectID) + "/" + strconv.FormatInt(jobID, 10) + "/delete"
}

type ExportView struct {
	ID            int64
	KindLabel     string
	FormatLabel   string
	FilterSummary string
	// машиночитаемый дубль FilterSummary — атрибуты data-* на той же ячейке.
	ScopeIssueID    int64
	FilterCode      string
	PseudonymMasked bool
	Status          string
	Rows            int64
	Size            int64
	Truncated       bool
	// пустая строка — не failed, либо ключ неизвестен: web-слой уже сверил
	// его с export.KnownFailureReasonKey и битый сюда не пропускает.
	FailureReasonKey string
	IncludePII       bool
	CreatedAt        time.Time
	ExpiresAt        time.Time // нулевое — заявка ещё не терминальна, срок не назначен
	Author           string
	CanDownload      bool
	CanDelete        bool
}

func exportStatusBadgeClass(status string) string {
	switch status {
	case "done":
		return "badge badge-good"
	case "failed":
		return "badge badge-danger"
	case "expired":
		return "badge badge-neutral"
	default: // queued, running
		return "badge badge-warn"
	}
}

// Rows/Size нулевые не потому, что выгрузка пуста, а потому, что воркер ещё
// не досчитал; exportRow показывает вместо них «—».
func exportPending(status string) bool {
	return status == "queued" || status == "running"
}

templ exportRow(projectID int64, e ExportView) {
	<tr>
		<td>{ e.KindLabel }</td>
		<td>{ e.FormatLabel }</td>
		<td
			data-scope-issue-id={ strconv.FormatInt(e.ScopeIssueID, 10) }
			data-filter-code={ e.FilterCode }
			data-pseudonym-masked={ strconv.FormatBool(e.PseudonymMasked) }
		>{ e.FilterSummary }</td>
		<td>
			<span class={ exportStatusBadgeClass(e.Status) }>{ i18n.T(ctx, "exports.status."+e.Status) }</span>
			if e.Truncated {
				<div class="hint">{ i18n.T(ctx, "exports.truncated") }</div>
			}
			if e.FailureReasonKey != "" {
				<div class="hint">{ i18n.Tf(ctx, "exports.failed.reason", "reason", i18n.T(ctx, e.FailureReasonKey)) }</div>
			}
		</td>
		<td class="num">
			if exportPending(e.Status) {
				{ "—" }
			} else {
				{ strconv.FormatInt(e.Rows, 10) }
			}
		</td>
		<td>
			if exportPending(e.Status) {
				{ "—" }
			} else {
				{ humanize.Bytes(e.Size) }
			}
		</td>
		<td>
			if e.IncludePII {
				{ i18n.T(ctx, "exports.pii.column_included") }
			} else {
				{ i18n.T(ctx, "exports.pii.column_masked") }
			}
		</td>
		<td>@relativeTime(e.CreatedAt)</td>
		<td>
			if e.ExpiresAt.IsZero() {
				{ "—" }
			} else {
				// humanize.Time, не relativeTime: ExpiresAt всегда в будущем, а
				// relativeTime зажал бы отрицательную разницу в «прямо сейчас».
				{ humanize.Time(ctx, e.ExpiresAt, time.UTC) }
			}
		</td>
		<td>{ assigneeDisplay(e.Author) }</td>
		<td>
			if e.CanDownload {
				<a class="btn btn-ghost" href={ templ.URL(exportsDownloadPath(projectID, e.ID)) }>{ i18n.T(ctx, "exports.download") }</a>
			}
		</td>
		<td>
			if e.CanDelete {
				<form method="post" action={ templ.URL(exportsDeletePath(projectID, e.ID)) }>
					<button type="submit" class="btn btn-danger-ghost">{ i18n.T(ctx, "exports.delete") }</button>
				</form>
			} else {
				// текст «ещё выполняется» верен всегда: строка чужого CreatedBy без
				// CanManage сюда не доезжает, поэтому CanDelete=false здесь — только !Terminal().
				<span class="hint">{ i18n.T(ctx, "exports.delete_disabled") }</span>
			}
		</td>
	</tr>
}

// общий кусок для четырёх форм постановки заявки (эта плюс три точки входа
// на issues/issuedetail) — список и порядок опций менять только здесь.
templ exportFormatField(form FormState) {
	<div class="field">
		<label>
			{ i18n.T(ctx, "exports.field.format") }
			<select name="format" class="select" aria-label={ i18n.T(ctx, "exports.field.format") }>
				<option value="csv" selected?={ form.Selected("format", "csv", "csv") }>{ i18n.T(ctx, "exports.format.csv") }</option>
				<option value="json" selected?={ form.Selected("format", "json", "csv") }>{ i18n.T(ctx, "exports.format.json") }</option>
				<option value="ndjson" selected?={ form.Selected("format", "ndjson", "csv") }>{ i18n.T(ctx, "exports.format.ndjson") }</option>
			</select>
		</label>
	</div>
}

// canManagePII — тот же гейт, что в exportsCreate: без него include_pii молча игнорируется сервером.
templ exportPIIField(canManagePII bool, form FormState) {
	if canManagePII {
		<div class="field">
			// без checkbox-inline сработал бы базовый `.field label` (column) —
			// галка уехала бы на отдельную строку над текстом.
			<label class="checkbox-inline">
				<input type="checkbox" name="include_pii" value="1" checked?={ form.Checked("include_pii", false) }/>
				{ i18n.T(ctx, "exports.pii.label") }
			</label>
			<p class="hint">{ i18n.T(ctx, "exports.pii.hint") }</p>
		</div>
	}
}

// здесь нет своего окна времени: постановка использует общее состояние
// селектора (rangeCookie/резолвится в exportsCreate) — это осознанно, не баг.
templ exportsForm(projectID int64, canManagePII bool, errMsg string, form FormState) {
	<details class="card" open?={ errMsg != "" }>
		<summary class="card-header">{ i18n.T(ctx, "exports.create") }</summary>
		if errMsg != "" {
			<p class="error">{ errMsg }</p>
		}
		<form method="post" action={ templ.URL(ExportsPath(projectID)) }>
			<div class="form-grid">
				<div class="field">
					<label>
						{ i18n.T(ctx, "exports.field.kind") }
						<select name="kind" class="select" aria-label={ i18n.T(ctx, "exports.field.kind") }>
							<option value="issues" selected?={ form.Selected("kind", "issues", "issues") }>{ i18n.T(ctx, "exports.kind.issues") }</option>
							<option value="events" selected?={ form.Selected("kind", "events", "issues") }>{ i18n.T(ctx, "exports.kind.events") }</option>
						</select>
					</label>
				</div>
				@exportFormatField(form)
			</div>
			@exportPIIField(canManagePII, form)
			<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "exports.create") }</button>
		</form>
	</details>
}

// enabled — источник истины, а не побочный эффект пустого списка rows: иначе
// проект без единой заявки показывал бы то же «объяснение», что выключенная фича.
templ Exports(projectID int64, rows []ExportView, canManagePII bool, userEmail string, enabled bool, errMsg string, form FormState) {
	@layout(i18n.T(ctx, "exports.title"), userEmail) {
		<h1>{ i18n.T(ctx, "exports.title") }</h1>
		@helpPanel("exports", "exports")
		if !enabled {
			@emptyState("file-text", "exports.disabled.title", "exports.disabled.body", "", "", 2)
		} else {
			<p class="hint">{ i18n.T(ctx, "exports.intro") }</p>
			<section class="card">
				<h2 class="card-header">{ i18n.T(ctx, "exports.list.title") }</h2>
				if len(rows) == 0 {
					@emptyState("file-text", "exports.empty.title", "exports.empty.body", "", "", 3)
				} else {
					@scrollRegion("table-scroll", "exports.list.title") {
						<table class="data-table">
							<thead>
								<tr>
									<th scope="col">{ i18n.T(ctx, "exports.table.kind") }</th>
									<th scope="col">{ i18n.T(ctx, "exports.table.format") }</th>
									<th scope="col">{ i18n.T(ctx, "exports.table.filters") }</th>
									<th scope="col">{ i18n.T(ctx, "exports.table.status") }</th>
									<th scope="col" class="num">{ i18n.T(ctx, "exports.table.rows") }</th>
									<th scope="col">{ i18n.T(ctx, "exports.table.size") }</th>
									<th scope="col">{ i18n.T(ctx, "exports.table.pii") }</th>
									<th scope="col">{ i18n.T(ctx, "exports.table.created") }</th>
									<th scope="col">{ i18n.T(ctx, "exports.table.expires") }</th>
									<th scope="col">{ i18n.T(ctx, "exports.table.author") }</th>
									<th scope="col"></th>
									<th scope="col"></th>
								</tr>
							</thead>
							<tbody>
								for _, e := range rows {
									@exportRow(projectID, e)
								}
							</tbody>
						</table>
					}
				}
			</section>
			@exportsForm(projectID, canManagePII, errMsg, form)
		}
	}
}
