// relativetime.templ — точный момент времени рядом с относительной подписью.
// Раньше во всём интерфейсе время показывалось только относительно («5 часов
// назад») без единой точки, где дежурный мог бы увидеть, что это за момент —
// сопоставить инцидент с логами приложения можно было только через «Сырой
// JSON события». relativeTime закрывает это одним компонентом на все места,
// где раньше звался humanize.Ago напрямую.
package templates

import (
	"time"

	"gitflic.ru/otezvikentiy/gotcha/internal/humanize"
)

// relativeTime — относительная подпись («5 часов назад») внутри <time>:
// подпись читает человек, machine-readable datetime — программы (парсеры,
// тесты), title — точное время по наведению для человека, которому мало
// «давно ли». UTC везде намеренно: у пользователя нет настройки часового
// пояса, а в аудите доставок (internal/notify) UTC уже принят как соглашение
// для того же класса решений.
templ relativeTime(t time.Time) {
	<time datetime={ t.UTC().Format(time.RFC3339) } title={ humanize.Time(ctx, t, time.UTC) }>
		{ humanize.Ago(ctx, t) }
	</time>
}
