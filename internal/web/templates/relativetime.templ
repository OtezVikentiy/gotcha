package templates

import (
	"time"

	"gitflic.ru/otezvikentiy/gotcha/internal/humanize"
)

// время всегда в UTC — у пользователя нет настройки часового пояса.
templ relativeTime(t time.Time) {
	<time datetime={ t.UTC().Format(time.RFC3339) } title={ humanize.Time(ctx, t, time.UTC) }>
		{ humanize.Ago(ctx, t) }
	</time>
}
