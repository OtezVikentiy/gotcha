package templates

import "gitflic.ru/otezvikentiy/gotcha/internal/i18n"

// level должен продолжать структуру заголовков вокруг (h1→h2, не h1→h3);
// templ не умеет динамическое имя тега, отсюда switch вместо параметра.
templ emptyState(iconName, titleKey, bodyKey, ctaKey, ctaHref string, level int) {
	<div class="empty-state">
		@icon(iconName)
		switch level {
			case 2:
				<h2 class="empty-title">{ i18n.T(ctx, titleKey) }</h2>
			default:
				<h3 class="empty-title">{ i18n.T(ctx, titleKey) }</h3>
		}
		<p>{ i18n.T(ctx, bodyKey) }</p>
		if ctaKey != "" {
			<a class="btn btn-primary empty-cta" href={ templ.SafeURL(ctaHref) }>{ i18n.T(ctx, ctaKey) }</a>
		}
	</div>
}
