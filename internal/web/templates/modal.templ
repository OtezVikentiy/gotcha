package templates

import "gitflic.ru/otezvikentiy/gotcha/internal/i18n"

// open нужен при ошибке валидации: страница отрисовывается заново без #id в адресе, и без него
// модалка закрывалась бы вместе с введёнными данными.
templ createModalOpen(id, titleKey string, wide, open bool) {
	@modalShell(id, titleKey, wide, open) {
		{ children... }
	}
}

templ modalShell(id, titleKey string, wide, open bool) {
	// Модалку, открытую С СЕРВЕРА (modal--open), нельзя закрыть переходом на "#" — она держится
	// классом, не :target. Переход на #id-close снимает :target и включает правило поверх modal--open.
	<span id={ id + "-close" } class="modal-dismiss" aria-hidden="true"></span>
	<div id={ id } class={ "modal", templ.KV("modal--open", open) }>
		<a class="modal-backdrop" href={ templ.SafeURL("#" + id + "-close") } aria-label={ i18n.T(ctx, "modal.close") } tabindex="-1"></a>
		// aria-modal не выставляем: фон не изолирован ([inert]/aria-hidden нет), фокусируемые элементы
		// позади доступны — aria-modal="true" скрыл бы их от AT, а клавиатура туда всё же уводит.
		<div class={ "modal-card", templ.KV("modal-card--wide", wide) } role="dialog" aria-labelledby={ id + "-title" }>
			<a class="modal-close" href={ templ.SafeURL("#" + id + "-close") } aria-label={ i18n.T(ctx, "modal.close") }>&times;</a>
			// tabindex=-1 — цель программного фокуса modal.js при серверном переоткрытии после ошибки.
			<h2 class="card-header" id={ id + "-title" } tabindex="-1">{ i18n.T(ctx, titleKey) }</h2>
			{ children... }
		</div>
	</div>
}

templ createTrigger(id, labelKey string) {
	<a class="btn btn-primary create-trigger" href={ templ.SafeURL("#" + id) }>
		@icon("plus")
		{ i18n.T(ctx, labelKey) }
	</a>
}
