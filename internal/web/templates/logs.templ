package templates

import (
	"context"
	"net/url"
	"slices"
	"sort"
	"strconv"
	"time"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/log"
	"gitflic.ru/otezvikentiy/gotcha/internal/logfilter"
)

type LogsFilter struct {
	Severity    []string
	Service     string
	Environment string
	Query       string
	// Attrs сохраняются в URL: иначе клик по фасету severity/service/environment сбросил бы их.
	Attrs []log.AttrFilter
	Range TimeRangeVM
	// Active: пустой список при Active=true значит «ничего не подошло», не «логов не было».
	Active bool
	// Facet сохраняется в ссылке «показать старее», иначе раскрытый атрибут схлопывался бы дальше.
	Facet string
	TraceID string
	Not []log.Predicate
	// Range урезан снизу по сроку хранения — без индикации выглядело бы как «логов нет».
	// RetentionDays==0 — хранение бессрочно, RangeClamped всегда false.
	RangeClamped  bool
	RetentionDays int
	// Непусто, только когда URL был пуст и фильтр применим. Скрытый фильтр во время инцидента — худший
	// случай для мониторинга, поэтому плашка с явным сбросом обязательна.
	DefaultApplied *logfilter.Filter
	// «показать всё» — URL плюс явный параметр подавления; пустой URL заново включил бы умолчание.
	DefaultShowAllHref string
	// Форма эхом переносит это скрытым полем — иначе сабмит без условий воскресил бы умолчание.
	// hasLogFilterParams проверяет наличие ключа, не непустоту значения — учитывать при рефакторинге.
	DefaultSuppressed bool
}

// Empty=true — данных нет: график не рисуется вовсе, не пустая шкала.
type LogsHistogram struct {
	Chart  templ.Component
	Legend []LegendItem
	Empty  bool
}

type LogFacets struct {
	Severity    LogFacet
	Service     LogFacet
	Environment LogFacet
	Attrs       LogAttrFacets
}

// TooMuchData — Facet вернул ошибку/таймаут: секция рисует пометку вместо падения всей страницы.
type LogFacet struct {
	Values      []LogFacetValue
	TooMuchData bool
}

type LogFacetValue struct {
	Label        string
	Count        int64
	Href         string
	Active       bool
	ExcludeHref  string
	ExcludeLabel string
}

func NewSeverityFacet(ctx context.Context, projectID int64, filter LogsFilter, values []log.FacetValue, tooMuchData bool) LogFacet {
	items := make([]LogFacetValue, len(values))
	for i, v := range values {
		items[i] = LogFacetValue{
			Label:        severityLabel(ctx, v.Value),
			Count:        v.Count,
			Href:         logFacetSeverityURL(projectID, filter, v.Value),
			Active:       severitySelected(filter.Severity, v.Value),
			ExcludeHref:  logExcludeURL(projectID, filter, log.Predicate{Field: log.FieldSeverity, Op: log.OpNeq, Value: v.Value}),
			ExcludeLabel: i18n.Tf(ctx, "logs.row.exclude_severity", "value", severityLabel(ctx, v.Value)),
		}
	}
	return LogFacet{Values: items, TooMuchData: tooMuchData}
}

func NewServiceFacet(ctx context.Context, projectID int64, filter LogsFilter, values []log.FacetValue, tooMuchData bool) LogFacet {
	return newSingleValueFacet(ctx, projectID, filter, values, tooMuchData, log.FieldService, "logs.row.exclude_service",
		func(f LogsFilter) string { return f.Service },
		func(f LogsFilter, v string) LogsFilter { f.Service = v; return f },
	)
}

func NewEnvironmentFacet(ctx context.Context, projectID int64, filter LogsFilter, values []log.FacetValue, tooMuchData bool) LogFacet {
	return newSingleValueFacet(ctx, projectID, filter, values, tooMuchData, log.FieldEnvironment, "logs.row.exclude_environment",
		func(f LogsFilter) string { return f.Environment },
		func(f LogsFilter, v string) LogsFilter { f.Environment = v; return f },
	)
}

// Общая для service/environment: одиночный select — клик заменяет значение, не добавляет.
// field/excludeLabelKey параметризуют разницу между фильтрами, не дублируя сборку LogFacetValue.
func newSingleValueFacet(ctx context.Context, projectID int64, filter LogsFilter, values []log.FacetValue, tooMuchData bool, field, excludeLabelKey string, get func(LogsFilter) string, set func(LogsFilter, string) LogsFilter) LogFacet {
	items := make([]LogFacetValue, len(values))
	for i, v := range values {
		active := get(filter) == v.Value
		next := filter
		if active {
			next = set(next, "")
		} else {
			next = set(next, v.Value)
		}
		items[i] = LogFacetValue{
			Label:        v.Value,
			Count:        v.Count,
			Href:         LogsPageURL(projectID, next, time.Time{}, 0),
			Active:       active,
			ExcludeHref:  logExcludeURL(projectID, filter, log.Predicate{Field: field, Op: log.OpNeq, Value: v.Value}),
			ExcludeLabel: i18n.Tf(ctx, excludeLabelKey, "value", v.Value),
		}
	}
	return LogFacet{Values: items, TooMuchData: tooMuchData}
}

// Тоггл в мультивыборе filter.Severity; курсор пагинации сбрасывается — прежний уже не годится.
func logFacetSeverityURL(projectID int64, filter LogsFilter, sev string) string {
	next := filter
	if severitySelected(filter.Severity, sev) {
		out := make([]string, 0, len(filter.Severity))
		for _, s := range filter.Severity {
			if s != sev {
				out = append(out, s)
			}
		}
		next.Severity = out
	} else {
		next.Severity = append(append([]string{}, filter.Severity...), sev)
	}
	return LogsPageURL(projectID, next, time.Time{}, 0)
}

func logFacetValueClass(active bool) string {
	if active {
		return "logs-facet-value logs-facet-value-active"
	}
	return "logs-facet-value"
}

// Значения подгружаются лениво только для раскрытого ключа; TooMuchData — как у LogFacet.
type LogAttrFacets struct {
	Keys        []LogAttrKeyFacet
	TooMuchData bool
}

type LogAttrKeyFacet struct {
	Key      string
	Count    int64
	Href     string
	Expanded bool
	Values   []LogAttrValueFacet
}

type LogAttrValueFacet struct {
	Value        string
	Count        int64
	Href         string
	Active       bool
	ExcludeHref  string
	ExcludeLabel string
}

// expandedKey может не входить в keys: автокомплит ищет по всем ключам, сайдбар — только топ-N.
// Без синтетического элемента клик по найденному вне топа ключу визуально ничего не раскрывал.
func NewAttrFacets(ctx context.Context, projectID int64, filter LogsFilter, keys []log.FacetValue, expandedKey string, values []log.FacetValue) LogAttrFacets {
	items := make([]LogAttrKeyFacet, 0, len(keys)+1)
	foundExpanded := false
	for _, k := range keys {
		expanded := expandedKey != "" && k.Value == expandedKey
		if expanded {
			foundExpanded = true
		}
		items = append(items, newAttrKeyFacetItem(ctx, projectID, filter, k.Value, k.Count, expanded, values))
	}
	if expandedKey != "" && !foundExpanded {
		// Точного Count здесь нет — сумма values ближе к реальности, чем 0.
		var count int64
		for _, v := range values {
			count += v.Count
		}
		items = append([]LogAttrKeyFacet{newAttrKeyFacetItem(ctx, projectID, filter, expandedKey, count, true, values)}, items...)
	}
	return LogAttrFacets{Keys: items}
}

func newAttrKeyFacetItem(ctx context.Context, projectID int64, filter LogsFilter, key string, count int64, expanded bool, values []log.FacetValue) LogAttrKeyFacet {
	item := LogAttrKeyFacet{
		Key:      key,
		Count:    count,
		Href:     logAttrKeyFacetURL(projectID, filter, key, expanded),
		Expanded: expanded,
	}
	if expanded {
		item.Values = make([]LogAttrValueFacet, len(values))
		for j, v := range values {
			item.Values[j] = LogAttrValueFacet{
				Value:        v.Value,
				Count:        v.Count,
				Href:         logAttrValueURL(projectID, filter, key, v.Value),
				Active:       logAttrValueActive(filter, key, v.Value),
				ExcludeHref:  logExcludeURL(projectID, filter, log.Predicate{Field: log.FieldAttr, Key: key, Op: log.OpNeq, Value: v.Value}),
				ExcludeLabel: i18n.Tf(ctx, "logs.row.exclude_attr_value", "key", key, "value", v.Value),
			}
		}
	}
	return item
}

// Курсор пагинации сбрасывается при раскрытии/сворачивании ключа — как у остальных фасетных ссылок.
func logAttrKeyFacetURL(projectID int64, filter LogsFilter, key string, expanded bool) string {
	q := logsPageURLValues(filter)
	if !expanded {
		q.Set("facet", key)
	}
	return logsURLFromValues(projectID, q)
}

// В отличие от прочих фасетных ссылок facet=key сохраняется: после клика по значению сайдбар не
// сворачивается — виден результат, можно тоглить следующее значение того же ключа.
func logAttrValueURL(projectID int64, filter LogsFilter, key, value string) string {
	next := filter
	if logAttrValueActive(filter, key, value) {
		out := make([]log.AttrFilter, 0, len(filter.Attrs))
		for _, a := range filter.Attrs {
			if a.Resource || a.Key != key || a.Value != value {
				out = append(out, a)
			}
		}
		next.Attrs = out
	} else {
		next.Attrs = append(append([]log.AttrFilter{}, filter.Attrs...), log.AttrFilter{Key: key, Value: value})
	}
	q := logsPageURLValues(next)
	q.Set("facet", key)
	return logsURLFromValues(projectID, q)
}

// Проверяет только log_attributes (не resource_attrs) — фасеты сайдбара раскрывают только их.
func logAttrValueActive(filter LogsFilter, key, value string) bool {
	for _, a := range filter.Attrs {
		if !a.Resource && a.Key == key && a.Value == value {
			return true
		}
	}
	return false
}

type LogRow struct {
	Row   log.LogRow
	Attrs []logAttrRow
}

// Resource/RawKey несут происхождение явно (из NewLogRow) — предикат строится из них, не разбором
// префикса "resource." в Key: атрибут, буквально названный так, дал бы предикат по чужой карте.
type logAttrRow struct {
	Key      string
	RawKey   string
	Val      string
	Resource bool
}

func NewLogRow(r log.LogRow) LogRow {
	var attrs []logAttrRow
	for _, k := range sortedAttrKeys(r.LogAttributes) {
		attrs = append(attrs, logAttrRow{Key: k, RawKey: k, Val: r.LogAttributes[k]})
	}
	for _, k := range sortedAttrKeys(r.ResourceAttrs) {
		attrs = append(attrs, logAttrRow{Key: "resource." + k, RawKey: k, Val: r.ResourceAttrs[k], Resource: true})
	}
	return LogRow{Row: r, Attrs: attrs}
}

// Карта Go не гарантирует порядок обхода — без сортировки таблица дрожала бы между рендерами.
func sortedAttrKeys(m map[string]string) []string {
	keys := make([]string, 0, len(m))
	for k := range m {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	return keys
}

func logsPath(projectID int64) string {
	return "/projects/" + strconv.FormatInt(projectID, 10) + "/logs"
}

// Отсутствующий трейс — честный 404 (h.notFound), не паника.
func logTracePath(traceID string) string {
	return "/traces/" + url.PathEscape(traceID)
}

// Предел в рунах, не байтах — не резать многобайтовые UTF-8-последовательности.
const maxLogBodyPreviewRunes = 160

func logBodyPreview(s string) string {
	r := []rune(s)
	if len(r) <= maxLogBodyPreviewRunes {
		return s
	}
	return string(r[:maxLogBodyPreviewRunes]) + "…"
}

func severityBadgeClass(sev string) string {
	switch sev {
	case log.SevError, log.SevFatal:
		return "badge badge-danger"
	case log.SevWarn:
		return "badge badge-warn"
	case log.SevInfo:
		return "badge badge-info"
	default:
		return "badge badge-neutral"
	}
}

func severityLabel(ctx context.Context, sev string) string {
	return i18n.T(ctx, "logs.severity."+sev)
}

func severitySelected(selected []string, sev string) bool {
	for _, s := range selected {
		if s == sev {
			return true
		}
	}
	return false
}

func logsPageURLValues(f LogsFilter) url.Values {
	q := url.Values{}
	for _, sv := range f.Severity {
		q.Add("severity", sv)
	}
	if f.Service != "" {
		q.Set("service", f.Service)
	}
	if f.Environment != "" {
		q.Set("environment", f.Environment)
	}
	if f.Query != "" {
		q.Set("q", f.Query)
	}
	for _, a := range f.Attrs {
		q.Add("attr", logAttrFilterParam(a))
	}
	if f.TraceID != "" {
		q.Set("trace_id", f.TraceID)
	}
	for _, p := range f.Not {
		q.Add(logNotParamName(p), logNotParamValue(p))
	}
	// nodefault обязан пережить любой построенный отсюда переход (пагинация, фасеты, чип) — иначе
	// умолчание молча вернётся после того, как пользователь явно его отключил.
	if f.DefaultSuppressed {
		q.Set("nodefault", "1")
	}
	f.Range.apply(q)
	return q
}

// Держать рядом с web.parseLogFilter — расходятся молча, ссылка перестанет воспроизводить его.
func logNotParamName(p log.Predicate) string {
	switch p.Field {
	case log.FieldBody:
		return "q_not"
	case log.FieldSeverity:
		return "severity_not"
	case log.FieldService:
		return "service_not"
	case log.FieldEnvironment:
		return "environment_not"
	default: // FieldAttr, FieldResourceAttr
		return "attr_not"
	}
}

func logNotParamValue(p log.Predicate) string {
	switch p.Field {
	case log.FieldAttr:
		return p.Key + ":" + p.Value
	case log.FieldResourceAttr:
		return "res:" + p.Key + ":" + p.Value
	default:
		return p.Value
	}
}

func logExcludeURL(projectID int64, f LogsFilter, p log.Predicate) string {
	f.Not = append(append([]log.Predicate{}, f.Not...), p)
	return logsURLFromValues(projectID, logsPageURLValues(f))
}

// service/environment замещают прежнее значение (одиночные); severity/атрибуты — добавляют.
func logIncludeURL(projectID int64, f LogsFilter, p log.Predicate) string {
	switch p.Field {
	case log.FieldService:
		f.Service = p.Value
	case log.FieldEnvironment:
		f.Environment = p.Value
	case log.FieldSeverity:
		if !slices.Contains(f.Severity, p.Value) {
			f.Severity = append(append([]string{}, f.Severity...), p.Value)
		}
	case log.FieldAttr, log.FieldResourceAttr:
		af := log.AttrFilter{Resource: p.Field == log.FieldResourceAttr, Key: p.Key, Value: p.Value}
		if !slices.Contains(f.Attrs, af) {
			f.Attrs = append(append([]log.AttrFilter{}, f.Attrs...), af)
		}
	}
	return logsURLFromValues(projectID, logsPageURLValues(f))
}

func logNotChipRemoveURL(projectID int64, f LogsFilter, p log.Predicate) string {
	kept := make([]log.Predicate, 0, len(f.Not))
	for _, x := range f.Not {
		if x != p {
			kept = append(kept, x)
		}
	}
	f.Not = kept
	return logsURLFromValues(projectID, logsPageURLValues(f))
}

func logNotChipLabel(ctx context.Context, p log.Predicate) string {
	switch p.Field {
	case log.FieldBody:
		return i18n.Tf(ctx, "logs.exclude.body", "value", p.Value)
	case log.FieldSeverity:
		return i18n.Tf(ctx, "logs.exclude.severity", "value", severityLabel(ctx, p.Value))
	case log.FieldService:
		return i18n.Tf(ctx, "logs.exclude.service", "value", p.Value)
	case log.FieldEnvironment:
		return i18n.Tf(ctx, "logs.exclude.environment", "value", p.Value)
	default: // FieldAttr, FieldResourceAttr
		return i18n.Tf(ctx, "logs.exclude.attr", "key", p.Key, "value", p.Value)
	}
}

func shortTraceID(id string) string {
	if len(id) <= 8 {
		return id
	}
	return id[:8] + "…"
}

func logsTraceChipRemoveURL(projectID int64, f LogsFilter) string {
	f.TraceID = ""
	return logsURLFromValues(projectID, logsPageURLValues(f))
}

// Префикс res: в подписи не показываем — пользователю важно значение, не в какой карте оно лежит.
func logAttrChipLabel(a log.AttrFilter) string {
	return a.Key + ": " + a.Value
}

// Отдельно от logAttrValueURL: тот тоглит только log_attributes и хранит facet, чип обязан снимать
// и resource-атрибут (например host.name из «Логи хоста»), у которого своего фасета в сайдбаре нет.
func logAttrChipRemoveURL(projectID int64, f LogsFilter, target log.AttrFilter) string {
	out := make([]log.AttrFilter, 0, len(f.Attrs))
	for _, a := range f.Attrs {
		if a.Resource == target.Resource && a.Key == target.Key && a.Value == target.Value {
			continue
		}
		out = append(out, a)
	}
	f.Attrs = out
	return logsURLFromValues(projectID, logsPageURLValues(f))
}

// resource_attrs — префикс res:, значение может содержать «:» — парсер режет по первому вхождению.
func logAttrFilterParam(a log.AttrFilter) string {
	s := a.Key + ":" + a.Value
	if a.Resource {
		return "res:" + s
	}
	return s
}

// Общая точка для GET-формы (LogsScreen) и POST сохранённых фильтров (logsavedfilters.templ), чтобы
// оба места не расходились. severity/service/environment/q сюда не входят — это видимые поля формы.
templ logFilterHiddenChipFields(filter LogsFilter) {
	for _, a := range filter.Attrs {
		<input type="hidden" name="attr" value={ logAttrFilterParam(a) }/>
	}
	if filter.TraceID != "" {
		<input type="hidden" name="trace_id" value={ filter.TraceID }/>
	}
	for _, p := range filter.Not {
		<input type="hidden" name={ logNotParamName(p) } value={ logNotParamValue(p) }/>
	}
}

func logsAttrKeysPath(projectID int64) string {
	return logsPath(projectID) + "/attr-keys"
}

func logAttrSearchBaseHref(projectID int64, filter LogsFilter) string {
	return logsURLFromValues(projectID, logsPageURLValues(filter))
}

func logsURLFromValues(projectID int64, q url.Values) string {
	qs := q.Encode()
	if qs == "" {
		return logsPath(projectID)
	}
	return logsPath(projectID) + "?" + qs
}

// Событие ±5 мин без trace_id для точной склейки — с trace_id окно точное.
const logsAroundEventWindow = 5 * time.Minute

// Окно [ts±5м] обязательно в обеих ветках: без него /logs берёт дефолт 24ч и отсекает старые логи.
// trace_id, если есть, добавляется поверх окна; время — unix-секунды (граница templates/web).
func logsAroundEventPath(projectID int64, traceID string, ts time.Time, env string) string {
	q := url.Values{}
	q.Set("start", strconv.FormatInt(ts.Add(-logsAroundEventWindow).Unix(), 10))
	q.Set("end", strconv.FormatInt(ts.Add(logsAroundEventWindow).Unix(), 10))
	if traceID != "" {
		q.Set("trace_id", traceID)
	} else if env != "" {
		q.Set("environment", env)
	}
	return logsURLFromValues(projectID, q)
}

// Окно — лишь оптимизация скана: trace_id фильтрует точно. TotalUS насыщается на ~71 мин (uint32)
// для очень длинных трейсов — тогда берём широкий конец (from+24ч), чтобы не отсечь хвост логов.
func logsForTracePath(projectID int64, traceID string, from time.Time, totalUS uint32) string {
	q := url.Values{}
	q.Set("trace_id", traceID)
	q.Set("start", strconv.FormatInt(from.Unix(), 10))
	window := time.Duration(totalUS)*time.Microsecond + time.Second
	if totalUS == ^uint32(0) {
		window = 24 * time.Hour
	}
	q.Set("end", strconv.FormatInt(from.Add(window).Unix(), 10))
	return logsURLFromValues(projectID, q)
}

func logsForHostPath(projectID int64, hostName string) string {
	q := url.Values{}
	q.Set("attr", "res:host.name:"+hostName)
	return logsURLFromValues(projectID, q)
}

// before нулевое снимает курсор из ссылки (используется для сброса фильтров, не для пагинации).
func LogsPageURL(projectID int64, f LogsFilter, before time.Time, tieSkip int) string {
	q := logsPageURLValues(f)
	if f.Facet != "" {
		q.Set("facet", f.Facet)
	}
	if !before.IsZero() {
		q.Set("before", strconv.FormatInt(before.UnixMilli(), 10))
		if tieSkip > 0 {
			q.Set("tskip", strconv.Itoa(tieSkip))
		}
	}
	return logsURLFromValues(projectID, q)
}

// loadFailed — ClickHouse недоступен: список пуст без падения 500, гистограмма/фасеты тоже не
// запрашиваются и приходят уже в состоянии отказа (см. web.logsList).
templ LogsScreen(projectID int64, rows []LogRow, filter LogsFilter, loadFailed bool, olderHref string, histogram LogsHistogram, facets LogFacets, userEmail string, savedFilters LogSavedFiltersPanel, errMsg string) {
	@layout(i18n.T(ctx, "logs.title"), userEmail) {
		<div class="logs">
			<h1>{ i18n.T(ctx, "logs.title") }</h1>
			@helpPanel("logs", "logs")
			@logSavedFiltersSection(projectID, filter, savedFilters, errMsg)
			if filter.DefaultApplied != nil {
				<p class="notice logs-default-notice">
					{ i18n.Tf(ctx, "logs.default.applied", "name", filter.DefaultApplied.Name) }
					<a href={ templ.URL(filter.DefaultShowAllHref) }>{ i18n.T(ctx, "logs.default.show_all") }</a>
				</p>
			}

			<form method="get" action={ templ.URL(logsPath(projectID)) } class="logs-filters">
				<fieldset class="logs-severity-filter">
					<legend>{ i18n.T(ctx, "logs.filter.severity_all") }</legend>
					for _, sev := range log.Severities {
						<label class="checkbox-inline">
							<input type="checkbox" name="severity" value={ sev } checked?={ severitySelected(filter.Severity, sev) }/>
							{ severityLabel(ctx, sev) }
						</label>
					}
				</fieldset>
				<input type="text" name="service" class="input" placeholder={ i18n.T(ctx, "logs.filter.service") } value={ filter.Service } aria-label={ i18n.T(ctx, "logs.filter.service") }/>
				<input type="text" name="environment" class="input" placeholder={ i18n.T(ctx, "logs.filter.environment") } value={ filter.Environment } aria-label={ i18n.T(ctx, "logs.filter.environment") }/>
				<input type="text" name="q" class="input" placeholder={ i18n.T(ctx, "logs.filter.query") } value={ filter.Query } aria-label={ i18n.T(ctx, "logs.filter.query") }/>
				@timeRangeFields(filter.Range)
				// attr/trace_id/исключения — вне видимых полей формы; сабмит обязан их сохранить, не обнулить.
				@logFilterHiddenChipFields(filter)
				if filter.DefaultSuppressed {
					<input type="hidden" name="nodefault" value="1"/>
				}
				<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "logs.filter.apply") }</button>
			</form>
			if filter.TraceID != "" || len(filter.Attrs) > 0 || len(filter.Not) > 0 {
				<div class="logs-active-filters">
					if filter.TraceID != "" {
						<span class="logs-filter-chip">
							{ i18n.Tf(ctx, "logs.chip.trace", "id", shortTraceID(filter.TraceID)) }
							<a class="chip-remove" href={ templ.URL(logsTraceChipRemoveURL(projectID, filter)) } title={ i18n.T(ctx, "logs.chip.trace_remove") } aria-label={ i18n.T(ctx, "logs.chip.trace_remove") }>✕</a>
						</span>
					}
					for _, a := range filter.Attrs {
						<span class="logs-filter-chip">
							{ logAttrChipLabel(a) }
							<a class="chip-remove" href={ templ.URL(logAttrChipRemoveURL(projectID, filter, a)) } title={ i18n.Tf(ctx, "logs.chip.attr_remove", "key", a.Key) } aria-label={ i18n.Tf(ctx, "logs.chip.attr_remove", "key", a.Key) }>✕</a>
						</span>
					}
					for _, p := range filter.Not {
						<span class="logs-filter-chip logs-filter-chip--not">
							{ logNotChipLabel(ctx, p) }
							<a class="chip-remove" href={ templ.URL(logNotChipRemoveURL(projectID, filter, p)) } title={ i18n.T(ctx, "logs.exclude.chip_remove") } aria-label={ i18n.T(ctx, "logs.exclude.chip_remove") }>✕</a>
						</span>
					}
				</div>
			}
			if filter.RangeClamped {
				<p class="hint logs-range-clamped">{ i18n.Tf(ctx, "logs.range.clamped", "days", strconv.Itoa(filter.RetentionDays)) }</p>
			}
			if !histogram.Empty {
				<div class="card logs-histogram">
					@scrollRegion("logs-histogram-wrap", "logs.histogram.title") {
						@histogram.Chart
					}
					@chartLegend(histogram.Legend)
				</div>
			}
			<div class="logs-body">
				<div id="logs-table">
					if loadFailed {
						@emptyState("file-text", "logs.error.title", "logs.error.body", "", "", 2)
					} else if len(rows) == 0 && filter.Active {
						@emptyState("file-text", "logs.empty.filter.title", "logs.empty.filter.body", "logs.empty.filter.cta", logsPath(projectID), 2)
					} else if len(rows) == 0 {
						@emptyState("file-text", "logs.empty.none.title", "logs.empty.none.body", "logs.empty.none.cta", projectSetupPath(projectID), 2)
					} else {
						<div class="card">
							@scrollRegion("table-scroll", "logs.title") {
								<table class="data-table">
									<thead>
										<tr>
											<th scope="col">{ i18n.T(ctx, "logs.table.time") }</th>
											<th scope="col">{ i18n.T(ctx, "logs.table.severity") }</th>
											<th scope="col">{ i18n.T(ctx, "logs.table.service") }</th>
											<th scope="col">{ i18n.T(ctx, "logs.table.body") }</th>
										</tr>
									</thead>
									<tbody>
										for _, row := range rows {
											@logRowView(projectID, filter, row)
										}
									</tbody>
								</table>
							}
						</div>
						if olderHref != "" {
							<nav class="pagination" aria-label={ i18n.T(ctx, "pagination.label") }>
								<a href={ templ.URL(olderHref) }>{ i18n.T(ctx, "logs.older") }</a>
							</nav>
						}
					}
				</div>
				@logFacetsSidebar(projectID, filter, facets)
			</div>
		</div>
	}
}

// Рендерится всегда, даже когда все секции пусты — иначе сайдбар прыгал бы по ширине.
templ logFacetsSidebar(projectID int64, filter LogsFilter, facets LogFacets) {
	<aside class="logs-facets" aria-label={ i18n.T(ctx, "logs.facet.title") }>
		@logFacetSection("logs.facet.severity", facets.Severity)
		@logFacetSection("logs.facet.service", facets.Service)
		@logFacetSection("logs.facet.environment", facets.Environment)
		@logAttrFacetSection(projectID, filter, facets.Attrs)
	</aside>
}

// Без JS — обычный текстовый инпут без name: не участвует в отправке формы и ничего не делает.
// data-атрибуты — точки привязки static/logs.js (attr-keys-url, base-href).
templ logAttrSearchBox(projectID int64, filter LogsFilter) {
	<div class="logs-attr-search" data-attr-typeahead data-attr-keys-url={ logsAttrKeysPath(projectID) } data-attr-base-href={ logAttrSearchBaseHref(projectID, filter) }>
		<input type="text" class="input" data-attr-typeahead-input autocomplete="off" placeholder={ i18n.T(ctx, "logs.facet.attr_search") } aria-label={ i18n.T(ctx, "logs.facet.attr_search") }/>
		<ul class="logs-attr-suggestions" data-attr-typeahead-list hidden></ul>
	</div>
}

// Поиск рендерится ДО TooMuchData/empty-веток: бьёт по отдельному эндпоинту, работает независимо от
// состояния секции ниже — так найденный вне топа ключ (см. NewAttrFacets) остаётся достижимым.
templ logAttrFacetSection(projectID int64, filter LogsFilter, facet LogAttrFacets) {
	<section class="card logs-facet">
		<h2 class="logs-facet-title">{ i18n.T(ctx, "logs.facet.attributes") }</h2>
		@logAttrSearchBox(projectID, filter)
		if facet.TooMuchData {
			<p class="logs-facet-note">{ i18n.T(ctx, "logs.facet.too_much_data") }</p>
		} else if len(facet.Keys) == 0 {
			<p class="logs-facet-note">{ i18n.T(ctx, "logs.facet.empty") }</p>
		} else {
			<ul class="logs-facet-list">
				for _, k := range facet.Keys {
					<li class="logs-attr-key-item">
						<div class="logs-facet-item">
							<a class={ logFacetValueClass(k.Expanded) } href={ templ.URL(k.Href) } if k.Expanded { aria-current="page" }>{ k.Key }</a>
							<span class="logs-facet-count">{ strconv.FormatInt(k.Count, 10) }</span>
						</div>
						if k.Expanded {
							if len(k.Values) == 0 {
								<p class="logs-facet-note">{ i18n.T(ctx, "logs.facet.empty") }</p>
							} else {
								<ul class="logs-facet-values">
									for _, v := range k.Values {
										<li class="logs-facet-item">
											<a class={ logFacetValueClass(v.Active) } href={ templ.URL(v.Href) } if v.Active { aria-current="page" }>{ v.Value }</a>
											<span class="logs-facet-count">{ strconv.FormatInt(v.Count, 10) }</span>
											@logRowFieldAction(true, v.ExcludeHref, v.ExcludeLabel)
										</li>
									}
								</ul>
							}
						}
					</li>
				}
			</ul>
		}
	</section>
}

templ logFacetSection(titleKey string, facet LogFacet) {
	<section class="card logs-facet">
		<h2 class="logs-facet-title">{ i18n.T(ctx, titleKey) }</h2>
		if facet.TooMuchData {
			<p class="logs-facet-note">{ i18n.T(ctx, "logs.facet.too_much_data") }</p>
		} else if len(facet.Values) == 0 {
			<p class="logs-facet-note">{ i18n.T(ctx, "logs.facet.empty") }</p>
		} else {
			<ul class="logs-facet-list">
				for _, v := range facet.Values {
					<li class="logs-facet-item">
						<a class={ logFacetValueClass(v.Active) } href={ templ.URL(v.Href) } if v.Active { aria-current="page" }>{ v.Label }</a>
						<span class="logs-facet-count">{ strconv.FormatInt(v.Count, 10) }</span>
						@logRowFieldAction(true, v.ExcludeHref, v.ExcludeLabel)
					</li>
				}
			</ul>
		}
	</section>
}

templ logRowFieldAction(exclude bool, href string, label string) {
	if exclude {
		<a class="logs-row-action logs-row-action--exclude" href={ templ.URL(href) } title={ label } aria-label={ label }>
			@icon("minus")
		</a>
	} else {
		<a class="logs-row-action logs-row-action--include" href={ templ.URL(href) } title={ label } aria-label={ label }>
			@icon("plus")
		</a>
	}
}

templ logRowSeverityActions(projectID int64, f LogsFilter, sev string) {
	<span class="logs-row-actions">
		@logRowFieldAction(true, logExcludeURL(projectID, f, log.Predicate{Field: log.FieldSeverity, Op: log.OpNeq, Value: sev}), i18n.Tf(ctx, "logs.row.exclude_severity", "value", severityLabel(ctx, sev)))
		@logRowFieldAction(false, logIncludeURL(projectID, f, log.Predicate{Field: log.FieldSeverity, Value: sev}), i18n.Tf(ctx, "logs.row.include_severity", "value", severityLabel(ctx, sev)))
	</span>
}

// Пустой сервис (записи без него) кнопок не получает — исключать/оставлять "" бессмысленно.
templ logRowServiceActions(projectID int64, f LogsFilter, service string) {
	if service != "" {
		<span class="logs-row-actions">
			@logRowFieldAction(true, logExcludeURL(projectID, f, log.Predicate{Field: log.FieldService, Op: log.OpNeq, Value: service}), i18n.Tf(ctx, "logs.row.exclude_service", "value", service))
			@logRowFieldAction(false, logIncludeURL(projectID, f, log.Predicate{Field: log.FieldService, Value: service}), i18n.Tf(ctx, "logs.row.include_service", "value", service))
		</span>
	}
}

// Поле-источник — r.Resource/r.RawKey (из NewLogRow), не разбор r.Key: см. докблок logAttrRow.
func logRowAttrPredicate(r logAttrRow, op log.Op) log.Predicate {
	if r.Resource {
		return log.Predicate{Field: log.FieldResourceAttr, Key: r.RawKey, Op: op, Value: r.Val}
	}
	return log.Predicate{Field: log.FieldAttr, Key: r.RawKey, Op: op, Value: r.Val}
}

templ logRowAttrActions(projectID int64, f LogsFilter, r logAttrRow) {
	@logRowFieldAction(true, logExcludeURL(projectID, f, logRowAttrPredicate(r, log.OpNeq)), i18n.Tf(ctx, "logs.row.exclude_attr", "key", r.Key))
	@logRowFieldAction(false, logIncludeURL(projectID, f, logRowAttrPredicate(r, log.OpEq)), i18n.Tf(ctx, "logs.row.include_attr", "key", r.Key))
}

templ logAttrTable(rows []logAttrRow, projectID int64, f LogsFilter) {
	<table class="ctx-table data-table data-table--auto">
		<tbody>
			for _, r := range rows {
				<tr>
					<td class="ctx-key">{ r.Key }</td>
					<td class="ctx-val">{ r.Val }</td>
					<td class="ctx-actions">
						@logRowAttrActions(projectID, f, r)
					</td>
				</tr>
			}
		</tbody>
	</table>
}

// filter — текущий фильтр: нужен, чтобы ссылки исключить/оставить добавляли условие к уже активным.
templ logRowView(projectID int64, filter LogsFilter, row LogRow) {
	<tr>
		<td>@relativeTime(row.Row.Timestamp)</td>
		<td>
			<span class={ severityBadgeClass(row.Row.Severity) }>{ severityLabel(ctx, row.Row.Severity) }</span>
			@logRowSeverityActions(projectID, filter, row.Row.Severity)
		</td>
		<td>
			{ row.Row.Service }
			@logRowServiceActions(projectID, filter, row.Row.Service)
		</td>
		<td>
			<details class="log-row-details">
				<summary>{ logBodyPreview(row.Row.Body) }</summary>
				<div class="log-row-expanded">
					<pre class="contexts-json">{ row.Row.Body }</pre>
					if len(row.Attrs) > 0 {
						<h4 class="ctx-title">{ i18n.T(ctx, "logs.table.attributes") }</h4>
						@logAttrTable(row.Attrs, projectID, filter)
					}
					if row.Row.TraceID != "" {
						<p class="log-row-trace">
							<span class="ctx-key">{ i18n.T(ctx, "logs.table.trace_id") }</span>
							<a href={ templ.URL(logTracePath(row.Row.TraceID)) } title={ i18n.T(ctx, "logs.table.trace_link_title") } aria-label={ i18n.T(ctx, "logs.table.trace_link_title") }>{ row.Row.TraceID }</a>
						</p>
					}
				</div>
			</details>
		</td>
	</tr>
}
