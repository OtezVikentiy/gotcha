// Package templates — SSR-шаблоны Gotcha (templ). Локализация — i18n.T(ctx,...),
// локаль в контексте кладёт web-миддлвара withLocale.
package templates

import (
	"context"
	"strconv"
	"strings"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/nav"
	"gitflic.ru/otezvikentiy/gotcha/internal/theme"
	"gitflic.ru/otezvikentiy/gotcha/internal/version"
)

templ layout(title string, userEmail string) {
	<!DOCTYPE html>
	if theme.FromContext(ctx).Code != "system" {
		<html lang={ i18n.FromContext(ctx).Code } data-theme={ theme.FromContext(ctx).Code }>
			@layoutBody(title, userEmail) {
				{ children... }
			}
		</html>
	} else {
		<html lang={ i18n.FromContext(ctx).Code }>
			@layoutBody(title, userEmail) {
				{ children... }
			}
		</html>
	}
}

// chromeless — минимальный layout для анонимных/setup-страниц (login,
// register, invite-accept, error, onboarding): тот же <head>, что и у
// authenticated layout (см. headTag), но без icon-рейла и контекстного
// сайдбара — только тонкая верхняя полоса с логотипом и переключателями
// языка/темы.
templ chromeless(title string, userEmail string) {
	<!DOCTYPE html>
	if theme.FromContext(ctx).Code != "system" {
		<html lang={ i18n.FromContext(ctx).Code } data-theme={ theme.FromContext(ctx).Code }>
			@chromelessBody(title, userEmail) {
				{ children... }
			}
		</html>
	} else {
		<html lang={ i18n.FromContext(ctx).Code }>
			@chromelessBody(title, userEmail) {
				{ children... }
			}
		</html>
	}
}

// headTag — общий <head>, вынесен отдельно, чтобы не дублироваться между
// layoutBody и chromelessBody.
templ headTag(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ title } · Gotcha</title>
		<link rel="icon" href={ assetURL("/static/favicon.svg") } type="image/svg+xml"/>
		<link rel="stylesheet" href={ assetURL("/static/app.css") }/>
		// Прогрессивное улучшение селектора окна времени в единый попап-пикер
		// диапазона. Не обязателен: без него .time-range работает нативно
		// (пресеты + два поля datetime-local). Тот же origin — CSP разрешает.
		<script src={ assetURL("/static/daterange.js") } defer></script>
		<script src={ assetURL("/static/modal.js") } defer></script>
		<script src={ assetURL("/static/copy.js") } defer></script>
		// Прогрессивное улучшение поиска ключа атрибута на экране логов
		// (задача 6, C2): без него поле — обычный текстовый инпут, ничего не
		// подсказывающий. Общий блок скриптов, а не ручной <script> в
		// logs.templ — единая точка версионирования (assetURL/assetVer), как
		// и у daterange/modal/copy выше.
		<script src={ assetURL("/static/logs.js") } defer></script>
	</head>
}

// layoutBody — общее содержимое <head>/<body> для авторизованного app-shell,
// вынесено отдельно, чтобы не дублировать всю разметку между двумя вариантами
// открывающего тега <html> (с data-theme и без — см. layout). Тело — icon-
// рейл (области нав-структуры) + контекстный сайдбар (подразделы текущей
// области + переключатель проекта) + верхняя панель (breadcrumb + переключатели).
templ layoutBody(title string, userEmail string) {
	@headTag(title)
	<body>
		@iconSprite()
		// Skip-link (WCAG 2.4.1, уровень A): до <main> идёт 8-30 навигационных
		// ссылок (рейл + контекстный сайдбар), и без этой ссылки пользователь
		// клавиатуры и скринридера протабливает их НА КАЖДОЙ странице. Видима
		// только при фокусе (см. .skip-link в app.css).
		<a class="skip-link" href="#main">{ i18n.T(ctx, "a11y.skip_to_content") }</a>
		<div class="app-shell">
			// <nav>, а не <aside>: это основная навигация. <aside> объявляет
			// «дополнительный контент», поэтому пользователь скринридера не мог
			// перейти к меню через список ориентиров — на 27 из 29 страниц
			// ориентира navigation не было вовсе.
			<nav class="rail" aria-label={ i18n.T(ctx, "nav.primary") }>
				<a class="rail-logo" href="/" title="Gotcha">@brandMark()</a>
				{{ spacerDone := false }}
				if shell := nav.FromContext(ctx); len(shell.Projects) > 0 {
					// Разделитель перед «Оповещениями» отбивает ярус настройки
					// алертинга от рабочих областей выше; распорка перед первой
					// footer-областью («Настройки») прижимает подвал (настройки,
					// документация) вниз, к аватару и выходу.
					for _, a := range nav.Areas(shell) {
						if a.ID == "alerts" {
							<div class="rail-sep"></div>
						}
						if a.Footer && !spacerDone {
							<div class="rail-spacer"></div>
							{{ spacerDone = true }}
						}
						<a class={ railAreaClass(a.Active) } href={ templ.SafeURL(a.Href) } title={ i18n.T(ctx, a.LabelKey) } if a.Active { aria-current="page" }>
							<span class="rail-ic">@icon(a.IconName)</span>
							<span class="rail-label">{ i18n.T(ctx, a.LabelKey) }</span>
						</a>
					}
				}
				if !spacerDone {
					<div class="rail-spacer"></div>
				}
				<a class="avatar" href="/profile" title={ userEmail }>{ initials(userEmail) }</a>
				<form method="post" action="/logout" class="rail-logout">
					<button type="submit" class="rail-logout-btn" title={ i18n.T(ctx, "action.logout") } aria-label={ i18n.T(ctx, "action.logout") }>
						@icon("log-out")
					</button>
				</form>
			</nav>
			<nav class="ctx-sidebar" aria-label={ i18n.T(ctx, "nav.section") }>
				@ctxNav(nav.FromContext(ctx))
			</nav>
			<div class="app-main">
				<header class="topbar">
					<details class="mobile-nav">
						<summary class="mobile-nav-summary" aria-label={ i18n.T(ctx, "nav.menu") }>@icon("menu")</summary>
						<div class="mobile-nav-panel">
							@ctxNav(nav.FromContext(ctx))
						</div>
					</details>
					@whereAmI(nav.FromContext(ctx))
					<div class="breadcrumb">{ title }</div>
					<div class="topbar-spacer"></div>
					@langSwitcher()
					@themeToggle()
				</header>
				<main class="app-content" id="main" tabindex="-1">
					@flashView()
					{ children... }
				</main>
				<footer class="app-footer">
					<a href="/about">
						gotcha { version.Version() }
					</a>
				</footer>
			</div>
		</div>
	</body>
}

// ctxNav — содержимое контекстного сайдбара: подразделы текущей области и
// ссылка на настройки проекта (или кнопка создания проекта, если проектов
// ещё нет). Переключатель проекта здесь больше не живёт — переехал в топбар
// (задача 4 nav-ia, см. whereAmI): два селекта в разных местах экрана иначе
// спорили бы за то, какой из них главный. Вынесено отдельным компонентом,
// чтобы переиспользовать разметку и в desktop .ctx-sidebar, и в мобильном
// no-JS disclosure-меню топбара (см. layoutBody).
templ ctxNav(shell nav.Shell) {
	if len(shell.Projects) > 0 {
		for _, g := range nav.GroupedSubsections(shell) {
			if g.LabelKey != "" {
				<div class="ctx-group">{ i18n.T(ctx, g.LabelKey) }</div>
			}
			for _, it := range g.Items {
				<a class={ ctxItemClass(it.Active) } href={ templ.SafeURL(it.Href) } if it.Active { aria-current="page" }>
					if it.Label != "" {
						{ it.Label }
					} else {
						{ i18n.T(ctx, it.LabelKey) }
					}
				</a>
			}
		}
		// В самой области настроек ссылку в футере не показываем: там она уже
		// есть первым пунктом списка подразделов, и дублировать её незачем.
		if shell.CanManage && shell.Area != "settings" {
			<a class="ctx-settings" href={ templ.SafeURL("/projects/" + itoa(effectiveProjectID(shell)) + "/settings") }>
				@icon("settings")
				{ i18n.T(ctx, "nav.project_settings") }
			</a>
		}
	} else {
		<a class="btn btn-primary" href="/onboarding">{ i18n.T(ctx, "nav.create_project") }</a>
	}
}

// whereAmI — «где я» в топбаре (задача 4 nav-ia): селект организации (когда
// их у пользователя больше одной — единственная у одной организации просто
// подписана) над переключателем проекта, суженным выбранной организацией
// (nav.Shell.Projects уже отфильтрован в web/shell.go). Дверь к
// "/orgs/{id}/projects" (задача 5) — единственный способ сменить
// организацию и единственный способ завести второй проект.
templ whereAmI(shell nav.Shell) {
	if len(shell.Orgs) > 1 {
		<details class="org-switch">
			<summary>
				<span class="org-switch-name">{ currentOrgName(shell) }</span>
				@icon("chevron-down")
			</summary>
			<ul>
				for _, o := range shell.Orgs {
					<li><a href={ templ.SafeURL("/orgs/" + itoa(o.ID) + "/projects") }>{ o.Name }</a></li>
				}
			</ul>
		</details>
	} else if len(shell.Orgs) == 1 {
		<span class="org-name">{ shell.Orgs[0].Name }</span>
	}
	if len(shell.Projects) > 0 {
		// Проектный селект НЕ схлопывается даже при единственном проекте:
		// в нём живёт пункт «Все проекты», а на той странице — создание
		// проекта. Схлопни его — и пользователь с одним проектом не сможет
		// завести второй (см. TestTopbarKeepsAllProjectsDoorWithSingleProject).
		<details class="proj-switch">
			<summary>
				<span class="proj-switch-name">{ currentProjectName(shell) }</span>
				@icon("chevron-down")
			</summary>
			<ul>
				for _, p := range shell.Projects {
					// №60: смена проекта держит текущий раздел (nav.ProjectSwitchHref);
					// раздел, недоступный у целевого проекта, откатывается на issues.
					<li><a href={ templ.SafeURL(nav.ProjectSwitchHref(shell, p.ID)) }>{ p.Name }</a></li>
				}
				// OrgID резолвится best-effort (web/shell.go): ProjectOrg
				// может ошибиться, тогда OrgID==0 и "/orgs/0/projects" 404-ит
				// — пункт рендерится только при разрешённой организации.
				if shell.OrgID != 0 {
					<li class="proj-switch-all"><a href={ templ.SafeURL("/orgs/" + itoa(shell.OrgID) + "/projects") }>{ i18n.T(ctx, "nav.all_projects") }</a></li>
				}
			</ul>
		</details>
	}
}

// currentOrgName — имя организации в селекте: текущая по OrgID, иначе
// первая из списка, иначе пусто. По образцу currentProjectName ниже.
func currentOrgName(s nav.Shell) string {
	for _, o := range s.Orgs {
		if o.ID == s.OrgID {
			return o.Name
		}
	}
	if len(s.Orgs) > 0 {
		return s.Orgs[0].Name
	}
	return ""
}

// chromelessBody — тело минимального layout для анонимных/setup-страниц: без
// рейла и сайдбара, только тонкая верхняя полоса с логотипом и переключателями.
templ chromelessBody(title string, userEmail string) {
	@headTag(title)
	<body class="chromeless">
		@iconSprite()
		<header class="chromeless-top">
			<a class="brand-lockup" href="/">@brandMark()<span class="brand-word">Gotcha</span></a>
			<div class="topbar-spacer"></div>
			@langSwitcher()
			@themeToggle()
			// Выход и без рейла (№21): залогиненный без проектов/организаций
			// иначе не мог даже разлогиниться. Анонимные chromeless-страницы
			// (логин/регистрация) передают пустой userEmail — кнопки нет.
			if userEmail != "" {
				<form method="post" action="/logout" class="chromeless-logout">
					<button type="submit" class="btn btn-ghost">
						@icon("log-out")
						{ i18n.T(ctx, "action.logout") }
					</button>
				</form>
			}
		</header>
		<main class="chromeless-main">
			@flashView()
			{ children... }
		</main>
	</body>
}

// railAreaClass — класс рейл-пункта, is-active подсвечивает текущую область.
func railAreaClass(active bool) string {
	if active {
		return "rail-area is-active"
	}
	return "rail-area"
}

// ctxItemClass — класс пункта контекстного сайдбара, is-active подсвечивает
// текущий подраздел.
func ctxItemClass(active bool) string {
	if active {
		return "ctx-item is-active"
	}
	return "ctx-item"
}

// initials — 1-2 заглавные буквы для аватара из email (до "@").
func initials(email string) string {
	local := email
	if i := strings.IndexByte(email, '@'); i > 0 {
		local = email[:i]
	}
	local = strings.TrimSpace(local)
	if local == "" {
		return ""
	}
	r := []rune(local)
	if len(r) == 1 {
		return strings.ToUpper(string(r[0:1]))
	}
	return strings.ToUpper(string(r[0:2]))
}

// itoa — форматирование int64 для построения href-ов в шаблонах.
func itoa(n int64) string {
	return strconv.FormatInt(n, 10)
}

// currentProjectName — имя проекта в переключателе: текущий проект по
// ProjectID, иначе первый из списка, иначе пусто.
func currentProjectName(s nav.Shell) string {
	for _, p := range s.Projects {
		if p.ID == s.ProjectID {
			return p.Name
		}
	}
	if len(s.Projects) > 0 {
		return s.Projects[0].Name
	}
	return ""
}

// effectiveProjectID — ProjectID, если задан, иначе ID первого проекта,
// иначе 0.
func effectiveProjectID(s nav.Shell) int64 {
	if s.ProjectID != 0 {
		return s.ProjectID
	}
	if len(s.Projects) > 0 {
		return s.Projects[0].ID
	}
	return 0
}

// langSwitcher — переключатель языка (форма POST, работает без JS). Активный
// язык помечен классом is-active.
templ langSwitcher() {
	<form method="post" action="/settings/locale" class="lang-switcher">
		<button type="submit" name="lang" value="ru" class={ langBtnClass(ctx, "ru") } aria-pressed={ langPressed(ctx, "ru") }>{ i18n.T(ctx, "lang.ru") }</button>
		<button type="submit" name="lang" value="en" class={ langBtnClass(ctx, "en") } aria-pressed={ langPressed(ctx, "en") }>{ i18n.T(ctx, "lang.en") }</button>
	</form>
}

func langBtnClass(ctx context.Context, code string) string {
	if i18n.FromContext(ctx).Code == code {
		return "lang-btn is-active"
	}
	return "lang-btn"
}

// langPressed — aria-pressed для кнопки языка: визуально выбранный язык
// отличает только цвет, скринридеру нужно состояние (№84) — тот же принцип,
// что themePressed ниже.
func langPressed(ctx context.Context, code string) string {
	if i18n.FromContext(ctx).Code == code {
		return "true"
	}
	return "false"
}

// themeToggle — переключатель темы оформления (форма POST, работает без JS).
// Иконочный: три текстовых кнопки занимали четверть топбара и спорили с
// основными действиями страницы. @icon печатает aria-hidden, поэтому имя
// кнопки задаётся aria-label, а title даёт подсказку по наведению.
templ themeToggle() {
	<form method="post" action="/settings/theme" class="theme-toggle">
		@themeBtn("dark", "moon", "theme.dark")
		@themeBtn("light", "sun", "theme.light")
		@themeBtn("system", "monitor", "theme.system")
	</form>
}

templ themeBtn(code, iconName, labelKey string) {
	<button
		type="submit"
		name="theme"
		value={ code }
		class={ themeBtnClass(ctx, code) }
		aria-label={ i18n.T(ctx, labelKey) }
		title={ i18n.T(ctx, labelKey) }
		aria-pressed={ themePressed(ctx, code) }
	>
		@icon(iconName)
	</button>
}

// themePressed — aria-pressed для сегмента: без него скринридер не отличит
// выбранную тему от невыбранной, потому что визуально это делает только цвет.
func themePressed(ctx context.Context, code string) string {
	if theme.FromContext(ctx).Code == code {
		return "true"
	}
	return "false"
}

func themeBtnClass(ctx context.Context, code string) string {
	if theme.FromContext(ctx).Code == code {
		return "theme-btn is-active"
	}
	return "theme-btn"
}
