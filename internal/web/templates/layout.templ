package templates

import (
	"context"
	"strconv"
	"strings"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/nav"
	"gitflic.ru/otezvikentiy/gotcha/internal/theme"
	"gitflic.ru/otezvikentiy/gotcha/internal/version"
)

templ layout(title string, userEmail string) {
	<!DOCTYPE html>
	if theme.FromContext(ctx).Code != "system" {
		<html lang={ i18n.FromContext(ctx).Code } data-theme={ theme.FromContext(ctx).Code }>
			@layoutBody(title, userEmail) {
				{ children... }
			}
		</html>
	} else {
		<html lang={ i18n.FromContext(ctx).Code }>
			@layoutBody(title, userEmail) {
				{ children... }
			}
		</html>
	}
}

templ chromeless(title string, userEmail string) {
	<!DOCTYPE html>
	if theme.FromContext(ctx).Code != "system" {
		<html lang={ i18n.FromContext(ctx).Code } data-theme={ theme.FromContext(ctx).Code }>
			@chromelessBody(title, userEmail) {
				{ children... }
			}
		</html>
	} else {
		<html lang={ i18n.FromContext(ctx).Code }>
			@chromelessBody(title, userEmail) {
				{ children... }
			}
		</html>
	}
}

templ headTag(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		// theme-color красит системную рамку браузера — без него на тёмной теме висела белая полоса.
		// Значения = --bg из app.css; совпадение держит TestThemeColorMatchesCSS.
		if theme.FromContext(ctx).Code == "system" {
			<meta name="theme-color" content={ themeColor("dark") } media="(prefers-color-scheme: dark)"/>
			<meta name="theme-color" content={ themeColor("light") } media="(prefers-color-scheme: light)"/>
		} else {
			<meta name="theme-color" content={ themeColor(theme.FromContext(ctx).Code) }/>
		}
		<title>{ title } · Gotcha</title>
		<link rel="icon" href={ assetURL("/static/favicon.svg") } type="image/svg+xml"/>
		<link rel="stylesheet" href={ assetURL("/static/app.css") }/>
		// Прогрессивное улучшение: без скрипта .time-range работает нативно (пресеты + datetime-local).
		<script src={ assetURL("/static/daterange.js") } defer></script>
		<script src={ assetURL("/static/modal.js") } defer></script>
		<script src={ assetURL("/static/copy.js") } defer></script>
		// Прогрессивное улучшение поиска атрибута логов; без скрипта — обычный текстовый инпут.
		<script src={ assetURL("/static/logs.js") } defer></script>
		// Прогрессивное улучшение выгрузки данных субъекта; без скрипта — обычное скачивание.
		<script src={ assetURL("/static/export.js") } defer></script>
	</head>
}

var themeColorByCode = map[string]string{
	"dark":  "#0f131b",
	"light": "#f6f8fb",
}

func themeColor(code string) string {
	return themeColorByCode[code]
}

// Наружу — ради сторожа TestThemeColorMatchesCSS в пакете web.
func ThemeColor(code string) string {
	return themeColor(code)
}

templ layoutBody(title string, userEmail string) {
	@headTag(title)
	<body>
		@iconSprite()
		// Skip-link (WCAG 2.4.1): без него таб проходит все 8-30 ссылок рейла на каждой странице.
		// Виден только в фокусе (.skip-link в app.css).
		<a class="skip-link" href="#main">{ i18n.T(ctx, "a11y.skip_to_content") }</a>
		<div class="app-shell">
			// <nav>, не <aside>: aside читается как «доп. контент» — меню не находилось через ориентиры.
			<nav class="rail" aria-label={ i18n.T(ctx, "nav.primary") }>
				<a class="rail-logo" href="/" title="Gotcha">@brandMark("brand-grad-rail")</a>
				{{ spacerDone := false }}
				if shell := nav.FromContext(ctx); len(shell.Projects) > 0 {
					// Разделитель — перед «Оповещениями», отделяет алертинг от рабочих областей выше.
					// Распорка — перед первой footer-областью, прижимает подвал вниз, к аватару и выходу.
					for _, a := range nav.Areas(shell) {
						if a.ID == "alerts" {
							<div class="rail-sep"></div>
						}
						if a.Footer && !spacerDone {
							<div class="rail-spacer"></div>
							{{ spacerDone = true }}
						}
						<a class={ railAreaClass(a.Active) } href={ templ.SafeURL(a.Href) } title={ i18n.T(ctx, a.LabelKey) } if a.Active { aria-current="page" }>
							<span class="rail-ic">@icon(a.IconName)</span>
							<span class="rail-label">{ i18n.T(ctx, a.LabelKey) }</span>
						</a>
					}
				}
				if !spacerDone {
					<div class="rail-spacer"></div>
				}
				<a class="avatar" href="/profile" title={ userEmail } aria-label={ i18n.T(ctx, "profile.title") + ": " + userEmail }>{ initials(userEmail) }</a>
				<form method="post" action="/logout" class="rail-logout">
					<button type="submit" class="rail-logout-btn" title={ i18n.T(ctx, "action.logout") } aria-label={ i18n.T(ctx, "action.logout") }>
						@icon("log-out")
					</button>
				</form>
			</nav>
			<nav class="ctx-sidebar" aria-label={ i18n.T(ctx, "nav.section") }>
				@ctxNav(nav.FromContext(ctx))
			</nav>
			<div class="app-main">
				<header class="topbar">
					<details class="mobile-nav">
						<summary class="mobile-nav-summary" aria-label={ i18n.T(ctx, "nav.menu") }>@icon("menu")</summary>
						<div class="mobile-nav-panel">
							@ctxNav(nav.FromContext(ctx))
						</div>
					</details>
					@whereAmI(nav.FromContext(ctx))
					<div class="breadcrumb">{ title }</div>
					<div class="topbar-spacer"></div>
					@langSwitcher()
					@themeToggle()
				</header>
				<main class="app-content" id="main" tabindex="-1">
					@flashView()
					{ children... }
				</main>
				<footer class="app-footer">
					<a href="/about">
						gotcha { version.Version() }
					</a>
				</footer>
			</div>
		</div>
	</body>
}

// Переключатель проекта не здесь, он в топбаре: два селекта в разных местах спорили бы за главный.
templ ctxNav(shell nav.Shell) {
	if len(shell.Projects) > 0 {
		for _, g := range nav.GroupedSubsections(shell) {
			if g.LabelKey != "" {
				<div class="ctx-group">{ i18n.T(ctx, g.LabelKey) }</div>
			}
			for _, it := range g.Items {
				<a class={ ctxItemClass(it.Active) } href={ templ.SafeURL(it.Href) } if it.Active { aria-current="page" }>
					if it.Label != "" {
						{ it.Label }
					} else {
						{ i18n.T(ctx, it.LabelKey) }
					}
				</a>
			}
		}
		// В области настроек не дублируем ссылку — она уже первый пункт списка подразделов.
		if shell.CanManage && shell.Area != "settings" {
			<a class="ctx-settings" href={ templ.SafeURL("/projects/" + itoa(effectiveProjectID(shell)) + "/settings") }>
				@icon("settings")
				{ i18n.T(ctx, "nav.project_settings") }
			</a>
		}
	} else {
		<a class="btn btn-primary" href="/onboarding">{ i18n.T(ctx, "nav.create_project") }</a>
	}
}

// /orgs/{id}/projects — единственный способ сменить организацию или завести второй проект.
// Проектный список уже отфильтрован выбранной организацией (nav.Shell.Projects, web/shell.go).
templ whereAmI(shell nav.Shell) {
	if len(shell.Orgs) > 1 {
		<details class="org-switch">
			<summary>
				<span class="org-switch-name">{ currentOrgName(shell) }</span>
				@icon("chevron-down")
			</summary>
			<ul>
				for _, o := range shell.Orgs {
					<li><a href={ templ.SafeURL("/orgs/" + itoa(o.ID) + "/projects") }>{ o.Name }</a></li>
				}
			</ul>
		</details>
	} else if len(shell.Orgs) == 1 {
		<span class="org-name">{ shell.Orgs[0].Name }</span>
	}
	if len(shell.Projects) > 0 {
		// Не схлопывать даже при одном проекте: тут «Все проекты»/создание — иначе некуда завести второй.
		// Держит TestTopbarKeepsAllProjectsDoorWithSingleProject.
		<details class="proj-switch">
			<summary>
				<span class="proj-switch-name">{ currentProjectName(shell) }</span>
				@icon("chevron-down")
			</summary>
			<ul>
				for _, p := range shell.Projects {
					// Смена проекта держит текущий раздел; недоступный у целевого проекта — откат на issues.
					<li><a href={ templ.SafeURL(nav.ProjectSwitchHref(shell, p.ID)) }>{ p.Name }</a></li>
				}
				// OrgID резолвится best-effort: при OrgID==0 путь /orgs/0/projects 404-ит, пункт не рендерится.
				if shell.OrgID != 0 {
					<li class="proj-switch-all"><a href={ templ.SafeURL("/orgs/" + itoa(shell.OrgID) + "/projects") }>{ i18n.T(ctx, "nav.all_projects") }</a></li>
				}
			</ul>
		</details>
	}
}

func currentOrgName(s nav.Shell) string {
	for _, o := range s.Orgs {
		if o.ID == s.OrgID {
			return o.Name
		}
	}
	if len(s.Orgs) > 0 {
		return s.Orgs[0].Name
	}
	return ""
}

templ chromelessBody(title string, userEmail string) {
	@headTag(title)
	<body class="chromeless">
		@iconSprite()
		<header class="chromeless-top">
			<a class="brand-lockup" href="/">@brandMark("brand-grad-chromeless")<span class="brand-word">Gotcha</span></a>
			<div class="topbar-spacer"></div>
			@langSwitcher()
			@themeToggle()
			// Кнопка выхода — иначе залогиненный без проектов/организаций не может разлогиниться.
			if userEmail != "" {
				<form method="post" action="/logout" class="chromeless-logout">
					<button type="submit" class="btn btn-ghost">
						@icon("log-out")
						{ i18n.T(ctx, "action.logout") }
					</button>
				</form>
			}
		</header>
		<main class="chromeless-main">
			@flashView()
			{ children... }
		</main>
	</body>
}

func railAreaClass(active bool) string {
	if active {
		return "rail-area is-active"
	}
	return "rail-area"
}

func ctxItemClass(active bool) string {
	if active {
		return "ctx-item is-active"
	}
	return "ctx-item"
}

func initials(email string) string {
	local := email
	if i := strings.IndexByte(email, '@'); i > 0 {
		local = email[:i]
	}
	local = strings.TrimSpace(local)
	if local == "" {
		return ""
	}
	r := []rune(local)
	if len(r) == 1 {
		return strings.ToUpper(string(r[0:1]))
	}
	return strings.ToUpper(string(r[0:2]))
}

func itoa(n int64) string {
	return strconv.FormatInt(n, 10)
}

func currentProjectName(s nav.Shell) string {
	for _, p := range s.Projects {
		if p.ID == s.ProjectID {
			return p.Name
		}
	}
	if len(s.Projects) > 0 {
		return s.Projects[0].Name
	}
	return ""
}

func effectiveProjectID(s nav.Shell) int64 {
	if s.ProjectID != 0 {
		return s.ProjectID
	}
	if len(s.Projects) > 0 {
		return s.Projects[0].ID
	}
	return 0
}

templ langSwitcher() {
	<form method="post" action="/settings/locale" class="lang-switcher">
		<button type="submit" name="lang" value="ru" class={ langBtnClass(ctx, "ru") } aria-pressed={ langPressed(ctx, "ru") }>{ i18n.T(ctx, "lang.ru") }</button>
		<button type="submit" name="lang" value="en" class={ langBtnClass(ctx, "en") } aria-pressed={ langPressed(ctx, "en") }>{ i18n.T(ctx, "lang.en") }</button>
	</form>
}

func langBtnClass(ctx context.Context, code string) string {
	if i18n.FromContext(ctx).Code == code {
		return "lang-btn is-active"
	}
	return "lang-btn"
}

// aria-pressed нужен: активный язык отличает только цвет, скринридеру этого не видно.
func langPressed(ctx context.Context, code string) string {
	if i18n.FromContext(ctx).Code == code {
		return "true"
	}
	return "false"
}

// Иконки, не текстовые кнопки: три текста занимали четверть топбара.
// @icon aria-hidden, поэтому имя кнопки — aria-label, title — подсказка при наведении.
templ themeToggle() {
	<form method="post" action="/settings/theme" class="theme-toggle">
		@themeBtn("dark", "moon", "theme.dark")
		@themeBtn("light", "sun", "theme.light")
		@themeBtn("system", "monitor", "theme.system")
	</form>
}

templ themeBtn(code, iconName, labelKey string) {
	<button
		type="submit"
		name="theme"
		value={ code }
		class={ themeBtnClass(ctx, code) }
		aria-label={ i18n.T(ctx, labelKey) }
		title={ i18n.T(ctx, labelKey) }
		aria-pressed={ themePressed(ctx, code) }
	>
		@icon(iconName)
	</button>
}

// aria-pressed нужен: выбранную тему отличает только цвет, скринридеру этого не видно.
func themePressed(ctx context.Context, code string) string {
	if theme.FromContext(ctx).Code == code {
		return "true"
	}
	return "false"
}

func themeBtnClass(ctx context.Context, code string) string {
	if theme.FromContext(ctx).Code == code {
		return "theme-btn is-active"
	}
	return "theme-btn"
}
