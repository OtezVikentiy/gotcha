package templates

// Class должен быть уже объявлен в app.css (legend-*).
type LegendItem struct {
	Label string
	Class string
}

templ chartLegend(items []LegendItem) {
	<p class="chart-legend">
		for _, it := range items {
			<span class={ "legend-item", it.Class }>{ it.Label }</span>
		}
	</p>
}
