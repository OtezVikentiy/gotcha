package templates

import (
	"strconv"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
)

type CardinalityNotice struct {
	Field string
	Limit int
	Collapsed int64
	Samples []string
}

templ cardinalityNoticeView(notices []CardinalityNotice) {
	for _, n := range notices {
		<div class="cardinality-notice">
			<p class="cardinality-notice-head">
				{ i18n.Tf(ctx, "cardinality.notice.title", "field", n.Field, "limit", strconv.Itoa(n.Limit)) }
			</p>
			<p>{ i18n.Tn(ctx, "cardinality.notice.collapsed", int(n.Collapsed)) }</p>
			if len(n.Samples) > 0 {
				<p class="hint">{ i18n.T(ctx, "cardinality.notice.samples") }</p>
				<ul class="cardinality-samples">
					for _, s := range n.Samples {
						<li><code>{ s }</code></li>
					}
				</ul>
			}
			<p>
				{ i18n.T(ctx, "cardinality.notice.cause") }
				{ " " }
				<a href="/docs/cardinality">{ i18n.T(ctx, "cardinality.notice.link") }</a>
			</p>
		</div>
	}
}
