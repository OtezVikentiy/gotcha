package templates

import (
	"context"
	"math"
	"strconv"

	"gitflic.ru/otezvikentiy/gotcha/internal/humanize"
	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/trace"
)

func regressionsPath(projectID int64) string {
	return "/projects/" + strconv.FormatInt(projectID, 10) + "/regressions"
}

func regressionTargetURL(projectID int64, r trace.Regression) string {
	if r.TargetKind == "webvital_p75" {
		return webVitalsPath(projectID)
	}
	return endpointPath(projectID, r.Target)
}

func regressionMetricLabel(ctx context.Context, metric string) string {
	if metric == "duration" {
		return i18n.T(ctx, "perf.regressions.metric.duration_p95")
	}
	return vitalLabel(metric) + " p75"
}

// duration приходит сюда уже в миллисекундах — конвертация из микросекунд единственная, в trace.msSample.
// не использовать функции, ждущие микросекунды: значение будет в тысячу раз больше истинного.
func regressionValueRange(ctx context.Context, r trace.Regression) string {
	return humanize.MetricValue(ctx, r.Metric, r.BaselineValue) + " → " + humanize.MetricValue(ctx, r.Metric, r.PeakValue)
}

// берём пик, не current — у закрытой регрессии current около базы, «+N%» был бы околонулевым.
// пик показывает, насколько плохо стало в худший момент, и для открытых, и для закрытых.
func regressionIncreasePct(r trace.Regression) string {
	if r.BaselineValue <= 0 {
		return "—"
	}
	pct := (r.PeakValue - r.BaselineValue) / r.BaselineValue * 100
	rounded := int64(math.Round(pct))
	sign := "+"
	if rounded < 0 {
		sign = ""
	}
	return sign + strconv.FormatInt(rounded, 10) + "%"
}

// та же семантика, что у perfStatusBadgeClass.
func regressionStatusBadgeClass(status string) string {
	if status == "open" {
		return "badge badge-danger"
	}
	return "badge badge-good"
}

func regressionStatusLabel(ctx context.Context, status string) string {
	switch status {
	case "open":
		return i18n.T(ctx, "perf.tab.open")
	case "resolved":
		return i18n.T(ctx, "issues.status.resolved")
	}
	return status
}

func regressionDurationText(ctx context.Context, r trace.Regression) string {
	if r.ResolvedAt == nil {
		return i18n.T(ctx, "perf.regressions.ongoing")
	}
	return humanize.Duration(ctx, r.ResolvedAt.Sub(r.StartedAt))
}

func regressionStatusFilterURL(projectID int64, status string) string {
	if status == "" {
		return regressionsPath(projectID)
	}
	return regressionsPath(projectID) + "?status=" + status
}

templ regressionStatusTab(projectID int64, value, label, active string) {
	<a class={ perfStatusFilterClass(value == active) } href={ templ.URL(regressionStatusFilterURL(projectID, value)) } if value == active { aria-current="page" }>{ label }</a>
}

templ RegressionsList(projectID int64, regressions []trace.Regression, deployAttr []string, filter string, userEmail string, seasonal bool, canOperate bool, ackedByOpt ...map[int64]string) {
	{{ ackedBy := firstAckedByMap(ackedByOpt) }}
	@layout(i18n.T(ctx, "nav.regressions"), userEmail) {
		<div class="regressions">
			<h1>
				{ i18n.T(ctx, "nav.regressions") }
				if seasonal {
					<span class="badge badge-info" title={ i18n.T(ctx, "regressions.seasonal_badge_hint") }>{ i18n.T(ctx, "regressions.seasonal_badge") }</span>
				}
			</h1>
			@helpPanel("regressions", "performance")
			<nav class="tabs" aria-label={ i18n.T(ctx, "filter.status") }>
				@regressionStatusTab(projectID, "open", i18n.T(ctx, "perf.tab.open"), filter)
				@regressionStatusTab(projectID, "resolved", i18n.T(ctx, "issues.status.resolved"), filter)
				@regressionStatusTab(projectID, "all", i18n.T(ctx, "perf.tab.all"), filter)
			</nav>
			if len(regressions) == 0 {
				@emptyState("zap", "perf.regressions.empty.title", "perf.regressions.empty.body", "", "", 2)
			} else {
				<div class="card">
				@scrollRegion("table-scroll", "nav.regressions") {
					<table class="data-table">
						<thead>
							<tr>
								<th scope="col">{ i18n.T(ctx, "perf.regressions.table.target") }</th>
								<th scope="col">{ i18n.T(ctx, "perf.regressions.table.metric") }</th>
								<th scope="col" class="num">{ i18n.T(ctx, "perf.regressions.table.increase") }</th>
								<th scope="col" class="num">{ i18n.T(ctx, "perf.regressions.table.range") }</th>
								<th scope="col">{ i18n.T(ctx, "issues.table.status") }</th>
								<th scope="col">{ i18n.T(ctx, "incidents.table.severity") }</th>
								<th scope="col">{ i18n.T(ctx, "perf.regressions.table.started") }</th>
								<th scope="col" class="num">{ i18n.T(ctx, "perf.regressions.table.duration") }</th>
								<th scope="col"></th>
							</tr>
						</thead>
						<tbody>
							for i, reg := range regressions {
								<tr>
									<td><a href={ templ.URL(regressionTargetURL(projectID, reg)) }>{ reg.Target }</a></td>
									<td>{ regressionMetricLabel(ctx, reg.Metric) }</td>
									<td class="num">{ regressionIncreasePct(reg) }</td>
									<td class="num">{ regressionValueRange(ctx, reg) }</td>
									<td><span class={ regressionStatusBadgeClass(reg.Status) }>{ regressionStatusLabel(ctx, reg.Status) }</span></td>
									<td>@incidentSeverityBadge(reg.Severity)</td>
									<td>
										@relativeTime(reg.StartedAt)
										if i < len(deployAttr) && deployAttr[i] != "" {
											<div class="regression-deploy-attr"><a href={ templ.URL(deploymentsPath(projectID)) }>{ deployAttr[i] }</a></div>
										}
									</td>
									<td class="num">{ regressionDurationText(ctx, reg) }</td>
									<td>
										if reg.Status == "open" {
											@ackControl(projectID, "trace", reg.ID, canOperate, reg.AcknowledgedAt, ackedByEmailOf(reg.AcknowledgedBy, ackedBy))
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
				</div>
			}
		</div>
	}
}
