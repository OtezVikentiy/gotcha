package templates

import (
	"strconv"
	"time"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/org"
)

func projectSettingsPath(projectID int64) string {
	return "/projects/" + strconv.FormatInt(projectID, 10) + "/settings"
}

func projectSettingsRenamePath(projectID int64) string {
	return projectSettingsPath(projectID) + "/rename"
}

func projectSettingsKeysPath(projectID int64) string {
	return projectSettingsPath(projectID) + "/keys"
}

func projectSettingsKeysRevokePath(projectID int64) string {
	return projectSettingsKeysPath(projectID) + "/revoke"
}

func projectSettingsPerformancePath(projectID int64) string {
	return projectSettingsPath(projectID) + "/performance"
}

func projectSettingsRegressionsPath(projectID int64) string {
	return projectSettingsPath(projectID) + "/regressions"
}

func projectSettingsDeletePath(projectID int64) string {
	return projectSettingsPath(projectID) + "/delete"
}

// PerfSettingsForm — значения формы «Performance» строками, чтобы при 422
// перерисовке показать РОВНО то, что отправил пользователь (например «1.5»),
// а не переигранное через float. На GET заполняется из org.Project и
// распарсенного perf_detector_config (см. perfFormFromProject в projsettings.go).
type PerfSettingsForm struct {
	SampleRate         string
	ApdexMS            string
	NPlusOneMin        string
	NPlusOneMinTotalMs string
	SlowDBMs           string
	HTTPFloodMin       string
}

// RegressionSettingsForm — значения формы «Регрессии» строками (тот же приём,
// что и PerfSettingsForm: при 422 показать РОВНО отправленное). ThresholdPct и
// RecoveryPct — В ПРОЦЕНТАХ (25 = ratio 0.25), конвертация в долю на стороне
// обработчика. Полы — абсолютные значения метрик. Enabled — bool (чекбокс).
// На GET заполняется из RegressionConfigFromJSON(project.PerfRegressionConfig)
// (см. regressionFormFromProject в projsettings.go).
type RegressionSettingsForm struct {
	ThresholdPct    string
	RecoveryPct     string
	WindowMinutes   string
	MinSamples      string
	DurationFloorMs string
	FloorLCP        string
	FloorINP        string
	FloorCLS        string
	FloorFCP        string
	FloorTTFB       string
	Enabled         bool
	SeasonalEnabled bool
	SeasonalWeeks   string
}

// keyStatusBadgeClass — цвет статуса DSN-ключа через дизайн-систему: живой
// ключ — .badge-good (используется прямо сейчас), отозванный — .badge-danger
// (клиенты с ним сразу получают 403 — это заметное, «опасное» состояние,
// не просто нейтральный факт).
func keyStatusBadgeClass(k org.Key) string {
	if k.Revoked {
		return "badge badge-danger"
	}
	return "badge badge-good"
}

// keyStatusLabelKey — i18n-ключ подписи статуса ключа.
func keyStatusLabelKey(k org.Key) string {
	if k.Revoked {
		return "project.settings.keys.status.revoked"
	}
	return "project.settings.keys.status.active"
}

// ProjectKeyView — строка таблицы ключей: сам ключ и его собственный DSN.
// DSN считается в web-слое (buildDSN знает BaseURL инстанса), шаблон его
// только показывает.
type ProjectKeyView struct {
	Key org.Key
	DSN string
}

// DeprecatedPathView — одна строка callout'а «проект ещё шлёт по устаревшим
// адресам» (аудит перед 1.0, K7-5/K7-6): собирается в web-слое из
// ingestsignal.Store.ForProject (renderProjectSettings), фильтр по
// LastSeenAt — там же. Path — сам устаревший адрес (например "/logs"), Hits
// — сумма попаданий за всё время наблюдения (не только за окно фильтра, оно
// лишь решает, показывать ли строку вообще — отсюда формулировка «всего», а
// не «за 7 дней» в тексте). Docs — страница документации именно этого входа
// (ingest.DocsPath), не общий /docs/upgrade: разные адреса ведут в разные
// разделы (logs/profiling/deployments).
type DeprecatedPathView struct {
	Path       string
	LastSeenAt time.Time
	Hits       int64
	Docs       string
}

// deprecatedPathsCallout — над списком ключей (K7-5): раз отправитель ещё
// стучится на удаляемый в 1.0 алиас, самое уместное место напомнить об этом
// — прямо рядом с тем местом, где выпускают новые ключи и смотрят на DSN.
// Пусто (nil/[]) → блок не рендерится вовсе — свежий проект или проект без
// Store (h.Signals == nil) не должен видеть пустой callout. Ссылка — у
// каждого адреса своя (p.Docs), а не одна общая: /logs и /profiles/pprof
// документированы в разных разделах.
templ deprecatedPathsCallout(paths []DeprecatedPathView) {
	if len(paths) > 0 {
		<div class="quota-banner">
			<div>
				<strong>{ i18n.T(ctx, "ingest_signals.deprecated.title") }</strong>
				<ul>
					for _, p := range paths {
						<li>
							{ i18n.Tf(ctx, "ingest_signals.deprecated.item", "path", p.Path) }
							@relativeTime(p.LastSeenAt)
							{ i18n.Tf(ctx, "ingest_signals.deprecated.item_hits", "hits", strconv.FormatInt(p.Hits, 10)) }
							<a href={ templ.SafeURL(p.Docs) }>{ i18n.T(ctx, "ingest_signals.deprecated.link") }</a>
						</li>
					}
				</ul>
				<span class="quota-banner-detail">{ i18n.T(ctx, "ingest_signals.deprecated.hint") }</span>
			</div>
		</div>
	}
}

// keyKindLabelKey — i18n-ключ подписи типа ключа. legacy отображается как
// «без типа»: с точки зрения пользователя это ключ, выпущенный до появления
// типов, а не ещё один равноправный выбор.
func keyKindLabelKey(k org.Key) string {
	if k.Kind == org.KindLegacy || k.Kind == "" {
		return "project.settings.keys.kind.legacy"
	}
	return "project.settings.keys.kind." + string(k.Kind)
}

// keyKindBadgeClass — legacy выделен как состояние, требующее внимания
// (переход на типизированные ключи), но не как ошибка: ключ работает.
func keyKindBadgeClass(k org.Key) string {
	if k.Kind == org.KindLegacy || k.Kind == "" {
		return "badge badge-warn"
	}
	return "badge"
}

// keyRowHasDSN — у карточки ключа есть блок с его DSN. Отозванному ключу DSN
// не показываем (слать им нечего), пустой DSN означает ненастроенный BaseURL
// инстанса — и то, и другое оставляет карточку без DSN-блока (см.
// keyCard ниже и keyDisplayID, которая на этом же условии решает, сокращать
// ли идентификатор в шапке).
func keyRowHasDSN(v ProjectKeyView) bool {
	return !v.Key.Revoked && v.DSN != ""
}

// keyDisplayID — идентификатор ключа для шапки карточки (keyCard). Когда
// карточка и так показывает DSN (keyRowHasDSN), полный ключ уже виден внутри
// него (buildDSN подставляет его целиком) — печатать те же 32 hex-символа
// ВТОРОЙ раз в шапке было бы чистым повтором, поэтому там сокращённая форма
// «первые 6…последние 4». Отозванному ключу (и живому с пустым DSN) сокращать
// нечего: шапка — единственное место, где виден весь ключ, а title как
// единственный носитель полного значения не годится — его не прочесть ни с
// клавиатуры, ни скринридером.
//
// Сокращаем только то, что реально длиннее результата сокращения: при длине
// ключа ≤12 символов «сокращённая» форма (6+1+4=11) выигрывает от силы один
// символ, а на коротких тестовых фикстурах (7-10 символов) вообще ничего не
// экономит — возвращаем ключ как есть.
func keyDisplayID(v ProjectKeyView) string {
	id := v.Key.PublicKey
	if !keyRowHasDSN(v) {
		return id
	}
	const headRunes, tailRunes = 6, 4
	r := []rune(id)
	if len(r) <= 12 {
		return id
	}
	return string(r[:headRunes]) + "…" + string(r[len(r)-tailRunes:])
}

// hasLiveKey — есть ли среди ключей проекта хотя бы один неотозванный.
// Предупреждение «нет активного ключа» (ProjectSettings) обязано появляться
// не только когда ключей нет вовсе, но и когда все выпущенные — отозваны:
// приём событий в обоих случаях одинаково сломан, а старое условие
// len(keys)==0 второй случай молча пропускало.
func hasLiveKey(keys []ProjectKeyView) bool {
	for _, v := range keys {
		if !v.Key.Revoked {
			return true
		}
	}
	return false
}

// keyCard — карточка одного DSN-ключа: шапка (сокращённый/полный
// идентификатор + бейджи типа и статуса), опциональная заметка (ссылка
// «Что это значит» у legacy-ключа, пояснение у отозванного), DSN-блок
// (copyBlock, показывается только при keyRowHasDSN) и кнопка отзыва (только у
// живого ключа). Раньше запись занимала ДВЕ строки таблицы (сама запись +
// DSN во всю ширину через colspan) — обходной приём, вызванный тем, что
// таблица стоит в узкой средней колонке трёхколоночных настроек и пятую
// колонку под DSN схлопывала до ~78px. Карточка этого ограничения не имеет:
// ширина у неё одна, произвольная высота — не проблема.
templ keyCard(projectID int64, v ProjectKeyView) {
	<article class={ "key-card", templ.KV("key-card--revoked", v.Key.Revoked) }>
		<div class="key-card-head">
			<span class="key-card-id">{ keyDisplayID(v) }</span>
			<span class={ keyKindBadgeClass(v.Key) }>{ i18n.T(ctx, keyKindLabelKey(v.Key)) }</span>
			<span class={ keyStatusBadgeClass(v.Key) }>{ i18n.T(ctx, keyStatusLabelKey(v.Key)) }</span>
		</div>
		if v.Key.Kind == org.KindLegacy || v.Key.Kind == "" {
			<p class="key-card-note"><a href="/docs/keys">{ i18n.T(ctx, "project.settings.keys.kind.legacy.hint") }</a></p>
		}
		if v.Key.Revoked {
			<p class="key-card-note">{ i18n.T(ctx, "project.settings.keys.revoked.note") }</p>
		}
		if keyRowHasDSN(v) {
			@copyBlock("dsn-"+strconv.FormatInt(v.Key.ID, 10), "project.settings.dsn.copy", v.DSN)
		}
		if !v.Key.Revoked {
			<div class="card-actions">
				<form method="post" action={ templ.URL(projectSettingsKeysRevokePath(projectID)) } class="key-revoke-form">
					<input type="hidden" name="key_id" value={ strconv.FormatInt(v.Key.ID, 10) }/>
					<button type="submit" class="btn btn-danger-ghost">{ i18n.T(ctx, "project.settings.keys.revoke") }</button>
				</form>
			</div>
		}
	</article>
}

// ProjectSettings — GET/POST /projects/{id}/settings: имя (форма rename),
// платформа (readonly), список карточек DSN-ключей (идентификатор, тип,
// статус, DSN и revoke — по одной карточке на ключ, см. keyCard), форма
// выпуска нового ключа. errMsg —
// сообщение об ошибке последнего POST, рендерится с тем же статусом (422),
// что и ответ — тот же принцип, что и у OrgSettings/Teams.
// helpLabel — подпись поля с всплывающей расшифровкой (нативный title, без JS
// и CSP-исключений). Пунктирное подчёркивание и курсор-help сигналят, что при
// наведении будет пояснение. Для форм с «непрозрачными» техническими полями
// (пороги детекторов производительности/регрессий), где непосвящённому имя
// поля ничего не говорит.
templ helpLabel(labelKey, helpKey string) {
	<span class="help-label" title={ i18n.T(ctx, helpKey) }>{ i18n.T(ctx, labelKey) }</span>
}

// perfSettingsForm — секция «Performance»: доля семплирования транзакций,
// порог Apdex и пороги детекторов. Один POST на /settings/performance
// (sameOrigin + owner|admin), при невалидном вводе — 422 с этой же формой.
templ perfSettingsForm(projectID int64, f PerfSettingsForm) {
	<section class="card">
		<h2 class="card-header">{ i18n.T(ctx, "nav.performance") }</h2>
		<form method="post" action={ templ.URL(projectSettingsPerformancePath(projectID)) } class="project-perf-form">
			<div class="field">
				<label>
					@helpLabel("project.settings.perf.sample_rate", "project.settings.perf.sample_rate.help")
					<input type="number" name="sample_rate" value={ f.SampleRate } min="0" max="1" step="0.01" required class="input"/>
				</label>
			</div>
			<div class="field">
				<label>
					@helpLabel("project.settings.perf.apdex_ms", "project.settings.perf.apdex_ms.help")
					<input type="number" name="apdex_threshold_ms" value={ f.ApdexMS } min="1" required class="input"/>
				</label>
			</div>
			<div class="field">
				<label>
					@helpLabel("project.settings.perf.n_plus_one_min", "project.settings.perf.n_plus_one_min.help")
					<input type="number" name="n_plus_one_min" value={ f.NPlusOneMin } min="1" required class="input"/>
				</label>
			</div>
			<div class="field">
				<label>
					@helpLabel("project.settings.perf.n_plus_one_total_ms", "project.settings.perf.n_plus_one_total_ms.help")
					<input type="number" name="n_plus_one_min_total_ms" value={ f.NPlusOneMinTotalMs } min="1" required class="input"/>
				</label>
			</div>
			<div class="field">
				<label>
					@helpLabel("project.settings.perf.slow_db_ms", "project.settings.perf.slow_db_ms.help")
					<input type="number" name="slow_db_ms" value={ f.SlowDBMs } min="1" required class="input"/>
				</label>
			</div>
			<div class="field">
				<label>
					@helpLabel("project.settings.perf.http_flood_min", "project.settings.perf.http_flood_min.help")
					<input type="number" name="http_flood_min" value={ f.HTTPFloodMin } min="1" required class="input"/>
				</label>
			</div>
			<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "project.settings.perf.submit") }</button>
		</form>
	</section>
}

// regressionSettingsForm — секция «Регрессии»: пороги детектора регрессий
// (рост p95/p75 над скользящей базой). threshold_pct/recovery_pct В ПРОЦЕНТАХ
// (шаг 1). Один POST на /settings/regressions (sameOrigin + owner|admin), при
// невалидном вводе — 422 с этой же формой.
templ regressionSettingsForm(projectID int64, f RegressionSettingsForm) {
	<section class="card">
		<h2 class="card-header">{ i18n.T(ctx, "nav.regressions") }</h2>
		<form method="post" action={ templ.URL(projectSettingsRegressionsPath(projectID)) } class="project-regression-form">
			<div class="field">
				<label>
					@helpLabel("project.settings.regressions.threshold_pct", "project.settings.regressions.threshold_pct.help")
					<input type="number" name="threshold_pct" value={ f.ThresholdPct } min="1" max="100" step="1" required class="input"/>
				</label>
			</div>
			<div class="field">
				<label>
					@helpLabel("project.settings.regressions.recovery_pct", "project.settings.regressions.recovery_pct.help")
					<input type="number" name="recovery_pct" value={ f.RecoveryPct } min="1" max="100" step="1" required class="input"/>
				</label>
			</div>
			<div class="field">
				<label>
					@helpLabel("project.settings.regressions.window_minutes", "project.settings.regressions.window_minutes.help")
					<input type="number" name="window_minutes" value={ f.WindowMinutes } min="1" required class="input"/>
				</label>
			</div>
			<div class="field">
				<label>
					@helpLabel("project.settings.regressions.min_samples", "project.settings.regressions.min_samples.help")
					<input type="number" name="min_samples" value={ f.MinSamples } min="1" required class="input"/>
				</label>
			</div>
			<div class="field">
				<label>
					@helpLabel("project.settings.regressions.duration_floor_ms", "project.settings.regressions.duration_floor_ms.help")
					<input type="number" name="duration_floor_ms" value={ f.DurationFloorMs } min="0" step="any" required class="input"/>
				</label>
			</div>
			<div class="field">
				<label>
					@helpLabel("project.settings.regressions.floor_lcp", "project.settings.regressions.floor_lcp.help")
					<input type="number" name="floor_lcp" value={ f.FloorLCP } min="0" step="any" required class="input"/>
				</label>
			</div>
			<div class="field">
				<label>
					@helpLabel("project.settings.regressions.floor_inp", "project.settings.regressions.floor_inp.help")
					<input type="number" name="floor_inp" value={ f.FloorINP } min="0" step="any" required class="input"/>
				</label>
			</div>
			<div class="field">
				<label>
					@helpLabel("project.settings.regressions.floor_cls", "project.settings.regressions.floor_cls.help")
					<input type="number" name="floor_cls" value={ f.FloorCLS } min="0" step="any" required class="input"/>
				</label>
			</div>
			<div class="field">
				<label>
					@helpLabel("project.settings.regressions.floor_fcp", "project.settings.regressions.floor_fcp.help")
					<input type="number" name="floor_fcp" value={ f.FloorFCP } min="0" step="any" required class="input"/>
				</label>
			</div>
			<div class="field">
				<label>
					@helpLabel("project.settings.regressions.floor_ttfb", "project.settings.regressions.floor_ttfb.help")
					<input type="number" name="floor_ttfb" value={ f.FloorTTFB } min="0" step="any" required class="input"/>
				</label>
			</div>
			<label class="checkbox-inline">
				<input type="checkbox" name="enabled" value="1" checked?={ f.Enabled }/>
				{ i18n.T(ctx, "project.settings.regressions.enabled") }
			</label>
			<label class="checkbox-inline">
				<input type="checkbox" name="seasonal_enabled" value="1" checked?={ f.SeasonalEnabled }/>
				{ i18n.T(ctx, "project.settings.regressions.seasonal_enabled") }
			</label>
			<div class="field">
				<label>
					@helpLabel("project.settings.regressions.seasonal_weeks", "project.settings.regressions.seasonal_weeks.help")
					<input type="number" name="seasonal_weeks" value={ f.SeasonalWeeks } min="2" max="12" step="1" required class="input"/>
				</label>
				<p class="hint">{ i18n.T(ctx, "project.settings.regressions.seasonal_hint") }</p>
			</div>
			<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "project.settings.regressions.submit") }</button>
		</form>
	</section>
}

// retentionNotice — «События хранятся N дней» при заданном RetentionDays,
// иначе «срок хранения не ограничен» — PROD-P6. Число подставляется через
// i18n.Tf, а не отдельным узлом рядом с переводом: иначе порядок слов
// «N дней» / «N days» не переживает разные языки.
templ retentionNotice(retentionDays int) {
	if retentionDays > 0 {
		<p class="retention-notice">{ i18n.Tf(ctx, "project.settings.retention.notice", "days", strconv.Itoa(retentionDays)) }</p>
	} else {
		<p class="retention-notice">{ i18n.T(ctx, "project.settings.retention.unset") }</p>
	}
}

templ ProjectSettings(project org.Project, keys []ProjectKeyView, errMsg, userEmail string, perf PerfSettingsForm, reg RegressionSettingsForm, retentionDays int, deprecatedPaths []DeprecatedPathView) {
	@layout(i18n.T(ctx, "project.settings.title")+" "+project.Name, userEmail) {
		<div class="project-settings">
			<h1>{ i18n.T(ctx, "project.settings.title") } { project.Name }</h1>
			if errMsg != "" {
				<p class="error">{ errMsg }</p>
			}
			<div class="settings-grid">
			<section class="card">
				<h2 class="card-header">{ i18n.T(ctx, "project.settings.general.title") }</h2>
				<form method="post" action={ templ.URL(projectSettingsRenamePath(project.ID)) } class="project-rename-form">
					<div class="field">
						<label>
							{ i18n.T(ctx, "project.settings.field.name") }
							<input type="text" name="name" value={ project.Name } required class="input"/>
						</label>
					</div>
					<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "project.settings.rename.submit") }</button>
				</form>
				<p><strong>{ i18n.T(ctx, "project.settings.field.platform") }:</strong> { i18n.T(ctx, "platform."+project.Platform) }</p>
				<p><a class="btn btn-ghost" href={ templ.URL(alertsPath(project.ID)) }>{ i18n.T(ctx, "nav.alerts") }</a></p>
			</section>
			<section class="card">
				<h2 class="card-header">{ i18n.T(ctx, "project.settings.keys.title") }</h2>
				if !hasLiveKey(keys) {
					<p class="error">{ i18n.T(ctx, "project.settings.keys.no_dsn") }</p>
				}
				@deprecatedPathsCallout(deprecatedPaths)
				<div class="key-list">
					for _, v := range keys {
						@keyCard(project.ID, v)
					}
				</div>
				<form method="post" action={ templ.URL(projectSettingsKeysPath(project.ID)) } class="key-create-form">
					<fieldset class="field">
						<legend class="field-label">{ i18n.T(ctx, "project.settings.keys.kind.legend") }</legend>
						<div class="segmented">
							for _, kind := range []org.KeyKind{org.KindBrowser, org.KindServer, org.KindAgent} {
								<label>
									<input type="radio" name="kind" value={ string(kind) } required/>
									{ i18n.T(ctx, "project.settings.keys.kind."+string(kind)) }
								</label>
							}
						</div>
						<p class="hint key-kind-hint key-kind-hint--none">{ i18n.T(ctx, "project.settings.keys.kind.none.hint") }</p>
						for _, kind := range []org.KeyKind{org.KindBrowser, org.KindServer, org.KindAgent} {
							<p class={ "hint", "key-kind-hint", "key-kind-hint--" + string(kind) }>{ i18n.T(ctx, "project.settings.keys.kind."+string(kind)+".hint") }</p>
						}
					</fieldset>
					<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "project.settings.keys.create") }</button>
				</form>
			</section>
			@perfSettingsForm(project.ID, perf)
			@regressionSettingsForm(project.ID, reg)
			<div class="settings-stack">
				<section class="card">
					<h2 class="card-header">{ i18n.T(ctx, "project.settings.retention.title") }</h2>
					@retentionNotice(retentionDays)
				</section>
				<section class="card">
					<h2 class="card-header">{ i18n.T(ctx, "project.settings.danger.title") }</h2>
					<div class="card-actions">
						<form
							method="post"
							action={ templ.URL(projectSettingsDeletePath(project.ID)) }
							class="project-delete-form"
						>
							<button type="submit" class="btn btn-danger">{ i18n.T(ctx, "project.settings.danger.delete_submit") }</button>
						</form>
					</div>
				</section>
			</div>
			</div>
		</div>
	}
}
