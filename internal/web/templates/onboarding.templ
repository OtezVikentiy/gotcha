package templates

import (
	"strconv"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/org"
)

func projectSetupPath(id int64) string {
	return "/projects/" + strconv.FormatInt(id, 10) + "/setup"
}

templ platformOption(value, label, selected string) {
	if value == selected {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

templ Onboarding(errMsg, orgSlug, orgName, projectSlug, projectName, platform, userEmail string) {
	@chromeless(i18n.T(ctx, "onboarding.title"), userEmail) {
		<form method="post" action="/onboarding" class="auth-form">
			<h1>{ i18n.T(ctx, "onboarding.title") }</h1>
			if errMsg != "" {
				<p class="error">{ errMsg }</p>
			}
			<div class="field">
				<label>
					{ i18n.T(ctx, "onboarding.field.org_slug") }
					<input type="text" name="org_slug" placeholder="my-team" autocomplete="off" required autofocus pattern="[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?" maxlength="64" value={ orgSlug } class="input"/>
				</label>
				<p class="hint">{ i18n.T(ctx, "onboarding.slug_hint") }</p>
			</div>
			<div class="field">
				<label>
					{ i18n.T(ctx, "onboarding.field.org_name") }
					<input type="text" name="org_name" placeholder={ i18n.T(ctx, "onboarding.org_placeholder") } required value={ orgName } class="input"/>
				</label>
			</div>
			<div class="field">
				<label>
					{ i18n.T(ctx, "onboarding.field.project_slug") }
					<input type="text" name="project_slug" placeholder="backend" autocomplete="off" required pattern="[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?" maxlength="64" value={ projectSlug } class="input"/>
				</label>
				<p class="hint">{ i18n.T(ctx, "onboarding.slug_hint") }</p>
			</div>
			<div class="field">
				<label>
					{ i18n.T(ctx, "onboarding.field.project_name") }
					<input type="text" name="project_name" placeholder={ i18n.T(ctx, "onboarding.project_placeholder") } required value={ projectName } class="input"/>
				</label>
			</div>
			<div class="field">
				<label>
					{ i18n.T(ctx, "onboarding.field.platform") }
					<select name="platform" required class="select">
						for _, p := range org.Platforms {
							@platformOption(p, i18n.T(ctx, "platform."+p), platform)
						}
					</select>
				</label>
			</div>
			<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "onboarding.submit") }</button>
		</form>
	}
}

// missingPlatformKind непуст, когда снипет для платформы САМОГО проекта не попал в snippets.
// иначе пользователь JS-проекта видел бы Go/PHP/Python и не понимал, куда делся его язык.
templ ProjectSetup(project org.Project, dsn string, snippets []SetupSnippet, missingPlatformKind org.KeyKind, userEmail string) {
	@layout(i18n.T(ctx, "project.setup.title")+" "+project.Name, userEmail) {
		<div class="setup">
			@breadcrumbBackTo(templ.URL(projectSettingsPath(project.ID)), i18n.T(ctx, "project.settings.title"))
			<h1>{ project.Name }</h1>
			if len(snippets) == 0 {
				<p class="error">{ i18n.T(ctx, "project.setup.no_key") }</p>
			} else {
				<div class="card-stack">
					if dsn != "" {
						<section class="card">
							<h2 class="card-header">{ i18n.T(ctx, "project.setup.dsn.title") }</h2>
							<p>{ i18n.T(ctx, "project.setup.dsn_label") }</p>
							@copyBlock("setup-dsn", "project.settings.dsn.copy", dsn)
						</section>
					}
					if missingPlatformKind != "" {
						<p class="hint">
							{ i18n.Tf(ctx, "project.setup.missing_platform_key",
								"platform", i18n.T(ctx, "platform."+project.Platform),
								"kind", i18n.T(ctx, "project.settings.keys.kind."+string(missingPlatformKind))) }
							{ " " }
							<a href={ templ.URL(projectSettingsPath(project.ID)) }>{ i18n.T(ctx, "project.setup.missing_platform_key_link") }</a>
						</p>
					}
					<p class="hint">{ i18n.T(ctx, "project.setup.sdk_note") }</p>
					<p class="hint">{ i18n.T(ctx, "project.setup.dsn_kinds_note") }</p>
					for _, sn := range snippets {
						<section class="panel">
							<h2 class="card-header">{ sn.Lang }</h2>
							<p class="hint">{ i18n.T(ctx, "project.setup.install") }</p>
							@copyBlock("setup-install-"+sn.Lang, "project.setup.copy_install", sn.Install)
							<p class="hint">{ i18n.T(ctx, "project.setup.init") }</p>
							@copyBlock("setup-init-"+sn.Lang, "project.setup.copy_init", sn.Code)
						</section>
					}
				</div>
				<p><a href="/docs/sdk">{ i18n.T(ctx, "project.setup.full_docs_link") }</a></p>
			}
			<p>
				<a href={ templ.URL(issuesPath(project.ID)) }>{ i18n.T(ctx, "project.setup.issues_link") }</a>
				{ " · " }
				<a href="/projects">{ i18n.T(ctx, "project.setup.back_link") }</a>
			</p>
		</div>
	}
}

// не для юзера без организаций вовсе (тот уходит на /onboarding) — этому нужен админ.
// canCreate — owner/admin получает дверь в создание проекта, остальным иначе был бы тупик.
templ NoProjects(canCreate bool, userEmail string) {
	@chromeless(i18n.T(ctx, "project.none.title"), userEmail) {
		<div class="no-projects">
			if canCreate {
				@emptyState("building", "project.none.title", "project.none.admin.body", "project.none.admin.cta", "/projects", 3)
			} else {
				@emptyState("building", "project.none.title", "project.none.body", "", "", 3)
			}
		</div>
	}
}

// CanManage — иначе member получал бы ссылку на «Org settings», отвечающую ему 404.
type ProjectListItem struct {
	Project   org.Project
	CanManage bool
}

templ projectRow(it ProjectListItem) {
	<tr>
		<td><a href={ templ.URL(projectSettingsPath(it.Project.ID)) }>{ it.Project.Name }</a></td>
		<td><span class="chip">{ i18n.T(ctx, "platform."+it.Project.Platform) }</span></td>
		<td><a class="btn btn-ghost" href={ templ.URL(projectSetupPath(it.Project.ID)) }>{ i18n.T(ctx, "project.list.setup_link") }</a></td>
		<td>
			if it.CanManage {
				<a class="btn btn-ghost" href={ templ.URL(orgSettingsPath(it.Project.OrgID)) }>{ i18n.T(ctx, "project.list.org_settings_link") }</a>
			}
		</td>
	</tr>
}

type OrgOption struct {
	ID   int64
	Name string
}

templ ProjectsList(items []ProjectListItem, canCreate []OrgOption, form FormState, errMsg, userEmail string) {
	@layout(i18n.T(ctx, "project.list.title"), userEmail) {
		<div class="projects-list">
			<h1>{ i18n.T(ctx, "project.list.title") }</h1>
			if errMsg != "" && !form.Has() {
				<p class="error">{ errMsg }</p>
			}
			if len(canCreate) > 0 {
				@createTrigger("new-project", "project.create.title")
			}
			if len(items) == 0 {
				// пустой список у действующей организации ведёт в модалку на этой же странице, не в /onboarding.
				// без права создавать (member) CTA нет: якоря модалки не существует.
				if len(canCreate) > 0 {
					@emptyState("building", "project.list.empty.title", "project.list.empty", "project.list.empty_cta", "#new-project", 2)
				} else {
					@emptyState("building", "project.list.empty.title", "project.list.empty", "", "", 2)
				}
			} else {
				<div class="card">
				@scrollRegion("table-scroll", "project.list.title") {
						<table class="data-table">
							<thead>
								<tr>
									<th scope="col">{ i18n.T(ctx, "project.list.table.name") }</th>
									<th scope="col">{ i18n.T(ctx, "project.list.table.platform") }</th>
									<th scope="col"></th>
									<th scope="col"></th>
								</tr>
							</thead>
							<tbody>
								for _, it := range items {
									@projectRow(it)
								}
							</tbody>
						</table>
				}
				</div>
			}
			if len(canCreate) > 0 {
				@createModalOpen("new-project", "project.create.title", false, form.Opens("new-project")) {
					<form method="post" action="/projects/new" class="project-create-form">
						// без role=alert: фокус в модалку переносит modal.js, ошибка привязана через aria-describedby.
						if errMsg != "" && form.Opens("new-project") {
							<p class="error" id="new-project-error">{ errMsg }</p>
						}
						<div class="field">
							<label>
								{ i18n.T(ctx, "project.create.org") }
								<select name="org_id" class="select">
									for _, o := range canCreate {
										if form.Selected("org_id", strconv.FormatInt(o.ID, 10), strconv.FormatInt(canCreate[0].ID, 10)) {
											<option value={ strconv.FormatInt(o.ID, 10) } selected>{ o.Name }</option>
										} else {
											<option value={ strconv.FormatInt(o.ID, 10) }>{ o.Name }</option>
										}
									}
								</select>
							</label>
						</div>
						<div class="field">
							<label>
								{ i18n.T(ctx, "project.create.slug") }
								<input
									type="text"
									name="slug"
									required
									class="input"
									placeholder="backend-api"
									value={ form.Get("slug", "") }
									if errMsg != "" && form.Opens("new-project") {
										aria-invalid="true"
										aria-describedby="new-project-error"
									}
								/>
							</label>
							<span class="hint">{ i18n.T(ctx, "project.create.slug_hint") }</span>
						</div>
						<div class="field">
							<label>
								{ i18n.T(ctx, "project.create.name") }
								<input type="text" name="name" required class="input" value={ form.Get("name", "") }/>
							</label>
						</div>
						<div class="field">
							<label>
								{ i18n.T(ctx, "project.create.platform") }
								<select name="platform" required class="select">
									for _, p := range org.Platforms {
										@platformOption(p, i18n.T(ctx, "platform."+p), form.Get("platform", "go"))
									}
								</select>
							</label>
						</div>
						<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "project.create.submit") }</button>
					</form>
				}
			}
		</div>
	}
}
