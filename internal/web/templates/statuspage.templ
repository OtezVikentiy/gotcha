package templates

import (
	"context"
	"time"

	"gitflic.ru/otezvikentiy/gotcha/internal/humanize"
	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/theme"
	"gitflic.ru/otezvikentiy/gotcha/internal/uptime"
)

// модель публичной страницы — только то, что можно показать миру.
// URL/хоста/порта монитора, текста ошибки, имён проекта/организации здесь нет и не должно быть.
type StatusPageView struct {
	Title       string
	Description string
	Overall     string // operational | partial | major
	// фактическая глубина страницы — берётся из срока хранения событий, не захардкожена.
	Days        int
	Monitors    []StatusMonitorView
	Incidents   []StatusIncidentView
	Maintenance []StatusWindowView
}

type StatusMonitorView struct {
	Name      string
	Status    string // up | down | unknown | paused | maintenance
	Uptime90d uptime.UptimeStat
	// сырые корзины — готовый SVG с локализованными подписями строится на рендере запроса.
	BarStats []uptime.UptimeStat
	Bars     templ.Component
}

type StatusIncidentView struct {
	Name      string
	StartedAt string
	// time.Duration, не готовая строка — вьюха кешируется одна на всех, перевод числа зависит от языка.
	// Ongoing=true — нулевая длительность, шаблон подставляет «идёт» сам.
	Duration time.Duration
	Ongoing  bool
}

type StatusWindowView struct {
	Name string
	From string
	To   string
}

func overallStatusText(ctx context.Context, overall string) string {
	switch overall {
	case "major":
		return i18n.T(ctx, "status.overall.major")
	case "partial":
		return i18n.T(ctx, "status.overall.partial")
	default:
		return i18n.T(ctx, "status.overall.ok")
	}
}

// свои формулировки (status.monitor.*), не uptime.status.* — посетителю «Работает», не сухое «Up».
func statusMonitorText(ctx context.Context, status string) string {
	switch status {
	case "up":
		return i18n.T(ctx, "status.monitor.up")
	case "down":
		return i18n.T(ctx, "status.monitor.down")
	case "paused":
		return i18n.T(ctx, "status.monitor.paused")
	case "maintenance":
		return i18n.T(ctx, "status.monitor.maintenance")
	default:
		return i18n.T(ctx, "status.monitor.unknown")
	}
}

// подсказка paused_hint осмысленна только когда посетитель видит бейдж «Пауза».
func hasPausedMonitor(monitors []StatusMonitorView) bool {
	for _, m := range monitors {
		if m.Status == "paused" {
			return true
		}
	}
	return false
}

func overallStatusClass(overall string) string {
	switch overall {
	case "major":
		return "status-overall status-overall-major"
	case "partial":
		return "status-overall status-overall-partial"
	default:
		return "status-overall status-overall-ok"
	}
}

// свой layout публичной страницы — ни навигации приложения, ни JS, ни ссылок в кабинет.
templ statusLayout(title string) {
	<!DOCTYPE html>
	if theme.FromContext(ctx).Code != "system" {
		<html lang={ i18n.FromContext(ctx).Code } data-theme={ theme.FromContext(ctx).Code }>
			@statusLayoutBody(title) {
				{ children... }
			}
		</html>
	} else {
		<html lang={ i18n.FromContext(ctx).Code }>
			@statusLayoutBody(title) {
				{ children... }
			}
		</html>
	}
}

// вынесено — templ не даёт условно открыть тег без закрывающего, как в layout/chromeless.
templ statusLayoutBody(title string) {
	<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" href={ assetURL("/static/favicon.svg") } type="image/svg+xml"/>
		<link rel="stylesheet" href={ assetURL("/static/app.css") }/>
	</head>
	<body class="status-body">
		<main class="status-page">
			{ children... }
		</main>
	</body>
}

templ statusMonitorTile(m StatusMonitorView, days int) {
	<li class="status-tile card">
		<div class="status-tile-head">
			<span class="status-tile-name" title={ m.Name }>{ m.Name }</span>
			<span class={ monitorStatusBadgeClass(m.Status) }>{ statusMonitorText(ctx, m.Status) }</span>
		</div>
		<div class="status-tile-bars">@m.Bars</div>
		<div class="status-tile-uptime">
			{ i18n.Tf(ctx, "status.uptime_period",
				"period", i18n.Tn(ctx, "unit.days", days),
				"value", uptimeStatText(m.Uptime90d)) }
		</div>
	</li>
}

templ PublicStatusPage(v StatusPageView) {
	@statusLayout(v.Title) {
		<h1>{ v.Title }</h1>
		if v.Description != "" {
			<p class="status-description">{ v.Description }</p>
		}
		<p class={ overallStatusClass(v.Overall) }>{ overallStatusText(ctx, v.Overall) }</p>
		<p class="hint" data-status-note="timezone">{ i18n.T(ctx, "status.timezone_note") }</p>
		if hasPausedMonitor(v.Monitors) {
			<p class="hint" data-status-note="paused">{ i18n.T(ctx, "status.monitor.paused_hint") }</p>
		}

		if len(v.Monitors) == 0 {
			<p>{ i18n.T(ctx, "status.monitors.empty") }</p>
		} else {
			<ul class="status-tiles">
				for _, m := range v.Monitors {
					@statusMonitorTile(m, v.Days)
				}
			</ul>
		}

		<h2>
			{ i18n.Tf(ctx, "status.incidents.title_period",
				"period", i18n.Tn(ctx, "unit.days", v.Days)) }
		</h2>
		if len(v.Incidents) == 0 {
			<p>{ i18n.T(ctx, "status.incidents.empty") }</p>
		} else {
			@scrollRegion("table-scroll", "region.status.incidents") {
				<table class="status-incidents data-table">
					<thead>
						<tr>
							<th scope="col">{ i18n.T(ctx, "status.col.service") }</th>
							<th scope="col">{ i18n.T(ctx, "status.col.started") }</th>
							<th scope="col">{ i18n.T(ctx, "status.col.duration") }</th>
						</tr>
					</thead>
					<tbody>
						for _, inc := range v.Incidents {
							<tr>
								<td>{ inc.Name }</td>
								<td>{ inc.StartedAt }</td>
								if inc.Ongoing {
									<td>{ i18n.T(ctx, "status.incident.ongoing") }</td>
								} else {
									<td>{ humanize.Duration(ctx, inc.Duration) }</td>
								}
							</tr>
						}
					</tbody>
				</table>
			}
		}

		<h2>{ i18n.T(ctx, "status.maintenance.title") }</h2>
		if len(v.Maintenance) == 0 {
			<p>{ i18n.T(ctx, "status.maintenance.empty") }</p>
		} else {
			@scrollRegion("table-scroll", "region.status.maintenance") {
				<table class="status-maintenance data-table">
					<thead>
						<tr>
							<th scope="col">{ i18n.T(ctx, "status.col.window") }</th>
							<th scope="col">{ i18n.T(ctx, "status.col.started") }</th>
							<th scope="col">{ i18n.T(ctx, "status.col.ends") }</th>
						</tr>
					</thead>
					<tbody>
						for _, wnd := range v.Maintenance {
							<tr>
								<td>{ wnd.Name }</td>
								<td>{ wnd.From }</td>
								<td>{ wnd.To }</td>
							</tr>
						}
					</tbody>
				</table>
			}
		}
	}
}
