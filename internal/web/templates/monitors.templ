package templates

import (
	"context"
	"strconv"
	"time"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/uptime"
)

func monitorsPath(projectID int64) string {
	return "/projects/" + strconv.FormatInt(projectID, 10) + "/monitors"
}

func monitorNewPath(projectID int64) string {
	return monitorsPath(projectID) + "/new"
}

func monitorDetailPath(monitorID int64) string {
	return "/monitors/" + strconv.FormatInt(monitorID, 10)
}

// переиспользует общие классы .badge-good/-danger/-neutral, что и issues/perf-issues.
// используется и статус-страницей (statuspage.templ), не только этим пакетом.
func monitorStatusBadgeClass(status string) string {
	switch status {
	case "up":
		return "badge badge-good"
	case "down":
		return "badge badge-danger"
	case "paused":
		return "badge badge-neutral"
	case "maintenance":
		return "badge badge-info"
	default:
		return "badge badge-warn"
	}
}

func monitorStatusTextKey(status string) string {
	switch status {
	case "up":
		return "uptime.status.up"
	case "down":
		return "uptime.status.down"
	case "paused":
		return "uptime.status.paused"
	case "maintenance":
		return "uptime.status.maintenance"
	default:
		return "uptime.status.unknown"
	}
}

// не локализуется — использует статус-страница (statuspage.templ), у неё нет i18n.
// авторизованные страницы берут uptimeStatTextCtx ниже, не эту функцию.
func uptimeStatText(s uptime.UptimeStat) string {
	if s.Total == 0 {
		return "no data"
	}
	return strconv.FormatFloat(s.Ratio()*100, 'f', 2, 64) + "%"
}

func uptimeStatTextCtx(ctx context.Context, s uptime.UptimeStat) string {
	if s.Total == 0 {
		return i18n.T(ctx, "uptime.no_data")
	}
	return strconv.FormatFloat(s.Ratio()*100, 'f', 2, 64) + "%"
}

func avgLatencyText(s uptime.UptimeStat, avgMs uint32) string {
	if s.Total == 0 {
		return "-"
	}
	return strconv.Itoa(int(avgMs)) + "ms"
}

// component, не string — ячейка делит «нет данных» и <time> без ветвления в шаблоне.
func lastCheckedCell(t *time.Time) templ.Component {
	if t == nil {
		return noDataLabel()
	}
	return relativeTime(*t)
}

// component ради общей сигнатуры с relativeTime в lastCheckedCell.
templ noDataLabel() {
	{ i18n.T(ctx, "uptime.no_data") }
}

// статус/uptime%/задержка/полоска/время посчитаны в web/monitors.go — тот же приём, что у IssueRow.
// здесь только форматирование готовых данных.
type MonitorRow struct {
	Monitor      uptime.Monitor
	Status       string
	Uptime24h    uptime.UptimeStat
	AvgLatencyMs uint32
	Bars         templ.Component
	LastChecked  *time.Time
}

// statsFailed — ClickHouse не ответил: мониторы/статусы (PostgreSQL) на месте, метрики — «нет данных».
// ссылки Incidents/Maintenance/Status не дублируются — они в боковой панели app-shell.
templ MonitorsList(projectID int64, rows []MonitorRow, canOperate bool, userEmail string, statsFailed bool) {
	@layout(i18n.T(ctx, "nav.monitors"), userEmail) {
		<div class="monitors">
			<h1>{ i18n.T(ctx, "nav.monitors") }</h1>
			@helpPanel("uptime", "uptime")
			if canOperate {
				<p><a class="btn btn-primary" href={ templ.URL(monitorNewPath(projectID)) }>{ i18n.T(ctx, "uptime.monitors.new") }</a></p>
			}
			if statsFailed && len(rows) > 0 {
				<p class="hint">{ i18n.T(ctx, "uptime.monitors.stats.error") }</p>
			}
			if len(rows) == 0 {
				if canOperate {
					@emptyState("activity", "uptime.monitors.empty.title", "uptime.monitors.empty.body", "uptime.monitors.empty.cta", monitorNewPath(projectID), 2)
				} else {
					@emptyState("activity", "uptime.monitors.empty.title", "uptime.monitors.empty.body", "", "", 2)
				}
			} else {
				<div class="card">
				@scrollRegion("table-scroll", "nav.monitors") {
						<table class="data-table">
							<thead>
								<tr>
									<th scope="col">{ i18n.T(ctx, "uptime.monitors.table.name") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.monitors.table.type") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.monitors.table.status") }</th>
									<th scope="col" class="num">{ i18n.T(ctx, "uptime.monitors.table.uptime_24h") }</th>
									<th scope="col" class="num">{ i18n.T(ctx, "uptime.monitors.table.avg_latency_24h") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.monitors.table.availability_24h") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.monitors.table.last_check") }</th>
								</tr>
							</thead>
							<tbody>
								for _, row := range rows {
									<tr>
										<td><a href={ templ.URL(monitorDetailPath(row.Monitor.ID)) }>{ row.Monitor.Name }</a></td>
										<td><span class="chip">{ i18n.T(ctx, "uptime.kind."+string(row.Monitor.Kind)) }</span></td>
										<td><span class={ monitorStatusBadgeClass(row.Status) }>{ i18n.T(ctx, monitorStatusTextKey(row.Status)) }</span></td>
										<td class="num">{ uptimeStatTextCtx(ctx, row.Uptime24h) }</td>
										<td class="num">{ avgLatencyText(row.Uptime24h, row.AvgLatencyMs) }</td>
										<td>@row.Bars
						</td>
										<td>@lastCheckedCell(row.LastChecked)</td>
									</tr>
								}
							</tbody>
						</table>
				}
				</div>
			}
		</div>
	}
}
