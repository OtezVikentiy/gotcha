package templates

import (
	"context"
	"encoding/json"
	"net/url"
	"strconv"
	"strings"
	"time"

	"gitflic.ru/otezvikentiy/gotcha/internal/humanize"
	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/uptime"
)

func monitorPausePath(monitorID int64) string {
	return monitorDetailPath(monitorID) + "/pause"
}

func monitorResumePath(monitorID int64) string {
	return monitorDetailPath(monitorID) + "/resume"
}

func monitorDeletePath(monitorID int64) string {
	return monitorDetailPath(monitorID) + "/delete"
}

func monitorEditPath(monitorID int64) string {
	return monitorDetailPath(monitorID) + "/edit"
}

func monitorHeartbeatRegeneratePath(monitorID int64) string {
	return monitorDetailPath(monitorID) + "/heartbeat/regenerate"
}

func monitorToggleAction(m uptime.Monitor) string {
	if m.Enabled {
		return monitorPausePath(m.ID)
	}
	return monitorResumePath(m.ID)
}

func monitorToggleLabelKey(m uptime.Monitor) string {
	if m.Enabled {
		return "uptime.detail.action_pause"
	}
	return "uptime.detail.action_resume"
}

func checkStatusBadgeClass(ok bool) string {
	if ok {
		return "badge badge-good"
	}
	return "badge badge-danger"
}

func checkStatusText(ctx context.Context, ok bool) string {
	if ok {
		return i18n.T(ctx, "uptime.check.ok")
	}
	return i18n.T(ctx, "uptime.check.fail")
}

// Просроченный сертификат — отдельным словом, не «-3d left».
func sslExpiryText(ctx context.Context, t *time.Time) string {
	if t == nil {
		return "—"
	}
	date := t.Format("2006-01-02")
	days := int(time.Until(*t).Hours() / 24)
	if days < 0 {
		return i18n.Tf(ctx, "uptime.ssl.expired", "date", date)
	}
	return i18n.Tf(ctx, "uptime.ssl.days_left", "days", strconv.Itoa(days), "date", date)
}

// Невалидный config на детали не встречается (validateConfig отсекает при записи) — ошибка
// разбора не обрабатывается, нулевой допуск печатается прочерком, а не «0 с».
func heartbeatGrace(m uptime.Monitor) time.Duration {
	var c uptime.HeartbeatConfig
	_ = json.Unmarshal(m.Config, &c)
	return time.Duration(c.GraceSeconds) * time.Second
}

// humanize.Duration не подходит: печатает одну крупную единицу («1 час» для полутора) —
// здесь важна точная величина, не порядок.
func heartbeatGraceText(ctx context.Context, d time.Duration) string {
	if d <= 0 {
		return "—"
	}
	var parts []string
	if h := int(d / time.Hour); h > 0 {
		parts = append(parts, i18n.Tf(ctx, "uptime.detail.grace_hours", "n", strconv.Itoa(h)))
		d -= time.Duration(h) * time.Hour
	}
	if m := int(d / time.Minute); m > 0 {
		parts = append(parts, i18n.Tf(ctx, "uptime.detail.grace_minutes", "n", strconv.Itoa(m)))
		d -= time.Duration(m) * time.Minute
	}
	if sec := int(d / time.Second); sec > 0 {
		parts = append(parts, i18n.Tf(ctx, "uptime.detail.grace_seconds", "n", strconv.Itoa(sec)))
	}
	return strings.Join(parts, " ")
}

// Пока маячка не было — прочерк, не срок от created_at: показывать дату создания монитора
// как «ожидается до» было бы враньём о пинге.
func heartbeatExpectedByText(ctx context.Context, m uptime.Monitor) string {
	if m.LastBeatAt == nil {
		return "—"
	}
	return humanize.Time(ctx, m.LastBeatAt.Add(heartbeatGrace(m)), time.UTC)
}

func incidentStatusBadgeClass(inc uptime.Incident) string {
	if inc.ResolvedAt == nil {
		return "badge badge-danger"
	}
	return "badge badge-good"
}

func incidentStatusTextKey(inc uptime.Incident) string {
	if inc.ResolvedAt == nil {
		return "uptime.incident.status_open"
	}
	return "uptime.incident.status_resolved"
}

func incidentDurationText(ctx context.Context, inc uptime.Incident) string {
	if inc.ResolvedAt == nil {
		return i18n.T(ctx, "uptime.incident.ongoing")
	}
	return humanize.Duration(ctx, inc.ResolvedAt.Sub(inc.StartedAt))
}

func yesNo(ctx context.Context, b bool) string {
	if b {
		return i18n.T(ctx, "uptime.yes")
	}
	return i18n.T(ctx, "uptime.no")
}

// Собственная копия web/monitorform.go, не импорт web (иначе цикл web->templates->web).
// Команда — POST, не GET: URL дёргают боты/антивирусы GET-ом, POST снижает случайные срабатывания.
func heartbeatPingURL(baseURL, token string) string {
	return baseURL + "/uptime/hb/" + token
}

func heartbeatCronSnippet(baseURL, token string, intervalSeconds int) string {
	minutes := intervalSeconds / 60
	if minutes < 1 {
		minutes = 1
	}
	return "*/" + strconv.Itoa(minutes) + " * * * * curl -fsS -X POST " + heartbeatPingURL(baseURL, token) + " >/dev/null"
}

templ checkRow(c uptime.CheckRow) {
	<tr>
		<td>@relativeTime(c.Timestamp)</td>
		<td>{ c.Region }</td>
		<td><span class={ checkStatusBadgeClass(c.OK) }>{ checkStatusText(ctx, c.OK) }</span></td>
		<td class="num">{ strconv.Itoa(int(c.StatusCode)) }</td>
		<td>{ c.Error }</td>
		<td class="num">{ strconv.Itoa(int(c.TotalMs)) }ms</td>
	</tr>
}

templ incidentRow(inc uptime.Incident) {
	<tr>
		<td>
			<span class={ incidentStatusBadgeClass(inc) }>{ i18n.T(ctx, incidentStatusTextKey(inc)) }</span>
			if inc.SuppressedByDep {
				<span class="badge">{ i18n.T(ctx, "incident.badge.suppressed_by_dep") }</span>
			}
		</td>
		<td>@relativeTime(inc.StartedAt)</td>
		<td>{ incidentDurationText(ctx, inc) }</td>
		<td>{ inc.Cause }</td>
		<td>{ strings.Join(inc.Regions, ", ") }</td>
		<td>{ yesNo(ctx, inc.InMaintenance) }</td>
	</tr>
}

// heartbeat не пишет check_results — «Задержка»/проверки не рендерятся, SSL-плитка только у http.
// дублирует несэкспортированную константу web/monitors.go: числа должны совпадать для totalPages.
const monitorDetailIncidentsPerPage = 20

func monitorIncidentsTotalPages(total int64) int64 {
	if total <= 0 {
		return 1
	}
	return (total + monitorDetailIncidentsPerPage - 1) / monitorDetailIncidentsPerPage
}

func monitorIncidentsPageURL(monitorID int64, page int, rng TimeRangeVM) string {
	q := url.Values{}
	rng.apply(q)
	if page > 1 {
		q.Set("incpage", strconv.Itoa(page))
	}
	return monitorDetailPath(monitorID) + "?" + q.Encode()
}

// ClickHouse не ответил: шапка/статус/инциденты на месте, плитки аптайма — «недоступно»
// (не «нет данных»), вместо графика задержек и проверок — «данные временно недоступны».
templ MonitorDetail(m uptime.Monitor, status string, uptime24h, uptime7d, uptime30d uptime.UptimeStat, latencyChart templ.Component, rng TimeRangeVM, checks []uptime.CheckRow, incidents []uptime.Incident, incPage int, incTotal int64, canManage bool, canOperate bool, baseURL string, userEmail string, statsFailed bool) {
	@layout(m.Name, userEmail) {
		<div class="monitor-detail">
			@breadcrumbBackTo(templ.URL(monitorsPath(m.ProjectID)), i18n.T(ctx, "nav.monitors"))
			<h1>{ m.Name }</h1>
			<span class={ monitorStatusBadgeClass(status) }>{ i18n.T(ctx, monitorStatusTextKey(status)) }</span>
			<span class="chip">{ i18n.T(ctx, "uptime.kind."+string(m.Kind)) }</span>

			<div class="monitor-meta">
				if m.Kind == uptime.KindHeartbeat {
					<div class="stat-tile stat-tile--text">
						<div class="stat-label">{ i18n.T(ctx, "uptime.detail.last_beat") }</div>
						<div class="stat-value">
							if m.LastBeatAt != nil {
								@relativeTime(*m.LastBeatAt)
							} else {
								{ i18n.T(ctx, "uptime.detail.last_beat_never") }
							}
						</div>
					</div>
					<div class="stat-tile stat-tile--text">
						<div class="stat-label">{ i18n.T(ctx, "uptime.detail.grace") }</div>
						<div class="stat-value">{ heartbeatGraceText(ctx, heartbeatGrace(m)) }</div>
					</div>
					<div class="stat-tile stat-tile--text">
						<div class="stat-label">{ i18n.T(ctx, "uptime.detail.expected_by") }</div>
						<div class="stat-value">{ heartbeatExpectedByText(ctx, m) }</div>
					</div>
				} else {
					<div class="stat-tile">
						<div class="stat-label">{ i18n.T(ctx, "uptime.detail.uptime_24h") }</div>
						if statsFailed {
							<div class="stat-value">{ i18n.T(ctx, "uptime.detail.uptime_unavailable") }</div>
						} else {
							<div class="stat-value">{ uptimeStatTextCtx(ctx, uptime24h) }</div>
						}
					</div>
					<div class="stat-tile">
						<div class="stat-label">{ i18n.T(ctx, "uptime.detail.uptime_7d") }</div>
						if statsFailed {
							<div class="stat-value">{ i18n.T(ctx, "uptime.detail.uptime_unavailable") }</div>
						} else {
							<div class="stat-value">{ uptimeStatTextCtx(ctx, uptime7d) }</div>
						}
					</div>
					<div class="stat-tile">
						<div class="stat-label">{ i18n.T(ctx, "uptime.detail.uptime_30d") }</div>
						if statsFailed {
							<div class="stat-value">{ i18n.T(ctx, "uptime.detail.uptime_unavailable") }</div>
						} else {
							<div class="stat-value">{ uptimeStatTextCtx(ctx, uptime30d) }</div>
						}
					</div>
				}
				if m.Kind == uptime.KindHTTP {
					<div class="stat-tile stat-tile--text">
						<div class="stat-label">{ i18n.T(ctx, "uptime.detail.ssl") }</div>
						<div class="stat-value">{ sslExpiryText(ctx, m.SSLExpiresAt) }</div>
					</div>
				}
			</div>

			if canOperate && m.Kind == uptime.KindHeartbeat {
				<div class="monitor-heartbeat card">
					<h2>{ i18n.T(ctx, "uptime.detail.heartbeat_title") }</h2>
					if m.HeartbeatToken != "" {
						<p class="notice">{ i18n.T(ctx, "uptime.detail.heartbeat_copy_now") }</p>
						<p>{ i18n.T(ctx, "uptime.detail.heartbeat_url") }</p>
						@copyBlock("heartbeat-ping-url", "uptime.detail.heartbeat_copy_url", heartbeatPingURL(baseURL, m.HeartbeatToken))
						<p>{ i18n.T(ctx, "uptime.detail.heartbeat_cron") }</p>
						@copyBlock("heartbeat-cron-line", "uptime.detail.heartbeat_copy_cron", heartbeatCronSnippet(baseURL, m.HeartbeatToken, m.IntervalSeconds))
					} else {
						<p class="hint">{ i18n.T(ctx, "uptime.detail.heartbeat_hidden") }</p>
					}
					<form method="post" action={ templ.URL(monitorHeartbeatRegeneratePath(m.ID)) }>
						<button type="submit" class="btn btn-ghost">{ i18n.T(ctx, "uptime.detail.heartbeat_regenerate") }</button>
					</form>
				</div>
			}

			if canManage {
				<div class="monitor-actions">
					<form method="post" action={ templ.URL(monitorToggleAction(m)) }>
						<button type="submit" class="btn btn-ghost">{ i18n.T(ctx, monitorToggleLabelKey(m)) }</button>
					</form>
					<a class="btn btn-ghost" href={ templ.URL(monitorEditPath(m.ID)) }>{ i18n.T(ctx, "uptime.detail.action_edit") }</a>
					<form method="post" action={ templ.URL(monitorDeletePath(m.ID)) }>
						<button type="submit" class="btn btn-danger">{ i18n.T(ctx, "uptime.detail.action_delete") }</button>
					</form>
				</div>
			}

			if statsFailed {
				@emptyState("activity", "uptime.detail.error.title", "uptime.detail.error.body", "", "", 2)
			} else if m.Kind != uptime.KindHeartbeat {
				<h2>{ i18n.Tf(ctx, "uptime.detail.latency_title", "range", timeRangeLabelText(ctx, rng)) }</h2>
				<form method="get" action={ templ.URL(monitorDetailPath(m.ID)) } class="performance-filters">
					@timeRangeFields(rng)
					<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "perf.filter.apply") }</button>
				</form>
				<p class="chart-caption">{ i18n.T(ctx, "uptime.detail.latency_caption") }</p>
				<p class="chart-legend">
					<span class="legend-item legend-dns">DNS</span>
					<span class="legend-item legend-tcp">TCP</span>
					<span class="legend-item legend-tls">TLS</span>
					<span class="legend-item legend-ttfb">TTFB</span>
				</p>
				<div class="card monitor-chart">
					@latencyChart
				</div>

				<h2>{ i18n.T(ctx, "uptime.detail.checks_title") }</h2>
				if len(checks) == 0 {
					@emptyState("activity", "uptime.detail.checks_empty.title", "uptime.detail.checks_empty.body", "", "", 3)
				} else {
					// без ограничения высоты проверки растянули бы страницу, инциденты ушли бы за экран.
					// scroll-list скроллит обе оси (app.css); вложенный table-scroll дал бы два табстопа.
					@scrollRegion("card scroll-list", "uptime.detail.checks_title") {
						<table class="data-table">
							<thead>
								<tr>
									<th scope="col">{ i18n.T(ctx, "uptime.detail.checks_table.when") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.detail.checks_table.region") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.detail.checks_table.status") }</th>
									<th scope="col" class="num">{ i18n.T(ctx, "uptime.detail.checks_table.code") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.detail.checks_table.error") }</th>
									<th scope="col" class="num">{ i18n.T(ctx, "uptime.detail.checks_table.total") }</th>
								</tr>
							</thead>
							<tbody>
								for _, c := range checks {
									@checkRow(c)
								}
							</tbody>
						</table>
					}
				}
			}

			<h2>{ i18n.T(ctx, "nav.incidents") }</h2>
			if len(incidents) == 0 {
				@emptyState("activity", "uptime.detail.incidents_empty.title", "uptime.detail.incidents_empty.body", "", "", 3)
			} else {
				<div class="card">
				@scrollRegion("table-scroll", "nav.incidents") {
						<table class="data-table">
							<thead>
								<tr>
									<th scope="col">{ i18n.T(ctx, "uptime.incidents.table.status") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.incidents.table.started") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.incidents.table.duration") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.incidents.table.cause") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.incidents.table.regions") }</th>
									<th scope="col">{ i18n.T(ctx, "uptime.incidents.table.maintenance") }</th>
								</tr>
							</thead>
							<tbody>
								for _, inc := range incidents {
									@incidentRow(inc)
								}
							</tbody>
						</table>
				}
				</div>
			}
			// Пагинатор — вне ветки len(incidents)==0: пустая таблица не должна прятать пейджер.
			if monitorIncidentsTotalPages(incTotal) > 1 || incPage > 1 {
				<nav class="pagination" aria-label={ i18n.T(ctx, "pagination.label") }>
					if incPage > 1 {
						<a href={ templ.URL(monitorIncidentsPageURL(m.ID, pagerPrev(incPage, incTotal), rng)) }><span aria-hidden="true">« </span>{ i18n.T(ctx, "pagination.prev") }</a>
					}
					if incTotal > 0 {
						<span>{ strconv.Itoa(incPage) } / { strconv.FormatInt(monitorIncidentsTotalPages(incTotal), 10) }</span>
					}
					if int64(incPage) < monitorIncidentsTotalPages(incTotal) {
						<a href={ templ.URL(monitorIncidentsPageURL(m.ID, incPage+1, rng)) }>{ i18n.T(ctx, "pagination.next") }<span aria-hidden="true"> »</span></a>
					}
				</nav>
			}
		</div>
	}
}
