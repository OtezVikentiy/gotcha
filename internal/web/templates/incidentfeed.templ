package templates

import (
	"context"
	"strconv"
	"strings"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/incidentgroup"
)

type GroupCard struct {
	Group                        incidentgroup.GroupRow
	Members                      []incidentgroup.FeedItem
	Hosts, Uptime, Metrics, SLOs int
}

func NewGroupCard(g incidentgroup.GroupRow, members []incidentgroup.FeedItem) GroupCard {
	c := GroupCard{Group: g, Members: members}
	for _, m := range members {
		switch m.Source {
		case "host":
			c.Hosts++
		case "uptime":
			c.Uptime++
		case "metric":
			c.Metrics++
		case "slo":
			c.SLOs++
		}
	}
	return c
}

func groupCompositionHint(ctx context.Context, c GroupCard) string {
	parts := make([]string, 0, 4)
	if c.Hosts > 0 {
		parts = append(parts, i18n.T(ctx, "feed.source.host")+" "+strconv.Itoa(c.Hosts))
	}
	if c.Uptime > 0 {
		parts = append(parts, i18n.T(ctx, "feed.source.uptime")+" "+strconv.Itoa(c.Uptime))
	}
	if c.Metrics > 0 {
		parts = append(parts, i18n.T(ctx, "feed.source.metric")+" "+strconv.Itoa(c.Metrics))
	}
	if c.SLOs > 0 {
		parts = append(parts, i18n.T(ctx, "feed.source.slo")+" "+strconv.Itoa(c.SLOs))
	}
	partsStr := strings.Join(parts, " · ")
	if partsStr == "" {
		partsStr = "—" // защита: группа без единого члена не должна возникать, но не должна и падать
	}
	return i18n.Tf(ctx, "feed.group.composition", "total", strconv.Itoa(len(c.Members)), "parts", partsStr)
}

// trace/profile без детальной страницы инцидента — ссылка нарочно ведёт на список, не недосмотр.
func feedItemHref(projectID int64, it incidentgroup.FeedItem) string {
	switch it.Source {
	case "host":
		return hostLink(projectID, it.RefName)
	case "uptime":
		return monitorDetailPath(it.RefID)
	case "metric":
		return metricAlertsBasePath(projectID)
	case "slo":
		return sloDetailPath(projectID, it.RefID)
	case "trace":
		return regressionsPath(projectID)
	case "profile":
		return profileRegressionsBasePath(projectID)
	default:
		return overviewPath(projectID)
	}
}

// Также цель редиректа со старого адреса /incident-feed (см. web/overview.go).
func overviewPath(projectID int64) string {
	return "/projects/" + strconv.FormatInt(projectID, 10) + "/overview"
}

// profile_type нигде не переводится — печатаем как есть, для единообразия с родной страницей.
func feedItemSubKind(ctx context.Context, it incidentgroup.FeedItem) string {
	if it.SubKind == "" {
		return ""
	}
	switch it.Source {
	case "host":
		return i18n.T(ctx, "hosts.kind."+it.SubKind)
	case "trace":
		return regressionMetricLabel(ctx, it.SubKind)
	default:
		return it.SubKind
	}
}

// Дублирует incidentStatusBadgeClass, не зовёт его — тот принимает uptime.Incident, а не FeedItem.
func resolvedBadgeClass() string {
	return "badge badge-good"
}

func groupAnchorID(groupID int64) string {
	return "group-" + strconv.FormatInt(groupID, 10)
}

// root пуст только когда группа удалена целиком — тот же фолбэк, что и у корня карточки.
func wasGroupedLabel(ctx context.Context, it incidentgroup.FeedItem) string {
	root := it.FormerGroupRootName
	if root == "" {
		root = i18n.T(ctx, "feed.group.root_deleted")
	}
	return i18n.Tf(ctx, "feed.badge.was_grouped", "root", root)
}

// Ссылка якорем — только когда карточка реально на странице, иначе она вела бы в никуда.
func closedGroupIDSet(closedGroups []GroupCard) map[int64]bool {
	out := make(map[int64]bool, len(closedGroups))
	for _, c := range closedGroups {
		out[c.Group.ID] = true
	}
	return out
}

// metric/slo — lvlOperator-страницы, лента отдаётся lvlAccess: без проверки ссылка закроется 404.
func feedItemLinkable(it incidentgroup.FeedItem, canOperate bool) bool {
	if canOperate {
		return true
	}
	return it.Source != "metric" && it.Source != "slo"
}

// it.Title == "" на проде недостижимо (FK CASCADE); фолбэк — тот же ключ, что и у корня группы.
templ feedItemRow(projectID int64, it incidentgroup.FeedItem, closedGroupIDs map[int64]bool, canOperate bool) {
	<tr>
		<td>{ i18n.T(ctx, "feed.source."+it.Source) }</td>
		<td>
			if it.Title != "" {
				if feedItemLinkable(it, canOperate) {
					<a href={ templ.URL(feedItemHref(projectID, it)) }>{ it.Title }</a>
				} else {
					{ it.Title }
				}
			} else {
				{ i18n.T(ctx, "feed.group.root_deleted") }
			}
			if label := feedItemSubKind(ctx, it); label != "" {
				<span class="hint">{ " · " + label }</span>
			}
		</td>
		<td>
			@incidentSeverityBadge(it.Severity)
			if it.SuppressedByDep {
				<span class="badge">{ i18n.T(ctx, "incident.badge.suppressed_by_dep") }</span>
			}
			if it.HeldByGroup {
				<span class="badge">{ i18n.T(ctx, "feed.badge.held_by_group") }</span>
			}
			if it.Acknowledged {
				<span class="badge">{ i18n.T(ctx, "incidents.ack.confirmed") }</span>
			}
			if it.FormerGroupID != 0 {
				<span class="badge">
					if closedGroupIDs[it.FormerGroupID] {
						<a href={ templ.URL("#" + groupAnchorID(it.FormerGroupID)) }>{ wasGroupedLabel(ctx, it) }</a>
					} else {
						{ wasGroupedLabel(ctx, it) }
					}
				</span>
			}
			if it.ResolvedAt != nil {
				<span class={ resolvedBadgeClass() }>{ i18n.T(ctx, "uptime.incident.status_resolved") }</span>
			}
		</td>
		<td>
			@relativeTime(it.StartedAt)
		</td>
		<td>
			if it.ResolvedAt != nil {
				@relativeTime(*it.ResolvedAt)
			}
		</td>
	</tr>
}

// Начало и закрытие — отдельные колонки, иначе относительные времена слипаются в одну строку.
templ feedTableHead() {
	<thead>
		<tr>
			<th scope="col">{ i18n.T(ctx, "feed.table.source") }</th>
			<th scope="col">{ i18n.T(ctx, "perf.related_issues.table.title") }</th>
			<th scope="col">{ i18n.T(ctx, "metrics.alerts.table.status") }</th>
			<th scope="col">{ i18n.T(ctx, "metrics.alerts.table.started") }</th>
			<th scope="col">{ i18n.T(ctx, "feed.table.resolved_at") }</th>
		</tr>
	</thead>
}

// host — по имени (hostLink), monitor — по ID: имя монитора не участвует в его адресе.
func groupRootHref(projectID int64, g incidentgroup.GroupRow) string {
	if g.RootNodeKind == "monitor" {
		return monitorDetailPath(g.RootNodeID)
	}
	return hostLink(projectID, g.RootName)
}

templ groupCard(projectID int64, c GroupCard, canOperate bool) {
	<details id={ groupAnchorID(c.Group.ID) } class="card feed-group">
		<summary>
			<strong>
				{ i18n.T(ctx, "feed.group.root."+c.Group.RootSource) + ": " }
				if c.Group.RootName != "" {
					<a href={ templ.URL(groupRootHref(projectID, c.Group)) }>{ c.Group.RootName }</a>
				} else {
					{ i18n.T(ctx, "feed.group.root_deleted") }
				}
			</strong>
			@incidentSeverityBadge(c.Group.RootSeverity)
			<span class="hint">{ groupCompositionHint(ctx, c) }</span>
			if c.Group.ResolvedAt != nil {
				@relativeTime(*c.Group.ResolvedAt)
				<span class={ resolvedBadgeClass() }>{ i18n.T(ctx, "feed.group.resolved") }</span>
			} else {
				@relativeTime(c.Group.StartedAt)
			}
		</summary>
		@scrollRegion("table-scroll", "feed.aria.group_members") {
			<table class="data-table">
				@feedTableHead()
				<tbody>
					for _, it := range c.Members {
						@feedItemRow(projectID, it, nil, canOperate)
					}
				</tbody>
			</table>
		}
	</details>
}

// Числа приходят из overview.go, шаблон только печатает — иначе подпись и потолок разъедутся.
type FeedCaps struct {
	OpenGroups   int
	OutOfGroup   int
	ClosedGroups int
	ClosedItems  int
}
