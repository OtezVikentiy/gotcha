package templates

import (
	"net/url"
	"strings"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
)

type OAuthButton struct {
	Name  string // сегмент URL: /auth/oauth/{name}/start
	Label string
}

templ oauthButtons(providers []OAuthButton) {
	if len(providers) > 0 {
		<div class="oauth-buttons">
			<p class="oauth-sep">{ i18n.T(ctx, "auth.or") }</p>
			for _, p := range providers {
				<a class="btn btn-ghost" href={ templ.URL("/auth/oauth/" + p.Name + "/start") }>{ p.Label }</a>
			}
		</div>
	}
}

// errMsg не зависит от email — по нему нельзя понять, существует ли аккаунт.
templ Login(errMsg, next, email string, providers []OAuthButton) {
	@chromeless(i18n.T(ctx, "auth.login.title"), "") {
		<div class="auth-brand">
			@brandMark()
			<span class="auth-brand-word">Gotcha</span>
			<p class="auth-tagline">{ i18n.T(ctx, "brand.tagline") }</p>
		</div>
		<form method="post" action="/login" class="auth-form">
			<h1>{ i18n.T(ctx, "auth.login.title") }</h1>
			if next != "" {
				<input type="hidden" name="next" value={ next }/>
			}
			if errMsg != "" {
				<p class="error">{ errMsg }</p>
			}
			<div class="field">
				<label>
					{ i18n.T(ctx, "auth.email") }
					<input type="email" name="email" autocomplete="email" required autofocus class="input" value={ email }/>
				</label>
			</div>
			<div class="field">
				<label>
					{ i18n.T(ctx, "auth.password") }
					<input type="password" name="password" autocomplete="current-password" required class="input"/>
				</label>
			</div>
			<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "auth.login.submit") }</button>
			<p class="auth-switch"><a href="/register">{ i18n.T(ctx, "auth.login.register_link") }</a> · <a href="/sso">{ i18n.T(ctx, "auth.sso_link") }</a></p>
		</form>
		@oauthButtons(providers)
	}
}

templ SSOLogin(errMsg string) {
	@chromeless(i18n.T(ctx, "auth.sso.title"), "") {
		<form method="post" action="/sso" class="auth-form">
			<h1>{ i18n.T(ctx, "auth.sso.title") }</h1>
			if errMsg != "" {
				<p class="error">{ errMsg }</p>
			}
			<div class="field">
				<label>
					{ i18n.T(ctx, "auth.sso.work_email") }
					<input type="email" name="email" autocomplete="email" required autofocus class="input"/>
				</label>
			</div>
			<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "auth.sso.submit") }</button>
			<p class="auth-switch"><a href="/login">{ i18n.T(ctx, "auth.sso.back") }</a></p>
		</form>
	}
}

// локальная копия признака из web.inviteTokenFromNext: templates не может
// импортировать web (цикл). Токен здесь не проверяется, только распознаётся путь.
func isInvitePath(next string) bool {
	return strings.HasPrefix(next, "/invite/")
}

// путь приглашения в query не кладём никогда — токен утёк бы в историю
// браузера, лог обратного прокси и Referer; адресата несёт invite-cookie.
func loginLinkWithNext(next string) string {
	if next == "" || isInvitePath(next) {
		return "/login"
	}
	return "/login?next=" + url.QueryEscape(next)
}

func registerLinkWithNext(next string) string {
	if next == "" || isInvitePath(next) {
		return "/register"
	}
	return "/register?next=" + url.QueryEscape(next)
}

templ RegisterForm(errMsg string, inviteNote bool, next string, providers []OAuthButton) {
	@chromeless(i18n.T(ctx, "auth.register.title"), "") {
		<form method="post" action="/register" class="auth-form">
			<h1>{ i18n.T(ctx, "auth.register.title") }</h1>
			if next != "" {
				<input type="hidden" name="next" value={ next }/>
			}
			if errMsg != "" {
				<p class="error">{ errMsg }</p>
			}
			if inviteNote {
				<p class="warning">{ i18n.T(ctx, "auth.register.invite_note") }</p>
			}
			<div class="field">
				<label>
					{ i18n.T(ctx, "auth.email") }
					<input type="email" name="email" autocomplete="email" required autofocus class="input"/>
				</label>
			</div>
			<div class="field">
				<label>
					{ i18n.T(ctx, "auth.password") }
					<input type="password" name="password" autocomplete="new-password" required class="input"/>
				</label>
			</div>
			<div class="field">
				<label>
					{ i18n.T(ctx, "auth.password2") }
					<input type="password" name="password2" autocomplete="new-password" required class="input"/>
				</label>
			</div>
			<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "auth.register.submit") }</button>
			<p class="auth-switch"><a href="/login">{ i18n.T(ctx, "auth.register.have_account") }</a></p>
		</form>
		@oauthButtons(providers)
	}
}

templ RegisterStub(errMsg string, mode string, next string, providers []OAuthButton) {
	@chromeless(i18n.T(ctx, "auth.register.title"), "") {
		<div class="auth-form">
			if mode == "closed" {
				<h1>{ i18n.T(ctx, "auth.register.closed_title") }</h1>
			} else {
				<h1>{ i18n.T(ctx, "auth.register.invite_title") }</h1>
			}
			if errMsg != "" {
				<p class="error">{ errMsg }</p>
			} else if mode == "closed" {
				<p>{ i18n.T(ctx, "auth.register.closed_body") }</p>
			} else {
				<p>{ i18n.T(ctx, "auth.register.invite_required") }</p>
			}
			<p class="auth-switch"><a href={ templ.URL(loginLinkWithNext(next)) }>{ i18n.T(ctx, "auth.register.have_account") }</a> · <a href="/sso">{ i18n.T(ctx, "auth.sso_link") }</a></p>
		</div>
		@oauthButtons(providers)
	}
}
