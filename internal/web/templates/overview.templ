package templates

import (
	"strconv"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/incidentgroup"
)

// overviewRangeHref — ссылка переключателя окна «недавно решённые»: 24ч —
// канонический адрес без параметра (умолчание, не грязнит URL закладок),
// 7д — явный ?range=7d.
func overviewRangeHref(projectID int64, value string) string {
	if value == "24h" {
		return overviewPath(projectID)
	}
	return overviewPath(projectID) + "?range=" + value
}

func overviewRangeTabClass(active bool) string {
	if active {
		return "tab is-active"
	}
	return "tab"
}

// overviewRangeTab — вкладка окна «недавно решённые», тем же приёмом, что
// perfStatusTab (perfissues.templ): обычная ссылка с query-параметром, без
// JS. Подпись — переиспользованные ключи range.24h/range.7d (тот же
// словарь, что и у графиков TimeRangePresets).
templ overviewRangeTab(projectID int64, value, rangeKey string) {
	<a class={ overviewRangeTabClass(value == rangeKey) } href={ templ.URL(overviewRangeHref(projectID, value)) } if value == rangeKey { aria-current="page" }>{ i18n.T(ctx, "range."+value) }</a>
}

// Overview — GET /projects/{id}/overview (задача 6 nav-ia): первый экран
// проекта, шкала инцидентов. Тело страницы — прежняя /incident-feed БЕЗ
// урезания (инвентаризация, см. докблок web.overview): открытые группы и
// внегрупповые открытые инциденты остаются без временного окна (они
// открыты сейчас, обрезать нечего), у «недавно решённых» окно стало
// выбираемым (rangeKey — "24h"/"7d") вместо жёстко зашитых суток. Отдельной
// «полной ленты» не остаётся — /incident-feed целиком редиректит сюда.
//
// Совсем пустой проект (ни одной секции ни по одному источнику) получает не
// «нет данных» по трём секциям сразу, а одно приглашение подключить SDK,
// ссылкой на «Первые шаги» — три одинаковых «здесь пока пусто» подряд на
// первом экране проекта выглядели бы как поломка, а не как чистый старт.
templ Overview(projectID int64, rangeKey string, openGroups []GroupCard, outOfGroup []incidentgroup.FeedItem, closedGroups []GroupCard, closed []incidentgroup.FeedItem, caps FeedCaps, canOperate bool, userEmail string) {
	{{ closedIDs := closedGroupIDSet(closedGroups) }}
	{{ empty := len(openGroups) == 0 && len(outOfGroup) == 0 && len(closedGroups) == 0 && len(closed) == 0 }}
	@layout(i18n.T(ctx, "overview.title"), userEmail) {
		<div class="incident-feed">
			<h1>{ i18n.T(ctx, "overview.title") }</h1>
			<p class="hint">{ i18n.T(ctx, "feed.see_incidents_hint") }<a href={ templ.URL(incidentsPath(projectID)) }>{ i18n.T(ctx, "nav.incidents") }</a>{ i18n.T(ctx, "feed.see_incidents_hint_suffix") }</p>
			@helpPanel("feed", "incident-groups")
			if empty {
				@emptyState("home", "overview.empty.title", "overview.empty.body", "getting_started.title", projectSetupPath(projectID), 2)
			} else {
				<h2>{ i18n.T(ctx, "feed.section.groups") } <span class="hint">{ i18n.Tf(ctx, "feed.open_groups.cap", "n", strconv.Itoa(caps.OpenGroups)) }</span></h2>
				if len(openGroups) == 0 {
					@emptyState("activity", "feed.groups.empty.title", "feed.groups.empty.body", "", "", 3)
				} else {
					for _, c := range openGroups {
						@groupCard(projectID, c, canOperate)
					}
				}
				<h2>{ i18n.T(ctx, "feed.section.out_of_group") } <span class="hint">{ i18n.Tf(ctx, "feed.out_of_group.cap", "n", strconv.Itoa(caps.OutOfGroup)) }</span></h2>
				if len(outOfGroup) == 0 {
					@emptyState("activity", "feed.out_of_group.empty.title", "feed.out_of_group.empty.body", "", "", 3)
				} else {
					<div class="card">
						@scrollRegion("table-scroll", "feed.section.out_of_group") {
							<table class="data-table">
								@feedTableHead()
								<tbody>
									for _, it := range outOfGroup {
										@feedItemRow(projectID, it, closedIDs, canOperate)
									}
								</tbody>
							</table>
						}
					</div>
				}
				<h2>{ i18n.T(ctx, "feed.section.closed") } <span class="hint">{ i18n.Tf(ctx, "overview.closed.cap", "window", i18n.T(ctx, "range."+rangeKey), "groups", strconv.Itoa(caps.ClosedGroups), "items", strconv.Itoa(caps.ClosedItems)) }</span></h2>
				<nav class="tabs" aria-label={ i18n.T(ctx, "overview.range.aria") }>
					@overviewRangeTab(projectID, "24h", rangeKey)
					@overviewRangeTab(projectID, "7d", rangeKey)
				</nav>
				for _, c := range closedGroups {
					@groupCard(projectID, c, canOperate)
				}
				if len(closed) == 0 && len(closedGroups) == 0 {
					@emptyState("activity", "feed.closed.empty.title", "feed.closed.empty.body", "", "", 3)
				} else if len(closed) > 0 {
					<div class="card">
						@scrollRegion("table-scroll", "feed.section.closed") {
							<table class="data-table">
								@feedTableHead()
								<tbody>
									for _, it := range closed {
										@feedItemRow(projectID, it, closedIDs, canOperate)
									}
								</tbody>
							</table>
						}
					</div>
				}
			}
		</div>
	}
}
