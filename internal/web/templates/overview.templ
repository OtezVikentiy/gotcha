package templates

import (
	"strconv"

	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
	"gitflic.ru/otezvikentiy/gotcha/internal/incidentgroup"
	"gitflic.ru/otezvikentiy/gotcha/internal/uptime"
)

// Uptime=0 рисуется как «нет данных»; HostsOverThreshold/NewIssues24h — 0 значит «всё спокойно».
// для них нет отдельного признака «недоступно» — эта разница не имеет действия для читателя.
type StatusLine struct {
	Uptime uptime.UptimeStat
	// true — плитка аптайма показывает «недоступно» вместо значения.
	UptimeUnavailable  bool
	HostsOverThreshold int
	NewIssues24h       int64
}

// 24ч — канонический адрес без параметра: не грязнит URL закладок значением по умолчанию.
func overviewRangeHref(projectID int64, value string) string {
	if value == "24h" {
		return overviewPath(projectID)
	}
	return overviewPath(projectID) + "?range=" + value
}

func overviewRangeTabClass(active bool) string {
	if active {
		return "tab is-active"
	}
	return "tab"
}

// переиспользует ключи range.24h/range.7d — тот же словарь, что у графиков.
templ overviewRangeTab(projectID int64, value, rangeKey string) {
	<a class={ overviewRangeTabClass(value == rangeKey) } href={ templ.URL(overviewRangeHref(projectID, value)) } if value == rangeKey { aria-current="page" }>{ i18n.T(ctx, "range."+value) }</a>
}

// показывается и в пустом состоянии — иначе проект без данных за 24ч не имел бы двери к окну 7д.
templ overviewRangeTabs(projectID int64, rangeKey string) {
	<nav class="tabs" aria-label={ i18n.T(ctx, "overview.range.aria") }>
		@overviewRangeTab(projectID, "24h", rangeKey)
		@overviewRangeTab(projectID, "7d", rangeKey)
	</nav>
}

// .stat-tile — та же вёрстка, что у monitordetail/hostdetail/slodetail, но с ссылкой вместо числа.
// .monitor-meta переиспользован как контейнер — своей сетки под три плитки не заводим.
templ statusLine(projectID int64, sl StatusLine) {
	<div class="monitor-meta">
		<a class="stat-tile" href={ templ.URL(monitorsPath(projectID)) }>
			<div class="stat-label">{ i18n.T(ctx, "overview.status.uptime") }</div>
			if sl.UptimeUnavailable {
				<div class="stat-value">{ i18n.T(ctx, "overview.status.uptime_unavailable") }</div>
			} else {
				<div class="stat-value">{ uptimeStatTextCtx(ctx, sl.Uptime) }</div>
			}
		</a>
		<a class="stat-tile" href={ templ.URL(hostsBasePath(projectID)) }>
			<div class="stat-label">{ i18n.T(ctx, "overview.status.hosts_over_threshold") }</div>
			<div class="stat-value">{ strconv.Itoa(sl.HostsOverThreshold) }</div>
		</a>
		<a class="stat-tile" href={ templ.URL(issuesPath(projectID)) }>
			<div class="stat-label">{ i18n.T(ctx, "overview.status.new_issues") }</div>
			<div class="stat-value">{ strconv.FormatInt(sl.NewIssues24h, 10) }</div>
		</a>
	</div>
}

// то же окно rangeKey, что у «недавно решённых» — деплой и инциденты видны на одном экране.
// пусто → секция не рисуется вовсе (в отличие от групп) — деплои вспомогательный контекст.
templ overviewDeploys(projectID int64, deploys []DeploymentRow) {
	if len(deploys) > 0 {
		<h2>{ i18n.T(ctx, "deploy.title") }</h2>
		<div class="card">
			@scrollRegion("table-scroll", "deploy.title") {
				<table class="data-table">
					<thead>
						<tr>
							<th scope="col">{ i18n.T(ctx, "deploy.table.version") }</th>
							<th scope="col">{ i18n.T(ctx, "deploy.table.environment") }</th>
							<th scope="col">{ i18n.T(ctx, "deploy.table.when") }</th>
						</tr>
					</thead>
					<tbody>
						for _, d := range deploys {
							<tr>
								<td>{ d.Version }</td>
								<td>{ d.Environment }</td>
								<td>@relativeTime(d.DeployedAt)</td>
							</tr>
						}
					</tbody>
				</table>
			}
			<p class="hint"><a href={ templ.URL(deploymentsPath(projectID)) }>{ i18n.T(ctx, "overview.deploys.view_all") }</a></p>
		</div>
	}
}

// совсем пустой проект получает одно приглашение подключить SDK, не «нет данных» по трём секциям —
// три одинаковых «пусто» подряд выглядели бы как поломка, а не чистый старт.
templ Overview(projectID int64, rangeKey string, openGroups []GroupCard, outOfGroup []incidentgroup.FeedItem, closedGroups []GroupCard, closed []incidentgroup.FeedItem, caps FeedCaps, canOperate bool, sl StatusLine, deploys []DeploymentRow, userEmail string) {
	{{ closedIDs := closedGroupIDSet(closedGroups) }}
	{{ empty := len(openGroups) == 0 && len(outOfGroup) == 0 && len(closedGroups) == 0 && len(closed) == 0 }}
	@layout(i18n.T(ctx, "overview.title"), userEmail) {
		<div class="incident-feed">
			<h1>{ i18n.T(ctx, "overview.title") }</h1>
			<p class="hint">{ i18n.T(ctx, "feed.see_incidents_hint") }<a href={ templ.URL(incidentsPath(projectID)) }>{ i18n.T(ctx, "nav.incidents") }</a>{ i18n.T(ctx, "feed.see_incidents_hint_suffix") }</p>
			@statusLine(projectID, sl)
			@overviewDeploys(projectID, deploys)
			@helpPanel("feed", "overview")
			if empty {
				@emptyState("home", "overview.empty.title", "overview.empty.body", "getting_started.title", projectSetupPath(projectID), 2)
				@overviewRangeTabs(projectID, rangeKey)
			} else {
				<h2>{ i18n.T(ctx, "feed.section.groups") } <span class="hint">{ i18n.Tf(ctx, "feed.open_groups.cap", "n", strconv.Itoa(caps.OpenGroups)) }</span></h2>
				if len(openGroups) == 0 {
					@emptyState("activity", "feed.groups.empty.title", "feed.groups.empty.body", "", "", 3)
				} else {
					for _, c := range openGroups {
						@groupCard(projectID, c, canOperate)
					}
				}
				<h2>{ i18n.T(ctx, "feed.section.out_of_group") } <span class="hint">{ i18n.Tf(ctx, "feed.out_of_group.cap", "n", strconv.Itoa(caps.OutOfGroup)) }</span></h2>
				if len(outOfGroup) == 0 {
					@emptyState("activity", "feed.out_of_group.empty.title", "feed.out_of_group.empty.body", "", "", 3)
				} else {
					<div class="card">
						@scrollRegion("table-scroll", "feed.section.out_of_group") {
							<table class="data-table">
								@feedTableHead()
								<tbody>
									for _, it := range outOfGroup {
										@feedItemRow(projectID, it, closedIDs, canOperate)
									}
								</tbody>
							</table>
						}
					</div>
				}
				<h2>{ i18n.T(ctx, "feed.section.closed") } <span class="hint">{ i18n.Tf(ctx, "overview.closed.cap", "window", i18n.T(ctx, "range."+rangeKey), "groups", strconv.Itoa(caps.ClosedGroups), "items", strconv.Itoa(caps.ClosedItems)) }</span></h2>
				@overviewRangeTabs(projectID, rangeKey)
				for _, c := range closedGroups {
					@groupCard(projectID, c, canOperate)
				}
				if len(closed) == 0 && len(closedGroups) == 0 {
					@emptyState("activity", "feed.closed.empty.title", "feed.closed.empty.body", "", "", 3)
				} else if len(closed) > 0 {
					<div class="card">
						@scrollRegion("table-scroll", "feed.section.closed") {
							<table class="data-table">
								@feedTableHead()
								<tbody>
									for _, it := range closed {
										@feedItemRow(projectID, it, closedIDs, canOperate)
									}
								</tbody>
							</table>
						}
					</div>
				}
			}
		</div>
	}
}
