package templates

import (
	"context"
	"crypto/sha256"
	"encoding/hex"
	"math"
	"strconv"
	"time"

	"gitflic.ru/otezvikentiy/gotcha/internal/host"
	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
)

func hostSettingsFormPath(projectID int64) string {
	return hostsBasePath(projectID) + "/settings"
}

// доли (0..1] показываются человеку процентами, храним долями — конверсия
// строго на этой границе.
func settingsBoolDefault(b bool) string {
	if b {
		return "1"
	}
	return "0"
}

// округление до десятых перед форматированием: 0.28*100 без него даёт
// двоичный мусор "28.000000000000004" (FormatFloat печатает кратчайшее РОВНОЕ представление).
func settingsPercentDefault(frac float64) string {
	return strconv.FormatFloat(math.Round(frac*100*10)/10, 'f', -1, 64)
}

func settingsFloatDefault(v float64) string {
	return strconv.FormatFloat(v, 'f', -1, 64)
}

func settingsMinutesDefault(d time.Duration) string {
	return strconv.Itoa(int(d / time.Minute))
}

templ HostSettings(projectID int64, s host.Settings, installCmd, config, agentReason string, form FormState, errMsg string, groups HostGroupThresholdsVM, userEmail string, canManage bool) {
	@layout(i18n.T(ctx, "nav.host_thresholds"), userEmail) {
		<div class="host-settings">
			<h1>{ i18n.T(ctx, "nav.host_thresholds") }</h1>
			if errMsg != "" {
				<p class="error" id="host-settings-error">{ errMsg }</p>
			}
			<form method="post" action={ templ.URL(hostSettingsFormPath(projectID)) } class="host-settings-form">
				<div class="threshold-grid">
					<fieldset class="card">
						<legend class="card-header">{ i18n.T(ctx, "hosts.settings.disk_title") }</legend>
						<label class="checkbox-inline">
							<input type="checkbox" name="disk_enabled" checked?={ form.Get("disk_enabled", settingsBoolDefault(s.DiskEnabled)) == "1" }/>
							{ i18n.T(ctx, "hosts.settings.field.enabled") }
						</label>
						<div class="field">
							<label>
								{ i18n.T(ctx, "hosts.settings.field.disk_threshold") }
								<input type="number" class="input" name="disk_threshold" min="1" max="99" step="1" required
									value={ form.Get("disk_threshold", settingsPercentDefault(s.DiskThreshold)) }
									aria-describedby="hint-disk-threshold"/>
							</label>
							<p class="hint" id="hint-disk-threshold">{ i18n.T(ctx, "hosts.settings.hint.disk_threshold") }</p>
						</div>
					</fieldset>
					<fieldset class="card">
						<legend class="card-header">{ i18n.T(ctx, "hosts.settings.memory_title") }</legend>
						<label class="checkbox-inline">
							<input type="checkbox" name="memory_enabled" checked?={ form.Get("memory_enabled", settingsBoolDefault(s.MemoryEnabled)) == "1" }/>
							{ i18n.T(ctx, "hosts.settings.field.enabled") }
						</label>
						<div class="field">
							<label>
								{ i18n.T(ctx, "hosts.settings.field.memory_threshold") }
								<input type="number" class="input" name="memory_threshold" min="1" max="99" step="1" required
									value={ form.Get("memory_threshold", settingsPercentDefault(s.MemoryThreshold)) }
									aria-describedby="hint-memory-threshold"/>
							</label>
							<p class="hint" id="hint-memory-threshold">{ i18n.T(ctx, "hosts.settings.hint.memory_threshold") }</p>
						</div>
					</fieldset>
					<fieldset class="card">
						<legend class="card-header">{ i18n.T(ctx, "hosts.settings.load_title") }</legend>
						<label class="checkbox-inline">
							<input type="checkbox" name="load_enabled" checked?={ form.Get("load_enabled", settingsBoolDefault(s.LoadEnabled)) == "1" }/>
							{ i18n.T(ctx, "hosts.settings.field.enabled") }
						</label>
						<div class="field">
							<label>
								{ i18n.T(ctx, "hosts.settings.field.load_threshold") }
								<input type="number" class="input" name="load_threshold" min="0.1" step="0.1" required
									value={ form.Get("load_threshold", settingsFloatDefault(s.LoadThreshold)) }
									aria-describedby="hint-load-threshold"/>
							</label>
							<p class="hint" id="hint-load-threshold">{ i18n.T(ctx, "hosts.settings.hint.load_threshold") }</p>
						</div>
					</fieldset>
					<fieldset class="card">
						<legend class="card-header">{ i18n.T(ctx, "hosts.settings.silent_title") }</legend>
						<label class="checkbox-inline">
							<input type="checkbox" name="silent_enabled" checked?={ form.Get("silent_enabled", settingsBoolDefault(s.SilentEnabled)) == "1" }/>
							{ i18n.T(ctx, "hosts.settings.field.enabled") }
						</label>
						<div class="field">
							<label>
								{ i18n.T(ctx, "hosts.settings.field.silent_after") }
								<input type="number" class="input" name="silent_after" min="3" max="720" step="1" required
									value={ form.Get("silent_after", settingsMinutesDefault(s.SilentAfter)) }
									aria-describedby="hint-silent-after"/>
							</label>
							<p class="hint" id="hint-silent-after">{ i18n.T(ctx, "hosts.settings.hint.silent_after") }</p>
						</div>
					</fieldset>
				</div>
				<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "hosts.settings.submit") }</button>
			</form>
			@hostGroupThresholdSection(projectID, s, groups)
			@hostsCollectorConfigDetails("host-settings-collector-config", projectID, installCmd, config, agentReason, canManage)
			<p class="hint"><a href="/docs/hosts">{ i18n.T(ctx, "hosts.settings.docs_link") }</a></p>
		</div>
	}
}

type HostGroupThresholdsVM struct {
	// nil, если GroupThresholds/Hosts ещё не проведены в Handler — секция
	// тогда просто не предлагает добавление.
	Groups []host.GroupThreshold
	// пустой список у одного скрывает соответствующий scope из
	// сегмент-контрола формы добавления.
	Envs, Roles []string
	Form        FormState
	// ошибка ДРУГОЙ формы на той же странице, не errMsg у HostSettings.
	ErrMsg string
}

func groupThresholdSettingsPath(projectID int64) string {
	return hostSettingsFormPath(projectID) + "/groups"
}

func groupThresholdDeleteSettingsPath(projectID int64) string {
	return groupThresholdSettingsPath(projectID) + "/delete"
}

const GroupThresholdCreateModalID = "new-group-threshold"

// label — произвольная строка пользователя, ей не место в HTML-id/URL-фрагменте,
// поэтому якорь строится по детерминированному хешу, а не по самой метке.
func EditGroupThresholdModalID(scope, label string) string {
	sum := sha256.Sum256([]byte(label))
	return "edit-group-threshold-" + scope + "-" + hex.EncodeToString(sum[:8])
}

func groupScopeDefault(envs []string) string {
	if len(envs) > 0 {
		return "env"
	}
	return "role"
}

func groupKindPart(ctx context.Context, kind string, enabled *bool, value *float64) string {
	if enabled == nil {
		return ""
	}
	valueText := i18n.T(ctx, "host.threshold.off_value")
	if *enabled {
		v := 0.0
		if value != nil {
			v = *value
		}
		valueText = host.ValueLabel(ctx, kind, v)
	}
	return i18n.T(ctx, "host.threshold."+kind) + ": " + valueText
}

func groupThresholdParts(ctx context.Context, gt host.GroupThreshold) []string {
	var parts []string
	if p := groupKindPart(ctx, "disk", gt.DiskEnabled, gt.DiskThreshold); p != "" {
		parts = append(parts, p)
	}
	if p := groupKindPart(ctx, "memory", gt.MemoryEnabled, gt.MemoryThreshold); p != "" {
		parts = append(parts, p)
	}
	if p := groupKindPart(ctx, "load", gt.LoadEnabled, gt.LoadThreshold); p != "" {
		parts = append(parts, p)
	}
	if gt.SilentEnabled != nil {
		valueText := i18n.T(ctx, "host.threshold.off_value")
		if *gt.SilentEnabled {
			secs := 0.0
			if gt.SilentAfter != nil {
				secs = gt.SilentAfter.Seconds()
			}
			valueText = host.ValueLabel(ctx, "silent", secs)
		}
		parts = append(parts, i18n.T(ctx, "host.threshold.silent")+": "+valueText)
	}
	return parts
}

templ groupThresholdKinds(gt host.GroupThreshold) {
	if gt.DiskEnabled == nil && gt.MemoryEnabled == nil && gt.LoadEnabled == nil && gt.SilentEnabled == nil {
		{ i18n.T(ctx, "host.group_threshold.none_set") }
	} else {
		for i, part := range groupThresholdParts(ctx, gt) {
			if i > 0 {
				{ ", " }
			}
			{ part }
		}
	}
}

templ groupThresholdRow(projectID int64, s host.Settings, gt host.GroupThreshold, form FormState, errMsg string) {
	<tr>
		<td>{ i18n.T(ctx, "host.threshold.scope."+gt.Scope) }</td>
		<td>{ gt.Label }</td>
		<td>@groupThresholdKinds(gt)</td>
		<td>
			<div class="row-actions">
				<a
					class="btn btn-ghost"
					href={ templ.SafeURL("#" + EditGroupThresholdModalID(gt.Scope, gt.Label)) }
					aria-label={ i18n.Tf(ctx, "host.group_threshold.edit_aria", "scope", i18n.T(ctx, "host.threshold.scope."+gt.Scope), "label", gt.Label) }
				>
					{ i18n.T(ctx, "host.group_threshold.edit") }
				</a>
				<form method="post" action={ templ.URL(groupThresholdDeleteSettingsPath(projectID)) }>
					<input type="hidden" name="scope" value={ gt.Scope }/>
					<input type="hidden" name="label" value={ gt.Label }/>
					<button
						type="submit"
						class="btn btn-danger"
						aria-label={ i18n.Tf(ctx, "host.group_threshold.delete_aria", "scope", i18n.T(ctx, "host.threshold.scope."+gt.Scope), "label", gt.Label) }
					>
						{ i18n.T(ctx, "host.group_threshold.delete") }
					</button>
				</form>
			</div>
			@groupThresholdEditModal(projectID, s, gt, form, errMsg)
		</td>
	</tr>
}

templ hostGroupThresholdSection(projectID int64, s host.Settings, groups HostGroupThresholdsVM) {
	<section class="host-group-thresholds">
		<h2>{ i18n.T(ctx, "host.group_threshold.title") }</h2>
		if len(groups.Envs) > 0 || len(groups.Roles) > 0 {
			@createTrigger(GroupThresholdCreateModalID, "host.group_threshold.new.title")
		}
		if len(groups.Groups) == 0 {
			<p class="hint">{ i18n.T(ctx, "host.group_threshold.empty") }</p>
		} else {
			@scrollRegion("table-scroll", "host.group_threshold.title") {
				<table class="data-table">
					<thead>
						<tr>
							<th scope="col">{ i18n.T(ctx, "host.group_threshold.table.scope") }</th>
							<th scope="col">{ i18n.T(ctx, "host.group_threshold.table.label") }</th>
							<th scope="col">{ i18n.T(ctx, "host.group_threshold.table.thresholds") }</th>
							<th scope="col"></th>
						</tr>
					</thead>
					<tbody>
						for _, gt := range groups.Groups {
							@groupThresholdRow(projectID, s, gt, groups.Form, groups.ErrMsg)
						}
					</tbody>
				</table>
			}
		}
		if len(groups.Envs) == 0 && len(groups.Roles) == 0 {
			// без меток модалки создания на странице нет — 422 показывается
			// здесь напрямую, а не внутри переоткрытой модалки.
			if groups.ErrMsg != "" && groups.Form.Opens(GroupThresholdCreateModalID) {
				<p class="error">{ groups.ErrMsg }</p>
			}
			<p class="hint">{ i18n.T(ctx, "host.group_threshold.no_labels") }</p>
		} else {
			@groupThresholdCreateModal(projectID, s, groups)
		}
	</section>
}

func groupThresholdFormValues(form FormState, open bool) FormState {
	if open {
		return form
	}
	return nil
}

// виден только select выбранного scope — CSS :has по radio,
// .gt-label-env/.gt-label-role в app.css.
templ groupThresholdCreateModal(projectID int64, s host.Settings, groups HostGroupThresholdsVM) {
	{{ open := groups.Form.Opens(GroupThresholdCreateModalID) }}
	{{ form := groupThresholdFormValues(groups.Form, open) }}
	@createModalOpen(GroupThresholdCreateModalID, "host.group_threshold.new.title", true, open) {
		<form method="post" action={ templ.URL(groupThresholdSettingsPath(projectID)) } class="host-group-threshold-form">
			if open && groups.ErrMsg != "" {
				<p class="error" id={ GroupThresholdCreateModalID + "-error" }>{ groups.ErrMsg }</p>
			}
			<fieldset class="field">
				<legend class="field-label">{ i18n.T(ctx, "host.group_threshold.scope") }</legend>
				<div class="segmented">
					if len(groups.Envs) > 0 {
						<label>
							<input type="radio" name="scope" value="env" checked?={ form.Selected("scope", "env", groupScopeDefault(groups.Envs)) }/>
							{ i18n.T(ctx, "host.threshold.scope.env") }
						</label>
					}
					if len(groups.Roles) > 0 {
						<label>
							<input type="radio" name="scope" value="role" checked?={ form.Selected("scope", "role", groupScopeDefault(groups.Envs)) }/>
							{ i18n.T(ctx, "host.threshold.scope.role") }
						</label>
					}
				</div>
			</fieldset>
			<div class="field gt-label-env">
				<label>
					{ i18n.T(ctx, "host.group_threshold.label") }
					<select name="label_env" class="select">
						for _, v := range groups.Envs {
							<option value={ v } selected?={ form.Selected("label_env", v, "") }>{ v }</option>
						}
					</select>
				</label>
			</div>
			<div class="field gt-label-role">
				<label>
					{ i18n.T(ctx, "host.group_threshold.label") }
					<select name="label_role" class="select">
						for _, v := range groups.Roles {
							<option value={ v } selected?={ form.Selected("label_role", v, "") }>{ v }</option>
						}
					</select>
				</label>
			</div>
			@groupThresholdKindFields(form, s, host.GroupThreshold{})
			<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "host.group_threshold.save") }</button>
		</form>
	}
}

// scope и метка не редактируются: Upsert идемпотентен по (project_id, scope,
// label), правка пары молча создала бы ВТОРОЕ правило вместо переименования.
templ groupThresholdEditModal(projectID int64, s host.Settings, gt host.GroupThreshold, form FormState, errMsg string) {
	{{ modalID := EditGroupThresholdModalID(gt.Scope, gt.Label) }}
	{{ open := form.Opens(modalID) }}
	{{ values := groupThresholdFormValues(form, open) }}
	@createModalOpen(modalID, "host.group_threshold.edit.title", true, open) {
		<form method="post" action={ templ.URL(groupThresholdSettingsPath(projectID)) } class="host-group-threshold-form">
			if open && errMsg != "" {
				<p class="error" id={ modalID + "-error" }>{ errMsg }</p>
			}
			<p class="hint">{ i18n.Tf(ctx, "host.group_threshold.editing", "scope", i18n.T(ctx, "host.threshold.scope."+gt.Scope), "label", gt.Label) }</p>
			<input type="hidden" name="scope" value={ gt.Scope }/>
			if gt.Scope == "role" {
				<input type="hidden" name="label_role" value={ gt.Label }/>
			} else {
				<input type="hidden" name="label_env" value={ gt.Label }/>
			}
			@groupThresholdKindFields(values, s, gt)
			<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "host.group_threshold.save") }</button>
		</form>
	}
}

// id у radio/полей нет намеренно: модалок с этим фрагментом на странице N+1,
// любой id здесь давал бы дубли в документе.
templ groupThresholdKindFields(form FormState, s host.Settings, gt host.GroupThreshold) {
	<fieldset class="card th-kind">
		<legend class="card-header">{ i18n.T(ctx, "host.threshold.disk") }</legend>
		<div class="segmented">
			<label>
				<input type="radio" name="disk_mode" value="inherit" checked?={ thresholdModeFor(form, "disk_mode", gt.DiskEnabled) == "inherit" }/>
				{ i18n.T(ctx, "host.threshold.inherit") }
			</label>
			<label>
				<input type="radio" name="disk_mode" value="override" checked?={ thresholdModeFor(form, "disk_mode", gt.DiskEnabled) == "override" }/>
				{ i18n.T(ctx, "host.threshold.override") }
			</label>
			<label>
				<input type="radio" name="disk_mode" value="off" checked?={ thresholdModeFor(form, "disk_mode", gt.DiskEnabled) == "off" }/>
				{ i18n.T(ctx, "host.threshold.off") }
			</label>
		</div>
		<div class="field th-disk-value">
			<label>
				{ i18n.T(ctx, "hosts.settings.field.disk_threshold") }
				<input type="number" class="input" name="disk_value" min="1" max="99" step="1"
					value={ form.Get("disk_value", thresholdPercentValue(gt.DiskThreshold, s.DiskThreshold)) }/>
			</label>
		</div>
	</fieldset>
	<fieldset class="card th-kind">
		<legend class="card-header">{ i18n.T(ctx, "host.threshold.memory") }</legend>
		<div class="segmented">
			<label>
				<input type="radio" name="memory_mode" value="inherit" checked?={ thresholdModeFor(form, "memory_mode", gt.MemoryEnabled) == "inherit" }/>
				{ i18n.T(ctx, "host.threshold.inherit") }
			</label>
			<label>
				<input type="radio" name="memory_mode" value="override" checked?={ thresholdModeFor(form, "memory_mode", gt.MemoryEnabled) == "override" }/>
				{ i18n.T(ctx, "host.threshold.override") }
			</label>
			<label>
				<input type="radio" name="memory_mode" value="off" checked?={ thresholdModeFor(form, "memory_mode", gt.MemoryEnabled) == "off" }/>
				{ i18n.T(ctx, "host.threshold.off") }
			</label>
		</div>
		<div class="field th-memory-value">
			<label>
				{ i18n.T(ctx, "hosts.settings.field.memory_threshold") }
				<input type="number" class="input" name="memory_value" min="1" max="99" step="1"
					value={ form.Get("memory_value", thresholdPercentValue(gt.MemoryThreshold, s.MemoryThreshold)) }/>
			</label>
		</div>
	</fieldset>
	<fieldset class="card th-kind">
		<legend class="card-header">{ i18n.T(ctx, "host.threshold.load") }</legend>
		<div class="segmented">
			<label>
				<input type="radio" name="load_mode" value="inherit" checked?={ thresholdModeFor(form, "load_mode", gt.LoadEnabled) == "inherit" }/>
				{ i18n.T(ctx, "host.threshold.inherit") }
			</label>
			<label>
				<input type="radio" name="load_mode" value="override" checked?={ thresholdModeFor(form, "load_mode", gt.LoadEnabled) == "override" }/>
				{ i18n.T(ctx, "host.threshold.override") }
			</label>
			<label>
				<input type="radio" name="load_mode" value="off" checked?={ thresholdModeFor(form, "load_mode", gt.LoadEnabled) == "off" }/>
				{ i18n.T(ctx, "host.threshold.off") }
			</label>
		</div>
		<div class="field th-load-value">
			<label>
				{ i18n.T(ctx, "hosts.settings.field.load_threshold") }
				<input type="number" class="input" name="load_value" min="0.1" step="0.1"
					value={ form.Get("load_value", thresholdFloatValue(gt.LoadThreshold, s.LoadThreshold)) }/>
			</label>
		</div>
	</fieldset>
	<fieldset class="card th-kind">
		<legend class="card-header">{ i18n.T(ctx, "host.threshold.silent") }</legend>
		<div class="segmented">
			<label>
				<input type="radio" name="silent_mode" value="inherit" checked?={ thresholdModeFor(form, "silent_mode", gt.SilentEnabled) == "inherit" }/>
				{ i18n.T(ctx, "host.threshold.inherit") }
			</label>
			<label>
				<input type="radio" name="silent_mode" value="override" checked?={ thresholdModeFor(form, "silent_mode", gt.SilentEnabled) == "override" }/>
				{ i18n.T(ctx, "host.threshold.override") }
			</label>
			<label>
				<input type="radio" name="silent_mode" value="off" checked?={ thresholdModeFor(form, "silent_mode", gt.SilentEnabled) == "off" }/>
				{ i18n.T(ctx, "host.threshold.off") }
			</label>
		</div>
		<div class="field th-silent-value">
			<label>
				{ i18n.T(ctx, "hosts.settings.field.silent_after") }
				<input type="number" class="input" name="silent_value" min="3" max="720" step="1"
					value={ form.Get("silent_value", thresholdMinutesValue(gt.SilentAfter, s.SilentAfter)) }/>
			</label>
		</div>
	</fieldset>
}
