package templates

import (
	"context"
	"math"
	"net/url"
	"strconv"
	"time"

	"gitflic.ru/otezvikentiy/gotcha/internal/host"
	"gitflic.ru/otezvikentiy/gotcha/internal/i18n"
)

func hostSettingsFormPath(projectID int64) string {
	return hostsBasePath(projectID) + "/settings"
}

// settingsBoolDefault/settingsPercentDefault/settingsFloatDefault/
// settingsMinutesDefault — значения host.Settings как строки формы: fallback
// для form.Get, когда форма ещё не отправлялась (GET, form == nil) или поле
// не было предметом ошибки предыдущей отправки. Доли (0..1] показываются
// человеку процентами (§4.2 дизайна — «в UI диск/RAM — проценты, храним
// долями»), конверсия строго на этой границе.
func settingsBoolDefault(b bool) string {
	if b {
		return "1"
	}
	return "0"
}

// settingsPercentDefault округляет процент до 1 знака ПЕРЕД форматированием
// (T6 косметика): 0.28*100 без округления даёт двоичный мусор
// "28.000000000000004" (FormatFloat с precision=-1 печатает кратчайшее
// РОВНОЕ представление, а не красивое число) — округление до десятых убирает
// артефакт, не теряя данных: на сабмите форма делит обратно на 100, точности
// десятой доли процента более чем достаточно для порога диска/памяти.
func settingsPercentDefault(frac float64) string {
	return strconv.FormatFloat(math.Round(frac*100*10)/10, 'f', -1, 64)
}

func settingsFloatDefault(v float64) string {
	return strconv.FormatFloat(v, 'f', -1, 64)
}

func settingsMinutesDefault(d time.Duration) string {
	return strconv.Itoa(int(d / time.Minute))
}

// HostSettings — GET/POST /projects/{id}/hosts/settings: форма порогов
// встроенных инцидентов хоста (§5.5 дизайна) + свёрнутые блоки команды
// установки агента и конфига коллектора (hostsCollectorConfigDetails, тот
// же компонент, что на непустом списке хостов, HostsList — T14).
//
// form — введённые значения при повторной отрисовке после ошибки валидации
// (см. FormState); при первом открытии (GET) form == nil, и все поля берут
// значения из s (сервис уже вернул DefaultSettings, если строки настроек ещё
// нет). installCmd/config — пустые одновременно, если в проекте нет ни
// одного активного ключа типа agent (h.hostInstallBlocks, hosts.go, общий
// liveKeyFor-путь) — тогда вместо copyBlock показывается подсказка, где
// ключ завести. agentReason — почему installCmd пуст при непустом config
// (rem-A sec-M1/sec-M4): см. комментарий hostInstallBlocks и
// hostsCollectorConfigDetails (hosts.templ, тот же компонент рендерит блоки
// здесь).
//
// У каждого числового поля своя подсказка, связанная с полем через
// aria-describedby (UX-аудит A1, P2-6): подпись «Порог, %» не говорит, ЧТО
// сравнивается с порогом и за какое окно, а «Порог, на ядро» не объясняла
// даже, что речь про load average, делённый на число логических ядер. Тексты —
// краткий пересказ таблицы порогов из docs/hosts.md, туда же ведёт ссылка
// внизу страницы.
templ HostSettings(projectID int64, s host.Settings, installCmd, config, agentReason string, form FormState, errMsg string, groups HostGroupThresholdsVM, userEmail string) {
	@layout(i18n.T(ctx, "nav.host_thresholds"), userEmail) {
		<div class="host-settings">
			<h1>{ i18n.T(ctx, "nav.host_thresholds") }</h1>
			if errMsg != "" {
				<p class="error" id="host-settings-error">{ errMsg }</p>
			}
			<form method="post" action={ templ.URL(hostSettingsFormPath(projectID)) } class="host-settings-form">
				<fieldset class="card">
					<legend class="card-header">{ i18n.T(ctx, "hosts.settings.disk_title") }</legend>
					<label class="checkbox-inline">
						<input type="checkbox" name="disk_enabled" checked?={ form.Get("disk_enabled", settingsBoolDefault(s.DiskEnabled)) == "1" }/>
						{ i18n.T(ctx, "hosts.settings.field.enabled") }
					</label>
					<div class="field">
						<label>
							{ i18n.T(ctx, "hosts.settings.field.disk_threshold") }
							<input type="number" class="input" name="disk_threshold" min="1" max="100" step="1" required
								value={ form.Get("disk_threshold", settingsPercentDefault(s.DiskThreshold)) }
								aria-describedby="hint-disk-threshold"/>
						</label>
						<p class="hint" id="hint-disk-threshold">{ i18n.T(ctx, "hosts.settings.hint.disk_threshold") }</p>
					</div>
				</fieldset>
				<fieldset class="card">
					<legend class="card-header">{ i18n.T(ctx, "hosts.settings.memory_title") }</legend>
					<label class="checkbox-inline">
						<input type="checkbox" name="memory_enabled" checked?={ form.Get("memory_enabled", settingsBoolDefault(s.MemoryEnabled)) == "1" }/>
						{ i18n.T(ctx, "hosts.settings.field.enabled") }
					</label>
					<div class="field">
						<label>
							{ i18n.T(ctx, "hosts.settings.field.memory_threshold") }
							<input type="number" class="input" name="memory_threshold" min="1" max="100" step="1" required
								value={ form.Get("memory_threshold", settingsPercentDefault(s.MemoryThreshold)) }
								aria-describedby="hint-memory-threshold"/>
						</label>
						<p class="hint" id="hint-memory-threshold">{ i18n.T(ctx, "hosts.settings.hint.memory_threshold") }</p>
					</div>
				</fieldset>
				<fieldset class="card">
					<legend class="card-header">{ i18n.T(ctx, "hosts.settings.load_title") }</legend>
					<label class="checkbox-inline">
						<input type="checkbox" name="load_enabled" checked?={ form.Get("load_enabled", settingsBoolDefault(s.LoadEnabled)) == "1" }/>
						{ i18n.T(ctx, "hosts.settings.field.enabled") }
					</label>
					<div class="field">
						<label>
							{ i18n.T(ctx, "hosts.settings.field.load_threshold") }
							<input type="number" class="input" name="load_threshold" min="0.1" step="0.1" required
								value={ form.Get("load_threshold", settingsFloatDefault(s.LoadThreshold)) }
								aria-describedby="hint-load-threshold"/>
						</label>
						<p class="hint" id="hint-load-threshold">{ i18n.T(ctx, "hosts.settings.hint.load_threshold") }</p>
					</div>
				</fieldset>
				<fieldset class="card">
					<legend class="card-header">{ i18n.T(ctx, "hosts.settings.silent_title") }</legend>
					<label class="checkbox-inline">
						<input type="checkbox" name="silent_enabled" checked?={ form.Get("silent_enabled", settingsBoolDefault(s.SilentEnabled)) == "1" }/>
						{ i18n.T(ctx, "hosts.settings.field.enabled") }
					</label>
					<div class="field">
						<label>
							{ i18n.T(ctx, "hosts.settings.field.silent_after") }
							<input type="number" class="input" name="silent_after" min="3" max="720" step="1" required
								value={ form.Get("silent_after", settingsMinutesDefault(s.SilentAfter)) }
								aria-describedby="hint-silent-after"/>
						</label>
						<p class="hint" id="hint-silent-after">{ i18n.T(ctx, "hosts.settings.hint.silent_after") }</p>
					</div>
				</fieldset>
				<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "hosts.settings.submit") }</button>
			</form>
			@hostGroupThresholdSection(projectID, s, groups)
			@hostsCollectorConfigDetails("host-settings-collector-config", projectID, installCmd, config, agentReason)
			<p class="hint"><a href="/docs/hosts">{ i18n.T(ctx, "hosts.settings.docs_link") }</a></p>
		</div>
	}
}

// HostGroupThresholdsVM — блок «Пороги по окружению/роли» (B2, T7): список
// уже сохранённых групповых правил проекта + состояние формы добавления/
// редактирования. Отдельная мини-VM, а не ещё пяток параметров у HostSettings
// — тот же приём, что HostChartVM/HostDetailVM у карточки хоста.
type HostGroupThresholdsVM struct {
	// Groups — все групповые правила проекта (host.GroupThresholdService.List,
	// уже отсортированы scope/label). nil, если GroupThresholds/Hosts ещё не
	// проведены в Handler (см. renderHostSettings) — секция тогда просто не
	// предлагает добавление (Envs/Roles тоже пусты).
	Groups []host.GroupThreshold
	// Envs/Roles — значения меток проекта (host.Store.FacetValues, B1) —
	// источник опций select'а метки формы добавления. Пустой список у одного
	// из них скрывает соответствующий scope из сегмент-контрола: предлагать
	// «окружение», когда ни один хост его не проставил, было бы пустой
	// опцией без единого варианта метки.
	Envs, Roles []string
	// EditScope/EditLabel — какое существующее правило форма редактирует:
	// на первом открытии — из query "?gt_scope=&gt_label=" ссылки
	// «Редактировать» в строке таблицы, на переотрисовке после ошибки — из
	// только что отправленных полей той же формы (см. renderHostSettings,
	// hosts.go). Пустые — форма в режиме добавления нового правила.
	EditScope, EditLabel string
	// Form — введённые значения формы группового правила при переотрисовке
	// после ошибки валидации (см. FormState); nil на первом открытии — поля
	// формы тогда берут значения из найденного по EditScope/EditLabel
	// правила (или из "inherit"/пусто, если EditScope/EditLabel не заданы
	// или не совпали ни с одним правилом — режим добавления).
	Form FormState
	// ErrMsg — сообщение об ошибке валидации формы группового правила (не
	// путать с errMsg у HostSettings — это ошибка ДРУГОЙ формы на той же
	// странице, ошибка одной не трогает другую).
	ErrMsg string
}

func groupThresholdSettingsPath(projectID int64) string {
	return hostSettingsFormPath(projectID) + "/groups"
}

func groupThresholdDeleteSettingsPath(projectID int64) string {
	return groupThresholdSettingsPath(projectID) + "/delete"
}

// groupThresholdEditPath — ссылка «Редактировать» строки таблицы: та же
// страница настроек с query-параметрами, которые говорят форме добавления,
// какое правило предзаполнить (см. HostGroupThresholdsVM.EditScope/
// EditLabel), плюс якорь на саму форму — без него правку легко не заметить
// под уже длинным списком правил.
func groupThresholdEditPath(projectID int64, scope, label string) string {
	return hostSettingsFormPath(projectID) + "?gt_scope=" + url.QueryEscape(scope) + "&gt_label=" + url.QueryEscape(label) + "#host-group-threshold-form"
}

// groupThresholdBy находит в groups правило с точным совпадением scope+label
// — источник значений формы в режиме редактирования (EditScope/EditLabel).
// Пустой scope/label (режим добавления, ссылка не совпала ни с одним
// правилом) — намеренно "не найдено", а не совпадение с пустой меткой (та же
// защита от "группы без метки", что у резолвера, host/resolve.go).
func groupThresholdBy(groups []host.GroupThreshold, scope, label string) (host.GroupThreshold, bool) {
	if scope == "" || label == "" {
		return host.GroupThreshold{}, false
	}
	for _, g := range groups {
		if g.Scope == scope && g.Label == label {
			return g, true
		}
	}
	return host.GroupThreshold{}, false
}

// groupScopeDefault — какой scope предвыбран в сегмент-контроле формы: тот,
// что редактируется (EditScope), а если у него нет доступных меток (env/role
// исчезли между отрисовкой ссылки «Редактировать» и открытием формы) или
// правка не запрошена вовсе — первый scope с непустым списком меток.
func groupScopeDefault(editScope string, envs, roles []string) string {
	if editScope == "env" && len(envs) > 0 {
		return "env"
	}
	if editScope == "role" && len(roles) > 0 {
		return "role"
	}
	if len(envs) > 0 {
		return "env"
	}
	return "role"
}

// groupKindPart/groupThresholdParts — «Диск: 80%», «Тишина: выключено» и
// т.п. для ТОЛЬКО заданных (non-nil Enabled) видов правила — список того, что
// это правило реально переопределяет (ненаследуемые виды в перечень не
// попадают, тем же смыслом, что и "inherit" на карточке хоста, T6).
func groupKindPart(ctx context.Context, kind string, enabled *bool, value *float64) string {
	if enabled == nil {
		return ""
	}
	valueText := i18n.T(ctx, "host.threshold.off_value")
	if *enabled {
		v := 0.0
		if value != nil {
			v = *value
		}
		valueText = host.ValueLabel(ctx, kind, v)
	}
	return i18n.T(ctx, "host.threshold."+kind) + ": " + valueText
}

func groupThresholdParts(ctx context.Context, gt host.GroupThreshold) []string {
	var parts []string
	if p := groupKindPart(ctx, "disk", gt.DiskEnabled, gt.DiskThreshold); p != "" {
		parts = append(parts, p)
	}
	if p := groupKindPart(ctx, "memory", gt.MemoryEnabled, gt.MemoryThreshold); p != "" {
		parts = append(parts, p)
	}
	if p := groupKindPart(ctx, "load", gt.LoadEnabled, gt.LoadThreshold); p != "" {
		parts = append(parts, p)
	}
	if gt.SilentEnabled != nil {
		valueText := i18n.T(ctx, "host.threshold.off_value")
		if *gt.SilentEnabled {
			secs := 0.0
			if gt.SilentAfter != nil {
				secs = gt.SilentAfter.Seconds()
			}
			valueText = host.ValueLabel(ctx, "silent", secs)
		}
		parts = append(parts, i18n.T(ctx, "host.threshold.silent")+": "+valueText)
	}
	return parts
}

// groupThresholdKinds — ячейка «заданные виды» строки таблицы.
templ groupThresholdKinds(gt host.GroupThreshold) {
	if gt.DiskEnabled == nil && gt.MemoryEnabled == nil && gt.LoadEnabled == nil && gt.SilentEnabled == nil {
		{ i18n.T(ctx, "host.group_threshold.none_set") }
	} else {
		for i, part := range groupThresholdParts(ctx, gt) {
			if i > 0 {
				{ ", " }
			}
			{ part }
		}
	}
}

// groupThresholdRow — строка таблицы существующих правил: scope+label+
// заданные виды, ссылка «Редактировать» (заполняет форму ниже тем же
// правилом) и форма удаления (тот же приём без confirm-страницы, что у
// metricAlertsBasePath+"/delete", metricalerts.templ — правило одно из
// многих в списке, а не необратимое per-хост действие вроде hostDelete).
templ groupThresholdRow(projectID int64, gt host.GroupThreshold) {
	<tr>
		<td>{ i18n.T(ctx, "host.threshold.scope."+gt.Scope) }</td>
		<td>{ gt.Label }</td>
		<td>@groupThresholdKinds(gt)</td>
		<td class="gt-row-actions">
			<a href={ templ.URL(groupThresholdEditPath(projectID, gt.Scope, gt.Label)) }>{ i18n.T(ctx, "host.group_threshold.edit") }</a>
			<form method="post" action={ templ.URL(groupThresholdDeleteSettingsPath(projectID)) } class="inline">
				<input type="hidden" name="scope" value={ gt.Scope }/>
				<input type="hidden" name="label" value={ gt.Label }/>
				<button type="submit" class="btn btn-danger">{ i18n.T(ctx, "host.group_threshold.delete") }</button>
			</form>
		</td>
	</tr>
}

// hostGroupThresholdSection — блок «Пороги по окружению/роли» (B2, T7):
// таблица существующих правил + форма добавления/редактирования (пер-видовое
// наследовать/переопределить/выключить — тот же контрол, что у порогов
// одного хоста, hostThresholdsSection/T6). s — настройки проекта, источник
// значения по умолчанию у числового поля при переключении на
// "Переопределить" (thresholdPercentValue/thresholdFloatValue/
// thresholdMinutesValue — та же логика, что при переопределении на карточке
// хоста: редактирование начинается не с нуля, а с уже действующего числа).
//
// Форма скрыта целиком (вместе с толькочто пояснением), если проект ещё не
// накопил ни одной метки env/role — предлагать её раньше нечего выбирать в
// select'е метки (groups.Envs/Roles пусты одновременно).
templ hostGroupThresholdSection(projectID int64, s host.Settings, groups HostGroupThresholdsVM) {
	<section class="host-group-thresholds">
		<h2>{ i18n.T(ctx, "host.group_threshold.title") }</h2>
		if len(groups.Groups) == 0 {
			<p class="hint">{ i18n.T(ctx, "host.group_threshold.empty") }</p>
		} else {
			@scrollRegion("table-scroll", "host.group_threshold.title") {
				<table class="data-table">
					<thead>
						<tr>
							<th scope="col">{ i18n.T(ctx, "host.group_threshold.table.scope") }</th>
							<th scope="col">{ i18n.T(ctx, "host.group_threshold.table.label") }</th>
							<th scope="col">{ i18n.T(ctx, "host.group_threshold.table.thresholds") }</th>
							<th scope="col"></th>
						</tr>
					</thead>
					<tbody>
						for _, gt := range groups.Groups {
							@groupThresholdRow(projectID, gt)
						}
					</tbody>
				</table>
			}
		}
		if groups.ErrMsg != "" {
			<p class="error" id="host-group-threshold-error">{ groups.ErrMsg }</p>
		}
		if len(groups.Envs) == 0 && len(groups.Roles) == 0 {
			<p class="hint">{ i18n.T(ctx, "host.group_threshold.no_labels") }</p>
		} else {
			{{ editing, editingFound := groupThresholdBy(groups.Groups, groups.EditScope, groups.EditLabel) }}
			{{ scopeDefault := groupScopeDefault(groups.EditScope, groups.Envs, groups.Roles) }}
			<form id="host-group-threshold-form" method="post" action={ templ.URL(groupThresholdSettingsPath(projectID)) } class="host-group-threshold-form">
				if editingFound {
					<p class="hint" id="host-group-threshold-editing">{ i18n.Tf(ctx, "host.group_threshold.editing", "scope", i18n.T(ctx, "host.threshold.scope."+groups.EditScope), "label", groups.EditLabel) }</p>
				}
				<fieldset class="field">
					<legend class="field-label">{ i18n.T(ctx, "host.group_threshold.scope") }</legend>
					<div class="segmented">
						if len(groups.Envs) > 0 {
							<label>
								<input type="radio" name="scope" value="env" checked?={ groups.Form.Selected("scope", "env", scopeDefault) }/>
								{ i18n.T(ctx, "host.threshold.scope.env") }
							</label>
						}
						if len(groups.Roles) > 0 {
							<label>
								<input type="radio" name="scope" value="role" checked?={ groups.Form.Selected("scope", "role", scopeDefault) }/>
								{ i18n.T(ctx, "host.threshold.scope.role") }
							</label>
						}
					</div>
				</fieldset>
				<div class="field gt-label-env">
					<label>
						{ i18n.T(ctx, "host.group_threshold.label") }
						<select name="label_env" class="select">
							for _, v := range groups.Envs {
								<option value={ v } selected?={ groups.Form.Selected("label_env", v, groupEditDefault(groups.EditScope, groups.EditLabel, "env")) }>{ v }</option>
							}
						</select>
					</label>
				</div>
				<div class="field gt-label-role">
					<label>
						{ i18n.T(ctx, "host.group_threshold.label") }
						<select name="label_role" class="select">
							for _, v := range groups.Roles {
								<option value={ v } selected?={ groups.Form.Selected("label_role", v, groupEditDefault(groups.EditScope, groups.EditLabel, "role")) }>{ v }</option>
							}
						</select>
					</label>
				</div>
				<fieldset class="card th-kind">
					<legend class="card-header">{ i18n.T(ctx, "host.threshold.disk") }</legend>
					<div class="segmented">
						<label>
							<input type="radio" name="disk_mode" value="inherit" checked?={ thresholdModeFor(groups.Form, "disk_mode", editing.DiskEnabled) == "inherit" }/>
							{ i18n.T(ctx, "host.threshold.inherit") }
						</label>
						<label>
							<input type="radio" name="disk_mode" value="override" checked?={ thresholdModeFor(groups.Form, "disk_mode", editing.DiskEnabled) == "override" }/>
							{ i18n.T(ctx, "host.threshold.override") }
						</label>
						<label>
							<input type="radio" name="disk_mode" value="off" checked?={ thresholdModeFor(groups.Form, "disk_mode", editing.DiskEnabled) == "off" }/>
							{ i18n.T(ctx, "host.threshold.off") }
						</label>
					</div>
					<div class="field th-disk-value">
						<label>
							{ i18n.T(ctx, "hosts.settings.field.disk_threshold") }
							<input type="number" class="input" name="disk_value" min="1" max="100" step="1"
								value={ groups.Form.Get("disk_value", thresholdPercentValue(editing.DiskThreshold, s.DiskThreshold)) }/>
						</label>
					</div>
				</fieldset>
				<fieldset class="card th-kind">
					<legend class="card-header">{ i18n.T(ctx, "host.threshold.memory") }</legend>
					<div class="segmented">
						<label>
							<input type="radio" name="memory_mode" value="inherit" checked?={ thresholdModeFor(groups.Form, "memory_mode", editing.MemoryEnabled) == "inherit" }/>
							{ i18n.T(ctx, "host.threshold.inherit") }
						</label>
						<label>
							<input type="radio" name="memory_mode" value="override" checked?={ thresholdModeFor(groups.Form, "memory_mode", editing.MemoryEnabled) == "override" }/>
							{ i18n.T(ctx, "host.threshold.override") }
						</label>
						<label>
							<input type="radio" name="memory_mode" value="off" checked?={ thresholdModeFor(groups.Form, "memory_mode", editing.MemoryEnabled) == "off" }/>
							{ i18n.T(ctx, "host.threshold.off") }
						</label>
					</div>
					<div class="field th-memory-value">
						<label>
							{ i18n.T(ctx, "hosts.settings.field.memory_threshold") }
							<input type="number" class="input" name="memory_value" min="1" max="100" step="1"
								value={ groups.Form.Get("memory_value", thresholdPercentValue(editing.MemoryThreshold, s.MemoryThreshold)) }/>
						</label>
					</div>
				</fieldset>
				<fieldset class="card th-kind">
					<legend class="card-header">{ i18n.T(ctx, "host.threshold.load") }</legend>
					<div class="segmented">
						<label>
							<input type="radio" name="load_mode" value="inherit" checked?={ thresholdModeFor(groups.Form, "load_mode", editing.LoadEnabled) == "inherit" }/>
							{ i18n.T(ctx, "host.threshold.inherit") }
						</label>
						<label>
							<input type="radio" name="load_mode" value="override" checked?={ thresholdModeFor(groups.Form, "load_mode", editing.LoadEnabled) == "override" }/>
							{ i18n.T(ctx, "host.threshold.override") }
						</label>
						<label>
							<input type="radio" name="load_mode" value="off" checked?={ thresholdModeFor(groups.Form, "load_mode", editing.LoadEnabled) == "off" }/>
							{ i18n.T(ctx, "host.threshold.off") }
						</label>
					</div>
					<div class="field th-load-value">
						<label>
							{ i18n.T(ctx, "hosts.settings.field.load_threshold") }
							<input type="number" class="input" name="load_value" min="0.1" step="0.1"
								value={ groups.Form.Get("load_value", thresholdFloatValue(editing.LoadThreshold, s.LoadThreshold)) }/>
						</label>
					</div>
				</fieldset>
				<fieldset class="card th-kind">
					<legend class="card-header">{ i18n.T(ctx, "host.threshold.silent") }</legend>
					<div class="segmented">
						<label>
							<input type="radio" name="silent_mode" value="inherit" checked?={ thresholdModeFor(groups.Form, "silent_mode", editing.SilentEnabled) == "inherit" }/>
							{ i18n.T(ctx, "host.threshold.inherit") }
						</label>
						<label>
							<input type="radio" name="silent_mode" value="override" checked?={ thresholdModeFor(groups.Form, "silent_mode", editing.SilentEnabled) == "override" }/>
							{ i18n.T(ctx, "host.threshold.override") }
						</label>
						<label>
							<input type="radio" name="silent_mode" value="off" checked?={ thresholdModeFor(groups.Form, "silent_mode", editing.SilentEnabled) == "off" }/>
							{ i18n.T(ctx, "host.threshold.off") }
						</label>
					</div>
					<div class="field th-silent-value">
						<label>
							{ i18n.T(ctx, "hosts.settings.field.silent_after") }
							<input type="number" class="input" name="silent_value" min="3" max="720" step="1"
								value={ groups.Form.Get("silent_value", thresholdMinutesValue(editing.SilentAfter, s.SilentAfter)) }/>
						</label>
					</div>
				</fieldset>
				<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "host.group_threshold.save") }</button>
			</form>
		}
	</section>
}

// groupEditDefault — fallback метки select'а формы (используется через
// FormState.Selected как последний аргумент): EditLabel, если правится
// правило именно этого scope, иначе пусто (ни одна опция не предвыбрана —
// браузер сам подсветит первую, как у остальных select без сохранённого
// выбора, ср. maintenanceTimezoneOption).
func groupEditDefault(editScope, editLabel, wantScope string) string {
	if editScope == wantScope {
		return editLabel
	}
	return ""
}
